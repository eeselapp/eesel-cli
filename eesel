# Agent helpers
# ──────────────────────────────────────────────────────────────────────────

def fetch_agents(creds: dict) -> list[dict]:
    """Return list of {agent_id, name, agent_type} for the workspace."""
    url = f"{creds['api_url']}/agents?{urllib.parse.urlencode({'workspace_id': creds['workspace_id']})}"
    data = http_request("GET", url, token=creds["token"])
    # Response shape varies; normalize.
    items = data if isinstance(data, list) else data.get("agents") or data.get("items") or []
    return items


def pick_agent(creds: dict, *, prompt: bool = True) -> str:
    if creds.get("agent_id"):
        return creds["agent_id"]
    agents = fetch_agents(creds)
    if not agents:
        sys.exit("No agents in workspace. Create one in the dashboard first.")
    if len(agents) == 1 or not prompt:
        chosen = agents[0]
    else:
        print("Pick an agent:")
        for i, a in enumerate(agents):
            print(f"  [{i}] {a.get('name', '?')}  ({a.get('agent_id', '?')[:8]})")
        try:
            idx = int(input("> ").strip())
            chosen = agents[idx]
        except (ValueError, IndexError):
            sys.exit("Invalid choice.")
    creds["agent_id"] = chosen["agent_id"]
    save_creds(creds)
    return creds["agent_id"]


# ──────────────────────────────────────────────────────────────────────────
# Chat — POST /agents/sandbox/start + stream
# ──────────────────────────────────────────────────────────────────────────

def send_message(creds: dict, sess: dict, message: str) -> str:
    sess["messages"].append({"sender": "user", "message": message})

    body = {
        "messages": sess["messages"],
        "agentId": sess["agent_id"],
        "taskId": sess["task_id"],
    }
    url = f"{creds['api_url']}/agents/sandbox/start"
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {creds['token']}",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            start_resp = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        err(f"sandbox/start → {e.code}: {body_text}")
        sess["messages"].pop()  # roll back the user message
        save_session(sess)
        return ""

    task_id = start_resp.get("taskId", sess["task_id"])
    sess["task_id"] = task_id
    stream_url = start_resp.get("streamUrl")

    print(_color("eesel ", "36") + "→ ", end="", flush=True)
    text = stream_reply(creds, task_id, stream_url)
    print()  # newline after stream

    if text:
        sess["messages"].append({"sender": "assistant", "message": text})
    save_session(sess)
    return text


def stream_reply(creds: dict, task_id: str, stream_url: str | None) -> str:
    if stream_url:
        url = stream_url
        headers = {}
    else:
        url = f"{creds['api_url']}/agents/chat/{task_id}/raw-stream"
        headers = {"Authorization": f"Bearer {creds['token']}"}
    req = urllib.request.Request(url, headers=headers)

    text_buffers: dict[str, str] = {}
    text_order: list[str] = []

    try:
        with urllib.request.urlopen(req, timeout=900) as resp:
            for raw in resp:
                line = raw.decode(errors="replace").rstrip("\r\n")
                if not line.startswith("data:"):
                    continue
                data = line[5:].lstrip()
                if not data or data == "[DONE]":
                    continue
                try:
                    evt = json.loads(data)
                except json.JSONDecodeError:
                    continue
                etype = evt.get("type")
                if etype == "text-start":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                elif etype == "text-delta":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                    delta = evt.get("delta", "")
                    text_buffers[tid] += delta
                    sys.stdout.write(delta)
                    sys.stdout.flush()
                elif etype == "tool-input-available":
                    name = evt.get("toolName")
                    inp = json.dumps(evt.get("input"))[:200]
                    print(_color(f"\n[tool] {name} {inp}", "2;37"), flush=True)
                elif etype == "tool-output-available":
                    out = evt.get("output")
                    preview = (json.dumps(out) if not isinstance(out, str) else out)[:200]
                    print(_color(f"[tool] → {preview}", "2;37"), flush=True)
                elif etype == "error":
                    print(_color(f"\n[error] {evt.get('errorText') or evt}", "31"),
                          file=sys.stderr, flush=True)
    except urllib.error.HTTPError as e:
        err(f"raw-stream → {e.code}: {e.read().decode(errors='replace')}")
        return ""

    return "".join(text_buffers[tid] for tid in text_order).strip()


