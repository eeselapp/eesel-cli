# Argument parsing
# ──────────────────────────────────────────────────────────────────────────


def hide_subcommands(sub_action, *names: str) -> None:
    """Hide already-registered subparsers (back-compat aliases) from a group's
    `--help`: drop them from the visible choice list AND rebuild the usage-line
    metavar so neither the listed subcommands nor the `{...}` usage shows them.

    argparse has no public API for a hidden alias: `help=argparse.SUPPRESS` only
    blanks the description, so the choice still leaks into the metavar unless the
    metavar is rebuilt from the trimmed list. Both steps live here so every group
    hides aliases identically — a per-group copy of this once forgot the metavar
    rebuild and leaked `delete`/`run` into `eesel schedules --help`.
    """
    hidden = set(names)
    sub_action._choices_actions = [a for a in sub_action._choices_actions if a.dest not in hidden]
    sub_action.metavar = "{" + ",".join(ca.dest for ca in sub_action._choices_actions) + "}"


def _add_documents_parser(sub, name: str, hidden: bool = False) -> None:
    """Register the documents command tree under `name`.

    Called once for the canonical plural `documents` and once for the legacy
    singular `document` (with `hidden=True`), so both share an identical
    subcommand surface. When hidden, the alias still parses and runs but is
    dropped from `--help` (the same technique used for the staff `impersonate`
    command).
    """
    sp = sub.add_parser(
        name,
        help=argparse.SUPPRESS if hidden else "List, show, add, remove documents (and manage knowledge ACLs)",
    )
    d_sub = sp.add_subparsers(dest="document_cmd")

    ls = d_sub.add_parser("list", help="List documents in this workspace")
    ls.add_argument("--prefix", help="Filter by document key prefix")
    ls.add_argument("--search", help="Free-text query over document names/keys")
    ls.add_argument("--limit", type=int, default=100, help="Maximum documents to return")
    ls.add_argument("--offset", type=int, default=0, help="Pagination offset")
    ls.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    ls.add_argument("--json", action="store_true", help="Emit the raw documents payload")
    ls.add_argument("--plain", action="store_true", help="Emit one tab-separated `id<TAB>key<TAB>name` row per document")

    # `show` is the canonical verb for "see one document"; `read` is its hidden
    # alias, kept for existing scripts. Both print a document's contents.
    for verb, hide in (("show", False), ("read", True)):
        rd = d_sub.add_parser(
            verb,
            help=argparse.SUPPRESS if hide else "Print a document's contents (omit id for an interactive menu)",
        )
        rd.add_argument("target", nargs="?", help="Document id, id-prefix, key, or filename (omit to pick from a menu)")
        rd.add_argument("--prefix", help="Filter the menu/list to keys under this prefix (e.g. files/, outputs/)")
        rd.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
        rd.add_argument("--format", default="md", choices=["md", "html"], help="Content format (default: md)")
        rd.add_argument("--json", action="store_true", help="Emit the document as a JSON object (id, key, content)")

    exp = d_sub.add_parser("export", help="Download a document as markdown or HTML")
    target = exp.add_mutually_exclusive_group(required=True)
    target.add_argument("--document-key", help="Document key to export")
    target.add_argument("--document-id", help="Document id to export")
    exp.add_argument("--format", default="md", choices=["md", "html"], help="Export format")
    exp.add_argument("-o", "--output", help="Output file path")

    cr = d_sub.add_parser("add", help="Add a document to the workspace (prints its key)")
    cr.add_argument("--title", required=True, help="Document title")
    content = cr.add_mutually_exclusive_group(required=True)
    content.add_argument("--content", help="Document content (inline)")
    content.add_argument("--content-file", help="Read document content from this file")
    cr.add_argument("--source-type", default="files", help="Source type the document is filed under (default: files)")
    cr.add_argument("--agent", help="Agent id, id-prefix, or name to grant knowledge access (default: active agent, or $EESEL_AGENT)")

    de = d_sub.add_parser("remove", help="Remove documents by key (asks for confirmation)")
    de.add_argument("keys", nargs="+", help="One or more document keys or ids to remove (each must match an existing document)")
    de.add_argument("-f", "--force", action="store_true", help="Skip the confirmation prompt (for non-interactive use)")

    acl = d_sub.add_parser("acl", help="Show or set an agent's knowledge-ACL key prefixes")
    acl_sub = acl.add_subparsers(dest="acl_cmd")
    acl_get = acl_sub.add_parser("show", help="Print an agent's knowledge-ACL key prefixes")
    acl_get.add_argument("agent", help="Agent id, id-prefix, or name")
    acl_get.add_argument("--json", action="store_true", help="Emit the key prefixes as a JSON array")
    acl_set = acl_sub.add_parser(
        "set",
        help="Replace an agent's knowledge-ACL key prefixes (this REPLACES the existing prefixes, it does not append)",
    )
    acl_set.add_argument("agent", help="Agent id, id-prefix, or name")
    acl_set.add_argument(
        "--prefix",
        action="append",
        required=True,
        dest="prefix",
        help="A key prefix to grant (repeatable). REPLACES the agent's current prefixes",
    )

    hide_subcommands(d_sub, "read")  # `read` is the hidden alias for `show`

    sp.set_defaults(func=cmd_document, document_cmd="list", prefix=None, search=None, limit=100, offset=0)
    if hidden:
        # Keep the alias parseable but off `--help`: drop it from the choices
        # list and the metavar is rebuilt from the survivors after all parsers
        # are registered.
        sub._choices_actions = [a for a in sub._choices_actions if a.dest != name]


def _install_suggestions(parser: argparse.ArgumentParser) -> None:
    """Make every subcommand level suggest the closest valid name on a typo.

    By default argparse fails an unknown subcommand with a bare "invalid
    choice", which dead-ends the user (or an agent). For each parser that has
    subcommands, this replaces the error handler so an unrecognized subcommand
    gets a "Did you mean X?" hint (nearest match by edit distance), then
    recurses into the child parsers so nested levels behave the same. Other
    parse errors fall through unchanged. Called once on the root after the whole
    tree is built, so it covers every noun automatically.
    """
    sub_action = next(
        (a for a in parser._actions if isinstance(a, argparse._SubParsersAction)), None
    )
    if sub_action is None:
        return
    # Suggest only visible subcommands (hidden back-compat aliases are dropped
    # from _choices_actions), falling back to all choices if none are visible.
    visible = [a.dest for a in sub_action._choices_actions]
    choices = visible or list(sub_action.choices)
    original_error = parser.error

    # A parser can carry a `_eesel_relocations` map of {old-subcommand: hint} for
    # subcommands that moved to a different command group. When the moved name is
    # given, point at the new home instead of a generic "did you mean" — e.g.
    # `eesel triggers fire` now lives at `eesel schedules fire`.
    relocations = getattr(parser, "_eesel_relocations", None) or {}

    def error(message: str, _orig=original_error, _choices=choices, _reloc=relocations) -> None:
        if "invalid choice" in message:
            bad = message.split("invalid choice: ", 1)[1].split(" ", 1)[0].strip("'\"")
            if bad in _reloc:
                hint = f" {_reloc[bad]}"
            else:
                near = difflib.get_close_matches(bad, _choices, n=1)
                hint = f" Did you mean {near[0]!r}?" if near else f" Choose from: {', '.join(_choices)}."
            message = message + hint
        _orig(message)

    parser.error = error  # type: ignore[method-assign]
    for child in sub_action.choices.values():
        _install_suggestions(child)


def build_parser(staff: bool = False) -> argparse.ArgumentParser:
    """Build the CLI parser.

    `staff` is whether the current login is on the global impersonator
    allowlist (cached in creds; see `cache_impersonator_flag`). When False, the
    staff-only surfaces — dev login (`--dev`/`--workspace-id`) and the
    `impersonate` command — are hidden from `--help`. They remain parseable so
    nothing breaks for someone who knows them, but the server-side allowlist
    (and, for dev login, the local-only dev secret) is the real gate.
    """
    p = argparse.ArgumentParser(prog="eesel", description=__doc__.strip().split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("login", help="Authenticate (browser-based, or --dev for local)" if staff else "Authenticate")
    sp.add_argument("--dev", action="store_true", help="Mint local dev JWT, no browser" if staff else argparse.SUPPRESS)
    sp.add_argument("--workspace-id", help="Dev login only: workspace id to mint credentials for" if staff else argparse.SUPPRESS)
    sp.set_defaults(func=cmd_login)

    sp = sub.add_parser("logout", help="Clear stored credentials")
    sp.set_defaults(func=cmd_logout)

    sp = sub.add_parser("whoami", help="Show the current login")
    sp.set_defaults(func=cmd_whoami)

    sp = sub.add_parser("agents", help="List, inspect, or manage agents")
    a_sub = sp.add_subparsers(dest="agents_cmd")
    list_p = a_sub.add_parser("list", help="List agents in this workspace (each row shows its on/off status)")
    list_p.add_argument("--json", action="store_true", help="Print the raw agent list as JSON")
    list_p.add_argument("--plain", action="store_true", help="Emit one tab-separated `agent_id<TAB>state<TAB>name` row per agent")

    show = a_sub.add_parser("show", help="Show one agent's full detail (type, status, instructions)")
    show.add_argument("agent_id", help="Full id, id prefix, or agent name (must match exactly one)")
    show.add_argument("--json", action="store_true", help="Print the raw agent record as JSON")

    instr = a_sub.add_parser("instructions", help="Show an agent's instructions (its system prompt)")
    instr.add_argument("agent", nargs="?", help="Agent id, id-prefix, or name (default: active agent)")

    create = a_sub.add_parser("create", help="Create a new agent")
    create.add_argument("--name", help="Agent name (required)")
    create.add_argument("--instructions", help="The agent's instructions / system prompt (optional)")

    # Hidden alias: `agents add` behaves identically to `agents create` so the
    # `add` verb (used to bring in every other noun) also works for agents.
    add = a_sub.add_parser("add", help=argparse.SUPPRESS)
    add.add_argument("--name", help="Agent name (required)")
    add.add_argument("--instructions", help="The agent's instructions / system prompt (optional)")

    # `set` changes an existing agent's fields; `edit` is the prior name, kept
    # as a hidden alias.
    for _verb in ("set", "edit"):
        _p = a_sub.add_parser(
            _verb,
            help="Change an agent's name or instructions (only the flags you pass)"
            if _verb == "set" else argparse.SUPPRESS,
        )
        _p.add_argument("agent_id", help="Full id, id prefix, or agent name (must match exactly one)")
        _p.add_argument("--name", help="New name")
        _p.add_argument("--instructions", help="New instructions / system prompt")

    remove = a_sub.add_parser("remove", help="Remove an agent (asks for confirmation)")
    remove.add_argument("agent_id", help="Full id, id prefix, or agent name (must match exactly one)")
    remove.add_argument("-f", "--force", action="store_true", help="Skip the confirmation prompt (for non-interactive use)")

    # `use` / `unset` set or clear a persistent active agent stored on disk. The
    # preferred, stateless way to scope a command is the EESEL_AGENT environment
    # variable or a per-command --agent flag (see apply_agent_env_override), so a
    # command's target is explicit rather than depending on hidden saved state.
    # They stay available but are hidden from help and the usage line: help=
    # SUPPRESS blanks the description, then the names are dropped from
    # _choices_actions so they disappear from the subcommand list and metavar.
    use = a_sub.add_parser("use", help=argparse.SUPPRESS)
    use.add_argument("agent_id", nargs="?")
    a_sub.add_parser("unset", help=argparse.SUPPRESS)

    hide_subcommands(a_sub, "use", "unset", "add", "edit")

    sp.set_defaults(func=cmd_agents)

    sp = sub.add_parser("instructions", help="Show an agent's instructions (its system prompt)")
    sp.add_argument("agent", nargs="?", help="Agent id, id-prefix, or name (default: active agent)")
    sp.set_defaults(func=cmd_instructions)

    sp = sub.add_parser("new", help="Start a new chat session")
    sp.add_argument("--agent", help="Agent id to use (default: active agent)")
    sp.add_argument("--name", help="Session name (default: auto)")
    # `--trigger` is the old name, kept as an alias; the noun is now a scheduled job.
    sp.add_argument("--schedule", "--trigger", dest="schedule", help="Bind session to a scheduled job (id-prefix or title substring) so the agent runs under that job's context (preview mode)")
    sp.set_defaults(func=cmd_new)

    sp = sub.add_parser("sessions", help="Manage chat sessions")
    s_sub = sp.add_subparsers(dest="sessions_cmd")
    s_sub.add_parser("list", help="List sessions")
    use = s_sub.add_parser("use", help="Switch active session")
    use.add_argument("session_id")
    rm = s_sub.add_parser("remove", help="Remove a session")
    rm.add_argument("session_id")
    # `delete` is the prior name, kept as a hidden alias for `remove`.
    de = s_sub.add_parser("delete", help=argparse.SUPPRESS)
    de.add_argument("session_id")
    show = s_sub.add_parser("show", help="Print session history")
    show.add_argument("session_id", nargs="?", help="(default: active session)")
    hide_subcommands(s_sub, "delete")  # `delete` is the hidden alias for `remove`
    sp.set_defaults(func=cmd_sessions)

    sp = sub.add_parser("chat", help="Send a message (no arg = interactive REPL)")
    sp.add_argument("message", nargs="?", help="Message to send (omit for REPL)")
    sp.add_argument("--agent", help="Agent id, id-prefix, or name to chat with (default: active agent, or $EESEL_AGENT). Explicit, stateless scope — does not change the saved active agent")
    sp.add_argument("--cost", action="store_true", help="After each reply, print a one-line cost + token summary for the whole session (incl. sub-agents)")
    # `--trigger` is the old name, kept as an alias; the noun is now a scheduled job.
    sp.add_argument(
        "--schedule",
        "--trigger",
        dest="schedule",
        help="Open a preview session bound to a scheduled job "
        "(id-prefix or title substring like 'heartbeat'). "
        "The agent runs under that job's context — "
        "useful for iterating on what the job would output",
    )
    sp.add_argument(
        "--task",
        help="Continue an existing conversation by its backend task id "
        "(e.g. one an agent included in an outbound request so your "
        "service can post the result back into the same conversation). "
        "Uses the active agent for new sessions",
    )
    sp.set_defaults(func=cmd_chat)

    sp = sub.add_parser("cost", help="Print cost + token usage for a session (includes sub-agents). Dev mode only.")
    sp.add_argument("session_id", nargs="?", help="(default: active session, prefix-match ok)")
    sp.set_defaults(func=cmd_cost)

    sp = sub.add_parser("tasks", help="List, count, or view workspace agent activity (all channels)")
    tk_sub = sp.add_subparsers(dest="tasks_cmd")
    tk_ls = tk_sub.add_parser("list", help="List recent tasks (most-recently-updated first)")
    tk_ls.add_argument("--limit", type=int, default=50, help="Tasks per page")
    tk_ls.add_argument("--page", type=int, default=1, help="Page number (1-based)")
    tk_ls.add_argument("--agent", help="Filter to one agent (full id, id-prefix, or name)")
    tk_ls.add_argument("--json", action="store_true", help="Emit the raw task rows as JSON instead of a table")
    tk_ls.add_argument("--plain", action="store_true", help="Emit one tab-separated `task_id<TAB>updated<TAB>agent<TAB>source<TAB>label` row per task")
    tk_ct = tk_sub.add_parser("count", help="Print the total number of tasks")
    tk_ct.add_argument("--agent", help="Count only one agent's tasks (full id, id-prefix, or name)")
    tk_ct.add_argument("--json", action="store_true", help="Emit the count as JSON instead of a sentence")
    tk_sh = tk_sub.add_parser("show", help="Print one task's full transcript")
    tk_sh.add_argument("task_id", help="Full task id or id-prefix")
    tk_sh.add_argument("--json", action="store_true", help="Emit the raw history payload instead of a rendered transcript")
    tk_sh.add_argument("--full", action="store_true", help="Don't truncate tool arguments/outputs")
    tk_sh.add_argument("--cost", action="store_true", help="Append a cost + token breakdown (dev mode only)")
    tk_co = tk_sub.add_parser("cost", help="Print cost + token usage for one task (includes sub-agents). Dev mode only.")
    tk_co.add_argument("task_id", help="Full task id or id-prefix")
    tk_co.add_argument("--json", action="store_true", help="Emit the raw cost breakdown as JSON instead of a summary")
    tk_an = tk_sub.add_parser("analytics", help="Print aggregated task analytics (resolution rate, counts, CSAT)")
    tk_an.add_argument("--agent", help="Scope analytics to one agent (full id, id-prefix, or name)")
    tk_an.add_argument("--start-date", dest="start_date", help="Range start, YYYY-MM-DD (default: all time)")
    tk_an.add_argument("--end-date", dest="end_date", help="Range end, YYYY-MM-DD (default: now)")
    tk_an.add_argument("--json", action="store_true", help="Emit the raw analytics payload instead of a summary")
    tk_ex = tk_sub.add_parser("export", help="Start a CSV export of tasks (download link is emailed when ready)")
    tk_ex.add_argument("--agent", help="Export only one agent's tasks (full id, id-prefix, or name)")
    tk_ex.add_argument("--start-date", dest="start_date", help="Range start, YYYY-MM-DD (default: last 7 days)")
    tk_ex.add_argument("--end-date", dest="end_date", help="Range end, YYYY-MM-DD (default: now)")
    sp.set_defaults(func=cmd_tasks, tasks_cmd="list", limit=50, page=1, agent=None)

    # `documents` is the canonical (plural) noun. Singular `document` is kept as
    # a hidden alias (registered below) so existing scripts keep working.
    _add_documents_parser(sub, "documents")
    _add_documents_parser(sub, "document", hidden=True)

    # Hidden back-compat alias: the read-only `eesel tools [agent]` command was
    # restructured into `eesel integrations <integration> actions`. Keep `tools`
    # working (suppressed from help) so existing scripts don't break.
    sp_tools = sub.add_parser("tools", help=argparse.SUPPRESS)
    sp_tools.add_argument("agent", nargs="?", help="Agent id, id-prefix, or name (default: active agent)")
    sp_tools.add_argument("--json", action="store_true", help="Emit the raw tools payload")
    sp_tools.set_defaults(func=cmd_tools)
    # `tools` is the hidden top-level alias for `integrations <int> actions`.
    # Only drop it from the choice list here; the root metavar is rebuilt once at
    # the end of this function, after every top-level command has been added
    # (unlike a group subparser, the root `sub` is still being populated below,
    # so `hide_subcommands` — which pins the metavar immediately — can't be used).
    sub._choices_actions = [a for a in sub._choices_actions if a.dest != "tools"]

    # `eesel integrations` lists and manages the workspace's integrations:
    # `available` (the connectable catalog), `connect`, `sync`, `sync-status`,
    # `show`, `remove`. Actions an integration exposes are scoped under it:
    # `eesel integrations <integration> actions <list|show|enable|disable|set>`.
    sp = sub.add_parser("integrations", help="List, connect, sync, and manage integrations and their actions")
    # --secrets / --json live on the parent too so bare `eesel integrations`
    # (which defaults to `list`) keeps accepting them.
    sp.add_argument("--secrets", action="store_true", help="Also print sensitive properties (access tokens etc). Sysadmin/impersonator accounts only")
    sp.add_argument("--json", action="store_true", help="Emit the raw integrations payload")
    sp.add_argument("--plain", action="store_true", help="Emit one tab-separated `id<TAB>type<TAB>connection<TAB>subdomain` row per integration")
    sp.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    # Bare `eesel integrations [--json] [--secrets]` lists integrations.
    # `eesel integrations <integration> actions ...` drops into the actions
    # sub-namespace. main() normalizes the latter form into the `actions`
    # subparser below before parsing, so the integration positional can't be
    # mistaken for a subcommand name.
    sp.set_defaults(func=cmd_integrations, integrations_cmd=None)
    ig_sub = sp.add_subparsers(dest="integrations_cmd")
    i_ls = ig_sub.add_parser("list", help="List every connected integration with status columns (read-only)")
    i_ls.add_argument("--secrets", action="store_true", help="Also print sensitive properties (access tokens etc). Sysadmin/impersonator accounts only")
    i_ls.add_argument("--json", action="store_true", help="Emit the raw integrations payload")
    i_ls.add_argument("--plain", action="store_true", help="Emit one tab-separated `id<TAB>type<TAB>connection<TAB>subdomain` row per integration")
    i_ls.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    i_av = ig_sub.add_parser("available", help="List connectable integration types and their connect options (read-only)")
    i_av.add_argument("--json", action="store_true", help="Emit the raw integration-definitions payload")
    i_av.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    i_show = ig_sub.add_parser("show", help="Show one connected integration's detail, including sync status (read-only)")
    i_show.add_argument("id", help="Full id, id prefix, or integration type of a connected integration")
    i_show.add_argument("--json", action="store_true", help="Emit the raw integration payload (with syncStatus)")
    i_show.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    def _connect_args(p):
        p.add_argument("key", help="Integration type key to connect (e.g. zendesk, website) — see `eesel integrations available`")
        p.add_argument("--option", help="Which connection option to use (its `type` from `eesel integrations available`); required when a connector has several")
        p.add_argument("--field", action="append", metavar="KEY=VALUE", help="A setup field for a `submit` connection option, e.g. `--field subdomain=acme` (repeatable)")
        p.add_argument("--agent", help="Agent id, id-prefix, or name to connect the integration for (default: active agent, or $EESEL_AGENT)")
        # Hidden back-compat flags carried over from the former `add` surface:
        # --config keys are folded into the field set, --token is sent as
        # access_token, and --no-input fails instead of opening a browser.
        p.add_argument("--config", help=argparse.SUPPRESS)
        p.add_argument("--token", help=argparse.SUPPRESS)
        p.add_argument("--no-input", action="store_true", help=argparse.SUPPRESS)

    i_connect = ig_sub.add_parser(
        "connect",
        help="Connect a new integration (browser OAuth hand-off, or a direct --field connect)",
        description="Connect a new integration of the given type. Run "
        "`eesel integrations available` to see connectable types and each one's "
        "connection options. `--option <type>` chooses one (required when a "
        "connector has several). A `submit` option connects directly — supply "
        "its fields with repeatable `--field key=value`. A `redirect` option "
        "opens the dashboard OAuth URL in your browser and hands off, like "
        "`eesel login`; the CLI does not wait for the flow to finish.",
    )
    _connect_args(i_connect)
    # `add` is the hidden back-compat alias for the canonical `connect`.
    _connect_args(ig_sub.add_parser("add", help=argparse.SUPPRESS))
    i_sy = ig_sub.add_parser(
        "sync",
        help="Trigger a data sync for a connected integration (Zendesk only today)",
        description="Trigger a data sync. --type must be one of: help-center, macros, tickets.",
    )
    i_sy.add_argument("id", help="Full id, id prefix, or integration type of a connected integration")
    i_sy.add_argument(
        "--type",
        default="help-center",
        choices=list(INTEGRATION_SYNC_TYPES),
        help="What to sync (default: help-center). One of: help-center, macros, tickets.",
    )
    i_sy.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    i_ss = ig_sub.add_parser("sync-status", help="Show sync-run status and progress (all runs, or one integration's)")
    i_ss.add_argument("id", nargs="?", help="Optional: full id, id prefix, or type of a connected integration to filter to")
    i_ss.add_argument("--json", action="store_true", help="Emit the raw sync-runs payload")
    i_ss.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")
    def _remove_args(p):
        p.add_argument("id", help="Full id, id prefix, or integration type of a connected integration")
        p.add_argument("-f", "--force", action="store_true", help="Skip the confirmation prompt (for non-interactive use)")
        p.add_argument("--agent", help="Agent id, id-prefix, or name to scope to (default: active agent, or $EESEL_AGENT)")

    i_rm = ig_sub.add_parser("remove", help="Disconnect a connected integration (asks for confirmation)")
    _remove_args(i_rm)
    # `disconnect` is the hidden back-compat alias for the canonical `remove`.
    _remove_args(ig_sub.add_parser("disconnect", help=argparse.SUPPRESS))

    ig_act = ig_sub.add_parser("actions", help="List, show, enable, disable, or edit an integration's actions")
    # The integration that scopes these actions (path positional, not a flag).
    ig_act.add_argument("integration", help="Integration type or instance id (e.g. 'zendesk')")
    act_sub = ig_act.add_subparsers(dest="actions_cmd")

    # --agent (whose action set to read/write) lives on every verb so it can be
    # passed after the verb, e.g. `... actions enable reply --agent Bot`.
    def _agent_arg(p):
        p.add_argument("--agent", help="Agent id, id-prefix, or name whose actions to read/write (default: active agent)")

    a_ls = act_sub.add_parser("list", help="List the integration's actions for the agent (read-only)")
    _agent_arg(a_ls)
    a_ls.add_argument("--json", action="store_true", help="Emit the raw actions payload")

    a_sh = act_sub.add_parser("show", help="Show one action's detail (read-only)")
    a_sh.add_argument("action", help="The action's key (e.g. 'zendesk_leave_internal_note')")
    _agent_arg(a_sh)
    a_sh.add_argument("--json", action="store_true", help="Emit the raw action entry")

    # enable and edit both POST /agents/{id}/tools/{tool_key}; enable sends an
    # empty config (action at its default settings), edit sends the given config.
    a_en = act_sub.add_parser("enable", help="Enable an action for the agent (POST with empty config)")
    a_en.add_argument("action", help="The action's key (e.g. 'zendesk_leave_internal_note')")
    _agent_arg(a_en)

    # `set` configures an action's settings; `edit` is the prior name, kept as
    # a hidden alias.
    for _verb in ("set", "edit"):
        a_ed = act_sub.add_parser(
            _verb,
            help="Configure an action's settings, e.g. permission mode (POST with config)"
            if _verb == "set" else argparse.SUPPRESS,
        )
        a_ed.add_argument("action", help="The action's key (e.g. 'zendesk_leave_internal_note')")
        a_ed.add_argument("--config", required=True, help="The action's full config as a JSON object (replaces what's stored; permission keys are kept if omitted), e.g. '{\"permission_mode\": \"ask\"}'")
        _agent_arg(a_ed)

    a_di = act_sub.add_parser("disable", help="Disable an action for the agent (DELETE; asks for confirmation)")
    a_di.add_argument("action", help="The action's key (e.g. 'zendesk_leave_internal_note')")
    _agent_arg(a_di)
    a_di.add_argument("-f", "--force", action="store_true", help="Skip the confirmation prompt (for non-interactive use)")

    ig_act.set_defaults(func=cmd_integration_actions, actions_cmd="list", agent=None, json=False, force=False)
    hide_subcommands(act_sub, "edit")  # `edit` is the hidden alias for `set`
    # `add`/`disconnect` are the hidden back-compat aliases for the canonical
    # `connect`/`remove` (the ENG-4700 universal verbs, kept working but off the
    # help surface so the ENG-4709 vocabulary is what's advertised).
    hide_subcommands(ig_sub, "add", "disconnect")

