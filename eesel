def _schedules_list(creds: dict, *, as_json: bool = False) -> int:
    """`eesel schedules list`: every scheduled job in the workspace, with its
    cron and timezone. Read-only."""
    rows = fetch_all_scheduled_jobs(creds)
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    if not rows:
        info("(no scheduled jobs in this workspace)")
        info("Add one with `eesel schedules add <agent> --cron \"0 9 * * *\" --prompt \"...\"`.")
        return 0
    for t in rows:
        cfg = t.get("config") or {}
        title = cfg.get("title") or "(untitled)"
        cron = cfg.get("cron") or "?"
