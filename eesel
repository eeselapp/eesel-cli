def _get_impersonate_status(creds: dict) -> dict | None:
    """GET /cli/impersonate, returning the parsed JSON or None on any error.

    Unlike `http_request`, this never calls sys.exit — it's for best-effort
    checks (whoami display, caching the staff-command gate) where a network
    hiccup or older server must not abort the CLI.
    """
    try:
        req = urllib.request.Request(
            f"{creds['api_url']}/cli/impersonate",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {creds['token']}"},
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read() or b"{}")
    except Exception:
        return None


def cache_impersonator_flag(creds: dict) -> bool:
    """Refresh and persist `is_impersonator` on the stored creds, returning
    whether this login is on the global impersonator allowlist.

    The cached flag is what gates the staff-only commands (`impersonate`, dev
    login) in `build_parser`, so the gate costs no per-command network call. On
    a network/endpoint error the cached value is left untouched, so a blip
    doesn't transiently hide a staff member's commands.
    """
    status = _get_impersonate_status(creds)
    if status is None:
        return bool(creds.get("is_impersonator"))
    allowed = bool(status.get("allowed"))
    if creds.get("is_impersonator") != allowed:
        creds["is_impersonator"] = allowed
        save_creds(creds)
    return allowed


def cmd_login(args) -> int:
    creds = login_dev(args.workspace_id) if args.dev else login_prod()
    # Cache whether this login is a global impersonator so the staff-only
    # commands can be surfaced/hidden without a network call on every run.
    cache_impersonator_flag(creds)
    return 0


def cmd_logout(args) -> int:
