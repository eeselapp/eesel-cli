# Cost tracking (dev-only for now)
# ──────────────────────────────────────────────────────────────────────────

# Recursively walks task → child tasks via parent_task_id, joins eesel_ai_task_metrics.
# One row per task in the tree; the root row has parent_task_id NULL.
_COST_SQL_TEMPLATE = """
WITH RECURSIVE task_tree AS (
    SELECT task_id, parent_task_id, name FROM eesel_ai_tasks WHERE task_id = '{root}'
    UNION ALL
    SELECT t.task_id, t.parent_task_id, t.name
    FROM eesel_ai_tasks t
    INNER JOIN task_tree tt ON t.parent_task_id = tt.task_id
)
SELECT
    tt.task_id,
    COALESCE(tt.parent_task_id::text, ''),
    COALESCE(tt.name, ''),
    COALESCE(SUM(tm.cost), 0),
    COALESCE(SUM(tm.input_tokens), 0),
    COALESCE(SUM(tm.output_tokens), 0),
    COALESCE(SUM(tm.cache_read_tokens), 0),
    COALESCE(SUM(tm.cache_write_tokens), 0),
    COUNT(tm.id)
FROM task_tree tt
LEFT JOIN eesel_ai_task_metrics tm ON tm.task_id = tt.task_id
GROUP BY tt.task_id, tt.parent_task_id, tt.name
ORDER BY tt.parent_task_id NULLS FIRST, tt.task_id;
""".strip()


def parse_cost_rows(raw: str) -> dict:
    """Parse the |-delimited psql output into a structured cost dict.

    Returns:
        {
            "total_cost": float,
            "total_runs": int,
            "totals": {input_tokens, output_tokens, cache_read_tokens, cache_write_tokens},
            "by_task": [{task_id, parent_task_id, name, cost, runs, ...}, ...],
        }
    """
    by_task: list[dict] = []
    total_cost = 0.0
    total_runs = 0
    totals = {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
    }
    for line in raw.splitlines():
        if not line.strip():
            continue
        parts = line.split("|")
        if len(parts) != 9:
            continue
        task_id, parent_id, name, cost, in_t, out_t, cr, cw, runs = parts
        row = {
            "task_id": task_id,
            "parent_task_id": parent_id or None,
            "name": name,
            "cost": float(cost or 0),
            "input_tokens": int(in_t or 0),
            "output_tokens": int(out_t or 0),
            "cache_read_tokens": int(cr or 0),
            "cache_write_tokens": int(cw or 0),
            "runs": int(runs or 0),
        }
        by_task.append(row)
        total_cost += row["cost"]
        total_runs += row["runs"]
        totals["input_tokens"] += row["input_tokens"]
        totals["output_tokens"] += row["output_tokens"]
        totals["cache_read_tokens"] += row["cache_read_tokens"]
        totals["cache_write_tokens"] += row["cache_write_tokens"]
    return {
        "total_cost": total_cost,
        "total_runs": total_runs,
        "totals": totals,
        "by_task": by_task,
    }


def fetch_session_cost(creds: dict, sess: dict) -> dict | None:
    """Pull cost + token usage for a session's whole task tree.

    Currently dev-only — reads directly from local Postgres. In prod the
    workspace JWT can't reach the metrics endpoint (it's Auth0-gated), so
    we return None and the caller prints a hint.
    """
    if creds.get("env") != "dev":
        return None
    root = sess.get("task_id")
    if not root:
        return None
    # Root must look UUID-ish — defends against any oddly stored task_ids
    # ending up interpolated into the SQL string.
    if not all(c in "0123456789abcdef-" for c in root.lower()):
        return None
    sql = _COST_SQL_TEMPLATE.format(root=root)
    try:
        raw = _run_psql(sql)
    except RuntimeError:
        return None
    return parse_cost_rows(raw)


def _fmt_tokens(n: int) -> str:
    """1234 → '1,234'; 1234567 → '1.23M'."""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _fmt_cost(c: float) -> str:
    if c < 0.01:
        return f"${c:.4f}"
    return f"${c:.4f}"


def format_cost_oneline(d: dict) -> str:
    if d["total_runs"] == 0:
        return "[no cost data yet — metrics arrive async]"
    return (
        f"[{_fmt_cost(d['total_cost'])} · "
        f"{_fmt_tokens(d['totals']['input_tokens'])} in / "
        f"{_fmt_tokens(d['totals']['output_tokens'])} out · "
        f"{d['total_runs']} call{'s' if d['total_runs'] != 1 else ''}" + (f" · {len(d['by_task'])} tasks" if len(d["by_task"]) > 1 else "") + "]"
    )


def format_cost_full(d: dict, sess: dict, label: str = "session") -> str:
    lines = []
    lines.append(f"{label} {sess['id']} ({sess.get('name', '?')})")
    lines.append(f"  task_id: {sess.get('task_id', '?')}")
    if d["total_runs"] == 0:
        lines.append("  no cost data — either nothing has run yet, or metrics")
        lines.append("  haven't been flushed (sandbox posts them async after")
        lines.append("  each LLM call finishes).")
        return "\n".join(lines)
    t = d["totals"]
    lines.append("")
    lines.append(f"  total: {_fmt_cost(d['total_cost'])}  ({d['total_runs']} LLM calls)")
    lines.append(f"    input          {_fmt_tokens(t['input_tokens']):>10}  tokens")
    lines.append(f"    output         {_fmt_tokens(t['output_tokens']):>10}  tokens")
    lines.append(f"    cache read     {_fmt_tokens(t['cache_read_tokens']):>10}  tokens")
    lines.append(f"    cache write    {_fmt_tokens(t['cache_write_tokens']):>10}  tokens")
    if len(d["by_task"]) > 1:
        lines.append("")
        lines.append(f"  by task ({len(d['by_task'])}):")
        for row in d["by_task"]:
            label = "root" if not row["parent_task_id"] else "sub"
            short = row["task_id"][:8]
            name = row["name"][:40] if row["name"] else "(unnamed)"
            lines.append(f"    [{label}] {short}  {_fmt_cost(row['cost'])}  {row['runs']} call{'s' if row['runs'] != 1 else ''}  {name}")
    return "\n".join(lines)


# ──────────────────────────────────────────────────────────────────────────
# HTTP helpers
# ──────────────────────────────────────────────────────────────────────────


# The creds the active command runs with, stashed by require_creds so the 401
# self-heal below can re-resolve and persist the workspace without threading
# creds through every http_request caller. None until a command authenticates.
_current_creds: dict | None = None


def _http_send(method: str, url: str, *, token: str | None, body: dict | None, timeout: int, headers: dict | None) -> dict:
    """One HTTP attempt. Returns the parsed JSON dict; lets HTTPError / URLError /
    timeout propagate so callers can decide whether to retry or exit."""
    assert_url_path_safe(url)
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json", **(headers or {})}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        if not raw:
            return {}
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            # A 2xx with a non-JSON body usually means a proxy/gateway or login
            # page answered instead of the API (e.g. an HTML error page served
            # with status 200). Surface a clean message rather than letting the
            # JSONDecodeError traceback escape.
            snippet = raw[:200].decode(errors="replace").strip()
            fail(
                EXIT_SERVER,
                f"{method} {url} → {resp.status} but the response was not JSON "
                f"({len(raw)} bytes; a proxy or login page?): {snippet}",
            )


def http_request(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60, headers: dict | None = None) -> dict:
    # Belt-and-braces: refuse a customer-changing request while impersonating.
    # Defined near main() alongside the pre-dispatch guard; a no-op unless a real
    # impersonation target is active.
    _impersonation_write_backstop(method, url)
    try:
        return _http_send(method, url, token=token, body=body, timeout=timeout, headers=headers)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            healed = _retry_with_current_workspace(method, url, token=token, body=body, timeout=timeout, headers=headers)
            if healed is not None:
                return healed
        body_text = e.read().decode(errors="replace")
        fail(code_for_status(e.code), f"{method} {url} → {e.code}: {body_text}")
    except (TimeoutError, socket.timeout):
        fail(EXIT_SERVER, f"{method} {url} timed out after {timeout}s (server slow or hung?).")
    except urllib.error.URLError as e:
        fail(EXIT_SERVER, f"{method} {url} failed (server reachable?): {e}")


def _deep_contains(obj, value: str) -> bool:
    """True if `value` (a workspace id) appears as a string anywhere in `obj`."""
    if isinstance(obj, str):
        return obj == value
    if isinstance(obj, dict):
        return any(_deep_contains(v, value) for v in obj.values())
    if isinstance(obj, list):
        return any(_deep_contains(v, value) for v in obj)
    return False


def _deep_replace(obj, old: str, new: str):
    """Return `obj` with every string equal to `old` replaced by `new`."""
    if isinstance(obj, str):
        return new if obj == old else obj
    if isinstance(obj, dict):
        return {k: _deep_replace(v, old, new) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_deep_replace(v, old, new) for v in obj]
    return obj


def _retry_with_current_workspace(method: str, url: str, *, token, body, timeout, headers) -> dict | None:
    """Self-heal a stale workspace pin on a 401, then retry once.

    A 401 on a request that carried the stored `workspace_id` usually means the
    pin is stale: a lapsed impersonation target, a workspace the login was
    removed from, or a value left on disk by an older CLI. Re-resolve the
    workspace the current identity actually acts in (`POST /workspaces/token`),
    persist the correction, substitute the id into the URL/body, and retry the
    request once. Gated on the id actually being in the request, so a genuinely
    unauthorized call fails fast instead of retrying blindly. Prod logins only;
    returns None (caller then reports the original 401) when it doesn't apply or
    the retry fails — never loops.
    """
    creds = _current_creds
    if not creds or not creds.get("refresh_token"):
        return None
    stale = creds.get("workspace_id")
    if not stale:
        return None
    # Match the workspace id only where it stands as a whole URL segment or query
    # value (after `/` or `=`, before `/`, `&`, `?`, or end) — never as a loose
    # substring of some other opaque id — and exact-match it in the body.
    ws_in_url = re.compile(r"(?<=[/=])" + re.escape(stale) + r"(?=[/&?]|$)")
    in_url = ws_in_url.search(url) is not None
    in_body = _deep_contains(body, stale)
    if not (in_url or in_body):
        return None
    fresh = resolve_effective_workspace_id(creds)
    if not fresh or fresh == stale:
        return None

    # Correct it in memory too, so a later http_request in this same command
    # reuses the fixed workspace (best-effort — a `--agent` path holds a dict
    # copy that won't see this). The retry below substitutes the id directly, so
    # it doesn't rely on this; the disk write below is what fixes later runs.
    creds["workspace_id"] = fresh
    # Persist only the workspace correction, re-reading disk so an in-memory
    # agent_id (never persisted, per require_creds) can't leak onto disk.
    disk = load_creds()
    if disk and not disk.get("ephemeral"):
        disk["workspace_id"] = fresh
        save_creds(disk)

    # The retry re-sends via _http_send, skipping the write-backstop. Safe: a
    # customer-changing request can't reach this point while impersonating — the
    # pre-dispatch guard and the backstop both exit before any request goes out —
    # so self-heal only ever retries a read (or an allowlisted POST-shaped read).
    try:
        return _http_send(
            method,
            ws_in_url.sub(fresh, url) if in_url else url,
            token=token,
            body=_deep_replace(body, stale, fresh) if in_body else body,
            timeout=timeout,
            headers=headers,
        )
    except Exception:
        return None


def http_request_allow_error(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60) -> tuple[int, dict]:
    """Like ``http_request`` but returns ``(status_code, parsed_json)`` instead
    of exiting on an HTTP error response.

    Used by flows that need to react to the server's error body rather than
    just abort — e.g. connecting an integration, where a 400 carries setup
    guidance (missing ``subdomain``, OAuth required) that the user must see.
    On a non-HTTP failure (server unreachable) it still exits, since there's no
    structured body to surface.
    """
    assert_url_path_safe(url)
    _impersonation_write_backstop(method, url)
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            if not raw:
                return resp.status, {}
            try:
                parsed = json.loads(raw)
            except json.JSONDecodeError:
                # A 2xx with a non-JSON body usually means a proxy/gateway or
                # login page answered instead of the API. Exit with a clean
                # message rather than letting the JSONDecodeError traceback
                # escape — mirrors http_request's handling of the same case.
                snippet = raw[:200].decode(errors="replace").strip()
                fail(
                    EXIT_SERVER,
                    f"{method} {url} → {resp.status} but the response was not JSON "
                    f"({len(raw)} bytes; a proxy or login page?): {snippet}",
                )
            return resp.status, (parsed if isinstance(parsed, dict) else {"result": parsed})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            parsed = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            parsed = {"error": raw.decode(errors="replace")}
        if not isinstance(parsed, dict):
            parsed = {"error": parsed}
        return e.code, parsed
    except (TimeoutError, socket.timeout):
        fail(EXIT_SERVER, f"{method} {url} timed out after {timeout}s (server slow or hung?).")
    except urllib.error.URLError as e:
        fail(EXIT_SERVER, f"{method} {url} failed (server reachable?): {e}")


def write_request(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60, allow_error: bool = False):
    """Send a state-changing request — the single choke point for every write.

    Every real mutation the CLI performs (the enumerated write set: agents
    create/update/delete, trigger/schedule add/remove/fire, integration
    connect/sync/remove, action enable/set/disable, mcp add/set/toggle/remove,
    file add/remove and knowledge-acl set, skill add/remove/set, and the
    workspace mutations) goes through here instead of calling `http_request`
    directly. Reads and read-backs — including the POST-shaped reads like
    `/workspace/tasks` — keep using `http_request`, so they always run even
    under `--dry-run` (dry-run still needs to resolve an agent id or fetch
    existing config to build a faithful body).

    Under `--dry-run`, prints the resolved `{method, url, body}` via `emit()`
    and exits 0 without contacting the server. A command that would issue more
    than one write stops at the first. Otherwise this is a thin pass-through:
    `allow_error=True` selects `http_request_allow_error` (returns
    `(status, body)`); the default returns the parsed JSON dict.
    """
    if _DRY_RUN:
        emit({"method": method, "url": url, "body": body})
        sys.exit(0)
    if allow_error:
        return http_request_allow_error(method, url, token=token, body=body, timeout=timeout)
    return http_request(method, url, token=token, body=body, timeout=timeout)


def http_fetch(url: str, *, token: str, timeout: int = 120) -> bytes:
    """GET a URL with the workspace Bearer token and return the raw bytes.

    Shared by the document download (write to file) and read (print to stdout)
    paths. Mirrors http_request's error handling — sys.exit with the server's
    body on failure.
    """
    assert_url_path_safe(url)
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        fail(code_for_status(e.code), f"GET {url} → {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        fail(EXIT_SERVER, f"GET {url} failed (server reachable?): {e}")


def http_download(url: str, *, token: str, output_path: Path) -> None:
    output_path.write_bytes(http_fetch(url, token=token))


def parse_config_object(raw: str, *, example: str = '{"key": "value"}') -> dict:
    """Parse a ``--config`` JSON string into a dict, or exit with code 2 and a
    uniform error message.

    The shared parser for plain ``--config`` JSON-object arguments (triggers
    add, schedules add, skills edit, mcp add): malformed input gives the same
    message and the same exit code, rather than each command inventing its own
    error contract. ``example`` tailors the "must be a JSON object" hint to the
    calling command.
    """
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError as e:
        err(f"--config is not valid JSON: {e}")
        sys.exit(2)
    if not isinstance(obj, dict):
        err(f"--config must be a JSON object (e.g. '{example}').")
        sys.exit(2)
    return obj


