def build_parser(staff: bool = False, platform_hint: str | None = None) -> argparse.ArgumentParser:
    """Build the CLI parser.

    `staff` is whether the current login is on the global impersonator
    allowlist (cached in creds; see `cache_impersonator_flag`). When False, the
    staff-only surfaces — dev login (`--dev`/`--workspace-id`) and the
    `impersonate` command — are hidden from `--help`. They remain parseable so
    nothing breaks for someone who knows them, but the server-side allowlist
    (and, for dev login, the local-only dev secret) is the real gate.

    `platform_hint` is the resolved platform for this run ("legacy"/"platform"/
    None). On "legacy" the commands with no read-only meaning there are hidden
    from `--help` (see `_hide_unsupported_legacy`) — they stay parseable so the
    pre-dispatch guard can still give its friendly message. Anything else (the
    new platform, or unknown) hides nothing.
    """
    p = argparse.ArgumentParser(
        prog="eesel",
        description=__doc__.strip().split("\n")[0],
        epilog="Tip: scope a command to one agent by path — `eesel agents <id> <noun> <verb>` "
               "(e.g. `eesel agents <id> integrations list`). See `eesel agents --help`.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    # Global machine-output/preview flags. These work anywhere on the command
    # line (before or after the subcommand) because `main()` lifts them out of
    # argv before parsing; they are declared here so `--help` and `eesel schema`
    # document them, and so the pre-subcommand position (`eesel --json …`) parses.
    p.add_argument("--json", action="store_true", help="Emit machine-readable JSON (also: EESEL_OUTPUT=json). Lists stream as NDJSON when piped.")
    p.add_argument("--fields", metavar="a,b,c", help="With --json: keep only these top-level keys on each object.")
    p.add_argument("--dry-run", action="store_true", help="Preview a side effect (config mutation, chat turn, or login): print the request that would be sent and make no call.")
    p.add_argument("--secrets", action="store_true", help="Reveal masked secret values (sysadmin/impersonator accounts only).")
    # Platform override: normally the CLI auto-detects legacy v2 vs the new
    # platform (see resolve_platform). These force it for one command — e.g.
    # when a just-migrated workspace's cached/flagged state lags. Mutually
    # exclusive (enforced in main after they're lifted from argv).
    p.add_argument("--legacy", action="store_true", help="Force legacy v2-platform mode for this command (overrides auto-detection).")
    p.add_argument("--platform", action="store_true", help="Force new-platform mode for this command (overrides auto-detection).")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("login", help="Authenticate (browser-based, or --dev for local)" if staff else "Authenticate")
    sp.add_argument("--dev", action="store_true", help="Mint local dev JWT, no browser" if staff else argparse.SUPPRESS)
    sp.add_argument("--workspace-id", help="Dev login only: workspace id to mint credentials for" if staff else argparse.SUPPRESS)
    sp.set_defaults(func=cmd_login)

    sp = sub.add_parser("logout", help="Clear stored credentials")
    sp.set_defaults(func=cmd_logout)

    sp = sub.add_parser("whoami", help="Show the current login")
    sp.set_defaults(func=cmd_whoami)

    sp = sub.add_parser(
        "link",
        help="Point this worktree at a branch (preprod) env — no login, no token on disk",
        description="Write a gitignored eesel.dev.json at the worktree root so every "
                    "eesel command here targets the given branch env. The token is minted "
                    "fresh per run from the env's /dev/session; nothing secret is stored. "
                    "Unlink by deleting eesel.dev.json.",
    )
    sp.add_argument("url", help="Branch env base URL, e.g. https://<slug>.preprod.eesel.xyz")
    sp.set_defaults(func=cmd_link)

    sp = sub.add_parser(
        "schema",
        help="Print the whole command surface as JSON (commands, flags, enums, endpoints)",
        description="Emit every command, flag, enum choice, and API endpoint as JSON, "
                    "walked live from the parser. Built for an AI agent to discover the "
                    "CLI without scraping --help. Combine with --fields to trim it.",
    )
