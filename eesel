def _get_impersonate_status(creds: dict) -> dict | None:
    """Best-effort impersonation status, normalized to ``{allowed, target_user_id}``.

    Reads `/sysadmin/impersonator-status` (the same endpoint the dashboard uses,
    now reachable with the CLI's Auth0 token). Never calls sys.exit — whoami
    display and the staff-command gate must not abort the CLI on a network
    hiccup.

    `allowed` is whether the caller may impersonate. `target_user_id` is the
    *active* target or None: the endpoint reports the effective user as
    `target_uid` even when idle, so a target counts as active only when an
    impersonator origin is present (i.e. a swap actually happened).
    """
    try:
        req = urllib.request.Request(
            f"{creds['api_url']}/sysadmin/impersonator-status",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {creds['token']}"},
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read() or b"{}")
    except Exception:
        return None
    allowed = bool(data.get("is_impersonator") or data.get("is_sysadmin"))
    target = data.get("target_uid") if data.get("impersonator_uid") else None
    return {"allowed": allowed, "target_user_id": target}


def cache_impersonator_flag(creds: dict) -> bool:
    """Refresh and persist `is_impersonator` on the stored creds, returning
    whether this login is on the global impersonator allowlist.

    The cached flag is what gates the staff-only commands (`impersonate`, dev
    login) in `build_parser`, so the gate costs no per-command network call. On
    a network/endpoint error the cached value is left untouched, so a blip
    doesn't transiently hide a staff member's commands.
    """
    status = _get_impersonate_status(creds)
    if status is None:
        return bool(creds.get("is_impersonator"))
    allowed = bool(status.get("allowed"))
    if creds.get("is_impersonator") != allowed:
        creds["is_impersonator"] = allowed
        save_creds(creds)
    return allowed


def cmd_login(args) -> int:
    creds = login_dev(args.workspace_id) if args.dev else login_prod()
    # Cache whether this login is a global impersonator so the staff-only
    # commands can be surfaced/hidden without a network call on every run.
    cache_impersonator_flag(creds)
    return 0


def cmd_logout(args) -> int:
    if CREDS_FILE.exists():
        CREDS_FILE.unlink()
        ok("Logged out.")
    else:
        info("Not logged in.")
    return 0


def cmd_whoami(args) -> int:
    creds = load_creds()
    if not creds:
        info("Not logged in.")
        return 0
    expires_in = int((creds.get("expires_at") or 0) - time.time())
    print(f"env          : {creds.get('env')}")
    print(f"api_url      : {creds.get('api_url')}")
    print(f"workspace_id : {creds.get('workspace_id')}")
    print(f"agent_id     : {creds.get('agent_id') or '(none — set EESEL_AGENT or pass --agent)'}")
    if creds.get("user_email"):
        print(f"user_email   : {creds['user_email']}")
    print(f"token expires: {expires_in}s ({expires_in // 3600}h {(expires_in % 3600) // 60}m)")

    # Surface active impersonation so sticky state isn't invisible, and refresh
    # the cached `is_impersonator` gate while we're here (so an existing staff
    # login un-hides its commands without needing to re-login). Best-effort: a
    # network error or older server just leaves the cached value as-is.
    status = _get_impersonate_status(creds)
    if status is not None:
        allowed = bool(status.get("allowed"))
        if creds.get("is_impersonator") != allowed:
            creds["is_impersonator"] = allowed
            save_creds(creds)
        if allowed:
            tgt = status.get("target_user_id")
            if tgt:
                print(f"impersonating: {tgt}")
                print("               (every command runs as this user; clear with `eesel impersonate clear`)")
            else:
                print("impersonator : yes (no target set)")

    return 0


def cmd_agents(args) -> int:
    creds = require_creds()
    sub = args.agents_cmd or "list"
    if sub == "list":
        agents = fetch_agents(creds)
        if getattr(args, "json", False):
            print(json.dumps(agents, indent=2))
            return 0
        if getattr(args, "plain", False):
            for a in agents:
                state = "on" if a.get("is_active") else "off"
                print(f"{str(a.get('agent_id') or '')}\t{state}\t{str(a.get('name') or '')}")
            return 0
        if not agents:
            info("(no agents)")
            return 0
        active = creds.get("agent_id")
        for a in agents:
            mark = "*" if a.get("agent_id") == active else " "
            # Status is a column, not a filter: every agent is listed, each with
            # its live/off state shown inline.
            status = "[on] " if a.get("is_active") else "[off]"
            print(
                f" {mark} {a.get('agent_id', '?')[:12]}  {status}  {a.get('name', '?')}"
                + (f"  [{a.get('agent_type')}]" if a.get("agent_type") else "")
            )
        return 0
    if sub == "use":
        warn("`agents use` is deprecated: it stores a hidden active agent on disk. "
             "Prefer explicit scope — `EESEL_AGENT=<id|name> eesel ...` or a `--agent` flag.")
        agents = fetch_agents(creds)
        if not agents:
            err("No agents in workspace. Create one in the dashboard first.")
            return 1
        active = creds.get("agent_id")
        target = args.agent_id
        if target:
            match = resolve_agent(agents, target)
            if not match:
                err(f"No agent matches '{target}'.")
                return 1
        else:
            # No id given → interactive arrow-key menu, starting on the active one.
            labels = [_agent_label(a, active) for a in agents]
            initial = next((i for i, a in enumerate(agents) if a.get("agent_id") == active), 0)
            choice = interactive_select(
                labels,
                title="Select an agent  (↑/↓ to move, Enter to confirm, q to cancel):",
                initial=initial,
            )
            if choice is None:
                info("Cancelled.")
                return 1
            match = agents[choice]
        creds["agent_id"] = match["agent_id"]
        save_creds(creds)
        ok(f"Active agent: {match.get('name')} ({match['agent_id']})")
        return 0
    if sub == "unset":
        warn("`agents unset` is deprecated alongside `agents use`. "
             "Prefer explicit scope — `EESEL_AGENT=<id|name> eesel ...` or a `--agent` flag.")
        if not creds.get("agent_id"):
            info("No active agent set.")
            return 0
        prev = creds.pop("agent_id", None)
        save_creds(creds)
        ok(f"Cleared active agent ({prev}). Commands that need one will prompt, or accept EESEL_AGENT / a --agent flag.")
        return 0
    if sub == "show":
        return _agents_get(args, creds)
    if sub == "instructions":
        # An agent's instructions are an attribute of the agent, so they're
        # reachable under the `agents` noun too. The top-level `eesel
        # instructions` is kept as a convenience alias for the same view.
        return cmd_instructions(args)
    if sub in ("create", "add"):
        # `add` is a hidden alias for `create` so the universal `add` verb
        # (used to bring in every other noun) also works for agents.
        return _agents_create(args, creds)
    if sub in ("set", "edit"):
        # `edit` is the prior name, kept as a hidden alias for `set`.
        return _agents_update(args, creds)
    if sub == "remove":
        return _agents_delete(args, creds)
    return 1


def _agents_create(args, creds: dict) -> int:
    if not args.name:
        err("--name is required.")
        return 1
    body = build_agent_create_body(creds["workspace_id"], args.name, args.instructions)
    data = http_request("POST", f"{creds['api_url']}/agents", token=creds["token"], body=body)
    agent_id = data.get("agent_id") or data.get("id") or (data.get("agent") or {}).get("agent_id")
    if agent_id:
        ok(f"Created agent '{args.name}' ({agent_id})")
    else:
        ok(f"Created agent '{args.name}'")
        info("(server returned no id; run `eesel agents list` to confirm)")
    return 0


def _agents_update(args, creds: dict) -> int:
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    body = build_agent_update_body(name=args.name, instructions=args.instructions)
    if not body:
        err("Nothing to change. Pass --name and/or --instructions.")
        return 1
    aid = agent["agent_id"]
    http_request("PUT", f"{creds['api_url']}/agents/{aid}", token=creds["token"], body=body)
    # Read the record back rather than trusting the 200: confirm every field the
    # user changed now holds the value we sent.
    updated = http_request("GET", f"{creds['api_url']}/agents/{aid}", token=creds["token"])
    mismatched = [k for k, v in body.items() if updated.get(k) != v]
    if mismatched:
        err(f"Server accepted the change but {', '.join(mismatched)} did not update as sent.")
        return 1
    ok(f"Edited {updated.get('name') or agent.get('name')} ({aid}): {', '.join(body.keys())}")
    return 0


def _agents_delete(args, creds: dict) -> int:
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    if not args.force and not confirm(f"Remove agent '{agent.get('name')}' ({agent['agent_id']})? [y/N] "):
        info("Aborted.")
        return 1
    http_request("DELETE", f"{creds['api_url']}/agents/{agent['agent_id']}", token=creds["token"])
    ok(f"Removed {agent.get('name')} ({agent['agent_id']}).")
    # If the deleted agent was the active one, drop the stored pointer so later
    # commands don't reference a dead id.
    if creds.get("agent_id") == agent["agent_id"]:
        creds.pop("agent_id", None)
        save_creds(creds)
        info("Cleared the active-agent pointer (it referenced the deleted agent).")
    return 0


def _agents_get(args, creds: dict) -> int:
    """Print one agent's full record: id, type, live/off status, description, and
    instructions. The agent listing already carries every field, so this resolves
    the target from that list rather than making a second call."""
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    if getattr(args, "json", False):
        print(json.dumps(agent, indent=2))
        return 0
    print(f"{agent.get('name', '?')}  ({agent.get('agent_id', '')})")
    if agent.get("agent_type"):
        print(f"  type:    {agent['agent_type']}")
    print(f"  status:  {'live' if agent.get('is_active') else 'off'}")
    if agent.get("description"):
        print(f"  summary: {agent['description']}")
    prompt = (agent.get("prompt") or "").strip()
    if not prompt:
        print("  instructions: (none)")
        return 0
    print("  instructions:")
    print()
    print(prompt)
    return 0


def cmd_instructions(args) -> int:
    """Print an agent's instructions (the system prompt that drives it).

    Defaults to the active agent; pass an id / id-prefix / name to inspect a
    different one. The instructions go to stdout (pipe/redirect-friendly) and
    the header to stderr, so `eesel instructions > prompt.md` captures just the
    prompt.
    """
    creds = require_creds()
    agents = fetch_agents(creds)
    if not agents:
        err("No agents in workspace. Create one in the dashboard first.")
        return 1

    target = getattr(args, "agent", None)
    if target:
        agent = resolve_agent(agents, target)
        if not agent:
            err(f"No agent matches '{target}'.")
            return 1
    else:
        agent = next((a for a in agents if a.get("agent_id") == creds.get("agent_id")), None)
        if not agent:
            err("No agent selected. Pass an agent id/name, set EESEL_AGENT, or use a --agent flag.")
            return 1

    info(f"# {agent.get('name', '?')} ({agent.get('agent_id', '')[:12]}) — instructions")
    prompt = (agent.get("prompt") or "").strip()
    if not prompt:
        info("(no instructions set for this agent)")
        return 0
    print(prompt)
    return 0


def cmd_new(args) -> int:
    creds = require_creds()
    pick_agent(creds, prompt=not args.agent)
    if args.agent:
        creds["agent_id"] = args.agent
        save_creds(creds)

    trigger_id = trigger_title = None
    if getattr(args, "schedule", None):
        match = resolve_scheduled_job(creds, args.schedule)
        if not match:
            err(f"No scheduled job matches '{args.schedule}'.")
            info("Run `eesel schedules list` to see available jobs.")
            return 1
        trigger_id = match["id"]
        trigger_title = (match.get("config") or {}).get("title")
        # Pin the agent on the session to whatever owns the trigger; mismatched
        # agent + trigger sends a chat to the wrong agent.
        creds["agent_id"] = match["agent_id"]
        save_creds(creds)

    sess = new_session(
        creds,
        agent_id=creds.get("agent_id"),
        name=args.name,
        switch_to=True,
        trigger_id=trigger_id,
        trigger_title=trigger_title,
    )
    suffix = f" [schedule: {trigger_title}]" if trigger_title else ""
    ok(f"New session: {sess['id']} ({sess['name']}){suffix}")

    # Auto-fire when bound to a scheduled job. The whole point of binding a
    # session to a scheduled job is to preview what it would output — making the
    # user type "go" as a separate `chat` step was friction and polluted the
    # persisted chat history with a "user said: go" turn. Now the session
    # immediately fires once with an empty user message (backend filters it
    # out of history), streams the agent's response, and leaves you in a
    # state where follow-up `eesel chat "<scenario tweak>"` calls iterate
    # on the preview.
    if trigger_id:
        info("Firing scheduled job...")
        send_message(creds, sess, "")
    return 0


def cmd_sessions(args) -> int:
    sub = args.sessions_cmd or "list"
    if sub == "list":
        sessions = list_sessions()
        if not sessions:
            info("(no sessions)")
            return 0
        cur = load_current()
        for s in sessions:
            mark = "*" if s["id"] == cur else " "
            ts = datetime.fromtimestamp(s.get("updated_at", 0)).strftime("%Y-%m-%d %H:%M")
            n_msgs = len(s.get("messages", []))
            print(f" {mark} {s['id']}  {ts}  {n_msgs:>3}msg  {s.get('name', '')}")
        return 0
    if sub == "use":
        sess = load_session(args.session_id)
        if not sess:
            # try prefix match
            all_s = list_sessions()
            match = next((s for s in all_s if s["id"].startswith(args.session_id)), None)
            if not match:
                err(f"No session matches '{args.session_id}'.")
                return 1
            sess = match
        set_current(sess["id"])
        ok(f"Active session: {sess['id']} ({sess.get('name')})")
        return 0
    if sub in ("remove", "delete"):
        # `remove` is canonical; `delete` is the prior name, kept as a hidden alias.
        if delete_session(args.session_id):
            ok(f"Removed {args.session_id}.")
        else:
            err(f"No session {args.session_id}.")
            return 1
        return 0
    if sub == "show":
        sess = load_session(args.session_id) if args.session_id else load_session(load_current() or "")
        if not sess:
            err("No such session.")
            return 1
        print(f"# {sess.get('name')} ({sess['id']})")
        print(f"# agent={sess.get('agent_id')} task={sess.get('task_id')}")
        for m in sess.get("messages", []):
            who = _color("you", "33") if m["sender"] == "user" else _color("eesel", "36")
            print(f"\n{who}:")
            print(m["message"])
        return 0
    return 1


def cmd_triggers(args) -> int:
    """`eesel triggers`: event/webhook triggers (the ones that fire themselves on
    an external event). Scheduled jobs live under `eesel schedules`."""
    # `eesel triggers --all` used to list every trigger across all agents. That
    # is now the default for `eesel triggers list`, and scheduled jobs moved to
    # `eesel schedules`. Fail closed with a pointer rather than silently doing
    # the wrong thing.
    if getattr(args, "all", False):
        err(
            "`triggers --all` was removed. `eesel triggers list` already lists "
            "every event/webhook trigger in the workspace; scheduled jobs live "
            "under `eesel schedules list`."
        )
        return 2

    creds = require_creds()
    sub = args.triggers_cmd or "list"

    if sub == "list":
        return _triggers_list_events(
            creds,
            as_json=getattr(args, "json", False),
            as_plain=getattr(args, "plain", False),
        )

    if sub == "show":
        return _triggers_show(creds, args.trigger_id, as_json=getattr(args, "json", False))

    if sub == "registry":
        return _triggers_registry(creds, as_json=getattr(args, "json", False))

    if sub == "add":
        return _triggers_add(creds, args)

    if sub == "remove":
        return _triggers_remove(creds, args)

    return 1


def _triggers_registry(creds: dict, *, as_json: bool = False) -> int:
    """`eesel triggers registry`: list the available event/webhook trigger types.

    Calls GET /triggers/registry and prints each trigger's key, integration and
    description. The `trigger_id` field in the registry is the value to pass as
    `--key` when adding a trigger with `eesel triggers add`. The scheduled-job
    type is filtered out — scheduled jobs are created with `eesel schedules add`.
    """
    data = http_request("GET", f"{creds['api_url']}/triggers/registry", token=creds["token"])
    triggers = data.get("triggers") if isinstance(data, dict) else data
    triggers = [t for t in (triggers or []) if t.get("trigger_id") != SCHEDULED_TRIGGER_KEY]
    if as_json:
        print(json.dumps(triggers, indent=2))
        return 0
    if not triggers:
        info("(no trigger types in the registry)")
        return 0

    info(f"# {len(triggers)} trigger type{'s' if len(triggers) != 1 else ''} — use the key with `eesel triggers add <agent> --key <key>`")
    fmt = " {:<34}  {:<14}  {}"
    info(fmt.format("key", "integration", "name"))
    for t in sorted(triggers, key=lambda r: (r.get("integration_key") or "", r.get("trigger_id") or "")):
        key = t.get("trigger_id") or "?"
        integration = t.get("integration_key") or "—"
        name = t.get("name") or t.get("description") or ""
        print(fmt.format(key[:34], integration[:14], name))
    return 0


def _triggers_add(creds: dict, args) -> int:
    """`eesel triggers add <agent> --key <key> [--config '<JSON>']`.

    POSTs to /agents/{agent_id}/triggers with {"trigger_key", "config"}. The
    server requires a non-null config, so an omitted --config is sent as an
    empty object. --config must be a JSON object.
    """
    agents = fetch_agents(creds)
    if not agents:
        err("No agents in workspace. Create one with `eesel agents create` first.")
        return 1
    agent = resolve_agent(agents, args.agent)
    if not agent:
        err(f"No agent matches '{args.agent}'.")
        info("Run `eesel agents list` to see available agents.")
        return 1

    config: dict = {}
    if getattr(args, "config", None):
        try:
            config = json.loads(args.config)
        except json.JSONDecodeError as e:
            err(f"--config is not valid JSON: {e}")
            return 1
        if not isinstance(config, dict):
            err("--config must be a JSON object (e.g. '{\"cron\": \"0 9 * * *\"}').")
            return 1

    url = f"{creds['api_url']}/agents/{agent['agent_id']}/triggers"
    resp = http_request("POST", url, token=creds["token"], body={"trigger_key": args.key, "config": config})

    trigger = resp.get("trigger") if isinstance(resp, dict) else None
    trigger_id = (trigger or {}).get("id") or (resp.get("id") if isinstance(resp, dict) else None)
    ok(f"Added trigger '{args.key}' to {agent.get('name', agent['agent_id'])} (id={trigger_id}).")
    info("Run `eesel triggers list` to confirm.")
    return 0


def match_event_triggers(rows: list[dict], trigger_id: str) -> list[dict]:
    """All event/webhook triggers matching `trigger_id`, in resolution-priority
    order: an exact id first, then id-prefix matches. The same trigger never
    appears twice, so callers can count the result to detect ambiguity. Triggers
    have no title, so the id is the only key (unlike scheduled jobs, which also
    match on config.title).

    A blank/whitespace `trigger_id` matches nothing: an empty string prefixes
    every id, so without this guard a destructive `remove` could resolve to the
    sole trigger on a single-trigger workspace with no real id given."""
    if not (trigger_id or "").strip():
        return []
    exact = [t for t in rows if t.get("id") == trigger_id]
    if exact:
        return exact
    return [t for t in rows if (t.get("id") or "").startswith(trigger_id)]


def _resolve_trigger(creds: dict, trigger_id: str) -> dict | None:
    """First event/webhook trigger matching `trigger_id` by exact id or id-prefix,
    or None. First-match — used by the read-only `show`. The `remove` path uses
    `resolve_event_trigger_strict`, which refuses an ambiguous prefix rather than
    deleting an arbitrary match. Resolving client-side means a bad or partial id
    is a clean 'no match' here rather than a 500 from `DELETE /triggers/{prefix}`
    (the server has no such row)."""
    matches = match_event_triggers(fetch_all_event_triggers(creds), trigger_id)
    return matches[0] if matches else None


def resolve_event_trigger_strict(creds: dict, trigger_id: str) -> dict | None:
    """Resolve `trigger_id` to exactly one event/webhook trigger for `remove`, or
    print why it could not (no match, or ambiguous with the candidates listed)
    and return None. An id-prefix can match several triggers, so deleting must
    not act on an arbitrary first match."""
    matches = match_event_triggers(fetch_all_event_triggers(creds), trigger_id)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        err(f"No event/webhook trigger matches '{trigger_id}'.")
        info("Run `eesel triggers list` to see triggers (the first column is the id).")
        return None
    err(f"'{trigger_id}' is ambiguous — it matches {len(matches)} triggers:")
    for t in matches:
        label = t.get("trigger_key") or t.get("id") or "?"
        err(f"  {t.get('id', '?')}  {label}")
    err("Re-run with a full trigger id to disambiguate.")
    return None


def _triggers_remove(creds: dict, args) -> int:
    """`eesel triggers remove <id> [--force]`: DELETE /triggers/{id}.

    The id is the trigger's own id (the first column of `eesel triggers list`),
    accepted as a full id or an unambiguous prefix. An ambiguous prefix is
    refused (candidates listed) rather than deleting an arbitrary match. Prompts
    for confirmation unless --force is passed.
    """
    match = resolve_event_trigger_strict(creds, args.trigger_id)
    if match is None:
        return 1
    trigger_id = match.get("id")
    label = match.get("trigger_key") or trigger_id
    if not getattr(args, "force", False):
        if not confirm(f"Remove trigger {trigger_id} ({label})? This cannot be undone. [y/N] "):
            info("Cancelled.")
            return 1

    http_request("DELETE", f"{creds['api_url']}/triggers/{trigger_id}", token=creds["token"])
    ok(f"Removed trigger {trigger_id}.")
    return 0


def _triggers_show(creds: dict, trigger_id: str, *, as_json: bool = False) -> int:
    """`eesel triggers show <id>`: full detail for one event/webhook trigger.

    There is no single-trigger endpoint, so the trigger is located within the
    workspace-wide list (GET /agents/{id}/triggers across agents) by exact id or
    id prefix. Secrets in the config are masked in the human view; --json emits
    the raw payload."""
    match = _resolve_trigger(creds, trigger_id)
    if match is None:
        err(f"No event/webhook trigger matches '{trigger_id}'.")
        info("Run `eesel triggers list` to see triggers (the first column is the id).")
        return 1

    if as_json:
        print(json.dumps(match, indent=2))
        return 0

    enabled = _trigger_enabled(match)
    print(f"{match.get('id')}  [{'on' if enabled else 'off'}]")
    print(f"  key:         {match.get('trigger_key') or '?'}")
    print(f"  type:        {match.get('type') or '?'}")
    print(f"  agent:       {match.get('agent_name') or match.get('agent_id') or '?'}")
    print(f"  integration: {match.get('integration_id') or '—'}")
    print(f"  last fired:  {_fmt_task_ts(match.get('last_executed_at'))}")
    cfg = match.get("config")
    if cfg:
        print("  config:")
        for line in json.dumps(_redact_secrets(cfg), indent=2).splitlines():
            print(f"    {line}")
    return 0


def _trigger_enabled(t: dict) -> bool:
    """Best-effort on/off state for a trigger row. The backend may carry the
    state under any of a few field names; a trigger with none of them present is
    treated as enabled (the default for a configured trigger)."""
    for field in ("enabled", "is_enabled", "is_active", "active"):
        if field in t and t[field] is not None:
            return bool(t[field])
    return True


def _triggers_list_events(creds: dict, *, as_json: bool = False, as_plain: bool = False) -> int:
    """`eesel triggers list`: every event/webhook trigger in the workspace,
    grouped by integration. Scheduled jobs are excluded — see `eesel schedules
    list`. Read-only."""
    rows = fetch_all_event_triggers(creds)
    if as_json:
        print(json.dumps(rows, indent=2))
        return 0
    if as_plain:
        for t in rows:
            state = "on" if _trigger_enabled(t) else "off"
            print(
                f"{str(t.get('id') or '')}\t{state}\t"
                f"{str(t.get('trigger_key') or '')}\t{str(t.get('agent_name') or '')}"
            )
        return 0
    if not rows:
        info("(no event/webhook triggers in this workspace)")
        info("Run `eesel schedules list` to see scheduled jobs.")
        return 0

    # Best-effort integration_id → type map for nicer group labels. Degrade to
    # integration_id-only if integrations aren't reachable (older server, etc.).
    id_to_type: dict = {}
    try:
        for it in fetch_integrations(creds):
            if it.get("id"):
                id_to_type[it["id"]] = it.get("integrationType")
    except (Exception, SystemExit):
        pass

    groups: dict = {}
    for t in rows:
        groups.setdefault(_trigger_integration_label(t, id_to_type), []).append(t)

    first = True

    def header(label: str) -> None:
        nonlocal first
        if not first:
            print()
        first = False
        print(_color(label, "1"))  # bold group header

    for label in sorted(groups):
        bucket = groups[label]
        header(f"{label} ({len(bucket)})")
        for t in bucket:
            tid = (t.get("id") or "?")[:12]
            tkey = t.get("trigger_key") or "?"
            ttype = t.get("type") or "?"
            status = "[on] " if _trigger_enabled(t) else "[off]"
            last = _fmt_task_ts(t.get("last_executed_at"))
            iid = (t.get("integration_id") or "")[:12] or "—"
            print(f"  {tid}  {status}  {tkey:<30}  {ttype:<8}  last={last:<16}  int={iid}  agent={t['agent_name']}")
            cfg = t.get("config")
            if cfg:
                blob = json.dumps(_redact_secrets(cfg))
                if len(blob) > 200:
                    blob = blob[:200] + "…"
                print(_color(f"      config: {blob}", "2;37"))
    return 0


