    sp = sub.add_parser("skills", help="List, show, add, remove, or configure an agent's skills")
    sk_sub = sp.add_subparsers(dest="skills_cmd")
    _AGENT_HELP = "Agent id, id-prefix, or name (defaults to $EESEL_AGENT)"
    sk_ls = sk_sub.add_parser("list", help="List every skill installed on an agent, with status")
    sk_ls.add_argument("agent", nargs="?", help=_AGENT_HELP)
    sk_ls.add_argument("--json", action="store_true", help="Emit the raw skills payload")
    sk_ls.add_argument("--plain", action="store_true", help="Emit one tab-separated `id<TAB>state<TAB>name` row per skill")
