# 30 days. The TTL the CLI self-mints its dev JWT with (--dev path). Also the
# long-lived TTL that /workspaces/token applies to the workspace token minted
# lazily for MCP (server/app/api/agents/agents.py).
CLI_TOKEN_TTL_SECONDS = 30 * 24 * 3600

# Prod logins store a short-lived Auth0 access token plus a refresh token.
# Renew the access token this many seconds before it expires so a command
# doesn't start with a token that dies mid-request.
TOKEN_REFRESH_SKEW_SECONDS = 120

# Conservative fallback when the dashboard bridge / refresh response omits the
# access token's TTL. Short on purpose: the refresh path renews it promptly.
PROD_TOKEN_TTL_FALLBACK_SECONDS = 3600


