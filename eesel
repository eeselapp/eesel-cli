def login_dev(workspace_id: str | None = None) -> dict:
    workspace_id, agent_id, user_id = discover_local_ids(workspace_id)
    token = mint_dev_jwt(workspace_id, None, user_id)
    creds = {
        "env": "dev",
        "api_url": ENVS["dev"]["api"],
        "dashboard_url": ENVS["dev"]["dashboard"],
        "workspace_id": workspace_id,
        "agent_id": agent_id,
        "user_id": user_id,
        "token": token,
        "expires_at": int(time.time()) + CLI_TOKEN_TTL_SECONDS,
    }
    save_creds(creds)
    ok(f"Logged in (dev) — workspace={workspace_id} agent={agent_id}" + (f" user={user_id}" if user_id else " (no owner user_id)"))
    return creds


def _find_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def login_prod() -> dict:
    """Browser bridge: open dashboard.eesel.ai/cli, capture token via local HTTP server."""
    state = secrets_mod.token_urlsafe(24)
    port = _find_free_port()
    dashboard = ENVS["prod"]["dashboard"]
    api_url = ENVS["prod"]["api"]

    captured: dict = {}
    done = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a, **kw):
            pass

        def _cors(self):
            origin = self.headers.get("Origin", "")
            allow = origin if origin in (dashboard, "http://localhost:3000") else dashboard
            self.send_header("Access-Control-Allow-Origin", allow)
            self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type")

        def do_OPTIONS(self):
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_POST(self):
            if self.path != "/auth":
                self.send_response(404)
                self._cors()
                self.end_headers()
                return
            length = int(self.headers.get("Content-Length", 0))
            try:
                payload = json.loads(self.rfile.read(length))
            except Exception:
                self.send_response(400)
                self._cors()
                self.end_headers()
                return
            if payload.get("state") != state:
                self.send_response(400)
                self._cors()
                self.end_headers()
                self.wfile.write(b'{"error":"state mismatch"}')
                return
            captured.update(payload)
            self.send_response(200)
            self._cors()
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
            done.set()

        def do_GET(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"eesel-cli local auth listener\n")

    server = http.server.HTTPServer(("127.0.0.1", port), Handler)
    th = threading.Thread(target=server.serve_forever, daemon=True)
    th.start()

    # We open /api/cli/init rather than /cli directly. The init route is
    # Auth0-gated, validates state + port, then sets `cli_state` as an
    # HttpOnly SameSite=Strict cookie scoped to /cli before 302-redirecting.
    # /cli reads the cookie server-side — state never lives in the URL,
    # so it can't end up in browser history, referrer headers, or be
    # injected by a malicious deep-link.
    url = f"{dashboard}/api/cli/init?{urllib.parse.urlencode({'port': port, 'state': state})}"
    info(f"Opening {url}")
    info("If the browser didn't open, paste that URL manually.")
    try:
        webbrowser.open(url)
    except Exception:
        pass

    if not done.wait(timeout=300):
        server.shutdown()
        sys.exit("Timed out waiting for browser auth (5 min).")
    server.shutdown()

    token = captured.get("token")
    workspace_id = captured.get("workspace_id") or captured.get("workspaceId")
    user_email = captured.get("user_email") or captured.get("email")
    if not token or not workspace_id:
        sys.exit(f"Auth response missing fields: {captured}")

    # `expires_in` is forwarded from the server's /workspaces/token response
    # by the dashboard bridge (CliAuthClient.tsx). It's the source of truth
    # for the JWT's `exp` claim. Fall back to the dev-path default only if
    # the bridge is older than the server change that added the field.
    expires_in = captured.get("expires_in")
    if not isinstance(expires_in, int) or expires_in <= 0:
        expires_in = CLI_TOKEN_TTL_SECONDS

    creds = {
        "env": "prod",
        "api_url": api_url,
        "dashboard_url": dashboard,
        "workspace_id": workspace_id,
        "user_email": user_email,
        "agent_id": None,  # picked on first chat / via `eesel agents use`
        "token": token,
        "expires_at": int(time.time()) + expires_in,
    }
    save_creds(creds)
    ok(f"Logged in — workspace={workspace_id}{f' as {user_email}' if user_email else ''}")
    return creds


# ──────────────────────────────────────────────────────────────────────────
# Agent helpers
# ──────────────────────────────────────────────────────────────────────────


def fetch_agents(creds: dict) -> list[dict]:
    """Return list of {agent_id, name, agent_type} for the workspace."""
    url = f"{creds['api_url']}/agents?{urllib.parse.urlencode({'workspace_id': creds['workspace_id']})}"
    data = http_request("GET", url, token=creds["token"])
    # Response shape varies; normalize.
    items = data if isinstance(data, list) else data.get("agents") or data.get("items") or []
    return items


def fetch_triggers(creds: dict, agent_id: str) -> list[dict]:
    """Return list of triggers for one agent."""
    url = f"{creds['api_url']}/agents/{agent_id}/triggers"
    data = http_request("GET", url, token=creds["token"])
    return data.get("triggers") or []


def fetch_all_scheduled_triggers(creds: dict) -> list[dict]:
    """Return scheduled triggers across every agent in the workspace.

    Each row is the raw trigger dict, augmented with `agent_id` and
    `agent_name` for display.
    """
    out = []
    for a in fetch_agents(creds):
        agent_id = a.get("agent_id")
        if not agent_id:
            continue
        try:
            for t in fetch_triggers(creds, agent_id):
                if t.get("trigger_key") != "eesel_scheduled":
                    continue
                t["agent_id"] = agent_id
                t["agent_name"] = a.get("name") or "?"
                out.append(t)
        except Exception as e:  # one agent's failure shouldn't kill the list
            warn(f"Couldn't list triggers for {a.get('name', agent_id)}: {e}")
    return out


def resolve_scheduled_trigger(creds: dict, target: str) -> dict | None:
    """Match `target` against scheduled triggers in the workspace.

    Resolution order: exact id, id prefix, then case-insensitive substring of
    config.title. Returns the augmented trigger dict, or None if nothing
    matches.
    """
    rows = fetch_all_scheduled_triggers(creds)
    match = next((t for t in rows if t.get("id") == target), None)
    if match:
        return match
    match = next((t for t in rows if (t.get("id") or "").startswith(target)), None)
    if match:
        return match
    needle = target.lower()
    return next(
        (t for t in rows if needle in ((t.get("config") or {}).get("title") or "").lower()),
        None,
    )


def pick_agent(creds: dict, *, prompt: bool = True) -> str:
    if creds.get("agent_id"):
        return creds["agent_id"]
    agents = fetch_agents(creds)
    if not agents:
        sys.exit("No agents in workspace. Create one in the dashboard first.")
    if len(agents) == 1 or not prompt:
        chosen = agents[0]
    else:
        print("Pick an agent:")
        for i, a in enumerate(agents):
            print(f"  [{i}] {a.get('name', '?')}  ({a.get('agent_id', '?')[:8]})")
        try:
            idx = int(input("> ").strip())
            chosen = agents[idx]
        except (ValueError, IndexError):
            sys.exit("Invalid choice.")
    creds["agent_id"] = chosen["agent_id"]
    save_creds(creds)
    return creds["agent_id"]


# ──────────────────────────────────────────────────────────────────────────
# Chat — POST /agents/sandbox/start + stream
# ──────────────────────────────────────────────────────────────────────────


def send_message(creds: dict, sess: dict, message: str) -> str:
    # Empty user messages are how trigger-preview sessions auto-fire (kicked off
    # by `eesel new --trigger X` with no user typing yet). The backend filters
    # empty messages out of the persisted chat history, so the task's history
    # doesn't get polluted with "(blank user turn)" markers. Skip the local
    # session append for the same reason — keeps `eesel sessions show` clean
    # and subsequent turns don't keep resending the empty entry.
    if message:
        sess["messages"].append({"sender": "user", "message": message})

    # Build the outgoing messages array. For auto-fire we send a one-shot
    # `[{"sender":"user","message":""}]` so backend validation passes (it
    # requires a non-empty array), but the message itself drops out of the
    # persisted history.
    outgoing_messages = sess["messages"] if sess["messages"] else [{"sender": "user", "message": ""}]
    body = {
        "messages": outgoing_messages,
        "agentId": sess["agent_id"],
        "taskId": sess["task_id"],
    }
    if sess.get("trigger_id"):
        body["triggerId"] = sess["trigger_id"]
    url = f"{creds['api_url']}/agents/sandbox/start"
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {creds['token']}",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            start_resp = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        err(f"sandbox/start → {e.code}: {body_text}")
        # Only roll back if we actually appended (i.e. non-empty user message).
        if message:
            sess["messages"].pop()
        save_session(sess)
        return ""

    task_id = start_resp.get("taskId", sess["task_id"])
    sess["task_id"] = task_id
    stream_url = start_resp.get("streamUrl")

    print(_color("eesel ", "36") + "→ ", end="", flush=True)
    text = stream_reply(creds, task_id, stream_url)
    print()  # newline after stream

    if text:
        sess["messages"].append({"sender": "assistant", "message": text})
    save_session(sess)
    return text


def stream_reply(creds: dict, task_id: str, stream_url: str | None) -> str:
    if stream_url:
        url = stream_url
        headers = {}
    else:
        url = f"{creds['api_url']}/agents/chat/{task_id}/raw-stream"
        headers = {"Authorization": f"Bearer {creds['token']}"}
    req = urllib.request.Request(url, headers=headers)

    text_buffers: dict[str, str] = {}
    text_order: list[str] = []

    try:
        with urllib.request.urlopen(req, timeout=900) as resp:
            for raw in resp:
                line = raw.decode(errors="replace").rstrip("\r\n")
                if not line.startswith("data:"):
                    continue
                data = line[5:].lstrip()
                if not data or data == "[DONE]":
                    continue
                try:
                    evt = json.loads(data)
                except json.JSONDecodeError:
                    continue
                etype = evt.get("type")
                if etype == "text-start":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                elif etype == "text-delta":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                    delta = evt.get("delta", "")
                    text_buffers[tid] += delta
                    sys.stdout.write(delta)
                    sys.stdout.flush()
                elif etype == "tool-input-available":
                    name = evt.get("toolName")
                    inp = json.dumps(evt.get("input"))[:200]
                    print(_color(f"\n[tool] {name} {inp}", "2;37"), flush=True)
                elif etype == "tool-output-available":
                    out = evt.get("output")
                    preview = (json.dumps(out) if not isinstance(out, str) else out)[:200]
                    print(_color(f"[tool] → {preview}", "2;37"), flush=True)
                elif etype == "error":
                    print(_color(f"\n[error] {evt.get('errorText') or evt}", "31"), file=sys.stderr, flush=True)
    except urllib.error.HTTPError as e:
        err(f"raw-stream → {e.code}: {e.read().decode(errors='replace')}")
        return ""

    return "".join(text_buffers[tid] for tid in text_order).strip()


