def _is_tty() -> bool:
    return sys.stdout.isatty()


def _color(s: str, code: str) -> str:
    if not _is_tty():
        return s
    return f"\033[{code}m{s}\033[0m"


def info(msg: str) -> None:
    print(_color(msg, "2;37"), file=sys.stderr)  # dim


def warn(msg: str) -> None:
    print(_color(f"! {msg}", "33"), file=sys.stderr)


def err(msg: str) -> None:
    print(_color(f"✗ {msg}", "31"), file=sys.stderr)


def ok(msg: str) -> None:
    print(_color(f"✓ {msg}", "32"), file=sys.stderr)


def confirm(prompt: str) -> bool:
    """Ask a yes/no question on stderr and return True only on an explicit yes.

    The prompt is written to stderr (not stdout) so that piping a command's
    output to a file — e.g. `eesel ... > out.txt` — never captures the prompt
    text. Anything other than "y" or "yes" (case-insensitive), including an
    empty line or EOF on a non-interactive stdin, counts as "no", so
    destructive operations default to not happening.
    """
    # Under --dry-run nothing is actually written, so don't gate the flow on an
    # interactive prompt — return True so it reaches write_request(), which
    # prints the request it *would* send and exits without contacting the server.
    if _DRY_RUN:
        return True
    print(_color(prompt, "33"), end="", file=sys.stderr, flush=True)
    try:
        answer = input().strip().lower()
    except EOFError:
        return False
    return answer in ("y", "yes")


def _stdin_has_piped_data() -> bool:
    """True when stdin is redirected from a pipe or file AND carries at least one
    byte to read — a real, non-empty source the CLI can read input from without a
    terminal (e.g. `echo 1 | eesel files read` or `eesel chat < message.txt`).

    False for an interactive TTY (handled by the arrow-key menu / REPL) and for a
    character device such as /dev/null or a closed descriptor.

    Critically also False for an *empty* pipe or file. A headless agent that
    supplies no input — `produces_nothing | eesel chat`, or `eesel chat <
    empty.txt` — leaves an empty FIFO/regular file. The descriptor type alone
    cannot tell that apart from a pipe carrying a real message, and treating it
    as "has input" would fall back into the REPL, hit EOF on the first read, and
    report exit 0 having sent nothing — the exact silent no-op this guard exists
    to refuse. So emptiness is settled by actually peeking a byte.

    The peek reads through the buffered binary layer (`sys.stdin.buffer.peek`),
    which fills the read buffer without advancing it: a following input() /
    readline() in the REPL or numbered picker still sees the whole stream. On a
    pipe the peek blocks until the first byte or EOF arrives — the same wait
    input() would incur.
    """
    if sys.stdin.isatty():
        return False
    try:
        mode = os.fstat(sys.stdin.fileno()).st_mode
    except (OSError, ValueError, AttributeError):
        # No real descriptor to inspect (e.g. a replaced stdin in tests, or a
        # platform without fstat) — treat it as "no piped input" so the honest
        # failure path stays the default.
        return False
    if not (stat.S_ISFIFO(mode) or stat.S_ISREG(mode)):
        return False
    # A FIFO or regular file with a real descriptor: peek one byte to tell an
    # empty source from one carrying input.
    buffer = getattr(sys.stdin, "buffer", None)
    peek = getattr(buffer, "peek", None)
    if peek is None:
        # No buffered binary layer to peek without consuming (an unusual stdin
        # replacement). Fall back to the descriptor type and assume the
        # redirected source has input.
        return True
    try:
        return len(peek(1)) > 0
    except (OSError, ValueError):
        return False


# ──────────────────────────────────────────────────────────────────────────
# Exit codes — a stable contract a headless agent branches on
# ──────────────────────────────────────────────────────────────────────────
#
# An agent driving the CLI unattended decides retry vs. re-authenticate vs.
# give-up from the exit code alone, without scraping the stderr prose. So a
# failure carries a code that names its class. These numbers are a committed
# contract — agents branch on them — and must not be renumbered.
#
#   0  success
#   1  generic / unexpected failure
#   2  argument-usage error (argparse emits this itself; left untouched)
#   3  auth        — 401 / 403; re-authenticate (e.g. `eesel login`)
#   4  not-found   — 404; the addressed thing does not exist
#   5  validation  — 400 / 422, or bad/missing local input; fix the call
#   6  rate-limit  — 429; back off and retry later
#   7  server      — 5xx, timeout, or unreachable; retry later
EXIT_OK = 0
EXIT_GENERIC = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_NOT_FOUND = 4
EXIT_VALIDATION = 5
EXIT_RATE_LIMIT = 6
EXIT_SERVER = 7


def code_for_status(status: int) -> int:
    """Map an HTTP failure status to the CLI's typed exit code.

    Only failure statuses (>= 400) are meaningful. A status without a dedicated
    class (e.g. 402, 409) falls through to EXIT_GENERIC, so the caller still
    exits non-zero without inventing a class the contract doesn't define.
    """
    if status in (401, 403):
        return EXIT_AUTH
    if status == 404:
        return EXIT_NOT_FOUND
    if status == 429:
        return EXIT_RATE_LIMIT
    if status in (400, 422):
        return EXIT_VALIDATION
    if status >= 500:
        return EXIT_SERVER
    return EXIT_GENERIC


def fail(code: int, msg: str) -> None:
    """Print `msg` to stderr and exit with a typed code.

    The single exit point for a classified failure, so the message and its code
    always travel together and the taxonomy can't drift between call-sites.
    """
    err(msg)
    sys.exit(code)


# ──────────────────────────────────────────────────────────────────────────
# Machine-output contract
# ──────────────────────────────────────────────────────────────────────────
#
# Every command that prints a machine-readable (JSON) payload routes through
# `emit()`, and every state-changing request routes through `write_request()`.
# That gives one place each for: the JSON format switch, the `--fields`
# projection, NDJSON-when-piped, secret redaction, and `--dry-run` preview —
# instead of ~34 hand-written `print(json.dumps(...))` sites that each had to
# remember to redact and had no way to stream or project.
#
# These module globals hold the resolved contract for the current invocation.
# `main()` sets them once (from the global `--json`/`--fields`/`--dry-run`
# flags and `EESEL_OUTPUT`) before dispatching. They default to the
# human/no-op values so that unit tests which call a handler directly — without
# going through `main()` — behave as they always did.
_OUTPUT_FORMAT = "human"   # "human" | "json"
_OUTPUT_FIELDS: list[str] | None = None   # --fields projection (top-level keys)
_DRY_RUN = False           # --dry-run: preview writes, make no call
_REVEAL_SECRETS = False    # --secrets on a sysadmin login: emit raw secret values


def _want_json(args=None) -> bool:
    """True when the caller asked for JSON output.

    Honours both the global contract (the top-level `--json` flag or
    `EESEL_OUTPUT=json`, resolved into `_OUTPUT_FORMAT` by `main()`) and a
    per-command `--json` set directly on `args` — the latter is how the unit
    tests drive handlers without running `main()`.
    """
    return _OUTPUT_FORMAT == "json" or bool(getattr(args, "json", False))


def _project_fields(payload, fields: list[str]):
    """Keep only `fields` (top-level keys) on each object in the payload.

    Applies element-wise to a list. An unknown field name is silently omitted
    rather than raising, so an agent can request a superset of keys safely.
    Non-object payloads (scalars, lists of scalars) pass through untouched.
    """
    if isinstance(payload, list):
        return [_project_fields(item, fields) for item in payload]
    if isinstance(payload, dict):
        return {k: payload[k] for k in fields if k in payload}
    return payload


def emit(payload, *, fields: list[str] | None = None, reveal: bool | None = None) -> None:
    """Print a payload as JSON — the single machine-output choke point.

    - Redacts secret-looking values by default. `reveal` left as None defers to
      the global `--secrets`+sysadmin gate (`_REVEAL_SECRETS`), which is how the
      gate reaches previously-raw emitters. A command that computes its own gate
      (integrations/actions, whose unit tests drive them without `main()`) passes
      an explicit True/False, which wins over the global.
    - Applies `--fields` (the argument here, else the global `_OUTPUT_FIELDS`).
    - When JSON output is active (`_OUTPUT_FORMAT == "json"`), the payload is a
      list, and stdout is piped, streams as NDJSON — one object per line — so an
      agent parses a long list line-by-line instead of buffering one giant
      array. On a TTY, or for a non-list payload, prints one pretty block.
    """
    if reveal is None:
        reveal = _REVEAL_SECRETS
    # Redact before projecting. `_redact_secrets` masks a property entry's
    # `value` based on its sibling `key`, so projecting first (which can drop
    # `key`) would strip the signal redaction relies on and leak the value.
    # Redaction must see the whole object.
    if not reveal:
        payload = _redact_secrets(payload)
    projection = fields if fields is not None else _OUTPUT_FIELDS
    if projection is not None:
        payload = _project_fields(payload, projection)
    if _OUTPUT_FORMAT == "json" and isinstance(payload, list) and not _is_tty():
        for item in payload:
            print(json.dumps(item))
    else:
        print(json.dumps(payload, indent=2))


# ──────────────────────────────────────────────────────────────────────────
# Interactive selection (arrow-key menu)
# ──────────────────────────────────────────────────────────────────────────


def _read_key(fd: int) -> str:
    """Read one keypress from the raw fd (already in cbreak mode) and normalize.

    Returns one of: 'up', 'down', 'left', 'right', 'enter', 'esc', 'ctrl-c',
    or the raw single character for anything else.

    Reads bytes straight off the fd with os.read (not sys.stdin.read): a
    TextIOWrapper would buffer ahead, and select() — which only sees the OS-level
    fd — would then disagree with what's actually been consumed.
    """
    import select

    ch = os.read(fd, 1)
    if ch == b"\x03":
        return "ctrl-c"
    if ch in (b"\r", b"\n"):
        return "enter"
    if ch == b"\x1b":
        # Distinguish a lone Esc from an arrow-key escape sequence. Arrow keys
        # arrive as a complete "\x1b[A" burst, so if nothing is queued right
        # after the Esc it was a bare Esc keypress.
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r or os.read(fd, 1) != b"[":
            return "esc"
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r:
            return "esc"
        return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(os.read(fd, 1), "other")
    try:
        return ch.decode()
    except UnicodeDecodeError:
        return "other"


def _numbered_select(options: list[str], *, title: str | None = None) -> int | None:
    """Fallback picker for non-interactive terminals: print a numbered list and
    read an index. Returns the chosen index, or None if cancelled/invalid."""
    if title:
        print(title, file=sys.stderr)
    for i, opt in enumerate(options):
        print(f"  [{i}] {opt}", file=sys.stderr)
    try:
        raw = input("> ").strip()
    except (EOFError, KeyboardInterrupt):
        return None
    try:
        idx = int(raw)
    except ValueError:
        return None
    return idx if 0 <= idx < len(options) else None


def interactive_select(options: list[str], *, title: str | None = None, initial: int = 0) -> int | None:
    """Show an arrow-key navigable menu and return the chosen index.

    ↑/↓ (or k/j) move, Enter confirms, q/Esc/Ctrl-C cancel (returns None). Falls
    back to a numbered text prompt when stdin/stderr isn't an interactive TTY or
    raw-mode control is unavailable (e.g. Windows). The menu renders to stderr
    so command stdout stays clean.
    """
    if not options:
        return None
    try:
        import termios
        import tty
    except ImportError:
        return _numbered_select(options, title=title)
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        return _numbered_select(options, title=title)

    out = sys.stderr
    idx = max(0, min(initial, len(options) - 1))

    def render(first: bool) -> None:
        if not first:
            out.write(f"\033[{len(options)}A")  # back to the top of the list
        for i, opt in enumerate(options):
            marker = "❯" if i == idx else " "
            line = f"{marker} {opt}"
            if i == idx:
                line = f"\033[36m{line}\033[0m"  # cyan highlight
            out.write(f"\r\033[K{line}\n")
        out.flush()

    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
    except termios.error:
        # isatty() lied (e.g. a pipe masquerading as a tty) — degrade gracefully.
        return _numbered_select(options, title=title)

    if title:
        out.write(title + "\n")
    out.write("\033[?25l")  # hide cursor
    out.flush()
    chosen: int | None = idx
    try:
        tty.setcbreak(fd)
        render(first=True)
        while True:
            key = _read_key(fd)
            if key in ("ctrl-c", "esc", "q"):
                chosen = None
                break
            if key in ("up", "k"):
                idx = (idx - 1) % len(options)
                render(first=False)
            elif key in ("down", "j"):
                idx = (idx + 1) % len(options)
                render(first=False)
            elif key == "enter":
                chosen = idx
                break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\033[?25h")  # restore cursor
        out.flush()
    return chosen


# ──────────────────────────────────────────────────────────────────────────
# Input validation
#
# An id/key that becomes an API URL path segment must never carry a traversal
# like `../`, an ASCII control character, or a URL metacharacter (`?` `#` `%`)
# that could smuggle a query string onto an unrelated endpoint. Two layers
# enforce this:
#
#   1. `assert_url_path_safe` (the choke point) runs inside the HTTP helpers on
#      the fully-assembled URL, so any id reaching a path segment is checked
#      centrally — even if a command forgets to validate it. This is what makes
#      traversal protection fail CLOSED. It inspects only the path, never the
#      query string (which legitimately carries metacharacters).
#   2. `validate_id` / `validate_key` reject a malformed *resolved* id/key close
#      to the call site, as defense in depth and for a clearer message.
#
#   validate_id   Opaque ids (agent_id, task_id, integration_id, session id, …).
#                 No `/` at all, and none of the shared rejects below.
#   validate_key  Path-like keys (e.g. `files/report.md`). Interior `/` is
#                 allowed, but a leading `/`, any `..` path segment, and the
#                 shared rejects are not.
#
# These validators run on the value that actually becomes a URL segment — the
# *resolved* id, not a raw human name. A target can legitimately be an agent
# name, job title, or filename containing `/ ? # % ..`; those are resolved to a
# slash-free id client-side, and only that resolved id is validated. Validating
# the raw name would break the documented id-or-name lookups for such targets.
# ──────────────────────────────────────────────────────────────────────────

# `?` `#` `%` delimit a URL's query and fragment and introduce percent-encoding;
# an id carrying one could smuggle a query string onto an unrelated endpoint.
_URL_METACHARS = "?#%"


def _control_or_meta_reason(value: str) -> str | None:
    """The reason `value` is unfit for a URL path segment (a control char or a
    URL metacharacter), or None if it carries neither. Shared by both validators."""
    for ch in value:
        code = ord(ch)
        if code < 0x20 or code == 0x7F:
            return "contains an ASCII control character"
        if ch in _URL_METACHARS:
            return f"contains a URL metacharacter '{ch}'"
    return None


def _reject_input(value: str, label: str, reason: str) -> None:
    err(f"Invalid {label} {value!r}: {reason}.")
    sys.exit(EXIT_VALIDATION)


def validate_id(value: str, label: str = "id") -> str:
    """Validate an opaque identifier bound for a URL path segment and return it
    unchanged, or exit EXIT_VALIDATION naming what was wrong.

    Rejects `/` (which would traverse into other path segments), `..`, ASCII
    control characters, and the URL metacharacters `? # %`. An empty or None
    value passes through untouched — "no id given" is handled downstream, not
    here."""
    if not isinstance(value, str) or not value:
        return value
    reason = _control_or_meta_reason(value)
    if reason is None and "/" in value:
        reason = "contains '/'"
    if reason is None and ".." in value:
        reason = "contains '..'"
    if reason is not None:
        _reject_input(value, label, reason)
    return value


def validate_key(value: str, label: str = "key") -> str:
    """Validate a path-like key bound for a URL path (e.g. `files/report.md`) and
    return it unchanged, or exit EXIT_VALIDATION naming what was wrong.

    Interior `/` is allowed — document keys legitimately contain it — but a
    leading `/`, any `..` path segment, ASCII control characters, and the URL
    metacharacters `? # %` are rejected. An empty or None value passes through."""
    if not isinstance(value, str) or not value:
        return value
    reason = _control_or_meta_reason(value)
    if reason is None and value.startswith("/"):
        reason = "has a leading '/'"
    if reason is None and ".." in value.split("/"):
        reason = "contains a '..' path segment"
    if reason is not None:
        _reject_input(value, label, reason)
    return value


def assert_url_path_safe(url: str) -> None:
    """Fail-closed guard against path traversal in a fully-assembled request URL.

    This runs inside the HTTP helpers, on the URL right before it is sent, so any
    id that reaches a URL path segment is checked here regardless of whether the
    caller remembered a per-argument `validate_id`/`validate_key`. It is the
    single choke point that makes traversal protection fail closed: a new command
    that forgets to validate its id still can't send a request whose path escapes
    the intended endpoint.

    Only the PATH is inspected. Query-string and fragment values legitimately
    carry URL metacharacters (`%`, `#`, an inner `?`) — e.g. a title or filename
    passed as a query parameter — so they are left untouched. A path segment that
    decodes to `.` or `..` (a traversal, including a percent-encoded `%2e%2e` or
    a `%2f`-smuggled separator) or that contains an ASCII control character aborts
    with EXIT_VALIDATION. Segments are unquoted before the check so an encoded
    traversal can't slip past the raw comparison; a legitimately percent-encoded
    id (e.g. a display name run through `urllib.parse.quote`) decodes to an
    ordinary string and passes."""
    path = urllib.parse.urlsplit(url).path
    for raw_segment in path.split("/"):
        decoded = urllib.parse.unquote(raw_segment)
        # An encoded separator (%2f) can hide a `..` inside a single raw segment,
        # so split the decoded segment again before comparing.
        for part in decoded.split("/"):
            if part in (".", ".."):
                _reject_input(url, "URL path", f"contains a '{part}' traversal segment")
        for ch in decoded:
            code = ord(ch)
            if code < 0x20 or code == 0x7F:
                _reject_input(url, "URL path", "contains an ASCII control character")


# ──────────────────────────────────────────────────────────────────────────
# Atomic file writes
#
# Session, pointer, and credentials writes must survive a crash and concurrent
# writers. A plain write_text can leave a truncated file if the process dies
# mid-write; a later read then fails to parse it and the whole session (its
# accumulated history) is silently lost. This helper writes to a uniquely-named
# temp file in the same directory and os.replace()s it into place. os.replace is
# atomic on POSIX, so a reader — or a crash, or another writer — only ever sees a
# complete file: the old one or the fully-written new one, never a half-written
# one. The unique temp name means two writers never collide, so no lock is needed
# for the file to stay intact. Two writers to the same path still resolve as a
# benign last-writer-wins on the (recoverable) pointer, which is acceptable — the
# guarantee that matters is that no conversation is ever dropped to a torn file.
# ──────────────────────────────────────────────────────────────────────────


def _atomic_write(path: Path, text: str, *, mode: int | None = None) -> None:
    """Write `text` to `path` atomically.

    The temp file is created in the target's own directory so os.replace is a
    same-filesystem rename (atomic); its name carries a pid + random suffix so
    two concurrent writers never collide. When `mode` is given, the temp file is
    *created* with those permissions via os.open(O_CREAT|O_EXCL, mode) — the
    bytes are never written to a file other local users could read, even for the
    instant between create and chmod. This matters for the 0o600 credentials
    file, whose token would otherwise exist group/world-readable at the default
    umask (~0o644) until a later chmod tightened it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.parent / f".{path.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}.tmp"
    try:
        if mode is not None:
            # O_EXCL guarantees we create (never open an existing) file, and the
            # mode argument sets the permission bits at creation time (subject to
            # umask), so the file is 0o600 before any bytes land in it.
            fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_EXCL, mode)
            try:
                os.write(fd, text.encode())
            finally:
                os.close(fd)
            # The create mode is masked by the process umask; chmod pins the
            # exact bits in case a permissive umask (e.g. 0) left them looser.
            try:
                os.chmod(tmp, mode)
            except OSError:
                pass
        else:
            tmp.write_text(text)
        os.replace(tmp, path)
    except OSError:
        # A failed write/replace must leave the existing file untouched and not
        # strand the temp file. Clean it up and re-raise so the caller sees the
        # real error rather than a silent partial write.
        tmp.unlink(missing_ok=True)
        raise


