_ACTIONS_SUBCOMMANDS = ("list", "show", "enable", "disable", "set")


# ── Path-as-scope namespace (the "everything is files" command model) ─────────
# The agreed CLI namespace scopes a command by its position in a resource tree —
# `eesel agents <id> integrations list` instead of `eesel integrations list
# --agent <id>`. Rather than re-implement dispatch, the path grammar is
# *normalized* into the flat command forms the cmd_* handlers already implement
# (mirrors _normalize_integrations_argv, generalized to the agent scope). The
# flat forms stay valid as hidden aliases, so nothing that scripts the old
# spelling breaks. The table below says, per agent-scoped child noun, how the
# flat form receives the agent; the function walks the path and reshapes. (This
# is the lightweight form of the namespace plan's resolver — a reshape over the
# existing handlers, not a separate dispatch engine.)

# The flat verbs the `agents` command already owns. When the token after
# `agents` is one of these, the invocation is already in flat form — leave it.
_AGENTS_FLAT_VERBS = frozenset(
    {"list", "show", "create", "set", "remove"}
)

_REMOVED_AGENTS_VERBS = {
    "use": "`eesel agents use` is gone — there is no saved active agent. Scope each "
           "command instead: `--agent <id>`, `EESEL_AGENT=<id>`, or the "
           "`eesel agents <id> …` path.",
    "unset": "`eesel agents unset` is gone — there is no saved active agent to clear. "
             "Scope each command with `--agent`, `EESEL_AGENT`, or the "
             "`eesel agents <id> …` path.",
}

# Agent-scoped child nouns → (how the flat form takes the agent, which verbs accept it).
#   mode "flag" → append `--agent <id>`         (e.g. `integrations list --agent X`)
#   mode "pos"  → agent is the first positional  (e.g. `skills list X`, verb then id)
#   verbs: the set of verbs whose flat parser actually accepts the agent. `None`
#     means every verb does, so any following token is reshaped — required for
#     `integrations`, where the token after the noun is often an integration
#     *type* (`zd`), not a verb. A finite set means ONLY those verbs are reshaped;
#     any other verb is reported as an invalid verb for that noun (naming the
#     verb), rather than mis-injecting `--agent` or blaming the agent id. (Keep
#     each set in sync with the flat parsers; TestPathScopeParsesEndToEnd guards it.)
# `triggers`/`schedules` are deliberately absent: they now live under the
# `automations` parent, and their `list` is workspace-wide (no agent argument),
# so there is no per-agent path form for them yet. `notifications` and the
# hidden `tools` alias are likewise out of scope here.
_AGENT_SCOPED_CHILDREN = {
    "integrations": ("flag", None),
    "files": ("flag", frozenset({"list", "show", "read", "add", "remove", "export"})),
    "tasks": ("flag", frozenset({"list", "count", "analytics", "export"})),
    "skills": ("pos", None),
}

# Heads valid directly after `agents <id>`: the agent's own verbs plus the
# agent-scoped child nouns. Used to give a targeted error (with a "did you mean")
# when the token after the agent is neither — instead of the flat parser blaming
# the agent id.
_AGENT_SCOPE_HEADS = ("show", "set", "add", "remove", "chat", *_AGENT_SCOPED_CHILDREN)


def _agent_scope_error(agent: str, bad: str, *, kind: str, valid) -> None:
    """Report a bad token after `agents <id>` against the token itself, then exit.

    Without this the bad token reaches the flat `agents` parser, which reports
    `invalid choice: '<agent-id>'` — pointing at the agent id rather than the word
    the user actually got wrong. `kind="command"` means `bad` sat where a noun or
    verb belongs (right after the agent); otherwise `kind` is the noun whose verb
    `bad` was. `valid` is the acceptable tokens, used for the list and a difflib
    "did you mean".
    """
    valid = list(valid)
    near = difflib.get_close_matches(bad, valid, n=1)
    hint = f" Did you mean `{near[0]}`?" if near else ""
    if kind == "command":
        err(f"`{bad}` is not an agent command. After `eesel agents {agent}` use one of: "
            f"{', '.join(valid)}.{hint}")
        if bad in ("triggers", "schedules"):
            info(f"`{bad}` isn't an agent-scoped path yet — use "
                 f"`eesel automations {bad}` for now.")
        elif bad == "notifications":
            info("`notifications` isn't an agent-scoped path yet — use "
                 "`eesel settings notifications` for now.")
    else:
        err(f"`{bad}` is not an agent-scoped `{kind}` verb. Try: {', '.join(valid)}.{hint}")
    sys.exit(2)


def _normalize_path_scope_argv(argv: list[str]) -> list[str]:
    """Reshape `agents <id> <noun> <verb> …` (path-as-scope) into the flat argv
    the argparse handlers expect. Returns argv unchanged when it isn't a
    path-scoped `agents <id> …` invocation (so the flat `agents` parser and every
    other command are untouched).

    The grammar is `agents <id> <tail>`; `<tail>` is dispatched by its head:
    - empty                       → `agents show <id>`            (cat the agent)
    - `set <field> <value> …`     → `agents set <id> --<field> <value> …`
    - `show …`                    → `agents show <id> …`          (carries flags)
    - `add|remove <pool>`         → `integrations add|remove <pool> --agent <id>` (grant/revoke)
    - `<child-noun> [<verb>] …`   → the child's flat form, scoped to <id>
                                    (verb defaults to `list`, uniform across nouns)
    - `chat …`                    → `chat … --agent <id>`
    - anything else               → a targeted error naming the bad token
    """
    if not argv or argv[0] != "agents":
        return argv
    rest = argv[1:]
    # `agents`, `agents --json`, `agents -h` → flat agent listing. And if the
    # first token is a flat verb, it's already the flat form.
    if not rest or rest[0].startswith("-") or rest[0] in _AGENTS_FLAT_VERBS:
        return argv

    # These were old stateful verbs, so keep them reserved for a useful removal
    # message instead of treating them as agent names in the path grammar.
    if rest[0] in _REMOVED_AGENTS_VERBS:
        err(_REMOVED_AGENTS_VERBS[rest[0]])
        sys.exit(2)

    agent = rest[0]            # the path scope: an agent id, id-prefix, or name
    if not agent.strip():
        # An empty agent token (e.g. `eesel agents "$AGENT" remove zendesk` with
        # `$AGENT` unset) is never a valid scope. Reshaping it would inject an
        # empty `--agent`, which downstream reads as "no agent given" — and for
        # `remove` that silently becomes a workspace-wide uninstall instead of a
        # per-agent revoke. Fail loudly before any routing happens.
        err("Empty agent in the command path. Pass an agent id, id-prefix, or name "
            "after `agents` (e.g. `eesel agents <id> ...`), or omit it.")
        sys.exit(2)
    tail = rest[1:]
    if not tail:
        return ["agents", "show", agent]          # `agents <id>` → show the agent
    head = tail[0]

    if head == "set":
        # `agents <id> set name "QA" instructions "…"` → flat flag form. Field
        # tokens become `--field`; the following token is its value. Pre-formed
        # flags (`--json`) pass through untouched. An unknown field becomes an
        # unrecognized `--flag`, so argparse still rejects it (just as a bad flag
        # rather than a "did you mean" on the field name).
        out = ["agents", "set", agent]
        i, fields = 0, tail[1:]
        while i < len(fields):
            tok = fields[i]
            if tok.startswith("-"):
                out.append(tok)
                i += 1
                continue
            out.append("--" + tok)
            if i + 1 < len(fields):
                out.append(fields[i + 1])
            i += 2
        return out

    if head == "show":
        return ["agents", "show", agent] + tail[1:]

    # Grant / revoke a shared integration at the agent scope (`agents X add zd`).
    # Reuses the flat integrations verbs with the agent supplied by the path
    # instead of a flag: the grant `add` maps to the canonical `connect`, and
    # `remove` stays `remove`.
    if head in ("add", "remove"):
        flat_verb = "connect" if head == "add" else "remove"
        if len(tail) >= 2 and not tail[1].startswith("-"):
            return ["integrations", flat_verb, tail[1]] + tail[2:] + ["--agent", agent]
        err(f"`agents {agent} {head}` needs an integration to {head} — "
            f"e.g. `eesel agents {agent} {head} zendesk`.")
        sys.exit(2)

    if head in _AGENT_SCOPED_CHILDREN:
        mode, verbs = _AGENT_SCOPED_CHILDREN[head]
        child = tail[1:]                          # the child's own `verb [args]`
        # Default the verb to `list` when none is given, so a bare
        # `agents <id> <noun>` lists — the same on every scoped noun.
        if not child or child[0].startswith("-"):
            child = ["list"] + child
        if verbs is not None and child[0] not in verbs:
            # A verb the flat parser can't scope by agent (e.g. `files acl`,
            # `tasks show`). Name the verb, instead of letting the flat `agents`
            # parser report `invalid choice: '<agent-id>'` and blame the id.
            _agent_scope_error(agent, child[0], kind=head, valid=sorted(verbs))
        if mode == "flag":
            return [head] + child + ["--agent", agent]
        # "pos": flat form is `<noun> <verb> <id> [args]`.
        return [head, child[0], agent] + child[1:]

    if head == "chat":
        return ["chat"] + tail[1:] + ["--agent", agent]

    # `agents <id> <something-else>`: not an agent verb or scoped noun. A flag
    # (`--json`) is left for argparse; a word — a typo, or a not-yet-scoped noun
    # like `triggers` — gets a targeted error that names it.
    if not head.startswith("-"):
        _agent_scope_error(agent, head, kind="command", valid=_AGENT_SCOPE_HEADS)
    return argv


def _normalize_integrations_argv(argv: list[str]) -> list[str]:
    """Reshape `integrations <integration> actions ...` into the argparse layout.

    The user-facing path puts the integration before the `actions` keyword:
    `eesel integrations zendesk actions enable reply`. argparse, however, sees
    `actions` as the subcommand whose first positional is the integration, so it
    wants `integrations actions zendesk enable reply`. This swaps the integration
    and the `actions` keyword, and inserts an explicit `list` verb when none
    follows (so `integrations zendesk actions` lists). Bare `eesel integrations`
    (the integration listing) and `--help` are left untouched.
    """
    try:
        i = argv.index("integrations")
    except ValueError:
        return argv
    rest = argv[i + 1:]
    if not rest or rest[0] in ("-h", "--help"):
        return argv
    # First positional after `integrations` is the integration name; `actions`
    # must follow it for this to be the actions sub-namespace.
    if rest[0].startswith("-"):
        return argv  # flags only → integration listing
    integration = rest[0]
    after = rest[1:]
    if not after or after[0] != "actions":
        return argv  # not the actions path → leave for the integrations parser
    # after == ["actions", <maybe verb>, <maybe action / flags>...]
    tail = after[1:]
    if tail and tail[0] in ("-h", "--help"):
        # `integrations zendesk actions --help` → show the actions help.
        return argv[: i + 1] + ["actions", integration] + tail
    # Find the first positional (the actions verb), skipping flags AND the value
    # of `--agent`. The path-scope reshape appends `--agent <id>` here, and a
    # naive scan would mistake that id for the verb (argparse then rejects the id
    # as an invalid actions verb). `--agent=<id>` is a single token, so only the
    # space-separated form needs the value skip.
    first_positional, skip_next = None, False
    for tok in tail:
        if skip_next:
            skip_next = False
            continue
        if tok == "--agent":
            skip_next = True
            continue
        if tok.startswith("-"):
            continue
        first_positional = tok
        break
    if first_positional is None:
        # No verb at all (bare `actions`, or only flags) → default to `list`.
        tail = ["list"] + tail
    # A positional that isn't a known verb is passed through unchanged so the
    # actions subparser raises a suggesting "invalid choice" on a typo (e.g.
    # `actions enabl` → "Did you mean 'enable'?"). Defaulting it to `list` here
    # would instead bury the typo as an unexpected argument to `list`.
    return argv[: i + 1] + ["actions", integration] + tail


def _extract_global_output_flags(argv: list[str]) -> tuple[list[str], dict]:
    """Pull the global output/preview flags out of argv, wherever they appear.

    Returns `(remaining_argv, values)`. argparse only accepts a top-level
    optional before the subcommand, so without this an agent could not write the
    natural `eesel agents create --name X --dry-run`. Boolean flags (`--json`,
    `--dry-run`, `--secrets`) are matched exactly; `--fields` consumes the
    following token as its value only when that token is not itself a flag,
    or takes a `--fields=…` inline value. Anything not one of these flags is
    passed through untouched for argparse to handle.
    """
    values = {"json": False, "dry_run": False, "secrets": False, "fields": None, "legacy": False, "platform": False}
    rest: list[str] = []
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok == "--json":
            values["json"] = True
        elif tok == "--dry-run":
            values["dry_run"] = True
        elif tok == "--secrets":
            values["secrets"] = True
        elif tok == "--legacy":
            values["legacy"] = True
        elif tok == "--platform":
            values["platform"] = True
        elif tok == "--fields":
            # Only consume the next token as the value when it is a real value,
            # not another flag. `eesel schema --fields --json` must leave --json
            # intact rather than swallow it as fields="--json" (which silently
            # disables JSON). A missing or flag-shaped value leaves fields unset,
            # matching argparse's "expected one argument" being a no-op here.
            nxt = argv[i + 1] if i + 1 < len(argv) else None
            if nxt is not None and not nxt.startswith("--"):
                values["fields"] = nxt
                i += 1
        elif tok.startswith("--fields="):
            values["fields"] = tok.split("=", 1)[1]
        else:
            rest.append(tok)
        i += 1
    return rest, values


def _configure_output(args, global_flags: dict, creds: dict | None) -> None:
    """Resolve the machine-output contract into module globals for this run.

    Called once by `main()` after parsing. `EESEL_OUTPUT=json` mirrors the
    existing `EESEL_BASE_URL`/`EESEL_AGENT` env precedent. `_REVEAL_SECRETS` is
    the generalized secret gate that reaches previously-raw emitters: raw values
    only for a sysadmin/impersonator login that passed `--secrets`. It is set
    silently here — the "restricted to sysadmin" warning is emitted by the
    commands that own an explicit `--secrets` flag (integrations/actions), so
    resolving it here too would double-warn.
    """
    global _OUTPUT_FORMAT, _OUTPUT_FIELDS, _DRY_RUN, _REVEAL_SECRETS
    want_json = bool(getattr(args, "json", False)) or os.environ.get("EESEL_OUTPUT", "").strip().lower() == "json"
    _OUTPUT_FORMAT = "json" if want_json else "human"
    raw_fields = global_flags.get("fields")
    _OUTPUT_FIELDS = [f.strip() for f in raw_fields.split(",") if f.strip()] if raw_fields else None
    _DRY_RUN = bool(global_flags.get("dry_run"))
    _REVEAL_SECRETS = bool(getattr(args, "secrets", False)) and bool(creds) and _is_sysadmin(creds)


# ──────────────────────────────────────────────────────────────────────────
# Impersonation write-guard
#
# While a staff login is impersonating a customer, every command runs in the
# customer's live workspace. Reads and chat are fine (chat's write tools are
# stubbed server-side), but any command that changes the customer's setup would
# hit their real account. Two layers refuse those, both no-ops unless a *real*
# target is active:
#   1. A pre-dispatch check in main() — refuses a known write command before any
#      API call, and shows a banner on every command.
#   2. A backstop in http_request — refuses any mutating HTTP method that a verb
#      tag missed, so a forgotten command can't become a silent hole.
# This is a CLI-side guard for the operator's own tool; a direct curl under a
# live target still writes. The complete fix (server-side block-by-default) is a
# separate, human-gated change.
# ──────────────────────────────────────────────────────────────────────────

# Distinct from 1 (general error) and 2 (usage) so a caller can tell a refused
# impersonated write apart from an ordinary failure.
EXIT_IMPERSONATION_BLOCKED = 3

# Set once by _guard_impersonated_command() when a real target is active; read
# by the http_request backstop. None means "not impersonating".
_impersonation_target: dict | None = None

# Mutating-method requests to these paths are reads or plumbing, not customer
# changes, so they run under a live target. Everything else with a mutating
# method is refused by the backstop.
_IMPERSONATION_ALLOWED_WRITE_PATHS = frozenset({
    "/workspaces/token",           # mint the identity-resolved workspace token (how we find the target's workspace)
    "/workspace/tasks",            # activity list/count — a POST-shaped read
    "/workspace/tasks/analytics",  # activity analytics — a POST-shaped read
    "/dev/session",                # branch-env plumbing: mint a throwaway dev token
})

def _is_write_command(args) -> bool:
    """True if the parsed command would change the customer's live setup.

    Each customer-changing subcommand is tagged `write=True` at its parser
    definition (`set_defaults(write=True)`), so the mark lives next to the
    command and rides argparse's own resolution — a command with no such tag
    reads as a non-write. The http_request backstop is the real guarantee; this
    only drives the earlier, cleaner pre-dispatch refusal, so a command that
    forgets the tag still gets refused (just later), never leaked.
    """
    return bool(getattr(args, "write", False))


def _refuse_impersonated_write() -> None:
    """Print the refusal to stderr and exit with the distinct block code. Used by
    both the pre-dispatch check and the http_request backstop, so the message is
    identical wherever a write is stopped."""
    t = _impersonation_target or {}
    user, workspace = t.get("user", "a customer"), t.get("workspace", "their workspace")
    # err() already gives the "✗ " prefix + red; the two continuation lines are
    # plain indented stderr (no helper emits an unprefixed line).
    err(f"Refused — you are impersonating {user} ({workspace}).")
    print("  The eesel CLI won't change a customer's live setup while impersonating.", file=sys.stderr)
    print("  Run `eesel impersonate clear` to make this change as yourself.", file=sys.stderr)
    sys.exit(EXIT_IMPERSONATION_BLOCKED)


def _impersonation_write_backstop(method: str, url: str) -> None:
    """Refuse a mutating request under a live target unless its path is a known
    read/plumbing exception. A mutating GET (there are none today that change a
    customer's setup) would slip past this and must be caught by _WRITE_VERBS."""
    if _impersonation_target is None:
        return
    if method.upper() not in ("POST", "PUT", "PATCH", "DELETE"):
        return
    if urllib.parse.urlsplit(url).path in _IMPERSONATION_ALLOWED_WRITE_PATHS:
        return
    _refuse_impersonated_write()


def _guard_impersonated_command(args, creds: dict | None) -> None:
    """Before dispatch: if a real impersonation target is active, show a banner on
    every command and refuse the ones that would change the customer's setup.

    Gated on the cached staff flag, so a normal customer login makes no status
    call, shows no banner, and is never blocked — zero cost off the staff path.
    Idle staff (no target armed) act as themselves and are likewise untouched.
    """
    global _impersonation_target
    if not (creds and creds.get("is_impersonator")):
        return
    # A cached staff token may be near/expired. `require_creds()` will refresh it
    # and send the command, so the guard's status probe must run on the same live
    # token — otherwise the probe 401s, reports "no target", and silently disarms
    # the write-block while the refreshed command still reaches the customer.
    # Refresh up front (it saves to disk, so require_creds reuses it) before
    # probing.
    expires_at = creds.get("expires_at") or 0
    near_expiry = bool(expires_at) and time.time() > expires_at - TOKEN_REFRESH_SKEW_SECONDS
    if near_expiry and creds.get("refresh_token"):
        refresh_prod_token(creds)
    status = _get_impersonate_status(creds)
    if status is None:
        # Couldn't confirm impersonation state on a staff login (probe failed even
        # after any refresh). Fail closed for a tagged write rather than let it
        # through unguarded; reads fall through and act as the caller.
        if _is_write_command(args):
            err("Refused — couldn't confirm impersonation state for a staff login.")
            print("  The eesel CLI won't risk changing a customer's live setup while unsure.", file=sys.stderr)
            print("  Re-run once the connection is back, or `eesel login` again.", file=sys.stderr)
            sys.exit(EXIT_IMPERSONATION_BLOCKED)
        return
    target_uid = status.get("target_user_id")
    if not target_uid:
        return
    workspace = resolve_effective_workspace_id(creds) or creds.get("workspace_id") or "their workspace"
    _impersonation_target = {"user": target_uid, "workspace": workspace}
    print(_color(f"▲ impersonating {target_uid} — {workspace}", "33"), file=sys.stderr)
    if _is_write_command(args):
        _refuse_impersonated_write()


def _guard_platform_command(args, creds: dict | None) -> None:
    """Before dispatch on a legacy v2 workspace: refuse any command that has no
    read-only meaning there, client-side, before any handler runs. Mirrors
    `_guard_impersonated_command`.

    A command that works on legacy is fine on either platform, so it returns at
    once — before resolving the platform — which keeps the common path free of
    any probe. Only an unsupported command needs to know the platform, and even
    then it makes NO network call beyond `resolve_platform` (which is flag- and
    cache-first). With no stored creds and no explicit `--legacy` there is
    nothing to resolve offline, so it defers to the handler's require_creds()."""
    if legacy_supports(args):
        return
    if not creds and not getattr(args, "legacy", False):
        return
    if resolve_platform(creds, args) != PLATFORM_LEGACY:
        return
    fail(EXIT_VALIDATION,
         f"'{_command_label(args)}' is not available on the legacy (v2) platform (read-only).")


def main(argv: list[str] | None = None) -> int:
    # Surface staff-only commands only for global impersonators. Read from the
    # cached creds flag (populated at login / refreshed by `whoami`) so this
    # stays a local read — no network call on every invocation.
    creds = load_creds()
    staff = bool(creds and creds.get("is_impersonator"))
    if argv is None:
        argv = sys.argv[1:]
    # Lift the global output/preview flags out of argv so they work in any
    # position (argparse only accepts top-level optionals before the
    # subcommand). The values are re-attached to the parsed namespace below.
    # This runs BEFORE build_parser so the lifted --legacy/--platform can pick
    # the help surface.
    argv, global_flags = _extract_global_output_flags(argv)
    if global_flags["legacy"] and global_flags["platform"]:
        fail(EXIT_USAGE, "--legacy and --platform are mutually exclusive.")
    # An explicit flag wins; else the cached platform decides which `--help`
    # surface to build. Unknown/None → show everything (hide nothing).
    platform_hint = (
        PLATFORM_LEGACY if global_flags["legacy"]
        else PLATFORM_NEW if global_flags["platform"]
        else (creds.get("platform") if creds else None)
    )
    parser = build_parser(staff, platform_hint)
    # Path-as-scope first (`agents <id> integrations …` → flat + `--agent <id>`),
    # then the integrations actions reshape runs on its output.
    argv = _normalize_path_scope_argv(argv)
    argv = _normalize_integrations_argv(argv)
    args = parser.parse_args(argv)
    # Re-attach the lifted flags: a handler reads `args.json`/`args.secrets`
    # exactly as before, whether the flag was global or per-command.
    args.json = bool(getattr(args, "json", False)) or global_flags["json"]
    args.secrets = bool(getattr(args, "secrets", False)) or global_flags["secrets"]
    args.legacy = bool(getattr(args, "legacy", False)) or global_flags["legacy"]
    args.platform = bool(getattr(args, "platform", False)) or global_flags["platform"]
    _configure_output(args, global_flags, creds)
    _guard_impersonated_command(args, creds)
    _guard_platform_command(args, creds)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
