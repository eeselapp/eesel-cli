def _triggers_registry(creds: dict, *, as_json: bool = False) -> int:
    """`eesel automations triggers registry`: list the available event/webhook trigger types.

    Calls GET /triggers/registry and prints each trigger's key, integration and
    description. The `trigger_id` field in the registry is the value to pass as
    `--key` when adding a trigger with `eesel automations triggers add`. The scheduled-job
    type is filtered out — scheduled jobs are created with `eesel automations schedules add`.
    """
    data = http_request("GET", f"{creds['api_url']}/triggers/registry", token=creds["token"])
    triggers = data.get("triggers") if isinstance(data, dict) else data
    triggers = [t for t in (triggers or []) if t.get("trigger_id") != SCHEDULED_TRIGGER_KEY]
    if as_json:
        emit(triggers)
        return 0
    if not triggers:
        info("(no trigger types in the registry)")
        return 0

    info(f"# {len(triggers)} trigger type{'s' if len(triggers) != 1 else ''} — use the key with `eesel automations triggers add <agent> --key <key>`")
    fmt = " {:<34}  {:<14}  {}"
    info(fmt.format("key", "integration", "name"))
    for t in sorted(triggers, key=lambda r: (r.get("integration_key") or "", r.get("trigger_id") or "")):
        key = t.get("trigger_id") or "?"
        integration = t.get("integration_key") or "—"
        name = t.get("name") or t.get("description") or ""
        print(fmt.format(key[:34], integration[:14], name))
    return 0


def _triggers_add(creds: dict, args) -> int:
    """`eesel automations triggers add <agent> --key <key> [--config '<JSON>']`.

    POSTs to /agents/{agent_id}/triggers with {"trigger_key", "config"}. The
    server requires a non-null config, so an omitted --config is sent as an
    empty object. --config must be a JSON object.
    """
    agent = resolve_agent_or_error(creds, args.agent)
    if not agent:
        return 1

    config: dict = {}
    if getattr(args, "config", None):
        try:
            config = json.loads(args.config)
        except json.JSONDecodeError as e:
            err(f"--config is not valid JSON: {e}")
            return 1
        if not isinstance(config, dict):
            err("--config must be a JSON object (e.g. '{\"cron\": \"0 9 * * *\"}').")
            return 1

    url = f"{creds['api_url']}/agents/{agent['agent_id']}/triggers"
    resp = write_request("POST", url, token=creds["token"], body={"trigger_key": args.key, "config": config})

    trigger = resp.get("trigger") if isinstance(resp, dict) else None
    trigger_id = (trigger or {}).get("id") or (resp.get("id") if isinstance(resp, dict) else None)
    ok(f"Added trigger '{args.key}' to {agent.get('name', agent['agent_id'])} (id={trigger_id}).")
    info("Run `eesel automations triggers list` to confirm.")
    return 0


def match_event_triggers(rows: list[dict], trigger_id: str) -> list[dict]:
    """All event/webhook triggers matching `trigger_id`, in resolution-priority
    order: an exact id first, then id-prefix matches. The same trigger never
    appears twice, so callers can count the result to detect ambiguity. Triggers
    have no title, so the id is the only key (unlike scheduled jobs, which also
    match on config.title).

    A blank/whitespace `trigger_id` matches nothing: an empty string prefixes
    every id, so without this guard a destructive `remove` could resolve to the
    sole trigger on a single-trigger workspace with no real id given."""
    if not (trigger_id or "").strip():
        return []
    exact = [t for t in rows if t.get("id") == trigger_id]
    if exact:
        return exact
    return [t for t in rows if (t.get("id") or "").startswith(trigger_id)]


def _resolve_trigger(creds: dict, trigger_id: str) -> dict | None:
    """First event/webhook trigger matching `trigger_id` by exact id or id-prefix,
    or None. First-match — used by the read-only `show`. The `remove` path uses
    `resolve_event_trigger_strict`, which refuses an ambiguous prefix rather than
    deleting an arbitrary match. Resolving client-side means a bad or partial id
    is a clean 'no match' here rather than a 500 from `DELETE /triggers/{prefix}`
    (the server has no such row)."""
    validate_id(trigger_id, "trigger id")
    matches = match_event_triggers(fetch_all_event_triggers(creds), trigger_id)
    return matches[0] if matches else None


def resolve_event_trigger_strict(creds: dict, trigger_id: str) -> dict | None:
    """Resolve `trigger_id` to exactly one event/webhook trigger for `remove`, or
    print why it could not (no match, or ambiguous with the candidates listed)
    and return None. An id-prefix can match several triggers, so deleting must
    not act on an arbitrary first match."""
    validate_id(trigger_id, "trigger id")
    matches = match_event_triggers(fetch_all_event_triggers(creds), trigger_id)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        err(f"No event/webhook trigger matches '{trigger_id}'.")
        info("Run `eesel automations triggers list` to see triggers (the first column is the id).")
        return None
    err(f"'{trigger_id}' is ambiguous — it matches {len(matches)} triggers:")
    for t in matches:
        label = t.get("trigger_key") or t.get("id") or "?"
        err(f"  {t.get('id', '?')}  {label}")
    err("Re-run with a full trigger id to disambiguate.")
    return None


def _triggers_remove(creds: dict, args) -> int:
    """`eesel automations triggers remove <id> [--force]`: DELETE /triggers/{id}.

    The id is the trigger's own id (the first column of `eesel automations triggers list`),
    accepted as a full id or an unambiguous prefix. An ambiguous prefix is
    refused (candidates listed) rather than deleting an arbitrary match. Prompts
    for confirmation unless --force is passed.
    """
    match = resolve_event_trigger_strict(creds, args.trigger_id)
    if match is None:
        return 1
    trigger_id = match.get("id")
    label = match.get("trigger_key") or trigger_id
    if not getattr(args, "force", False):
        if not confirm(f"Remove trigger {trigger_id} ({label})? This cannot be undone. [y/N] "):
            info("Cancelled.")
            return 1

    write_request("DELETE", f"{creds['api_url']}/triggers/{trigger_id}", token=creds["token"])
    ok(f"Removed trigger {trigger_id}.")
    return 0


def _triggers_show(creds: dict, trigger_id: str, *, as_json: bool = False) -> int:
    """`eesel automations triggers show <id>`: full detail for one event/webhook trigger.

    There is no single-trigger endpoint, so the trigger is located within the
    workspace-wide list (GET /agents/{id}/triggers across agents) by exact id or
    id prefix. Secrets in the config are masked in the human view; --json emits
    the raw payload."""
    match = _resolve_trigger(creds, trigger_id)
    if match is None:
        err(f"No event/webhook trigger matches '{trigger_id}'.")
        info("Run `eesel automations triggers list` to see triggers (the first column is the id).")
        return 1

    if as_json:
        emit(match)
        return 0

    enabled = _trigger_enabled(match)
    print(f"{match.get('id')}  [{'on' if enabled else 'off'}]")
    print(f"  key:         {match.get('trigger_key') or '?'}")
    print(f"  type:        {match.get('type') or '?'}")
    print(f"  agent:       {match.get('agent_name') or match.get('agent_id') or '?'}")
    print(f"  integration: {match.get('integration_id') or '—'}")
    print(f"  last fired:  {_fmt_task_ts(match.get('last_executed_at'))}")
    cfg = match.get("config")
    if cfg:
        print("  config:")
        for line in json.dumps(_redact_secrets(cfg), indent=2).splitlines():
            print(f"    {line}")
    return 0


def _trigger_enabled(t: dict) -> bool:
    """Best-effort on/off state for a trigger row. The backend may carry the
    state under any of a few field names; a trigger with none of them present is
    treated as enabled (the default for a configured trigger)."""
    for field in ("enabled", "is_enabled", "is_active", "active"):
        if field in t and t[field] is not None:
            return bool(t[field])
    return True


def _triggers_list_events(creds: dict, *, as_json: bool = False, as_plain: bool = False) -> int:
    """`eesel automations triggers list`: every event/webhook trigger in the workspace,
    grouped by integration. Scheduled jobs are excluded — see
    `eesel automations schedules list`. Read-only."""
    rows = fetch_all_event_triggers(creds)
    if as_json:
        emit(rows)
        return 0
    if as_plain:
        for t in rows:
            state = "on" if _trigger_enabled(t) else "off"
            print(
                f"{str(t.get('id') or '')}\t{state}\t"
                f"{str(t.get('trigger_key') or '')}\t{str(t.get('agent_name') or '')}"
            )
        return 0
    if not rows:
        info("(no event/webhook triggers in this workspace)")
        info("Run `eesel automations schedules list` to see scheduled jobs.")
        return 0

    # Best-effort integration_id → type map for nicer group labels. Degrade to
    # integration_id-only if integrations aren't reachable (older server, etc.).
    id_to_type: dict = {}
    try:
        for it in fetch_integrations(creds):
            if it.get("id"):
                id_to_type[it["id"]] = it.get("integrationType")
    except (Exception, SystemExit):
        pass

    groups: dict = {}
    for t in rows:
        groups.setdefault(_trigger_integration_label(t, id_to_type), []).append(t)

    first = True

    def header(label: str) -> None:
        nonlocal first
        if not first:
            print()
        first = False
        print(_color(label, "1"))  # bold group header

    for label in sorted(groups):
        bucket = groups[label]
        header(f"{label} ({len(bucket)})")
        for t in bucket:
            tid = (t.get("id") or "?")[:12]
            tkey = t.get("trigger_key") or "?"
            ttype = t.get("type") or "?"
            status = "[on] " if _trigger_enabled(t) else "[off]"
            last = _fmt_task_ts(t.get("last_executed_at"))
            iid = (t.get("integration_id") or "")[:12] or "—"
            print(f"  {tid}  {status}  {tkey:<30}  {ttype:<8}  last={last:<16}  int={iid}  agent={t['agent_name']}")
            cfg = t.get("config")
            if cfg:
                blob = json.dumps(_redact_secrets(cfg))
                if len(blob) > 200:
                    blob = blob[:200] + "…"
                print(_color(f"      config: {blob}", "2;37"))
    return 0


def cmd_tools(args) -> int:
    """Hidden back-compat alias for the removed `eesel tools` command.

    The action surface moved under `eesel integrations <integration> actions`,
    which lists one integration at a time. This alias preserves the old
    behavior — a read-only list of an agent's actions across all integrations —
    so existing scripts that call `eesel tools [agent]` keep working.
    Name the agent (id / prefix / name); a single-agent workspace needs no scope.
    """
    creds = require_creds()
    agent = resolve_agent_or_error(creds, getattr(args, "agent", None))
    if not agent:
        return 1

    agent_id = agent["agent_id"]
    tools = fetch_tools(creds, agent_id)
    if _want_json(args):
        emit(tools)
        return 0
    if not tools:
        info(f"(no tools/actions configured for {agent.get('name', agent_id)})")
        return 0

    info(f"# {agent.get('name', '?')} ({agent_id[:12]}) — {len(tools)} tool{'s' if len(tools) != 1 else ''}")
    rows = sorted((_tool_row(t) for t in tools), key=lambda r: (r["integration_key"], r["name"].lower()))
    fmt = " {:<32}  {:<5}  {:<13}  {:<16}  {}"
    info(fmt.format("name", "r/w", "permission", "integration", "integration_id"))
    for r in rows:
        print(fmt.format(r["name"][:32], r["action"], r["permission"][:13], r["integration_key"][:16], r["integration_id"][:12]))
    return 0


def cmd_schedules(args) -> int:
    """`eesel automations schedules`: scheduled jobs — cron-driven agent runs.
    These are triggers whose key is the scheduled-job sentinel; the CLI gives
    them their own sub-namespace because they behave differently from event
    triggers (they have a cron, and they can be fired manually)."""
    creds = require_creds()
    sub = args.schedules_cmd or "list"

    if sub == "list":
        return _schedules_list(creds, as_json=_want_json(args))

    if sub == "add":
        return _schedules_add(creds, args)

    if sub == "remove":
        return _schedules_remove(creds, args)

    if sub == "fire":
        return _schedules_fire(creds, args.job)

    return 1


def _schedules_list(creds: dict, *, as_json: bool = False) -> int:
    """`eesel automations schedules list`: every scheduled job in the workspace, with its
    cron and timezone. Read-only."""
    rows = fetch_all_scheduled_jobs(creds)
    if as_json:
        emit(rows)
        return 0
    if not rows:
        info("(no scheduled jobs in this workspace)")
        info("Add one with `eesel automations schedules add <agent> --cron \"0 9 * * *\" --prompt \"...\"`.")
        return 0
    for t in rows:
        cfg = t.get("config") or {}
        title = cfg.get("title") or "(untitled)"
        cron = cfg.get("cron") or "?"
        tz = cfg.get("timezone") or "UTC"
        tid = (t.get("id") or "?")[:12]
        print(f" {tid}  {title:<28}  cron={cron} ({tz})  agent={t['agent_name']}")
    return 0


def _schedules_add(creds: dict, args) -> int:
    """`eesel automations schedules add <agent> --cron "<expr>" --prompt "<text>" [--title ..] [--timezone ..]`.

    POSTs to /agents/{agent_id}/triggers with the scheduled-job key and a config
    built from the flags. The server requires a `prompt` (the instruction the
    agent runs on each fire), so it is a dedicated required flag. `--config` is an
    optional JSON object whose keys are merged in first, so the dedicated flags
    (`cron`, `prompt`, `title`, `timezone`) take precedence over it.
    """
    agent = resolve_agent_or_error(creds, args.agent)
    if not agent:
        return 1

    config: dict = {}
    if getattr(args, "config", None):
        try:
            config = json.loads(args.config)
        except json.JSONDecodeError as e:
            err(f"--config is not valid JSON: {e}")
            return 1
        if not isinstance(config, dict):
            err("--config must be a JSON object (e.g. '{\"cron\": \"0 9 * * *\"}').")
            return 1

    # Dedicated flags win over anything passed in --config.
    config["cron"] = args.cron
    config["prompt"] = args.prompt
    if getattr(args, "title", None):
        config["title"] = args.title
    if getattr(args, "timezone", None):
        config["timezone"] = args.timezone

    url = f"{creds['api_url']}/agents/{agent['agent_id']}/triggers"
    resp = write_request(
        "POST", url, token=creds["token"],
        body={"trigger_key": SCHEDULED_TRIGGER_KEY, "config": config},
    )

    trigger = resp.get("trigger") if isinstance(resp, dict) else None
    job_id = (trigger or {}).get("id") or (resp.get("id") if isinstance(resp, dict) else None)
    label = config.get("title") or args.cron
    ok(f"Added scheduled job '{label}' to {agent.get('name', agent['agent_id'])} (id={job_id}).")
    info("Run `eesel automations schedules list` to confirm.")
    return 0


def _schedules_remove(creds: dict, args) -> int:
    """`eesel automations schedules remove <id|title> [--force]`: DELETE /triggers/{id}.

    `<job>` is resolved by id, id-prefix, or title substring (the same way
    `eesel automations schedules fire` resolves it), so an unmatched value gives a clean
    error instead of being sent to the server verbatim. Prompts for
    confirmation unless --force is passed.
    """
    match = resolve_scheduled_job_strict(creds, args.job)
    if not match:
        return 1

    title = (match.get("config") or {}).get("title") or "(untitled)"
    if not getattr(args, "force", False):
        if not confirm(f"Remove scheduled job '{title}' ({match['id'][:12]})? This cannot be undone. [y/N] "):
            info("Cancelled.")
            return 1

    write_request("DELETE", f"{creds['api_url']}/triggers/{match['id']}", token=creds["token"])
    ok(f"Removed scheduled job {match['id']}.")
    return 0


def _schedules_fire(creds: dict, target: str) -> int:
    """`eesel automations schedules fire <id|title>`: manually run a scheduled job once via
    POST /triggers/{id}/fire. `target` is resolved by id, id-prefix, or title
    substring."""
    match = resolve_scheduled_job_strict(creds, target)
    if not match:
        return 1

    url = f"{creds['api_url']}/triggers/{match['id']}/fire"
    resp = write_request("POST", url, token=creds["token"], body={})

    title = (match.get("config") or {}).get("title") or "(untitled)"
    ok(f"Fired '{title}' (job={match['id'][:12]}, agent={match['agent_name']}).")
    info(f"  scheduled_at: {resp.get('scheduled_at')}")
    info(f"  external_ref: {resp.get('external_reference')}")
    info("Tail the worker: docker logs slack-server-1 -f | grep scheduled_trigger")
    return 0


def cmd_integrations(args) -> int:
    """Dispatch the `eesel integrations` subcommands.

    `list` (default) shows every connected integration with connection status.
    `available` lists the connectable catalog. `show <integration>` prints one
    integration's detail. `connect` connects a new integration; `sync` triggers
    a data refresh; `sync-status` reports sync-run progress; `remove` disconnects
    one. `add` and `disconnect` are hidden back-compat aliases for `connect` and
    `remove`.
    """
    creds = require_creds()
    if resolve_platform(creds, args) == PLATFORM_LEGACY:
        return _integrations_legacy(args, creds)
    # `--agent` scopes this command to one agent (id, id-prefix, or name), like
    # the EESEL_AGENT env var but per-command. It is resolved in memory and not
    # persisted, so the scope stays local to this command. Connection status in
    # list/show is computed against this agent, and `connect`'s redirect/OAuth
    # hand-off carries it as the agentId so the post-auth page lands on the right
    # agent. Resolving it here applies the scope uniformly across the group.
    agent_arg = getattr(args, "agent", None)
    if agent_arg is not None and not agent_arg.strip():
        # `--agent` was passed but is empty (e.g. `--agent "$AGENT"` with the
        # variable unset). Don't let it fall through the truthiness check below to
        # the unscoped path — for `remove` that would uninstall the integration
        # for the whole workspace instead of revoking it from one agent. Treat
        # "given but blank" as the error it is, distinct from "not given at all".
        err("--agent was given but is empty. Pass an agent id, id-prefix, or name, "
            "or omit --agent to act on the whole workspace.")
        return 1
    if agent_arg:
        # `--agent` may be a human agent name containing `/`, `%`, etc., so it is
        # resolved first; only the resolved agent_id (the URL path segment) is
        # validated.
        agent, candidates = resolve_agent_strict(fetch_agents(creds), args.agent)
        if not agent:
            if candidates:
                err(f"'{args.agent}' is ambiguous — it matches {len(candidates)} agents:")
                for a in candidates:
                    err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
                err("Re-run with a full agent id to disambiguate.")
            else:
                err(f"No agent matches '{args.agent}'.")
                info("Run `eesel agents list` to see available agents.")
            return 1
        creds = dict(creds)
        creds["agent_id"] = validate_id(agent["agent_id"], "agent id")
    sub = getattr(args, "integrations_cmd", None) or "list"
    # The integration reference (`<integration>` / `--id`) and the connect
    # catalog key both become URL path segments; reject a malformed one before
    # any lookup runs. `--id` is an opaque instance id; the connect `key` is a
    # connector key (e.g. `zendesk`), also opaque.
    if getattr(args, "id", None):
        validate_id(args.id, "integration")
    if sub == "connect" and getattr(args, "key", None):
        validate_id(args.key, "integration key")
    if sub == "list":
        return _integrations_list(args, creds)
    if sub == "available":
        return _integrations_available(args, creds)
    if sub == "show":
        return _integrations_show(args, creds)
    if sub == "connect":
        return _integrations_connect(args, creds)
    if sub == "remove":
        return _integrations_remove(args, creds)
    if sub == "sync":
        return _integrations_sync(args, creds)
    if sub == "sync-status":
        return _integrations_sync_status(args, creds)
    return 1


def _integrations_list(args, creds: dict) -> int:
    """List every connected integration, one row each (read-only).

    Columns: id, type, connection status, and subdomain. Connection status is
    shown as a column rather than filtering the list — every integration is
    always listed. Sensitive properties (access tokens, secrets) are hidden
    unless `--secrets` is passed *and* the caller is a sysadmin/impersonator —
    the same allowlist `eesel whoami` uses.
    """
    integrations = fetch_integrations(creds, agent_id=creds.get("agent_id"))

    # Sensitive properties (access tokens, secrets) are only revealed with
    # --secrets AND a sysadmin/impersonator account. The gate applies to every
    # render path — including --json — so secrets don't leak through a format that
    # skips it. The warn goes to stderr and so does not corrupt --json on stdout.
    reveal = False
    if getattr(args, "secrets", False):
        reveal = _is_sysadmin(creds)
        if not reveal:
            warn("--secrets is restricted to sysadmin/impersonator accounts — showing non-sensitive fields only.")

    if _want_json(args):
        emit(integrations, reveal=reveal)
        return 0
    if getattr(args, "plain", False):
        for it in integrations:
            print(
                f"{str(it.get('id') or '')}\t{str(it.get('integrationType') or '')}\t"
                f"{str(it.get('connectionStatus') or '')}\t{str(it.get('identifier') or '')}"
            )
        return 0
    if not integrations:
        info("(no integrations)")
        return 0

    fmt = " {:<12}  {:<18}  {:<10}  {}"
    info(fmt.format("id", "type", "connection", "subdomain"))
    for it in integrations:
        iid = it.get("id") or "—"
        itype = (it.get("integrationType") or "?")[:18]
        status = it.get("connectionStatus") or "?"
        subdomain = it.get("identifier") or ""
        print(fmt.format(str(iid)[:12], itype, status, subdomain))
        if reveal:
            props = it.get("properties") or []
            if not props:
                print(_color("      (no properties)", "2;37"))
            for prop in props:
                if isinstance(prop, dict) and "key" in prop:
                    print(_color(f"      {prop.get('key')} = {prop.get('value')}", "2;37"))
                else:
                    print(_color(f"      {json.dumps(prop)}", "2;37"))
    return 0


def _integrations_available(args, creds: dict) -> int:
    """List the connectable integration types (the catalog of what *can* be
    connected). The `key` column is the value passed to
    `eesel integrations connect <key>`; the `options` column lists that
    connector's connection-option `type`s — the values accepted by
    `connect --option`."""
    definitions = fetch_integration_definitions(creds)
    if _want_json(args):
        emit(definitions)
        return 0
    if not definitions:
        info("(no connectable integrations)")
        return 0

    fmt = " {:<22}  {:<16}  {:<26}  {}"
    info(fmt.format("key", "category", "title", "connect options"))
    for d in sorted(definitions, key=lambda x: (x.get("category") or "", x.get("key") or "")):
        key = (d.get("key") or "?")[:22]
        category = (d.get("category") or "—")[:16]
        title = (d.get("title") or "")[:26]
        opts = [o.get("type") for o in _connection_options(d) if o.get("type")]
        options = ", ".join(opts) if opts else "—"
        print(fmt.format(key, category, title, options))
    return 0


def _integrations_show(args, creds: dict) -> int:
    """Show one connected integration's detail (read-only).

    `<integration>` resolves from a full id, id prefix, or integration type.
    Prints the connection status and the latest sync run (status + progress),
    read from GET /v2/sync-runs. An integration with no active or recent run
    shows "—" for sync.
    """
    integration = resolve_integration(fetch_integrations(creds, agent_id=creds.get("agent_id")), args.id)
    if not integration:
        err(f"No connected integration matches '{args.id}'. Run `eesel integrations list`.")
        return 1
    integration_id = integration["id"]

    run = _latest_sync_run(creds, integration_id)

    if _want_json(args):
        out = dict(integration)
        out["syncRun"] = run
        # Secrets are masked unless the global `--secrets` gate is open for a
        # sysadmin login (handled inside emit via _REVEAL_SECRETS).
        emit(out)
        return 0

    itype = integration.get("integrationType") or "?"
    info(f"# {itype} [{integration_id}]")
    print(f" type        {itype}")
    print(f" id          {integration_id}")
    if integration.get("identifier"):
        print(f" subdomain   {integration.get('identifier')}")
    print(f" connection  {integration.get('connectionStatus') or '?'}")
    sync = f"{run.get('status')} — {_sync_run_progress(run)}" if run else "—"
    print(f" sync        {sync}")
    return 0


def _mask_legacy_config(entries: list, reveal: bool) -> list:
    """Mask legacy connection-config values whose `name` looks like a secret.

    Config entries are `{name, value}` (not the `{key, value}` property shape
    `_redact_secrets` recognizes), so mask off the same `_SECRET_KEY_HINTS`
    behind the same reveal gate the rest of the CLI uses. `customPrompt` isn't a
    secret, so it passes through untouched."""
    if reveal:
        return entries
    out = []
    for e in entries:
        if isinstance(e, dict):
            name, value = e.get("name"), e.get("value")
            if (isinstance(name, str) and isinstance(value, str) and value
                    and any(h in name.lower() for h in _SECRET_KEY_HINTS)):
                out.append({**e, "value": "***"})
                continue
        out.append(e)
    return out


def _legacy_connections_list(args, creds: dict) -> int:
    """`integrations list` on legacy: the bot's (namespace's) connections."""
    ns = resolve_namespace_or_error(creds, getattr(args, "agent", None))
    if not ns:
        return 1
    conns = fetch_namespace_connections(creds, ns["id"])
    if _want_json(args):
        emit(conns)
        return 0
    if not conns:
        info("(no connections)")
        return 0
    fmt = " {:<12}  {:<18}  {}"
    info(fmt.format("id", "type", "name"))
    for c in conns:
        cid = str(c.get("connectionId") or "—")[:12]
        ctype = (str(c.get("connectionType") or "?"))[:18]
        print(fmt.format(cid, ctype, c.get("connectionName") or ""))
