def _schedules_add(creds: dict, args) -> int:
    """`eesel schedules add <agent> --cron "<expr>" --prompt "<text>" [--title ..] [--timezone ..]`.

    POSTs to /agents/{agent_id}/triggers with the scheduled-job key and a config
    built from the flags. The server requires a `prompt` (the instruction the
    agent runs on each fire), so it is a dedicated required flag. `--config` is an
    optional JSON object whose keys are merged in first, so the dedicated flags
    (`cron`, `prompt`, `title`, `timezone`) take precedence over it.
    """
    agents = fetch_agents(creds)
    if not agents:
        err("No agents in workspace. Create one with `eesel agents create` first.")
        return 1
    agent = resolve_agent(agents, args.agent)
    if not agent:
        err(f"No agent matches '{args.agent}'.")
        info("Run `eesel agents list` to see available agents.")
        return 1

    config: dict = {}
    if getattr(args, "config", None):
        try:
            config = json.loads(args.config)
        except json.JSONDecodeError as e:
            err(f"--config is not valid JSON: {e}")
            return 1
        if not isinstance(config, dict):
            err("--config must be a JSON object (e.g. '{\"cron\": \"0 9 * * *\"}').")
            return 1

    # Dedicated flags win over anything passed in --config.
    config["cron"] = args.cron
    config["prompt"] = args.prompt
    if getattr(args, "title", None):
        config["title"] = args.title
    if getattr(args, "timezone", None):
        config["timezone"] = args.timezone

    url = f"{creds['api_url']}/agents/{agent['agent_id']}/triggers"
    resp = http_request(
        "POST", url, token=creds["token"],
        body={"trigger_key": SCHEDULED_TRIGGER_KEY, "config": config},
    )

    trigger = resp.get("trigger") if isinstance(resp, dict) else None
    job_id = (trigger or {}).get("id") or (resp.get("id") if isinstance(resp, dict) else None)
    label = config.get("title") or args.cron
    ok(f"Added scheduled job '{label}' to {agent.get('name', agent['agent_id'])} (id={job_id}).")
    info("Run `eesel schedules list` to confirm.")
    return 0


def _schedules_remove(creds: dict, args) -> int:
    """`eesel schedules remove <id|title> [--force]`: DELETE /triggers/{id}.

    `<job>` is resolved by id, id-prefix, or title substring (the same way
    `eesel schedules fire` resolves it), so an unmatched value gives a clean
    error instead of being sent to the server verbatim. Prompts for
    confirmation unless --force is passed.
    """
    match = resolve_scheduled_job_strict(creds, args.job)
    if not match:
        return 1

    title = (match.get("config") or {}).get("title") or "(untitled)"
    if not getattr(args, "force", False):
        if not confirm(f"Remove scheduled job '{title}' ({match['id'][:12]})? This cannot be undone. [y/N] "):
            info("Cancelled.")
            return 1

    http_request("DELETE", f"{creds['api_url']}/triggers/{match['id']}", token=creds["token"])
    ok(f"Removed scheduled job {match['id']}.")
    return 0


def _schedules_fire(creds: dict, target: str) -> int:
    """`eesel schedules fire <id|title>`: manually run a scheduled job once via
    POST /triggers/{id}/fire. `target` is resolved by id, id-prefix, or title
    substring."""
    match = resolve_scheduled_job_strict(creds, target)
    if not match:
        return 1

    url = f"{creds['api_url']}/triggers/{match['id']}/fire"
    resp = http_request("POST", url, token=creds["token"], body={})

    title = (match.get("config") or {}).get("title") or "(untitled)"
    ok(f"Fired '{title}' (job={match['id'][:12]}, agent={match['agent_name']}).")
    info(f"  scheduled_at: {resp.get('scheduled_at')}")
    info(f"  external_ref: {resp.get('external_reference')}")
    info("Tail the worker: docker logs slack-server-1 -f | grep scheduled_trigger")
    return 0


def cmd_integrations(args) -> int:
    """Dispatch the `eesel integrations` subcommands.

    `list` (default) shows every connected integration, one row each, with a
    connection-status and a sync-status column. `show <integration>` prints one
    integration's detail. `add` connects a new integration (`connect` is a thin
    alias). `remove` disconnects one (`disconnect` is a thin alias). `sync`
    triggers a data refresh for a connected integration.
    """
    creds = require_creds()
    # `--agent` scopes this command to one agent (id, id-prefix, or name), like
    # the EESEL_AGENT env var but per-command. It is resolved in memory and not
    # persisted, so it never changes the saved active agent. Every integrations
    # subcommand reads creds["agent_id"] — listing/connection status is computed
    # against it, and `add` folds it into the setup payload — so overriding it
    # here applies the scope uniformly across list/show/add/sync/remove.
    if getattr(args, "agent", None):
        agent, candidates = resolve_agent_strict(fetch_agents(creds), args.agent)
        if not agent:
            if candidates:
                err(f"'{args.agent}' is ambiguous — it matches {len(candidates)} agents:")
                for a in candidates:
                    err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
                err("Re-run with a full agent id to disambiguate.")
            else:
                err(f"No agent matches '{args.agent}'.")
                info("Run `eesel agents list` to see available agents.")
            return 1
        creds = dict(creds)
        creds["agent_id"] = agent["agent_id"]
    sub = getattr(args, "integrations_cmd", None) or "list"
    if sub == "list":
        return _integrations_list(args, creds)
    if sub == "available":
        return _integrations_available(args, creds)
    if sub == "show":
        return _integrations_show(args, creds)
    # `add` is a hidden back-compat alias for the canonical `connect`.
    if sub in ("connect", "add"):
        return _integrations_connect(args, creds)
    # `disconnect` is a permitted thin alias for the canonical `remove`.
    if sub in ("remove", "disconnect"):
        return _integrations_remove(args, creds)
    if sub == "sync":
        return _integrations_sync(args, creds)
    if sub == "sync-status":
        return _integrations_sync_status(args, creds)
    return 1


def _integrations_list(args, creds: dict) -> int:
    """List every connected integration, one row each (read-only).

    Columns: id, type, connection status, and subdomain. Connection status is
    shown as a column rather than filtering the list — every integration is
    always listed. Sensitive properties (access tokens, secrets) are hidden
    unless `--secrets` is passed *and* the caller is a sysadmin/impersonator —
    the same allowlist `eesel whoami` uses.
    """
    integrations = fetch_integrations(creds, agent_id=creds.get("agent_id"))

    # Sensitive properties (access tokens, secrets) are only revealed with
    # --secrets AND a sysadmin/impersonator account. The gate applies to every
    # render path — including --json — so secrets don't leak through a format that
    # skips it. The warn goes to stderr and so does not corrupt --json on stdout.
    reveal = False
    if getattr(args, "secrets", False):
        reveal = _is_sysadmin(creds)
        if not reveal:
            warn("--secrets is restricted to sysadmin/impersonator accounts — showing non-sensitive fields only.")

    if getattr(args, "json", False):
        payload = integrations if reveal else _redact_secrets(integrations)
        print(json.dumps(payload, indent=2))
        return 0
    if getattr(args, "plain", False):
        for it in integrations:
            print(
                f"{str(it.get('id') or '')}\t{str(it.get('integrationType') or '')}\t"
                f"{str(it.get('connectionStatus') or '')}\t{str(it.get('identifier') or '')}"
            )
        return 0
    if not integrations:
        info("(no integrations)")
        return 0

    fmt = " {:<12}  {:<18}  {:<10}  {}"
    info(fmt.format("id", "type", "connection", "subdomain"))
    for it in integrations:
        iid = it.get("id") or "—"
        itype = (it.get("integrationType") or "?")[:18]
        status = it.get("connectionStatus") or "?"
        subdomain = it.get("identifier") or ""
        print(fmt.format(str(iid)[:12], itype, status, subdomain))
        if reveal:
            props = it.get("properties") or []
            if not props:
                print(_color("      (no properties)", "2;37"))
            for prop in props:
                if isinstance(prop, dict) and "key" in prop:
                    print(_color(f"      {prop.get('key')} = {prop.get('value')}", "2;37"))
                else:
                    print(_color(f"      {json.dumps(prop)}", "2;37"))
    return 0


def _integrations_available(args, creds: dict) -> int:
    """List the connectable integration types (the catalog of what *can* be
    connected). The `key` column is the value passed to
    `eesel integrations connect <key>`; the `options` column lists that
    connector's connection-option `type`s — the values accepted by
    `connect --option`."""
    definitions = fetch_integration_definitions(creds)
    if getattr(args, "json", False):
        print(json.dumps(definitions, indent=2))
        return 0
    if not definitions:
        info("(no connectable integrations)")
        return 0

    fmt = " {:<22}  {:<16}  {:<26}  {}"
    info(fmt.format("key", "category", "title", "connect options"))
    for d in sorted(definitions, key=lambda x: (x.get("category") or "", x.get("key") or "")):
        key = (d.get("key") or "?")[:22]
        category = (d.get("category") or "—")[:16]
        title = (d.get("title") or "")[:26]
        opts = [o.get("type") for o in _connection_options(d) if o.get("type")]
        options = ", ".join(opts) if opts else "—"
        print(fmt.format(key, category, title, options))
    return 0


def _integrations_show(args, creds: dict) -> int:
    """Show one connected integration's detail (read-only).

    `<integration>` resolves from a full id, id prefix, or integration type.
    Prints the connection status and the latest sync run (status + progress),
    read from GET /v2/sync-runs. An integration with no active or recent run
    shows "—" for sync.
    """
    integration = resolve_integration(fetch_integrations(creds, agent_id=creds.get("agent_id")), args.id)
    if not integration:
        err(f"No connected integration matches '{args.id}'. Run `eesel integrations list`.")
        return 1
    integration_id = integration["id"]

    run = _latest_sync_run(creds, integration_id)

    if getattr(args, "json", False):
        out = dict(integration)
        out["syncRun"] = run
        # `show` has no --secrets flag, so there is no way to reveal sensitive
        # properties here — always mask them, mirroring the list/table gate.
        print(json.dumps(_redact_secrets(out), indent=2))
        return 0

    itype = integration.get("integrationType") or "?"
    info(f"# {itype} [{integration_id}]")
    print(f" type        {itype}")
    print(f" id          {integration_id}")
    if integration.get("identifier"):
        print(f" subdomain   {integration.get('identifier')}")
    print(f" connection  {integration.get('connectionStatus') or '?'}")
    sync = f"{run.get('status')} — {_sync_run_progress(run)}" if run else "—"
    print(f" sync        {sync}")
    return 0


def _latest_sync_run(creds: dict, integration_id: str):
    """The most recent sync run for an integration from GET /v2/sync-runs, or
    None.

    Reads the sync-runs feed (status + progress), NOT GET /integrations/{id}/sync
    — the latter *triggers* a sync rather than reporting one, so reading status
    from it would kick off unintended syncs. The feed only lists active and
    last-24h runs, so an integration whose last sync is older has no run here.
    """
    try:
        data = http_request("GET", f"{creds['api_url']}/v2/sync-runs", token=creds["token"])
    except SystemExit:
        return None
    runs = data.get("jobs") if isinstance(data, dict) else (data if isinstance(data, list) else [])
    return next((r for r in runs if str((r.get("metadata") or {}).get("integration_id")) == str(integration_id)), None)


def _parse_config_arg(raw: str | None) -> dict:
    """Parse the `--config` JSON string into a dict, exiting with a clear
    message if it isn't a valid JSON object."""
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as e:
        sys.exit(f"--config is not valid JSON: {e}")
    if not isinstance(parsed, dict):
        sys.exit("--config must be a JSON object, e.g. '{\"subdomain\": \"acme\"}'")
    return parsed


def _parse_field_args(raw_fields) -> dict:
    """Parse repeatable `--field key=value` arguments into a dict, exiting with
    a clear message on a malformed entry. The value may contain `=` (only the
    first splits the pair)."""
    fields: dict = {}
    for item in raw_fields or []:
        key, sep, value = item.partition("=")
        if not sep or not key:
            sys.exit(f"--field must be key=value, got '{item}'.")
        fields[key] = value
    return fields


def _select_connection_option(definition: dict, requested: str | None) -> tuple[dict | None, str | None]:
    """Pick which connection option `connect` should act on. With `requested`,
    match it against the options' `type`. Without it, use the sole option, or
    return a message asking the caller to choose when there are several. Returns
    `(option, error_message)` — exactly one is set."""
    options = _connection_options(definition)
    if not options:
        return None, "this integration exposes no connection options."
    names = ", ".join(o.get("type") for o in options if o.get("type")) or "(unnamed)"
    if requested:
        match = next((o for o in options if o.get("type") == requested), None)
        if match is None:
            return None, f"no connection option '{requested}'. Available: {names}."
        return match, None
    if len(options) == 1:
        return options[0], None
    return None, f"several connection options — choose one with --option. Available: {names}."


def _browser_connect_url(creds: dict, endpoint: str, identifier: str | None = None) -> str:
    """Resolve a `redirect` connection option's endpoint to a full browser URL
    on the dashboard host.

    Drops unresolved `{{...}}` template params, appends the active agent id, and
    fills an identifier param when the endpoint templates one (e.g. the Zendesk
    messenger option's `zendeskSubdomain={{integrationIdentifier}}`). The OAuth
    flow is served by the dashboard, a different host than the API.
    """
    match = re.search(r"([A-Za-z0-9_]+)=\{\{integrationIdentifier\}\}", endpoint)
    identifier_param = match.group(1) if match else None
    base, _, query = endpoint.partition("?")
    params = [(k, v) for k, v in urllib.parse.parse_qsl(query) if "{{" not in v]
    if identifier and identifier_param:
        params.append((identifier_param, identifier))
    if creds.get("agent_id"):
        params.append(("agentId", creds["agent_id"]))
    dashboard = (creds.get("dashboard_url") or ENVS["prod"]["dashboard"]).rstrip("/")
    return f"{dashboard}{base}?{urllib.parse.urlencode(params)}" if params else f"{dashboard}{base}"


def _integrations_connect(args, creds: dict) -> int:
    """Connect a new integration of type `<key>`. Reached via `connect` or its
    hidden back-compat alias `add`.

    Each connector publishes one or more connection options (see
    `eesel integrations available`), each with a `handler_type`: `submit` (a
    direct POST that connects without leaving the terminal) or `redirect` (a
    browser OAuth hand-off). `--option <type>` chooses one, and is required when
    a connector exposes several. For a `submit` option the option's field
    `schema` is filled from repeatable `--field key=value` and POSTed to the
    option's endpoint; a missing required field is reported before any request.
    For a `redirect` option the dashboard OAuth URL is opened in the browser and
    the command exits — it initiates the flow and hands off, exactly like
    `eesel login`; it does not wait for or complete the authorization.

    `--config '<json>'` and `--token` are hidden back-compat flags: `--config`
    keys are folded into the field set and `--token` is sent as `access_token`.
    """
    key = args.key
    definition = next((d for d in fetch_integration_definitions(creds) if d.get("key") == key), None)
    if definition is None:
        err(f"No connectable integration '{key}'.")
        info("Run `eesel integrations available` to see the catalog of connectable types.")
        return 1

    option, problem = _select_connection_option(definition, getattr(args, "option", None))
    if option is None:
        err(f"Could not connect '{key}': {problem}")
        return 1

    # Setup fields come from repeatable --field key=value, plus the hidden
    # back-compat --config (a JSON object) and --token (sent as access_token).
    fields = _parse_config_arg(getattr(args, "config", None))
    fields.update(_parse_field_args(getattr(args, "field", None)))
    token = getattr(args, "token", None)
    if token and "access_token" not in fields:
        fields["access_token"] = token

    handler = option.get("handler_type")
    endpoint = option.get("endpoint") or ""
    opt_type = option.get("type") or "(unnamed)"

    if handler == "redirect":
        if getattr(args, "no_input", False):
            err(f"Connecting '{key}' via '{opt_type}' needs an interactive browser OAuth step, and --no-input was given.")
            return 1
        url = _browser_connect_url(creds, endpoint, fields.get("subdomain") or fields.get("identifier"))
        info(f"Opening your browser to connect '{key}' — complete the authorization there:\n  {url}")
        try:
            webbrowser.open(url)
        except Exception:
            # No browser available (e.g. headless): the printed URL is the
            # hand-off, so this isn't a failure.
            pass
        info("The CLI initiates the OAuth flow and hands off — it does not wait for it to finish.")
        return 0

    if handler == "submit":
        required = (option.get("schema") or {}).get("required") or []
        missing = [f for f in required if f not in fields]
        if missing:
            err(f"Could not connect '{key}': missing required field(s): {', '.join(missing)}.")
            info(f"Pass them with --field, e.g. `--field {missing[0]}=<value>`.")
            return 1
        status, result = http_request_allow_error(
            "POST", f"{creds['api_url']}{endpoint}", token=creds["token"], body=fields
        )
        if status >= 400:
            message = result.get("error") or result.get("message") or json.dumps(result)
            err(f"Could not connect '{key}': {message}")
            if result.get("details"):
                info(str(result["details"]))
            return 1
        integration_id = result.get("integration_id") or result.get("id")
        identifier = result.get("identifier")
        suffix = (f" ({integration_id})" if integration_id else "") + (f" — {identifier}" if identifier else "")
        ok(f"Connected '{key}'{suffix}")
        return 0

    err(f"Could not connect '{key}': unsupported connection handler '{handler}' for option '{opt_type}'.")
    return 1


# Valid `sync_type` values accepted by POST /integrations/{id}/trigger-sync.
# The server maps these UI keys to its internal sync subcategories; anything
# else returns HTTP 400 "invalid sync_type". Only Zendesk integrations
# currently support triggered syncs.
INTEGRATION_SYNC_TYPES = ("help-center", "macros", "tickets")


def _integrations_sync(args, creds: dict) -> int:
    """Trigger a data sync for a connected integration.

    POSTs ``{"sync_type": ...}`` to trigger-sync. `<id>` resolves from a full
    id, id prefix, or integration type. Only Zendesk integrations support this
    today; the server returns the valid `sync_type` guidance otherwise.
    """
    sync_type = args.type
    if sync_type not in INTEGRATION_SYNC_TYPES:
        err(f"Invalid --type '{sync_type}'. Valid values: {', '.join(INTEGRATION_SYNC_TYPES)}.")
        return 1

    integration = resolve_integration(fetch_integrations(creds, agent_id=creds.get("agent_id")), args.id)
    if not integration:
        err(f"No connected integration matches '{args.id}'. Run `eesel integrations list`.")
        return 1
    integration_id = integration["id"]

    status, result = http_request_allow_error(
        "POST",
        f"{creds['api_url']}/integrations/{urllib.parse.quote(str(integration_id))}/trigger-sync",
        token=creds["token"],
        body={"sync_type": sync_type},
    )
    if status >= 400:
        err(f"Could not trigger sync: {result.get('error') or result.get('message') or json.dumps(result)}")
        return 1
    if result.get("skipped"):
        info(result.get("reason") or "A matching sync is already in progress.")
        return 0
    ok(result.get("message") or f"Triggered '{sync_type}' sync for {integration_id}.")
    return 0


def _sync_run_progress(run: dict) -> str:
    """One-line progress for a sync run. Shows a percentage when the run reports
    a total step count (clamped to 0–100, since the server can over-count
    completed steps), else the completed-step count, plus the server's status
    message when present."""
    progress = run.get("progress") or {}
    completed = progress.get("completed_steps")
    total = progress.get("total_steps")
    head = None
    if isinstance(total, int) and total > 0 and isinstance(completed, int):
        head = f"{max(0, min(100, round(100 * completed / total)))}%"
    elif isinstance(completed, int) and completed:
        head = f"{completed} steps"
    message = progress.get("message")
    parts = [p for p in (head, message) if p]
    return " — ".join(parts) if parts else "—"


def _integrations_sync_status(args, creds: dict) -> int:
    """Show sync-run status and progress, read from GET /v2/sync-runs.

    Bare `sync-status` lists every active or recent run in the workspace. With
    an `<id>` (a connected integration's id, id-prefix, or type), it filters to
    that integration's runs by matching ``metadata.integration_id``. Only
    active and last-24h, non-dismissed runs are returned, so an integration
    whose last sync is old legitimately shows nothing.
    """
    target_id = None
    if getattr(args, "id", None):
        integration = resolve_integration(fetch_integrations(creds, agent_id=creds.get("agent_id")), args.id)
        if not integration:
            err(f"No connected integration matches '{args.id}'. Run `eesel integrations list`.")
            return 1
        target_id = str(integration["id"])

    data = http_request("GET", f"{creds['api_url']}/v2/sync-runs", token=creds["token"])
    runs = data.get("jobs") if isinstance(data, dict) else (data if isinstance(data, list) else [])
    if target_id is not None:
        runs = [r for r in runs if str((r.get("metadata") or {}).get("integration_id")) == target_id]

    if getattr(args, "json", False):
        print(json.dumps(runs, indent=2))
        return 0
    if not runs:
        info("(no active or recent sync runs)")
        return 0

    fmt = " {:<10}  {:<22}  {}"
    info(fmt.format("status", "integration", "progress"))
    for r in runs:
        meta = r.get("metadata") or {}
        itype = (meta.get("integration_type") or "?")[:22]
        print(fmt.format((r.get("status") or "?")[:10], itype, _sync_run_progress(r)))
    return 0


def _integrations_remove(args, creds: dict) -> int:
    """Disconnect (remove) a connected integration via DELETE
    /integrations/{id}. Reached via `remove` or its alias `disconnect`.

    `<id>` resolves from a full id, id prefix, or integration type. Asks for
    confirmation unless `--force` is passed, since disconnecting removes the
    integration and its synced knowledge from the workspace.
    """
    integration = resolve_integration_strict(fetch_integrations(creds, agent_id=creds.get("agent_id")), args.id)
    if not integration:
        return 1
    integration_id = integration["id"]
    label = integration.get("integrationType") or integration_id
    identifier = integration.get("identifier")
    desc = f"{label}" + (f" ({identifier})" if identifier else "") + f" [{integration_id}]"
    if not getattr(args, "force", False):
        # Affirmative = y/yes (case-insensitive); bare Enter or EOF aborts.
        try:
            answer = input(f"Disconnect integration {desc}? This cannot be undone. [y/N] ").strip().lower()
        except EOFError:
            answer = ""
        if answer not in ("y", "yes"):
            info("Aborted.")
            return 1
    http_request(
        "DELETE",
        f"{creds['api_url']}/integrations/{urllib.parse.quote(str(integration_id))}",
        token=creds["token"],
    )
    ok(f"Disconnected integration {desc}.")
    return 0


def _resolve_actions_agent(creds: dict, target: str | None) -> dict | None:
    """Resolve the agent whose actions an `integrations ... actions` subcommand
    operates on, printing the error itself.

    Actions (formerly "tools") are configured per agent via /agents/{id}/tools,
    so even though the command path is scoped by integration, we still need to
    know which agent's action set to read or write. With an explicit `target`
    (id / id-prefix / name) it must match an agent; without one it falls back to
    the stored active agent. Returns the agent dict, or None after emitting an
    `err(...)` so the caller can `return 1`.
    """
    agents = fetch_agents(creds)
    if not agents:
        err("No agents in workspace. Create one in the dashboard first.")
        return None
    if target:
        # Actions subcommands include destructive writes (disable/edit), so an
        # ambiguous name is refused rather than resolved to an arbitrary match.
        agent, candidates = resolve_agent_strict(agents, target)
        if agent:
            return agent
        if candidates:
            err(f"'{target}' is ambiguous — it matches {len(candidates)} agents:")
            for a in candidates:
                err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
            err("Re-run with a full agent id to disambiguate.")
        else:
            err(f"No agent matches '{target}'.")
        return None
    agent = next((a for a in agents if a.get("agent_id") == creds.get("agent_id")), None)
    if not agent:
        err("No active agent. Run `eesel agents use` to pick one (or pass --agent).")
        return None
    return agent


def _action_matches_integration(row: dict, integration: str) -> bool:
    """Whether a flattened action row belongs to the named integration.

    `integration` is the positional from the command path (e.g. `zendesk`). It
    matches an action by its integration key (the integration type, e.g.
    `zendesk`) or by an exact / prefix match on its integration instance id, so
    both `eesel integrations zendesk actions` and a specific instance id work.
    """
    key = row.get("integration_key") or ""
    iid = row.get("integration_id") or ""
    return integration == key or integration == iid or (iid != "—" and iid.startswith(integration))


def _resolve_integration_id(creds: dict, agent_id: str, integration: str) -> str | None:
    """Resolve the integration positional to a connected instance id, or None.

    For write commands the server scopes a shared action to one connected
    instance via `integration_id`. The positional may already be that id, or it
    may be an integration type (e.g. `zendesk`) that we look up against the
    workspace's connected integrations. Returns None when nothing matches; the
    write still proceeds unscoped, which is correct for actions that aren't
    tied to a specific instance (e.g. built-in `ai_actions`).
    """
    integrations = fetch_integrations(creds, agent_id=agent_id)
    # Exact instance-id match first.
    for it in integrations:
        if it.get("id") and it.get("id") == integration:
            return it["id"]
    # Then by integration type, e.g. `zendesk` → its connected instance id.
    for it in integrations:
        if it.get("integrationType") == integration and it.get("id"):
            return it["id"]
    return None


def cmd_integration_actions(args) -> int:
    """`eesel integrations <integration> actions <list|show|enable|disable|edit>`.

    Actions are the tools an integration exposes to an agent. The integration
    positional scopes the command (per the namespace spec, the path carries the
    scope rather than a flag); `--agent` selects whose action set is read or
    written, since the backing endpoint is per agent. `enable`/`edit` both POST
    to /agents/{id}/tools/{tool_key} (the server creates the row on first
    write); `disable` DELETEs the row.
    """
    creds = require_creds()
    sub = getattr(args, "actions_cmd", None) or "list"
    if sub == "show":
        return _actions_show(args, creds)
    if sub == "enable":
        return _actions_enable(args, creds)
    if sub in ("set", "edit"):
        # `edit` is the prior name, kept as a hidden alias for `set`.
        return _actions_edit(args, creds)
    if sub == "disable":
        return _actions_disable(args, creds)
    return _actions_list(args, creds)


def _resolve_action_key(creds: dict, agent_id: str, integration: str, action: str) -> tuple[str | None, list[dict]]:
    """Map a user-supplied action reference to its canonical `tool_key`.

    Accepts the exact `tool_key`, the case-insensitive display name (e.g.
    "Search tickets" → `zendesk_search_tickets`), or a unique `tool_key`/name
    prefix — so the write verbs aren't limited to the key that only shows under
    `--json`. Returns ``(tool_key, scoped_tools)`` where `scoped_tools` is the
    agent's tools filtered to this integration; `tool_key` is None when nothing
    matches uniquely, so callers can report a clear error or fall back to the raw
    value (e.g. enabling a not-yet-configured action by its exact key)."""
    scoped = [t for t in fetch_tools(creds, agent_id) if _action_matches_integration(_tool_row(t), integration)]
    exact = next((t for t in scoped if t.get("tool_key") == action), None)
    if exact:
        return action, scoped
    lowered = action.lower()
    named = [t for t in scoped if (_tool_row(t)["name"] or "").lower() == lowered]
    if len(named) == 1:
        return named[0].get("tool_key"), scoped
    prefixed = [
        t for t in scoped
        if (t.get("tool_key") or "").startswith(action) or (_tool_row(t)["name"] or "").lower().startswith(lowered)
    ]
    if len(prefixed) == 1:
        return prefixed[0].get("tool_key"), scoped
    return None, scoped


def _actions_list(args, creds: dict) -> int:
    """List the integration's actions for an agent (read-only).

    Shows every action with its status as columns (read/write, permission
    mode), never only the enabled ones. Scoped to the integration on the
    command path. `--json` emits the raw payload (filtered to the integration).
    """
    agent = _resolve_actions_agent(creds, getattr(args, "agent", None))
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    integration = args.integration

    tools = fetch_tools(creds, agent_id)
    scoped = [t for t in tools if _action_matches_integration(_tool_row(t), integration)]
    if getattr(args, "json", False):
        print(json.dumps(scoped, indent=2))
        return 0
    if not scoped:
        info(f"(no '{integration}' actions configured for {agent.get('name', agent_id)})")
        return 0

    info(f"# {agent.get('name', '?')} ({agent_id[:12]}) / {integration} — {len(scoped)} action{'s' if len(scoped) != 1 else ''}")
    rows = sorted((_tool_row(t) for t in scoped), key=lambda r: r["name"].lower())
    # The `key` column is the value the show/enable/disable/set verbs accept, so
    # it must be visible here rather than only under --json. It is printed in full
    # (not truncated) so it can be copied.
    fmt = " {:<28}  {:<32}  {:<5}  {:<11}  {}"
    info(fmt.format("action", "key", "r/w", "permission", "integration_id"))
    for r in rows:
        print(fmt.format(r["name"][:28], r["tool_key"], r["action"], r["permission"][:11], r["integration_id"][:12]))
    return 0


def _actions_show(args, creds: dict) -> int:
    """Show one action's detail (read-only).

    Finds the action by its key within the integration scope and prints its
    fields. `--json` emits the raw entry. Errors if the action isn't found.
    """
    agent = _resolve_actions_agent(creds, getattr(args, "agent", None))
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    integration = args.integration

    tool_key, scoped = _resolve_action_key(creds, agent_id, integration, args.action)
    match = next((t for t in scoped if t.get("tool_key") == tool_key), None) if tool_key else None
    if match is None:
        err(f"No '{args.action}' action under '{integration}' for {agent.get('name', agent_id)}.")
        info("Run `eesel integrations <integration> actions list` to see action keys (or add --json).")
        return 1
    if getattr(args, "json", False):
        print(json.dumps(_redact_secrets(match), indent=2))
        return 0
    r = _tool_row(match)
    info(f"# {r['name']} ({r['tool_key']})")
    print(f"  integration:    {r['integration_key']}")
    print(f"  integration_id: {r['integration_id']}")
    print(f"  access:         {r['action']}")
    print(f"  permission:     {r['permission']}")
    print(f"  connected:      {r['connected']}")
    cfg = match.get("config")
    if isinstance(cfg, dict) and cfg:
        print(f"  config:         {json.dumps(_redact_secrets(cfg))}")
    return 0


def parse_tool_config(raw: str) -> dict:
    """Parse the `--config` JSON string into the dict the server stores.

    The value must be a JSON object (e.g. permission settings like
    `{"permission_mode": "ask"}`). Raises ValueError on malformed JSON or a
    non-object top level so the caller can surface a clear error.
    """
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as e:
        raise ValueError(f"--config is not valid JSON: {e}")
    if not isinstance(parsed, dict):
        raise ValueError("--config must be a JSON object, e.g. '{\"permission_mode\": \"ask\"}'")
    return parsed


def _configure_tool(creds: dict, agent_id: str, tool_key: str, config: dict, integration_id: str | None) -> dict:
    """POST /agents/{agent_id}/tools/{tool_key} with the {config} body.

    This single endpoint backs both `enable` (empty config) and `edit`
    (caller-supplied config): the server creates the tool row on first write,
    so writing config is what enables the action for the agent. `integration_id`
    scopes the write to one connected instance when the same action is shared
    by several (e.g. two Shopify stores); it's sent in the body when given.
    """
    body: dict = {"config": config}
    if integration_id:
        body["integration_id"] = integration_id
    url = f"{creds['api_url']}/agents/{agent_id}/tools/{urllib.parse.quote(tool_key, safe='')}"
    return http_request("POST", url, token=creds["token"], body=body)


def _actions_enable(args, creds: dict) -> int:
    """Enable an action for an agent by writing an empty config.

    Enabling and editing hit the same POST endpoint; enabling just sends no
    settings, leaving the action at its default permission mode. Use `edit` to
    also set settings (e.g. a human-in-the-loop permission mode). The
    integration on the path is resolved to a connected instance id to scope the
    write when several instances share the action.
    """
    agent = _resolve_actions_agent(creds, getattr(args, "agent", None))
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    # Accept a display name or prefix; fall back to the raw value so a not-yet-
    # configured action can still be enabled by its exact key.
    tool_key, _ = _resolve_action_key(creds, agent_id, args.integration, args.action)
    action_key = tool_key or args.action
    integration_id = _resolve_integration_id(creds, agent_id, args.integration)
    _configure_tool(creds, agent_id, action_key, {}, integration_id)
    ok(f"Enabled '{action_key}' ({args.integration}) for {agent.get('name', agent_id)}.")
    info("Set its permission/settings with `eesel integrations <integration> actions set`.")
    return 0


def _actions_edit(args, creds: dict) -> int:
    """Set an action's config (e.g. permission mode).

    `--config` writes the action's full config and replaces what's stored — the
    server keeps only the permission keys (`permission_mode` /
    `require_human_approval`) when they're absent, so pass every other setting
    you want to keep in the same call. (Unlike `skills set`, the tools endpoint
    has no partial-merge, so a one-field write drops the action's other settings.)
    The same POST also enables the action if it wasn't already, so editing a
    not-yet-enabled action turns it on with these settings in one step.
    """
    agent = _resolve_actions_agent(creds, getattr(args, "agent", None))
    if not agent:
        return 1
    try:
        config = parse_tool_config(args.config)
    except ValueError as e:
        err(str(e))
        return 1
    agent_id = agent["agent_id"]
    tool_key, _ = _resolve_action_key(creds, agent_id, args.integration, args.action)
    action_key = tool_key or args.action
    integration_id = _resolve_integration_id(creds, agent_id, args.integration)
    result = _configure_tool(creds, agent_id, action_key, config, integration_id)
    ok(f"Updated '{action_key}' ({args.integration}) for {agent.get('name', agent_id)}.")
    saved = result.get("config") if isinstance(result, dict) else None
    if saved is not None:
        info(f"  config: {json.dumps(_redact_secrets(saved))}")
    return 0


def _actions_disable(args, creds: dict) -> int:
    """Disable an action for an agent by deleting its tool row.

    DELETE /agents/{agent_id}/tools/{tool_key} removes the agent's configuration
    for the action. The integration on the path, when it resolves to a connected
    instance, scopes the delete to that instance (passed as a query param,
    mirroring the server). Gated behind a confirmation prompt unless `--force`
    is passed.
    """
    agent = _resolve_actions_agent(creds, getattr(args, "agent", None))
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    # Confirm before any network call so a declined prompt stays fully read-free.
    if not args.force and not confirm(
        f"Disable '{args.action}' ({args.integration}) for {agent.get('name', agent_id)}? [y/N] "
    ):
        info("Aborted.")
        return 1
    # Accept a display name or prefix; fall back to the raw value (e.g. an exact
    # key for a row that isn't listed).
    tool_key, _ = _resolve_action_key(creds, agent_id, args.integration, args.action)
    action_key = tool_key or args.action
    integration_id = _resolve_integration_id(creds, agent_id, args.integration)
    url = f"{creds['api_url']}/agents/{agent_id}/tools/{urllib.parse.quote(action_key, safe='')}"
    if integration_id:
        url += f"?{urllib.parse.urlencode({'integration_id': integration_id})}"
    http_request("DELETE", url, token=creds["token"])
    ok(f"Disabled '{action_key}' ({args.integration}) for {agent.get('name', agent_id)}.")
    return 0


def cmd_impersonate(args) -> int:
    """`eesel impersonate <user_id>` and `eesel impersonate clear`.

    Sets (or clears) a sticky impersonation target on the server. From the
    moment you set a target, every subsequent `eesel` command behaves as if
    that user were calling — auth, workspace context, agents, integrations.
    Calls the dashboard sysadmin endpoints (`/sysadmin/set-impersonator-target`
    and `/sysadmin/clear-impersonator-target`), reachable now that the CLI
    authenticates with an Auth0 token.

    Combine with `eesel chat --trigger heartbeat` to preview a target's
    heartbeat, or just `eesel chat` to run a general chat as them. WRITE
    tools (email send, helpdesk reply, Slack post, etc.) are stubbed
    server-side so previewing can't accidentally fire real-world actions.

    Sticks for ~1 hour, or until you `eesel impersonate clear`. Always
    visible in `eesel whoami`.
    """
    creds = require_creds()
    target = args.user_id

    if not target:
        err("Usage: eesel impersonate <user_id>   or   eesel impersonate clear")
        return 1

    if target == "clear":
        url = f"{creds['api_url']}/sysadmin/clear-impersonator-target"
        try:
            http_request("GET", url, token=creds["token"])
        except urllib.error.HTTPError as e:
            try:
                payload = json.loads(e.read().decode("utf-8") or "{}")
            except Exception:
                payload = {}
            err(f"{url} → {e.code}: {payload.get('error') or e.reason}")
            return 1
        ok("Impersonation cleared.")
        return 0

    # GET-with-side-effect, matching the /sysadmin/* convention. The target
    # user id goes in the `target` query param.
    url = f"{creds['api_url']}/sysadmin/set-impersonator-target?{urllib.parse.urlencode({'target': target})}"
    try:
        resp = http_request("GET", url, token=creds["token"])
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read().decode("utf-8") or "{}")
        except Exception:
            payload = {}
        err(f"{url} → {e.code}: {payload.get('error') or e.reason}")
        if e.code in (401, 403):
            info("This command requires a sysadmin/impersonator account. Your current login isn't on the allowlist.")
        return 1

    ok(f"Impersonating: {resp.get('target') or target}")
    info("All subsequent `eesel` commands run as this user.")
    info("Run `eesel whoami` to confirm. Clear with `eesel impersonate clear`.")
    return 0


def _print_cost_after_turn(creds: dict, sess: dict, prev_runs: int) -> None:
    """Poll briefly for fresh cost data, then print a one-line summary.

    The sandbox posts usage metrics back to the server *after* each LLM call
    finishes, so right when the SSE stream ends, the new metric rows haven't
    landed yet. We wait until either (a) the run count grew vs. before this
    turn, or (b) we hit the deadline.
    """
    deadline = time.time() + 4.0
    last = None
    while time.time() < deadline:
        d = fetch_session_cost(creds, sess)
        if d is None:
            print(_color("[cost: unavailable in prod — check /activity in dashboard]", "2;37"), file=sys.stderr)
            return
        last = d
        if d["total_runs"] > prev_runs:
            break
        time.sleep(0.4)
    if last is None:
        return
    print(_color(format_cost_oneline(last), "2;37"), file=sys.stderr)


def _current_run_count(creds: dict, sess: dict) -> int:
    d = fetch_session_cost(creds, sess)
    return d["total_runs"] if d else 0


def cmd_chat(args) -> int:
    creds = require_creds()
    # `--agent` scopes this one chat to a specific agent (id, id-prefix, or
    # name), like the EESEL_AGENT env var but per-command. It is resolved in
    # memory and not persisted, so it never changes the saved active agent.
    if getattr(args, "agent", None):
        match = resolve_agent(fetch_agents(creds), args.agent)
        if not match:
            err(f"No agent matches '{args.agent}'.")
            info("Run `eesel agents list` to see available agents.")
            return 1
        creds = dict(creds)
        creds["agent_id"] = match["agent_id"]
    pick_agent(creds, prompt=False)  # only prompt in REPL if needed

    # --trigger always opens a fresh session pinned to that trigger. Reusing an
    # active session whose trigger doesn't match would mean half its turns ran
    # under one trigger context and half under another — not useful for
    # iteration.
    task_target = getattr(args, "task", None)
    target = getattr(args, "schedule", None)
    if task_target and target:
        err("--task and --trigger are mutually exclusive.")
        return 1
    if task_target:
        # Attach to an existing backend conversation by its task id — e.g. one
        # an agent handed to an external service so it can post a result back
        # into the same conversation. Resolve an id-prefix to a full task id
        # first (like `tasks show`/`tasks cost`); binding to a truncated id would
        # create a junk session and fail the stream with an empty error. A full
        # uuid is used as-is, so a task that isn't in the recent list still works.
        task_id = resolve_task_id(creds, task_target)
        if not task_id:
            return 1
        # Reuse the local session bound to that task if we have one (keeps local
        # history accumulating), otherwise create a fresh session pinned to it.
        # The backend resumes the conversation from its own task state either way.
        sess = find_session_by_task(task_id)
        if sess:
            set_current(sess["id"])
        else:
            sess = new_session(
                creds,
                agent_id=creds.get("agent_id"),
                name=f"task-{task_id[:8]}",
                switch_to=True,
                task_id=task_id,
            )
        info(f"session {sess['id']} bound to task {task_id}")
    elif target:
        match = resolve_scheduled_job(creds, target)
        if not match:
            err(f"No scheduled job matches '{target}'.")
            info("Run `eesel schedules list` to see available jobs.")
            return 1
        # Pin the agent for this preview session only — resolve it in memory and
        # never rewrite the saved active agent, mirroring --agent. The session
        # itself stores agent_id (below), so the preview runs under the trigger's
        # agent without leaking that choice into later unrelated commands.
        creds = dict(creds)
        creds["agent_id"] = match["agent_id"]
        sess = new_session(
            creds,
            agent_id=creds["agent_id"],
            name=None,
            switch_to=True,
            trigger_id=match["id"],
            trigger_title=(match.get("config") or {}).get("title"),
        )
        info(f"Preview session bound to trigger '{sess.get('trigger_title')}' ({sess['trigger_id'][:12]}, agent={match['agent_name']})")
    else:
        sess = ensure_current_session(creds, agent_id=creds.get("agent_id"))
    show_cost = bool(getattr(args, "cost", False))

    if args.message:
        prev_runs = _current_run_count(creds, sess) if show_cost else 0
        send_message(creds, sess, args.message)
        if show_cost:
            _print_cost_after_turn(creds, sess, prev_runs)
        return 0

    # REPL mode
    badge = f" [trigger: {sess.get('trigger_title')}]" if sess.get("trigger_id") else ""
    info(f"session {sess['id']} ({sess.get('name')}) — agent {sess.get('agent_id', '?')[:8]}{badge}")
    if show_cost:
        info("cost-on: a one-line cost summary will print after each reply.")
    info("Type your message. Empty line submits. Ctrl-C to quit. /help for commands.")
    try:
        import readline  # noqa: F401  — enables line editing
    except ImportError:
        pass

    while True:
        try:
            print(_color("\nyou ", "33") + "→ ", end="", flush=True)
            line = input()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        line = line.strip()
        if not line:
            continue
        if line.startswith("/"):
            if line in ("/quit", "/exit", "/q"):
                return 0
            if line == "/help":
                print("  /new        start a new session")
                print("  /sessions   list sessions")
                print("  /agents     list agents")
                print("  /show       print this session's history")
                print("  /tasks      list recent workspace tasks (all channels)")
                print("  /task <id>  print one task's transcript")
                print("  /cost       print cost summary for this session")
                print("  /cost-on    auto-print cost after each reply")
                print("  /cost-off   stop auto-printing cost")
                print("  /quit       exit")
                continue
            if line == "/new":
                sess = new_session(creds, agent_id=creds.get("agent_id"), name=None, switch_to=True)
                info(f"new session: {sess['id']}")
                continue
            if line == "/sessions":
                cmd_sessions(argparse.Namespace(sessions_cmd="list", session_id=None))
                continue
            if line == "/agents":
                cmd_agents(argparse.Namespace(agents_cmd="list", agent_id=None))
                continue
            if line == "/show":
                cmd_sessions(argparse.Namespace(sessions_cmd="show", session_id=sess["id"]))
                continue
            if line == "/tasks":
                cmd_tasks(argparse.Namespace(tasks_cmd="list", limit=50, page=1, agent=None))
                continue
            if line.startswith("/task "):
                cmd_tasks(argparse.Namespace(tasks_cmd="show", task_id=line[len("/task "):].strip(), json=False, full=False, cost=False))
                continue
            if line == "/cost":
                d = fetch_session_cost(creds, sess)
                if d is None:
                    info("cost data is dev-only right now — see /activity in the dashboard for prod")
                else:
                    print(format_cost_full(d, sess))
                continue
            if line == "/cost-on":
                show_cost = True
                info("cost-on")
                continue
            if line == "/cost-off":
                show_cost = False
                info("cost-off")
                continue
            warn(f"unknown command: {line}")
            continue
        prev_runs = _current_run_count(creds, sess) if show_cost else 0
        send_message(creds, sess, line)
        if show_cost:
            _print_cost_after_turn(creds, sess, prev_runs)


def cmd_cost(args) -> int:
    creds = require_creds()
    sid = args.session_id or load_current()
    if not sid:
        err("No active session. Run `eesel new` or `eesel sessions use <id>` first.")
        return 1
    sess = load_session(sid)
    if not sess:
        # try prefix match
        match = next((s for s in list_sessions() if s["id"].startswith(sid)), None)
        if not match:
            err(f"No session matches '{sid}'.")
            return 1
        sess = match
    d = fetch_session_cost(creds, sess)
    if d is None:
        info("cost data is dev-only right now — see /activity in the dashboard for prod")
        return 0
    print(format_cost_full(d, sess))
    return 0


# ──────────────────────────────────────────────────────────────────────────
# Tasks — workspace-wide agent activity (read-only)
#
# A "task" is any conversation/run the workspace's agents have done: dashboard
# chats, the website widget, helpdesk ticket replies, scheduled-trigger runs,
# and sub-agent spawns. This is the same data the dashboard's Activity view
# shows — distinct from CLI "sessions", which are just local handles you
# created. Backed by the workspace-JWT endpoints POST /workspace/tasks and
# GET /workspace/tasks/{id}/history, which decode the bearer with HS256 only —
# so an Auth0 login routes through `workspace_token()` to send a minted
# workspace token rather than its RS256 access token. (Staff preview/
# impersonation tasks are filtered out server-side, so they never appear here.)
# ──────────────────────────────────────────────────────────────────────────


def fetch_tasks(creds: dict, *, limit: int = 50, page: int = 1, agent_id: str | None = None) -> tuple[list[dict], bool, int | None]:
    """List workspace tasks, most-recently-updated first.

    With the backend's default ``status`` grouping every task lands in a single
    "Done" bucket, so page/limit page cleanly through the global recent list
    (no weird per-group paging). Returns ``(rows, has_next_page, next_page)``.
    """
    filters: dict = {}
    if agent_id:
        filters["agent"] = [agent_id]  # server expects a list (TaskFilter.AGENT)
    body = {
        "page": page,
        "limit": limit,
        "filters": filters,
        "grouping": "status",
        "sorting": "updatedDate",
        "sort_order": 1,  # descending — most recently updated first
    }
    data = http_request("POST", f"{creds['api_url']}/workspace/tasks", token=workspace_token(creds), body=body)
    rows = data.get("tasks") or []
    # Server already sorts, but belt-and-braces in case grouping reorders.
    rows.sort(key=lambda r: r.get("updated_at") or "", reverse=True)
    return rows, bool(data.get("hasNextPage")), data.get("nextPage")


def count_tasks(creds: dict, *, agent_id: str | None = None) -> int:
    """Total task count for the workspace (or one agent).

    Reads ``totalCount`` from the list response, so it's accurate across all
    pages — unlike counting the rows on a single page.
    """
    filters: dict = {}
    if agent_id:
        filters["agent"] = [agent_id]
    body = {"page": 1, "limit": 1, "filters": filters, "grouping": "status"}
    data = http_request("POST", f"{creds['api_url']}/workspace/tasks", token=workspace_token(creds), body=body)
    return int(data.get("totalCount") or 0)


def fetch_task_analytics(
    creds: dict, *, start_date: str | None = None, end_date: str | None = None, agent_id: str | None = None
) -> dict:
    """Aggregate analytics for the workspace's tasks over an optional date range.

    Returns the raw analytics payload: total_tasks, resolution_counts
    (resolved / escalated / pending), csat_distribution, tasks_by_agent,
    tasks_by_channel, and time-series breakdowns. ``start_date`` / ``end_date``
    are ISO date strings (``YYYY-MM-DD``); omitting both yields all-time totals.
    ``agent_id`` scopes the numbers to a single agent.

    Uses the workspace-authenticated endpoint, which takes the same auth as the
    rest of the tasks commands.
    """
    body: dict = {}
    if start_date:
        body["start_date"] = start_date
    if end_date:
        body["end_date"] = end_date
    if agent_id:
        body["agent_ids"] = [agent_id]
    return http_request("POST", f"{creds['api_url']}/workspace/tasks/analytics", token=workspace_token(creds), body=body)


def export_tasks(
    creds: dict, *, start_date: str | None = None, end_date: str | None = None, agent_id: str | None = None
) -> dict:
    """Kick off a server-side CSV export of tasks; the link is emailed when ready.

    The date range and agent filter are passed as query parameters (the server
    reads them from the query string, not the JSON body). Returns the server's
    response (``{"message": "Export started"}`` with a 202 status). The export
    runs in the background on the server and emails a download link to the
    workspace owner, so there is no inline file to return.
    """
    params: dict = {}
    if start_date:
        params["start_date"] = start_date
    if end_date:
        params["end_date"] = end_date
    if agent_id:
        params["agent_id"] = agent_id
    qs = f"?{urllib.parse.urlencode(params)}" if params else ""
    return http_request("POST", f"{creds['api_url']}/tasks/export{qs}", token=creds["token"], body={"filters": {}})


def fetch_task_history(creds: dict, task_id: str) -> list[dict]:
    """Return one task's history as a list of runs: ``[{run_id, items:[...]}]``."""
    data = http_request("GET", f"{creds['api_url']}/workspace/tasks/{task_id}/history", token=workspace_token(creds))
    return data.get("runs") or []


def resolve_agent_filter(creds: dict, target: str) -> str | None:
    """Resolve an ``--agent`` value (full id, id-prefix, or name) to an agent_id."""
    agents = fetch_agents(creds)
    match = next((a for a in agents if a.get("agent_id") == target), None)
    if not match:
        match = next((a for a in agents if (a.get("agent_id") or "").startswith(target)), None)
    if not match:
        match = next((a for a in agents if a.get("name") == target), None)
    if not match:
        err(f"No agent matches '{target}'. Run `eesel agents list`.")
        return None
    return match["agent_id"]


def resolve_task_id(creds: dict, target: str) -> str | None:
    """Full uuid → use as-is; otherwise prefix-match against recent tasks."""
    if _looks_like_uuid(target):
        return target
    rows, _, _ = fetch_tasks(creds, limit=500)
    matches = [r for r in rows if (r.get("task_id") or "").startswith(target)]
    if len(matches) == 1:
        return matches[0].get("task_id")
    if len(matches) > 1:
        labels = ", ".join((r.get("task_id") or "?")[:12] for r in matches[:5])
        err(f"Task id prefix '{target}' is ambiguous: {labels}")
        return None
    err(f"No task matches '{target}' in the {len(rows)} most recent tasks. Pass a full task id.")
    return None


def find_task_row(creds: dict, task_id: str) -> dict | None:
    """Best-effort lookup of a task's metadata row for the `show` header."""
    try:
        rows, _, _ = fetch_tasks(creds, limit=200)
    except SystemExit:
        return None
    return next((r for r in rows if r.get("task_id") == task_id), None)


def _task_source(row: dict) -> str:
    """Human label for where a task came from, derived from trigger_context."""
    ctx = row.get("trigger_context") or {}
    return ctx.get("channel") or ctx.get("trigger_type") or ctx.get("source") or "chat"


def _task_label(row: dict) -> str:
    name = row.get("name") or row.get("external_reference") or "(untitled)"
    return name if len(name) <= 48 else name[:47] + "…"


def _fmt_task_ts(iso: str | None) -> str:
    if not iso:
        return "?"
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).strftime("%Y-%m-%d %H:%M")
    except (ValueError, AttributeError):
        return str(iso)[:16]


def render_task_runs(runs: list[dict], *, full: bool = False) -> None:
    """Print a task's transcript run-by-run, one line per history item type."""
    if not runs:
        info("(no history)")
        return
    multi = len(runs) > 1
    for i, run in enumerate(runs, 1):
        if multi:
            print(_color(f"\n── run {i}/{len(runs)} ──", "2;37"))
        for item in run.get("items", []):
            render_history_item(item, full=full)


def render_history_item(item: dict, *, full: bool = False) -> None:
    typ = item.get("type")
    if typ in ("message", "event"):
        who = _color("you", "33") if item.get("role") == "user" else _color("eesel", "36")
        print(f"\n{who}:")
        print(item.get("content") or "")
    elif typ == "thinking":
        print(_color(f"\n[thinking] {item.get('content') or ''}", "2;37"))
    elif typ == "tool_call":
        args_s = json.dumps(item.get("tool_arguments") or {})
        if not full:
            args_s = args_s[:200]
        print(_color(f"\n[tool] {item.get('name') or '?'} {args_s}", "2;37"))
    elif typ in ("tool_result", "tool_error"):
        out = item.get("tool_output")
        if out is None:
            preview = item.get("content") or ""
        elif isinstance(out, str):
            preview = out
        else:
            preview = json.dumps(out)
        if not full:
            preview = preview[:200]
        tag = "[tool error]" if typ == "tool_error" else "[tool]"
        print(_color(f"{tag} → {preview}", "2;37"))
    else:
        # Unknown type — print minimally so nothing is silently dropped.
        if item.get("content"):
            print(_color(f"[{typ}] {item['content']}", "2;37"))


def _print_task_cost(creds: dict, task_id: str, name: str | None = None, *, as_json: bool = False) -> None:
    # fetch_session_cost only needs a dict carrying `task_id` (+ id/name for the
    # header), so a synthetic session-like dict lets us reuse the exact same
    # cost path — including the recursive sub-agent task-tree breakdown.
    synthetic = {"id": task_id[:12], "name": name, "task_id": task_id}
    d = fetch_session_cost(creds, synthetic)
    if d is None:
        if as_json:
            print(json.dumps({"task_id": task_id, "cost": None}, indent=2))
        else:
            info("cost data is dev-only right now — see /activity in the dashboard for prod")
        return
    if as_json:
        print(json.dumps(d, indent=2))
        return
    print(format_cost_full(d, synthetic, label="task"))


def render_task_analytics(data: dict) -> None:
    """Print a human summary of the analytics payload: totals, resolution rate,
    CSAT, and the per-agent / per-channel breakdowns."""
    total = int(data.get("total_tasks") or 0)
    print(f"total tasks: {total}")
    if total == 0:
        info("(no tasks in range)")
        return

    res = data.get("resolution_counts") or {}
    resolved = int(res.get("resolved") or 0)
    escalated = int(res.get("escalated") or 0)
    pending = int(res.get("pending") or 0)
    decided = resolved + escalated  # tasks with a known outcome
    if decided:
        rate = 100.0 * resolved / decided
        print(f"resolution rate: {rate:.1f}%  (resolved {resolved} / escalated {escalated} / pending {pending})")
    else:
        print(f"resolution: resolved {resolved} / escalated {escalated} / pending {pending}")

    csat = data.get("csat_distribution") or {}
    if any(csat.values()):
        parts = ", ".join(f"{k} {v}" for k, v in csat.items())
        print(f"csat: {parts}")

    by_agent = data.get("tasks_by_agent") or {}
    if by_agent:
        print("by agent:")
        for entry in sorted(by_agent.values(), key=lambda e: e.get("count") or 0, reverse=True):
            print(f"  {entry.get('count') or 0:>6}  {entry.get('name') or '?'}")

    by_channel = data.get("tasks_by_channel") or {}
    if by_channel:
        print("by channel:")
        for name, count in sorted(by_channel.items(), key=lambda kv: kv[1] or 0, reverse=True):
            print(f"  {count or 0:>6}  {name}")


def cmd_tasks(args) -> int:
    creds = require_creds()
    sub = getattr(args, "tasks_cmd", None) or "list"

    if sub == "analytics":
        agent_id = None
        if getattr(args, "agent", None):
            agent_id = resolve_agent_filter(creds, args.agent)
            if not agent_id:
                return 1
        data = fetch_task_analytics(
            creds,
            start_date=getattr(args, "start_date", None),
            end_date=getattr(args, "end_date", None),
            agent_id=agent_id,
        )
        if getattr(args, "json", False):
            print(json.dumps(data, indent=2))
            return 0
        render_task_analytics(data)
        return 0

    if sub == "export":
        agent_id = None
        if getattr(args, "agent", None):
            agent_id = resolve_agent_filter(creds, args.agent)
            if not agent_id:
                return 1
        data = export_tasks(
            creds,
            start_date=getattr(args, "start_date", None),
            end_date=getattr(args, "end_date", None),
            agent_id=agent_id,
        )
        ok(data.get("message") or "Export started")
        # The server builds the CSV in the background and emails a download link
        # to the workspace owner — there is no inline file or URL to print here.
        for key in ("url", "download_url", "reference", "job_id"):
            if data.get(key):
                print(f"{key}: {data[key]}")
        info("A download link will be emailed to the workspace owner when the export is ready.")
        return 0

    if sub == "count":
        agent_id = None
        if getattr(args, "agent", None):
            agent_id = resolve_agent_filter(creds, args.agent)
            if not agent_id:
                return 1
        n = count_tasks(creds, agent_id=agent_id)
        if getattr(args, "json", False):
            print(json.dumps({"count": n, "agent_id": agent_id}, indent=2))
            return 0
        suffix = " for this agent" if agent_id else ""
        print(f"{n} task{'s' if n != 1 else ''}{suffix}")
        return 0

    if sub == "list":
        agent_id = None
        if getattr(args, "agent", None):
            agent_id = resolve_agent_filter(creds, args.agent)
            if not agent_id:
                return 1
        rows, has_next, next_page = fetch_tasks(creds, limit=args.limit, page=args.page, agent_id=agent_id)
        if getattr(args, "json", False):
            print(json.dumps({"tasks": rows, "has_next": has_next, "next_page": next_page}, indent=2))
            return 0
        if getattr(args, "plain", False):
            for r in rows:
                agent = r.get("agent_name") or r.get("agent_id") or ""
                print(
                    f"{str(r.get('task_id') or '')}\t{str(_fmt_task_ts(r.get('updated_at')) or '')}\t"
                    f"{str(agent or '')}\t{str(_task_source(r) or '')}\t{str(_task_label(r) or '')}"
                )
            return 0
        if not rows:
            info("(no tasks)")
            return 0
        local_task_ids = {s.get("task_id") for s in list_sessions()}
        for r in rows:
            tid = r.get("task_id") or "?"
            mark = "*" if tid in local_task_ids else " "
            agent = r.get("agent_name") or r.get("agent_id") or "?"
            print(f" {mark} {tid[:12]}  {_fmt_task_ts(r.get('updated_at'))}  {agent[:18]:<18}  {_task_source(r):<10}  {_task_label(r)}")
        if has_next:
            info(f"more: eesel tasks list --page {next_page or args.page + 1}")
        return 0

    if sub == "show":
        task_id = resolve_task_id(creds, args.task_id)
        if not task_id:
            return 1
        runs = fetch_task_history(creds, task_id)
        if getattr(args, "json", False):
            print(json.dumps({"task_id": task_id, "runs": runs}, indent=2))
            return 0
        row = find_task_row(creds, task_id)
        print(f"# task {task_id}")
        if row:
            agent = row.get("agent_name") or row.get("agent_id") or "?"
            print(f"# agent={agent}  source={_task_source(row)}  updated={_fmt_task_ts(row.get('updated_at'))}")
            if row.get("name"):
                print(f"# {row['name']}")
        render_task_runs(runs, full=getattr(args, "full", False))
        if getattr(args, "cost", False):
            print()
            _print_task_cost(creds, task_id, name=row.get("name") if row else None)
        return 0

    if sub == "cost":
        task_id = resolve_task_id(creds, args.task_id)
        if not task_id:
            return 1
        row = find_task_row(creds, task_id)
        _print_task_cost(creds, task_id, name=row.get("name") if row else None, as_json=getattr(args, "json", False))
        return 0

    err(f"Unknown tasks subcommand: {sub!r}. Try one of: list, show, count, cost, analytics, export.")
    return 1


def fetch_documents(creds: dict, *, prefix: str | None = None, search: str | None = None, limit: int = 100, offset: int = 0) -> list[dict]:
    params = {
        "limit": str(limit),
        "offset": str(offset),
    }
    if prefix:
        params["prefix"] = prefix
    if search:
        params["search"] = search
    url = f"{creds['api_url']}/documents?{urllib.parse.urlencode(params)}"
    data = http_request("GET", url, token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("documents") or data.get("items") or data.get("data") or []


def agent_document_prefix(creds: dict) -> str:
    return f"outputs/skills/{creds['agent_id']}"


def agent_document_prefixes(creds: dict) -> list[str]:
    return [f"files/{creds['agent_id']}", f"outputs/skills/{creds['agent_id']}"]


def document_key_agent_id(key: str) -> str | None:
    parts = (key or "").split("/")
    if len(parts) >= 2 and parts[0] == "files":
        return parts[1]
    if len(parts) >= 3 and parts[0] == "outputs" and parts[1] == "skills":
        return parts[2]
    return None


def document_matches_agent(creds: dict, document: dict) -> bool:
    key = document.get("key") or document.get("document_key") or ""
    return document_key_agent_id(key) == creds["agent_id"]


def _document_key_for_workspace(document_key: str, workspace_id: str) -> str | None:
    key = document_key.strip().lstrip("/")
    parts = key.split("/", 1)
    if parts and _looks_like_uuid(parts[0]):
        if parts[0] != workspace_id:
            return None
        return parts[1] if len(parts) > 1 else ""
    return key


def _looks_like_uuid(value: str) -> bool:
    try:
        uuid.UUID(value)
    except ValueError:
        return False
    return True


def resolve_document_id(creds: dict, target: str) -> str | None:
    if not (target or "").strip():
        err("No document given.")
        return None
    documents = [doc for doc in fetch_documents(creds, limit=500) if document_matches_agent(creds, doc)]
    exact = next((doc for doc in documents if doc.get("id") == target), None)
    if exact:
        return exact.get("id")
    matches = [doc for doc in documents if (doc.get("id") or "").startswith(target)]
    if len(matches) == 1:
        return matches[0].get("id")
    if len(matches) > 1:
        labels = ", ".join((doc.get("id") or "?")[:12] for doc in matches[:5])
        err(f"Document id prefix '{target}' is ambiguous: {labels}")
        return None
    err(f"No document id matches '{target}' in workspace {creds['workspace_id']}.")
    return None


def _document_key(doc: dict) -> str:
    return doc.get("key") or doc.get("document_key") or ""


def agent_documents(creds: dict, *, prefix: str | None = None, limit: int = 500) -> list[dict]:
    """Documents the active agent owns (files/{agent}, outputs/skills/{agent}),
    optionally narrowed to a key prefix. Shared by `document read`'s direct
    lookup and its interactive menu."""
    docs = fetch_documents(creds, prefix=prefix, limit=limit)
    return [doc for doc in docs if document_matches_agent(creds, doc)]


def match_document(docs: list[dict], target: str) -> dict | list[dict] | None:
    """Resolve `target` against a candidate list. Returns the matching doc, or a
    list of >1 candidates when an id-prefix/filename is ambiguous, or None.

    Resolution order: exact id, exact key, then id-prefix or basename (filename)
    match. A blank/whitespace target matches nothing (an empty string would
    otherwise prefix every id).
    """
    if not (target or "").strip():
        return None
    exact = next((d for d in docs if d.get("id") == target), None) or next(
        (d for d in docs if _document_key(d) == target), None
    )
    if exact:
        return exact
    fuzzy = [
        d
        for d in docs
        if (d.get("id") or "").startswith(target) or _document_key(d).rsplit("/", 1)[-1] == target
    ]
    if len(fuzzy) == 1:
        return fuzzy[0]
    return fuzzy or None


def _mcp_metadata_header(metadata: dict) -> str:
    payload = json.dumps(metadata, separators=(",", ":")).encode()
    return base64.b64encode(payload).decode()


def mcp_call_tool(creds: dict, tool_name: str, arguments: dict) -> dict:
    body = {
        "jsonrpc": "2.0",
        "id": "eesel-cli",
        "method": "tools/call",
        "params": {
            "name": tool_name,
            "arguments": arguments,
        },
    }
    data = http_request(
        "POST",
        f"{creds['api_url']}/mcp",
        token=creds["token"],
        body=body,
        headers={
            "X-Eesel-Agent-Id": creds["agent_id"],
            "X-Eesel-Metadata": _mcp_metadata_header({"available_tools_override": [tool_name]}),
        },
    )
    if data.get("error"):
        message = data["error"].get("message") or data["error"]
        raise RuntimeError(str(message))
    structured = (data.get("result") or {}).get("structuredContent") or {}
    if structured.get("type") == "error" or structured.get("isError"):
        raise RuntimeError(structured.get("text") or "Tool returned an error")
    payload = structured.get("data")
    if isinstance(payload, dict):
        return payload
    raise RuntimeError("Tool returned an invalid response")


def mint_workspace_token(creds: dict, agent_id: str | None = None) -> str:
    """Mint a 30-day workspace token (HS256) for the MCP endpoint.

    The CLI's primary credential is an Auth0 access token, but `/mcp` only
    accepts a workspace token. POST /workspaces/token exchanges the Auth0
    Bearer for one; `client:"cli"` opts into the 30-day TTL. Returns the token
    string, or exits with the server's error.
    """
    body: dict = {"client": "cli"}
    if agent_id:
        body["agent_id"] = agent_id
    data = http_request(
        "POST", f"{creds['api_url']}/workspaces/token", token=creds["token"], body=body
    )
    token = data.get("token")
    if not token:
        sys.exit("Mint failed: /workspaces/token returned no token.")
    return token


def workspace_token(creds: dict) -> str:
    """Return a token accepted by the legacy HS256 workspace-token endpoints.

    A handful of routes predate the Auth0 migration and still decode the bearer
    with HS256 only — `/workspace/tasks`, `/workspace/tasks/analytics`,
    `/workspace/tasks/{id}/history`, and `/agents/sandbox/start` (chat). An Auth0
    login holds an RS256 access token these routes reject, so exchange it for an
    HS256 workspace token. Workspace-token and dev logins already hold a token
    these routes accept, so use it directly.

    The minted token is cached on `creds` for the life of the process so a
    multi-turn chat or a tasks command doesn't re-mint on every request.
    """
    if not creds.get("refresh_token"):
        return creds["token"]
    cached = creds.get("_workspace_token")
    if not cached:
        cached = mint_workspace_token(creds, creds.get("agent_id"))
        creds["_workspace_token"] = cached
    return cached


def _document_record(creds: dict, *, document_id: str | None = None, document_key: str | None = None) -> dict | None:
    """Look up a single document dict (id, key, name) the CLI agent owns."""
    if document_key:
        for doc in fetch_documents(creds, prefix=document_key, limit=500):
            if (doc.get("key") or doc.get("document_key")) == document_key and document_matches_agent(creds, doc):
                return doc
        return None
    candidates = (doc for doc in fetch_documents(creds, limit=500) if document_matches_agent(creds, doc))
    return next((doc for doc in candidates if doc.get("id") == document_id), None)


def doc_export_signed_url(creds: dict, *, document_id: str, document_key: str | None, fmt: str) -> tuple[str, str]:
    """Mint a fresh signed download URL for a document via the Bearer-authed
    ``/documents/{id}/export-link`` endpoint.

    The dashboard hands the chat model short app links
    (``/platform/{agent}/files/{id}?download={fmt}``) and resolves them to a real
    download at click time through this same endpoint, which signs a short-lived
    token server-side. The CLI's workspace JWT can't open the cookie-gated
    dashboard app route, but it can call export-link directly. Going through the
    server export (rather than reading raw document content) is also what gives
    blog posts their frontmatter — cover image, FAQs, SEO block, slug, tags live
    in document properties and are prepended only by the server export path.
    """
    params = urllib.parse.urlencode({"format": fmt})
    data = http_request(
        "GET",
        f"{creds['api_url']}/documents/{document_id}/export-link?{params}",
        token=creds["token"],
    )
    url = data.get("url")
    if not url:
        raise RuntimeError(f"Export format '{fmt}' is not available for this document.")
    stem = Path((document_key or document_id).rstrip("/").rsplit("/", 1)[-1]).stem or document_id
    return f"{stem}.{fmt}", url


# ──────────────────────────────────────────────────────────────────────────
# MCP servers — external MCP server registrations on the workspace
#
# These are third-party MCP servers (e.g. a company's own tool server) that the
# workspace's agents load at runtime for extra tools. Distinct from `eesel`'s
# own MCP endpoint that external clients connect *to*.
#   GET    /workspaces/{ws}/mcp-servers              (list / show)
#   POST   /workspaces/{ws}/mcp-servers              (add)
#   PUT    /workspaces/{ws}/mcp-servers/{id}         (edit)
#   POST   /workspaces/{ws}/mcp-servers/{id}/toggle  (enable/disable) body {"is_active": bool}
#   DELETE /workspaces/{ws}/mcp-servers/{id}         (remove)
# The server stores the URL under `base_url` on the wire; the CLI exposes it as
# the friendlier `--url`.
# ──────────────────────────────────────────────────────────────────────────


def fetch_mcp_servers(creds: dict, *, include_inactive: bool = True) -> list[dict]:
    """List the MCP servers registered on the workspace.

    The server returns inactive servers only when asked, so the default here
    requests them too — the CLI prints an active/inactive column and would
    otherwise hide disabled ones. Each row carries id, name, base_url,
    auth_type, has_auth_token, is_active.
    """
    params = {"include_inactive": "true"} if include_inactive else {}
    qs = f"?{urllib.parse.urlencode(params)}" if params else ""
    url = f"{creds['api_url']}/workspaces/{creds['workspace_id']}/mcp-servers{qs}"
    data = http_request("GET", url, token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("mcp_servers") or data.get("servers") or data.get("items") or []


def match_mcp_servers(servers: list[dict], target: str) -> list[dict]:
    """All MCP servers matching `target`, in resolution-priority order: an exact
    id first, then id-prefix matches, then exact-name matches. The same server
    never appears twice, so callers can count the result to detect ambiguity. A
    blank/whitespace target matches nothing, so a destructive command can't act
    on the sole server when no real target was given (an empty string prefixes
    every id)."""
    if not (target or "").strip():
        return []
    exact = [s for s in servers if s.get("id") == target]
    if exact:
        return exact
    prefix = [s for s in servers if (s.get("id") or "").startswith(target)]
    by_name = [s for s in servers if s.get("name") == target and s not in prefix]
    return prefix + by_name


def resolve_mcp_server(servers: list[dict], target: str) -> dict | None:
    """First MCP server matching `target` by exact id, id-prefix, then exact
    name, or None. First-match; the write/destructive commands go through
    `_resolve_one_mcp_server`, which refuses an ambiguous value."""
    matches = match_mcp_servers(servers, target)
    return matches[0] if matches else None


def _mcp_create_body(name: str, url: str, config: dict | None = None) -> dict:
    """Request body for `POST .../mcp-servers`. `url` rides the server's
    `base_url` wire field. An optional `config` dict (parsed from `--config`)
    is merged in for advanced fields like `auth_type` / `auth_token`; explicit
    name/url win over anything the config repeats."""
    body: dict = {}
    if config:
        body.update(config)
    body["name"] = name
    body["base_url"] = url
    return body


def _mcp_update_body(*, name: str | None = None, url: str | None = None) -> dict:
    """Request body for `PUT .../mcp-servers/{id}`, containing only the fields
    the user passed. `url` rides the `base_url` wire field. Fields left out are
    untouched by the server."""
    body: dict = {}
    if name is not None:
        body["name"] = name
    if url is not None:
        body["base_url"] = url
    return body


def _mcp_server_url(creds: dict, server_id: str, suffix: str = "") -> str:
    return f"{creds['api_url']}/workspaces/{creds['workspace_id']}/mcp-servers/{server_id}{suffix}"


def _resolve_one_mcp_server(creds: dict, target: str) -> dict | None:
    """Resolve `target` to a single MCP server for a write/destructive command,
    or print why it couldn't (no match, or ambiguous with the candidates listed)
    and return None — so an ambiguous value can't change or delete an arbitrary
    server."""
    matches = match_mcp_servers(fetch_mcp_servers(creds), target)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        err(f"No MCP server matches '{target}'.")
        return None
    err(f"'{target}' is ambiguous — it matches {len(matches)} MCP servers:")
    for s in matches:
        err(f"  {s.get('id', '?')}  {s.get('name', '?')}")
    err("Re-run with a full server id to disambiguate.")
    return None


def cmd_mcp(args) -> int:
    """Manage external MCP servers registered on the workspace, and (via `token`)
    print the workspace token an external MCP client needs in its header.

    `add`/`remove` bring a server in / take it out; `enable`/`disable` flip its
    active field; `list`/`show` read the installed set. The underlying endpoints
    are unchanged — only the command surface follows the shared verb set.
    """
    creds = require_creds()
    sub = args.mcp_cmd or "list"

    if sub == "token":
        # External MCP clients (Claude Code, Cursor) send the workspace token as
        # their `Authorization: Bearer`. Auth0 logins must exchange their access
        # token for a workspace token, since `/mcp` only accepts the latter;
        # workspace-token and dev logins already hold one — print it directly.
        #
        #     claude mcp add --transport http eesel "<api>/mcp" \\
        #       --header "Authorization: Bearer $(eesel mcp token)"
        if creds.get("refresh_token"):
            print(mint_workspace_token(creds, creds.get("agent_id")))
        else:
            print(creds["token"])
        return 0

    if sub == "list":
        servers = fetch_mcp_servers(creds)
        if getattr(args, "json", False):
            print(json.dumps(servers, indent=2))
            return 0
        if getattr(args, "plain", False):
            for s in servers:
                state = "on" if s.get("is_active") else "off"
                print(
                    f"{str(s.get('id') or '')}\t{state}\t"
                    f"{str(s.get('name') or '')}\t{str(s.get('base_url') or '')}"
                )
            return 0
        if not servers:
            info("(no MCP servers)")
            return 0
        fmt = " {:<12}  {:<24}  {:<8}  {}"
        info(fmt.format("id", "name", "status", "url"))
        for s in servers:
            state = "on" if s.get("is_active") else "off"
            sid = (s.get("id") or "?")[:12]
            name = (s.get("name") or "?")[:24]
            print(fmt.format(sid, name, f"[{state}]", s.get("base_url", "?")))
        return 0

    if sub == "show":
        server = _resolve_one_mcp_server(creds, args.server)
        if not server:
            return 1
        if getattr(args, "json", False):
            print(json.dumps(server, indent=2))
            return 0
        state = "on" if server.get("is_active") else "off"
        info(f"{server.get('name', '?')}  [{state}]")
        print(f"  id        {server.get('id', '?')}")
        print(f"  url       {server.get('base_url', '?')}")
        print(f"  auth      {server.get('auth_type', 'none')}"
              + ("  (token set)" if server.get("has_auth_token") else ""))
        print(f"  active    {bool(server.get('is_active'))}")
        return 0

    if sub == "add":
        config = None
        if args.config:
            try:
                config = json.loads(args.config)
            except json.JSONDecodeError as e:
                err(f"--config is not valid JSON: {e}")
                return 1
            if not isinstance(config, dict):
                err("--config must be a JSON object.")
                return 1
        body = _mcp_create_body(args.name, args.url, config)
        data = http_request(
            "POST",
            f"{creds['api_url']}/workspaces/{creds['workspace_id']}/mcp-servers",
            token=creds["token"],
            body=body,
        )
        server_id = data.get("id") or (data.get("mcp_server") or {}).get("id")
        if server_id:
            ok(f"Added MCP server '{args.name}' ({server_id})")
        else:
            ok(f"Added MCP server '{args.name}'")
            info("(server returned no id; run `eesel mcp list` to confirm)")
        return 0

    if sub in ("set", "edit"):
        # `edit` is the prior name, kept as a hidden alias for `set`.
        server = _resolve_one_mcp_server(creds, args.server)
        if not server:
            return 1
        body = _mcp_update_body(name=args.name, url=args.url)
        if not body:
            err("Nothing to update. Pass --name and/or --url.")
            return 1
        http_request("PUT", _mcp_server_url(creds, server["id"]), token=creds["token"], body=body)
        ok(f"Updated {server.get('name')} ({server['id']}): {', '.join(body.keys())}")
        return 0

    if sub in ("enable", "disable"):
        server = _resolve_one_mcp_server(creds, args.server)
        if not server:
            return 1
        is_active = sub == "enable"
        http_request(
            "POST",
            _mcp_server_url(creds, server["id"], "/toggle"),
            token=creds["token"],
            body={"is_active": is_active},
        )
        ok(f"{'Enabled' if is_active else 'Disabled'} {server.get('name')} ({server['id']}).")
        return 0

    if sub == "remove":
        server = _resolve_one_mcp_server(creds, args.server)
        if not server:
            return 1
        if not args.force and not confirm(f"Remove MCP server '{server.get('name')}' ({server['id']})? [y/N] "):
            info("Aborted.")
            return 1
        http_request("DELETE", _mcp_server_url(creds, server["id"]), token=creds["token"])
        ok(f"Removed {server.get('name')} ({server['id']}).")
        return 0

    err(f"Unknown mcp command: {sub}")
    return 1


def cmd_document(args) -> int:
    """Dispatch the `documents` (and legacy singular `document`) subcommands.

    `read` is a hidden alias of `show` — both print one document's contents — so
    they route to the same handler here. A free-text query is `list --search
    <q>`, not a separate verb."""
    sub = args.document_cmd or "list"
    if sub == "list":
        creds = require_creds_scoped(args)
        documents = fetch_documents(
            creds,
            prefix=args.prefix,
            search=args.search,
            limit=args.limit,
            offset=args.offset,
        )
        documents = [doc for doc in documents if document_matches_agent(creds, doc)]
        if getattr(args, "json", False):
            print(json.dumps(documents, indent=2))
            return 0
        if getattr(args, "plain", False):
            for doc in documents:
                key = doc.get("key") or doc.get("document_key") or ""
                name = doc.get("name") or key.rsplit("/", 1)[-1]
                print(f"{str(doc.get('id') or '')}\t{str(key or '')}\t{str(name or '')}")
            return 0
        if not documents:
            info("(no documents)")
            return 0
        for doc in documents:
            doc_id = doc.get("id", "?")
            key = doc.get("key") or doc.get("document_key") or "?"
            name = doc.get("name") or key.rsplit("/", 1)[-1]
            print(f"{doc_id[:12]}  {key}  {name}")
        return 0
    if sub == "export":
        return cmd_document_export(args)
    if sub in ("show", "read"):
        return cmd_document_read(args)
    if sub == "add":
        return _documents_add(args)
    if sub == "remove":
        return _documents_remove(args)
    if sub == "acl":
        return _documents_acl(args)
    return 1


def build_document_create_body(*, title: str, content: str, source_type: str, agent_id: str | None = None) -> dict:
    """Request body for `POST /documents`. The server requires `title`,
    `content`, and `source_type` (a valid synchroniser source, e.g. `files`).
    Passing `agent_id` makes the server add the agent's `files/{agent_id}`
    knowledge-ACL prefix so the new document is visible to that agent."""
    body = {"title": title, "content": content, "source_type": source_type}
    if agent_id:
        body["agent_id"] = agent_id
    return body


def _documents_add(args) -> int:
    """`eesel documents add` — bring a new document into the workspace
    (POST /documents). Prints the new document's key so it can be captured."""
    creds = require_creds_scoped(args)
    if args.content is not None and args.content_file is not None:
        err("Pass either --content or --content-file, not both.")
        return 1
    if args.content is not None:
        content = args.content
    elif args.content_file is not None:
        path = Path(args.content_file).expanduser()
        try:
            content = path.read_text()
        except OSError as e:
            err(f"Could not read --content-file '{path}': {e}")
            return 1
    else:
        err("Document content is required. Pass --content or --content-file.")
        return 1

    body = build_document_create_body(
        title=args.title,
        content=content,
        source_type=args.source_type,
        agent_id=creds.get("agent_id"),
    )
    data = http_request("POST", f"{creds['api_url']}/documents", token=creds["token"], body=body)
    key = data.get("key") or data.get("document_key")
    doc_id = data.get("id")
    ok(f"Added document '{args.title}'")
    # The key is the stable address used by remove/export; print it to stdout so
    # it can be captured and reused (e.g. `KEY=$(eesel documents add ...)`).
    if key:
        print(key)
    elif doc_id:
        print(doc_id)
    else:
        info("(server returned no key/id; run `eesel documents list` to confirm)")
    return 0


def _documents_remove(args) -> int:
    """`eesel documents remove <key|id>...` — take documents out of the workspace
    (DELETE /documents). Prompts before deleting; `--force` skips the prompt.

    Each argument is resolved against the documents that actually exist (by exact
    key or exact id) before anything is deleted. If any argument matches no
    document, the command refuses and deletes nothing — rather than POSTing an
    unresolved key and reporting a fabricated "Removed N" for a typo the server
    silently ignored. The reported count is the number of documents actually
    matched and sent for deletion, not the number of arguments passed."""
    creds = require_creds_scoped(args)
    documents = agent_documents(creds, limit=500)
    by_key = {_document_key(doc): doc for doc in documents if _document_key(doc)}
    by_id = {doc.get("id"): doc for doc in documents if doc.get("id")}

    resolved_keys: list[str] = []
    unmatched: list[str] = []
    seen: set[str] = set()
    for target in args.keys:
        doc = by_key.get(target) or by_id.get(target)
        if doc is None:
            unmatched.append(target)
            continue
        key = _document_key(doc)
        if key and key not in seen:
            seen.add(key)
            resolved_keys.append(key)

    if unmatched:
        err(f"No document matches: {', '.join(unmatched)}")
        info("Run `eesel documents list` to see this agent's documents (the key is the second column).")
        return 1
    if not resolved_keys:
        err("No documents to remove.")
        return 1

    if not args.force:
        listed = "\n".join(f"  {k}" for k in resolved_keys)
        if not confirm(f"Remove {len(resolved_keys)} document(s)?\n{listed}\n[y/N] "):
            info("Aborted.")
            return 1
    http_request("DELETE", f"{creds['api_url']}/documents", token=creds["token"], body={"keys": resolved_keys})
    ok(f"Removed {len(resolved_keys)} document(s).")
    return 0


def _documents_acl(args) -> int:
    """`eesel documents acl show|set <agent>` — read or replace an agent's
    knowledge-ACL key prefixes (GET/PUT /agents/{agent_id}/knowledge-acl)."""
    creds = require_creds()
    sub = args.acl_cmd or "show"
    # `set` replaces the entire ACL, so refuse an ambiguous agent rather than
    # rewriting the wrong agent's knowledge access on a first match.
    agent = resolve_agent_or_error(creds, args.agent)
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    url = f"{creds['api_url']}/agents/{agent_id}/knowledge-acl"

    if sub == "show":
        data = http_request("GET", url, token=creds["token"])
        prefixes = data.get("key_prefixes") or []
        if getattr(args, "json", False):
            print(json.dumps(prefixes, indent=2))
            return 0
        if not prefixes:
            info("(no key prefixes)")
            return 0
        for prefix in prefixes:
            print(prefix)
        return 0

    if sub == "set":
        # PUT replaces the entire prefix set (it does not append). The server
        # always re-adds the agent's own `files/{agent_id}` prefix, so it can't
        # be removed even if omitted here.
        http_request("PUT", url, token=creds["token"], body={"key_prefixes": args.prefix})
        # The PUT response echoes the request; the server normalizes on store
        # (drops a bare `files`, dedupes, re-adds files/{agent_id}). Read the
        # state back with a GET so we report what was actually granted, not what
        # we asked for — otherwise an agent could believe it granted broader
        # access than the server kept.
        prefixes = http_request("GET", url, token=creds["token"]).get("key_prefixes") or []
        ok(f"Set {len(prefixes)} key prefix(es) for {agent.get('name')} ({agent_id}).")
        for prefix in prefixes:
            print(prefix)
        return 0

    err(f"Unknown acl command: {sub}")
    return 1


def cmd_document_read(args) -> int:
    """Print a document's contents to stdout.

    `eesel document read <id|key|filename>` reads that document; `eesel document
    read` (no target) opens an arrow-key menu. `--prefix` narrows both the menu
    and the direct match to keys under that prefix (e.g. files/, outputs/).

    Like `instructions`, the body goes to stdout and the header to stderr, so
    `eesel document read <id> > out.md` captures just the content.
    """
    creds = require_creds_scoped(args)
    fmt = (getattr(args, "format", None) or "md").lower()
    prefix = getattr(args, "prefix", None)

    candidates = agent_documents(creds, prefix=prefix)
    scope = f" under prefix '{prefix}'" if prefix else ""
    if not candidates:
        info(f"(no documents{scope})")
        return 0

    target = getattr(args, "target", None)
    if target:
        match = match_document(candidates, target)
        if match is None:
            err(f"No document matches '{target}'{scope}.")
            return 1
        if isinstance(match, list):
            labels = ", ".join(f"{(d.get('id') or '?')[:12]} ({_document_key(d).rsplit('/', 1)[-1]})" for d in match[:5])
            err(f"'{target}' is ambiguous{scope}: {labels}")
            return 1
        doc = match
    else:
        labels = [f"{(d.get('id') or '?')[:8]}  {_document_key(d) or d.get('name') or '?'}" for d in candidates]
        choice = interactive_select(labels, title=f"Select a document to read{scope}  (↑/↓, Enter, q to cancel):")
        if choice is None:
            info("Cancelled.")
            return 1
        doc = candidates[choice]

    doc_id = doc.get("id")
    key = _document_key(doc) or None
    try:
        _, url = doc_export_signed_url(creds, document_id=doc_id, document_key=key, fmt=fmt)
    except RuntimeError as e:
        err(str(e))
        return 1

    content = http_fetch(url, token=creds["token"])
    if getattr(args, "json", False):
        try:
            body = content.decode("utf-8")
        except UnicodeDecodeError:
            body = None
        print(json.dumps({"id": doc_id, "key": key, "format": fmt, "content": body}, indent=2))
        return 0
    info(f"# {key or doc_id}  ({(doc_id or '')[:12]}, {fmt})")
    try:
        text = content.decode("utf-8")
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
    except UnicodeDecodeError:
        sys.stdout.buffer.write(content)
    return 0


def cmd_document_export(args) -> int:
    creds = require_creds()
    fmt = args.format.lower()

    if args.document_id:
        document_id = resolve_document_id(creds, args.document_id)
        if not document_id:
            return 1
        document_key = None
    else:
        key = _document_key_for_workspace(args.document_key, creds["workspace_id"])
        if key is None:
            err(f"Document key belongs to a different workspace than {creds['workspace_id']}. Run `eesel login --dev --workspace-id <workspace-id>` first.")
            return 1
        key_agent_id = document_key_agent_id(key)
        if key_agent_id != creds["agent_id"]:
            err(f"Document key belongs to agent {key_agent_id or 'unknown'}, but current CLI agent is {creds['agent_id']}.")
            return 1
        record = _document_record(creds, document_key=key)
        if not record or not record.get("id"):
            err(f"No document found for key '{key}' in workspace {creds['workspace_id']}.")
            return 1
        document_id = record["id"]
        document_key = key

    try:
        filename, url = doc_export_signed_url(creds, document_id=document_id, document_key=document_key, fmt=fmt)
    except RuntimeError as e:
        err(str(e))
        return 1

    output_path = Path(args.output or filename).expanduser()
    http_download(url, token=creds["token"], output_path=output_path)
    ok(f"Exported {fmt} to {output_path}")
    return 0


# ──────────────────────────────────────────────────────────────────────────
# Skills — install/uninstall a skill on an agent + per-agent config
#
# `add`/`remove` install or uninstall a skill on an agent (the marketplace is a
# read-only catalog you install FROM). `list` shows every installed skill with
# its on/off status as a column. `set` merges keys into a skill's per-agent config.
# ──────────────────────────────────────────────────────────────────────────


def fetch_agent_skills(creds: dict, agent_id: str, *, filter_: str = "all") -> list[dict]:
    """Return an agent's skills, selected by the server's ``filter`` query.

    ``all`` (the default) returns every installed skill, each carrying an
    ``enabled`` flag — so `list` can show on/off as a column instead of hiding
    the off ones. ``enabled`` returns only the on ones. ``available`` returns
    the marketplace catalog of skills not yet installed — the ids that `skills
    add` accepts. The endpoint returns a bare JSON array of skill dicts
    (id, name, description, enabled, icon, …).
    """
    qs = urllib.parse.urlencode({"filter": filter_})
    data = http_request("GET", f"{creds['api_url']}/agents/{agent_id}/skills?{qs}", token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("skills") or data.get("items") or []


def _skill_is_on(skill: dict) -> bool:
    """Whether a skill row is currently enabled on the agent.

    The list payload may carry the on/off state under any of a few field names;
    treat a missing flag as enabled, since the pre-``filter=all`` endpoint only
    ever returned enabled skills.
    """
    for key in ("enabled", "is_enabled", "active"):
        if key in skill:
            return bool(skill[key])
    return True


def resolve_agent_or_error(creds: dict, target: str | None) -> dict | None:
    """Resolve `target` to exactly one agent for a write/destructive command,
    or print why it could not and return None.

    `target` falls back to the EESEL_AGENT environment variable. Unlike the
    first-match `resolve_agent`, this refuses an ambiguous name: it lists the
    candidates and returns None so the caller aborts rather than mutating an
    arbitrary agent. Use this for every command that changes server state
    (acl set, triggers/schedules add, actions disable, skills remove,
    notifications, instructions set, …); reads that select an "active" agent
    may keep using `resolve_agent`.
    """
    target = target or os.environ.get("EESEL_AGENT")
    if not target:
        err("No agent given. Pass one (e.g. `eesel skills add <agent> <skill>`) or set EESEL_AGENT.")
        return None
    agents = fetch_agents(creds)
    if not agents:
        err("No agents in workspace. Create one with `eesel agents create` first.")
        return None
    agent, candidates = resolve_agent_strict(agents, target)
    if agent:
        return agent
    if candidates:
        err(f"'{target}' is ambiguous — it matches {len(candidates)} agents:")
        for a in candidates:
            # Show the full agent_id (not the 8-char display label) so the
            # listed candidates are usable verbatim to disambiguate, even when
            # they share a short id prefix.
            err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
        err("Re-run with a full agent id to disambiguate.")
    else:
        err(f"No agent matches '{target}'.")
    return None


def cmd_skills(args) -> int:
    """Manage the skills installed on an agent.

    `list` shows every installed skill with its on/off status as a column;
    `show` prints one skill's detail; `add`/`remove` install or uninstall a
    skill (the marketplace is a read-only catalog you install FROM); `set`
    merges keys from a JSON object into a skill's per-agent config (it does not
    replace the whole config). Every subcommand
    resolves its `<agent>` argument by exact id, id-prefix, or name, falling
    back to the EESEL_AGENT environment variable.
    """
    creds = require_creds()
    sub = args.skills_cmd
    if sub is None:
        err("Specify a skills subcommand: list, available, show, add, remove, or set.")
        return 1

    agent = resolve_agent_or_error(creds, args.agent)
    if not agent:
        return 1
    agent_id = agent["agent_id"]

    if sub == "list":
        skills = fetch_agent_skills(creds, agent_id)
        if getattr(args, "json", False):
            print(json.dumps(skills, indent=2))
            return 0
        if getattr(args, "plain", False):
            for s in skills:
                state = "on" if _skill_is_on(s) else "off"
                print(f"{s.get('id') or '?'}\t{state}\t{s.get('name') or ''}")
            return 0
        if not skills:
            info(f"(no skills installed on {agent.get('name', agent_id)})")
            info("Install one with: eesel skills add <agent> <skill_id>")
            return 0
        fmt = " {:<28}  {:<5}  {:<24}  {}"
        info(fmt.format("id", "state", "name", "description"))
        for s in skills:
            sid = s.get("id") or "?"
            name = (s.get("name") or sid)[:24]
            state = "[on]" if _skill_is_on(s) else "[off]"
            desc = (s.get("description") or "").replace("\n", " ")
            if len(desc) > 60:
                desc = desc[:60] + "…"
            print(fmt.format(str(sid)[:28], state, name, desc))
        return 0

    if sub == "available":
        # The marketplace catalog scoped to this agent: the skills it can still
        # install. These ids are exactly what `skills add` accepts, so this is
        # how you discover a valid <skill_id> without leaving the CLI.
        skills = fetch_agent_skills(creds, agent_id, filter_="available")
        if getattr(args, "json", False):
            print(json.dumps(skills, indent=2))
            return 0
        if getattr(args, "plain", False):
            for s in skills:
                print(f"{s.get('id') or '?'}\t{s.get('name') or ''}")
            return 0
        if not skills:
            info(f"(no more skills available to install on {agent.get('name', agent_id)})")
            return 0
        fmt = " {:<28}  {:<24}  {}"
        info(fmt.format("id", "name", "description"))
        for s in skills:
            sid = s.get("id") or "?"
            name = (s.get("name") or sid)[:24]
            desc = (s.get("description") or "").replace("\n", " ")
            if len(desc) > 60:
                desc = desc[:60] + "…"
            print(fmt.format(str(sid)[:28], name, desc))
        info(f"Install one with: eesel skills add {args.agent or agent_id} <id>")
        return 0

    if sub == "show":
        skills = fetch_agent_skills(creds, agent_id)
        match = next((s for s in skills if (s.get("id") or "") == args.skill_id), None)
        if not match:
            err(f"No skill '{args.skill_id}' installed on {agent.get('name')} ({agent_id}).")
            return 1
        if getattr(args, "json", False):
            print(json.dumps(match, indent=2))
            return 0
        print(json.dumps(match, indent=2))
        return 0

    if sub == "add":
        url = f"{creds['api_url']}/agents/{agent_id}/skills/{args.skill_id}"
        http_request("POST", url, token=creds["token"], body={})
        ok(f"Installed skill '{args.skill_id}' on {agent.get('name')} ({agent_id}).")
        info(f"Confirm with: eesel skills list {args.agent or agent_id}")
        return 0

    if sub == "remove":
        if not args.force and not confirm(
            f"Remove skill '{args.skill_id}' from {agent.get('name')} ({agent_id})? [y/N] "
        ):
            info("Aborted.")
            return 1
        url = f"{creds['api_url']}/agents/{agent_id}/skills/{args.skill_id}"
        http_request("DELETE", url, token=creds["token"])
        ok(f"Removed skill '{args.skill_id}' from {agent.get('name')} ({agent_id}).")
        return 0

    if sub in ("set", "edit"):
        # `edit` is the prior name, kept as a hidden alias for `set`.
        config = parse_config_object(args.config)
        url = f"{creds['api_url']}/agents/{agent_id}/skills/{args.skill_id}/config"
        # PATCH merges the given keys into the existing config; PUT would replace
        # the whole object and drop any field this call didn't mention. The
        # response is the merged config — confirm each field we sent holds the
        # value we sent.
        saved = http_request("PATCH", url, token=creds["token"], body=config)
        if isinstance(saved, dict):
            mismatched = [k for k, v in config.items() if saved.get(k) != v]
            if mismatched:
                err(f"Server accepted the change but {', '.join(mismatched)} did not update as sent.")
                return 1
        ok(f"Updated config for skill '{args.skill_id}' on {agent.get('name')} ({agent_id}).")
        return 0

    return 1


# ──────────────────────────────────────────────────────────────────────────
# Workspace — the active workspace from stored creds (no id arg)
#
# Every command here operates on creds["workspace_id"], the workspace the
# current login belongs to. Backed by the Bearer-authed workspace endpoints:
#   GET  /workspaces/{id}                 the workspace object
#   PUT  /workspaces/{id}                 rename (body {"workspaceName": ...})
#   GET  /workspaces/{id}/members         members (each: email, role, status)
#   POST /workspace/billing-limit         set the monthly spend cap (singular path)
#   POST /subscription/extend-trial       extend the free-trial window
# Writes and billing require the Auth0 login (a workspace-token login 401s on
# these server-side); reads work with either.
#
# Command naming follows the CLI's stable verb set: `show` reads the object
# (the `cat` verb), `set <field> <value>` writes a single field (the workspace
# name or the billing limit), `members` lists the members directory, and
# `extend-trial` is a one-off server action with no field to set.
# ──────────────────────────────────────────────────────────────────────────


def fetch_workspace(creds: dict) -> dict:
    """Return the active workspace object (name, owner, trial length, etc.)."""
    url = f"{creds['api_url']}/workspaces/{creds['workspace_id']}"
    return http_request("GET", url, token=creds["token"])


def fetch_workspace_members(creds: dict) -> list[dict]:
    """Return the active workspace's members. Each row carries email, role, and
    status (accepted members and pending invitations both appear)."""
    url = f"{creds['api_url']}/workspaces/{creds['workspace_id']}/members"
    data = http_request("GET", url, token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("members") or data.get("items") or []


def cmd_workspace(args) -> int:
    creds = require_creds()
    sub = getattr(args, "workspace_cmd", None) or "show"

    if sub == "show":
        ws = fetch_workspace(creds)
        if getattr(args, "json", False):
            print(json.dumps(ws, indent=2))
            return 0
        # Print the fields the server returns, most useful first; skip the
        # large/structural ones (namespaces) from the default view.
        order = [
            "workspaceId",
            "workspaceName",
            "workspaceOwnerUserId",
            "trialDurationDays",
            "stripeSubscriptionId",
            "stripeCustomerId",
            "onboarding_completed",
            "dataResidency",
        ]
        printed = set()
        for key in order:
            if key in ws:
                print(f"{key:<22}: {ws.get(key)}")
                printed.add(key)
        for key, value in ws.items():
            if key in printed or key == "namespaces":
                continue
            print(f"{key:<22}: {value}")
        return 0

    if sub == "set":
        field = args.field
        if field == "name":
            url = f"{creds['api_url']}/workspaces/{creds['workspace_id']}"
            http_request("PUT", url, token=creds["token"], body={"workspaceName": args.value})
            # The update endpoint returns only a status message, so read the
            # workspace back to confirm and show the new name.
            ws = fetch_workspace(creds)
            ok(f"Workspace name: {ws.get('workspaceName')}")
            return 0

        if field == "billing-limit":
            # The value arrives as a string (one positional for every field);
            # the billing endpoint needs a non-negative integer amount.
            try:
                amount = int(args.value)
            except ValueError:
                err("billing-limit must be a non-negative integer.")
                return 1
            if amount < 0:
                err("billing-limit must be a non-negative integer.")
                return 1
            # The server stores the cap under the `value` field and returns
            # {"status": "success"} with no echo.
            http_request(
                "POST",
                f"{creds['api_url']}/workspace/billing-limit",
                token=creds["token"],
                body={"value": amount},
            )
            # Read the active cap back from the subscription license rather than
            # trusting the status message. On a trial workspace the active cap is
            # fixed at the trial allowance until the plan converts, so the limit
            # just submitted may not be reflected yet — report what the customer
            # will actually see instead of a bare "done".
            license = http_request("GET", f"{creds['api_url']}/subscription/license", token=creds["token"])
            stored = license.get("billingLimit") if isinstance(license, dict) else None
            if stored is not None and float(stored) == float(amount):
                ok(f"Billing limit set to {amount} (active cap confirmed).")
            elif stored is not None:
                ok(f"Billing limit set to {amount}.")
                info(f"Active cap still shows {stored}. On a trial plan the cap is fixed at the "
                     "trial allowance until you upgrade; otherwise re-check with `eesel billing show license`.")
            else:
                ok(f"Billing limit set to {amount}.")
            return 0

        err(f"Unknown workspace field '{field}'.")
        return 1

    if sub == "members":
        members = fetch_workspace_members(creds)
        if getattr(args, "json", False):
            print(json.dumps(members, indent=2))
            return 0
        if not members:
            info("(no members)")
            return 0
        for m in members:
            email = m.get("email") or "?"
            role = m.get("role") or "?"
            status = m.get("status")
            suffix = f"  [{status}]" if status and status != "accepted" else ""
            print(f"{email:<40}  {role}{suffix}")
        return 0

    if sub == "extend-trial":
        resp = http_request(
            "POST",
            f"{creds['api_url']}/subscription/extend-trial",
            token=creds["token"],
            body={},
        )
        ok(resp.get("message") or "Trial extended.")
        return 0

    return 1


