def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)


def load_creds() -> dict | None:
    if not CREDS_FILE.exists():
        return None
    try:
        return json.loads(CREDS_FILE.read_text())
    except Exception:
        return None


def save_creds(creds: dict) -> None:
    # Branch-env creds (`eesel link`) are throwaway — minted per run and marked
    # ephemeral. Never persist them: a linked worktree must not overwrite the
    # real login on disk (e.g. via impersonate's workspace resync) or leak its
    # branch target into other directories. This one guard covers every writer.
    if creds.get("ephemeral"):
        return
    ensure_dirs()
    # Written 0o600 on the temp file before the atomic replace, so the real
    # credentials file never briefly exists world-readable.
    _atomic_write(CREDS_FILE, json.dumps(creds, indent=2), mode=0o600)


# ──────────────────────────────────────────────────────────────────────────
# Platform detection (legacy v2 vs the new platform)
# ──────────────────────────────────────────────────────────────────────────

# eesel serves two products from one backend: the new "platform" (agents) and
# the legacy "v2" platform (bots/namespaces). Read commands work on both; the
# CLI serves the right backend per invocation. The signal is the same one the
# dashboard middleware routes on — `GET /subscription/license` → `isPlatform`,
# the server-side `eesel-agents` flag.
PLATFORM_LEGACY = "legacy"
PLATFORM_NEW = "platform"


def fetch_platform_from_license(creds: dict) -> str:
    """Probe the workspace's platform from `GET /subscription/license`.

    Returns "legacy" only when the license reports `isPlatform is False` — the
    exact signal the dashboard routes on. Any other value, a non-200, or a
    transport error fails **open** to "platform", so a detection hiccup never
    blocks a new-platform user.
    """
    try:
        status, data = http_request_allow_error(
            "GET", f"{creds['api_url']}/subscription/license", token=creds.get("token")
        )
    except SystemExit:
        return PLATFORM_NEW
    except Exception:
        return PLATFORM_NEW
    if status == 200 and isinstance(data, dict) and data.get("isPlatform") is False:
        return PLATFORM_LEGACY
    return PLATFORM_NEW


def resolve_platform(creds: dict, args=None) -> str:
    """Decide whether this invocation targets the legacy v2 platform or the new
    platform, once per run.

    Priority: an explicit ``--legacy`` / ``--platform`` flag (never persisted) →
    the cached ``creds["platform"]`` → a one-time license probe, whose result is
    cached back onto ``creds`` (and to disk, minus transient ``_``-keys) so later
    commands stay offline. Linked branch envs are ephemeral, so `save_creds`
    won't persist the cache there — each command re-probes (or pass `--legacy`).
    """
    if getattr(args, "legacy", False):
        return PLATFORM_LEGACY
    if getattr(args, "platform", False):
        return PLATFORM_NEW
    cached = creds.get("platform")
    if cached in (PLATFORM_LEGACY, PLATFORM_NEW):
        return cached
    detected = fetch_platform_from_license(creds)
    creds["platform"] = detected
    try:
        save_creds({k: v for k, v in creds.items() if not k.startswith("_")})
    except Exception:
        pass
    return detected


# Which commands have a read-only meaning on the legacy v2 platform. Everything
# else is refused there — the platform is read-only, and most nouns have no v2
# analogue. This is the SINGLE source of truth, shared by the pre-dispatch guard
# (`_guard_platform_command`), the `--help` trimming (`build_parser`), and the
# `eesel schema` annotation (`_serialize_parser`).
_LEGACY_UNIVERSAL = frozenset({"login", "logout", "whoami", "link", "schema"})
# noun → the subcommands supported on legacy (None ⇒ the whole noun is supported).
_LEGACY_SUPPORTED_SUBS = {
    "agents": frozenset({"list", "show"}),
    "instructions": None,
    "integrations": frozenset({"list", "show"}),
    "tasks": frozenset({"list", "show"}),
    "workspace": frozenset({"show", "members"}),
}
# The subcommand a bare `eesel <noun>` resolves to, mirroring each handler's
# `sub = ... or "..."`, so a group invoked with no verb is classified by default.
_LEGACY_DEFAULT_SUB = {
    "agents": "list", "integrations": "list", "tasks": "list", "workspace": "show",
}
# Where each noun's chosen subcommand is stored on the parsed args namespace.
_LEGACY_SUB_DEST = {
    "agents": "agents_cmd", "integrations": "integrations_cmd",
    "tasks": "tasks_cmd", "workspace": "workspace_cmd",
}
# Top-level nouns with no legacy read meaning at all — hidden wholesale from
# `--help` on legacy (they stay parseable; the guard refuses them).
_LEGACY_HIDDEN_NOUNS = (
    "files", "skills", "mcp", "settings", "chat", "new", "cost",
    "automations", "billing",
)


def _legacy_supports_cmd(cmd: str | None, sub: str | None) -> bool:
    """Whether `<cmd> [sub]` is available on the legacy v2 platform."""
    if cmd in _LEGACY_UNIVERSAL:
        return True
    if cmd not in _LEGACY_SUPPORTED_SUBS:
        return False
    subs = _LEGACY_SUPPORTED_SUBS[cmd]
    return True if subs is None else sub in subs


def legacy_supports(args) -> bool:
    """The single classifier: does the parsed command work on legacy? Keyed on
    the command plus its resolved subcommand (a bare noun uses its default)."""
    cmd = getattr(args, "cmd", None)
    dest = _LEGACY_SUB_DEST.get(cmd)
    sub = getattr(args, dest, None) if dest else None
    if sub is None:
        sub = _LEGACY_DEFAULT_SUB.get(cmd)
    return _legacy_supports_cmd(cmd, sub)


def _legacy_supports_path(path: tuple) -> bool:
    """`legacy_supports` for a schema command path, e.g. ('agents','create')."""
    if not path:
        return False
    cmd = path[0]
    sub = path[1] if len(path) > 1 else _LEGACY_DEFAULT_SUB.get(cmd)
    return _legacy_supports_cmd(cmd, sub)


def _command_label(args) -> str:
    """A human label for the current command (e.g. 'agents create') for the
    guard's refusal message. Includes the resolved subcommand when the noun
    tracks one, matching the inline `_legacy_unsupported` fallbacks."""
    cmd = getattr(args, "cmd", None) or "?"
    dest = _LEGACY_SUB_DEST.get(cmd)
    sub = getattr(args, dest, None) if dest else None
    if sub is None:
        sub = _LEGACY_DEFAULT_SUB.get(cmd)
    return f"{cmd} {sub}" if sub else cmd


# ──────────────────────────────────────────────────────────────────────────
# Per-worktree branch-env link (`eesel link`)
# ──────────────────────────────────────────────────────────────────────────


def walk_up_find(name: str, start: Path | None = None, stop_at: Path | None = None) -> Path | None:
    """Walk up from `start` (default cwd) looking for a file or dir named `name`,
    like git finds `.git`. Return the directory that contains it, or None. With
    `stop_at`, don't search above that directory (it's checked, then the walk
    stops) — used to keep discovery inside the current worktree."""
    here = (start or Path.cwd()).resolve()
    for d in (here, *here.parents):
        if (d / name).exists():
            return d
        if stop_at is not None and d == stop_at:
            break
    return None


def is_preprod_url(url: str) -> bool:
    """True only for `https://<slug>.preprod.eesel.xyz` — a branch env, never
    prod/dev. Uses the parsed hostname so a port or `user@` can't smuggle a
    different host past the check."""
    try:
        parsed = urllib.parse.urlparse(url)
    except ValueError:
        return False
    host = parsed.hostname or ""
    return parsed.scheme == "https" and host.endswith(PREPROD_HOST_SUFFIX)


def resolve_dev_base_url() -> str | None:
    """The branch-env target for commands run here, if any. `EESEL_BASE_URL`
    wins (one-off scripts); otherwise the nearest `eesel.dev.json` walking up
    from cwd (the per-worktree `eesel link`). None → no override, so normal
    prod/dev login applies unchanged."""
    env_url = os.environ.get("EESEL_BASE_URL")
    if env_url:
        return env_url.rstrip("/")
    # Discover only within the current worktree: a stray `eesel.dev.json` in a
    # parent (e.g. $HOME) must not silently hijack commands in unrelated repos.
    # `cmd_link` writes the file at the worktree root, so bound the walk at the
    # git root — or, outside a git repo, look only in the current directory.
    boundary = walk_up_find(".git") or Path.cwd().resolve()
    root = walk_up_find(WORKTREE_CONFIG_NAME, stop_at=boundary)
    if not root:
        return None
    path = root / WORKTREE_CONFIG_NAME
    try:
        data = json.loads(path.read_text())
    except Exception as e:
        err(f"Could not read {path}: {e}")
        sys.exit(1)
    url = data.get("base_url")
    if not isinstance(url, str) or not url:
        err(f'{path} must hold {{"base_url": "https://<slug>.preprod.eesel.xyz"}} — re-run `eesel link <url>`.')
        sys.exit(1)
    return url.rstrip("/")


def dev_session_creds(base_url: str) -> dict:
    """Mint throwaway credentials for a branch env from its `/dev/session`.

    Nothing is stored: the URL is the only durable state (in `eesel.dev.json`),
    and the token is minted fresh on every command. Hard-refuses any host that
    isn't a preprod branch env *before any network call*, so it can never be
    pointed at prod or a local dev stack. Returns the creds shape every command
    reads (api_url, workspace_id, token, …), so downstream code works unchanged."""
    if not is_preprod_url(base_url):
        err(
            f"Refusing to mint a dev token for {base_url!r} — only "
            f"https://<slug>{PREPROD_HOST_SUFFIX} branch envs are allowed."
        )
        sys.exit(1)
    # Short timeout: this runs before every linked command, so a hung env should
    # fail fast rather than block. `allow_error` lets us turn the server's status
    # into an actionable message instead of a raw dump.
    status, resp = http_request_allow_error("POST", f"{base_url}/dev/session", timeout=20)
    if status != 200:
        err(
            f"{base_url}/dev/session returned {status} — the branch env may be torn "
            "down, or not running in development mode (/dev/session is dev-gated)."
        )
        sys.exit(1)
    workspace_id = resp.get("workspace_id")
    token = resp.get("auth_token")
    if not workspace_id or not token:
        err(f"{base_url}/dev/session returned no workspace token (got keys: {sorted(resp)}).")
        sys.exit(1)
    return {
        "env": "preprod",
        "api_url": base_url,
        "dashboard_url": base_url,
        "workspace_id": workspace_id,
        "agent_id": None,
        "token": token,
        # Minted fresh per run, so there's no expiry to manage or refresh.
        "expires_at": 0,
        # Throwaway — `save_creds` refuses to write creds carrying this flag.
        "ephemeral": True,
    }


def add_to_gitignore(root: Path, entry: str) -> None:
    """Ensure `entry` is in `root/.gitignore`, so a per-worktree dev config is
    never committed. Idempotent; appends without disturbing existing lines."""
    gi = root / ".gitignore"
    existing = gi.read_text() if gi.exists() else ""
    if entry in existing.splitlines():
        return
    prefix = "" if existing == "" or existing.endswith("\n") else "\n"
    gi.write_text(existing + prefix + entry + "\n")


def refresh_prod_token(creds: dict) -> dict | None:
    """Exchange the stored Auth0 refresh token for a fresh access token.

    The dashboard performs the actual grant — it holds the Auth0 client secret,
    which must never live on a user's machine — so the CLI just hands it the
    refresh token. On success, updates `token`/`refresh_token`/`expires_at` in
    place, saves, and returns the creds. Returns None if the refresh failed
    (e.g. the refresh token was revoked, or rotated away because the dashboard
    session refreshed), leaving the caller to decide whether to force re-login.
    """
    dashboard = creds.get("dashboard_url") or ENVS["prod"]["dashboard"]
    payload = json.dumps({"refresh_token": creds["refresh_token"]}).encode()
    req = urllib.request.Request(
        f"{dashboard}/api/cli/refresh",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    # Unlike http_request, a failed refresh must not exit the process — it's
    # recoverable by re-login — so we handle errors locally.
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read() or b"{}")
    except Exception:
        return None

    access_token = data.get("access_token")
    if not access_token:
        return None
    creds["token"] = access_token
    if data.get("refresh_token"):
        creds["refresh_token"] = data["refresh_token"]
    expires_in = data.get("expires_in")
    if not isinstance(expires_in, int) or expires_in <= 0:
        expires_in = PROD_TOKEN_TTL_FALLBACK_SECONDS
    creds["expires_at"] = int(time.time()) + expires_in
    save_creds(creds)
    return creds


def apply_agent_env_override(creds: dict) -> dict:
    """Let the EESEL_AGENT environment variable scope a single command to one
    agent, without writing anything to disk.

    When EESEL_AGENT is set it scopes the command to that agent for this
    invocation only: `EESEL_AGENT=blog-bot eesel chat "hi"` always talks to
    blog-bot, and the choice doesn't leak into the next command. A per-command
    `--agent` flag still wins, since each command applies it after this.

    The value is a full id, id-prefix, or agent name — resolved exactly like
    `--agent`. Resolution needs the agent list, so this makes one extra API
    call, but only when EESEL_AGENT is actually set. A value that matches no
    agent — or an ambiguous prefix/name that matches more than one — is a hard
    error, so a typo or an under-specified value fails loudly here instead of
    silently scoping the command to the wrong agent. This mirrors the strict
    resolution the write/destructive commands use on their `--agent` target."""
    target = (os.environ.get("EESEL_AGENT") or "").strip()
    if not target:
        return creds
    # The target may legitimately be an agent *name* containing `/`, `%`, etc.
    # (e.g. "Support/Billing"), so it is resolved first; only the resolved
    # agent_id — the value that becomes a URL path segment — is validated.
    match, candidates = resolve_agent_strict(fetch_agents(creds), target)
    if not match:
        if candidates:
            err(f"EESEL_AGENT='{target}' is ambiguous — it matches {len(candidates)} "
                "agents. Use a full id (shown below):")
            for a in candidates:
                print(f"   {a.get('agent_id', '?')}  {a.get('name', '?')}", file=sys.stderr)
        else:
            err(f"EESEL_AGENT='{target}' matches no agent in this workspace.")
        sys.exit(1)
    # Copy so the override stays in memory for this process and is never saved.
    creds = dict(creds)
    creds["agent_id"] = validate_id(match["agent_id"], "agent id")
    return creds


def apply_agent_flag_override(creds: dict, agent: str | None) -> dict:
    """Scope a single command to `agent` (a `--agent` value: full id, id-prefix,
    or name), winning over EESEL_AGENT for this invocation only.

    Returns creds unchanged when `agent` is None. Resolved in memory and never
    written to disk. An unmatched or ambiguous value is a hard error, mirroring
    EESEL_AGENT handling so a typo fails loudly instead of silently scoping the
    command to the wrong agent."""
    if not agent:
        return creds
    match, candidates = resolve_agent_strict(fetch_agents(creds), agent)
    if not match:
        if candidates:
            err(f"'{agent}' is ambiguous — it matches {len(candidates)} agents:")
            for a in candidates:
                err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
            err("Re-run with a full agent id to disambiguate.")
        else:
            err(f"No agent matches '{agent}'.")
            info("Run `eesel agents list` to see available agents.")
        sys.exit(1)
    creds = dict(creds)
    # The `--agent` value may be a human name (e.g. "Support/Billing"); validate
    # the resolved id — the value that becomes a URL path segment — not the name.
    creds["agent_id"] = validate_id(match["agent_id"], "agent id")
    return creds


def require_creds_scoped(args) -> dict:
    """`require_creds()` plus an optional per-command `--agent` override.

    A `--agent` flag (full id, id-prefix, or name) scopes this one command to a
    specific agent, exactly like `EESEL_AGENT` but per-invocation and winning over
    it. The value is resolved in memory and never persisted."""
    return apply_agent_flag_override(require_creds(), getattr(args, "agent", None))


def _use_creds(creds: dict) -> dict:
    """Apply the agent-by-env override and record the result as the creds this
    command runs with, so the `http_request` 401 self-heal can re-resolve and
    persist the workspace without threading creds through every caller."""
    global _current_creds
    _current_creds = creds = apply_agent_env_override(creds)
    return creds


def require_creds() -> dict:
    # A worktree linked to a branch env (or an `EESEL_BASE_URL` override) mints a
    # throwaway token from that env's `/dev/session` per run. This reads nothing
    # from ~/.config, so a linked worktree needs no `eesel login` at all — and
    # five worktrees each target their own env with nothing global to race over.
    base_url = resolve_dev_base_url()
    if base_url:
        return _use_creds(dev_session_creds(base_url))

    creds = load_creds()
    if not creds:
        err("Not logged in. Run `eesel login` first.")
        sys.exit(1)

    # There is no stored "active agent". A persisted `agent_id` (left by an older
    # CLI that saved one) must never act as a silent default — every agent-scoped
    # command names its agent explicitly, or the sole agent is used. Drop it so
    # `creds["agent_id"]` is only ever set in memory, by `--agent` / EESEL_AGENT.
    creds.pop("agent_id", None)

    expires_at = creds.get("expires_at") or 0
    near_expiry = bool(expires_at) and time.time() > expires_at - TOKEN_REFRESH_SKEW_SECONDS

    # Prod logins carry an Auth0 refresh token — renew silently rather than
    # making the user re-run `eesel login`.
    if near_expiry and creds.get("refresh_token"):
        refreshed = refresh_prod_token(creds)
        if refreshed:
            # Resolve the effective workspace before EESEL_AGENT, so an agent
            # named by env resolves against the workspace we'll actually query.
            _apply_effective_workspace(refreshed)
            return _use_creds(refreshed)
        # Refresh failed. If the access token is already dead we can't proceed;
        # if it's merely near expiry, fall through and use it for this command.
        if time.time() > expires_at:
            err("Session expired and refresh failed. Run `eesel login` again.")
            sys.exit(1)
    # Dev tokens (and any login without a refresh token) can't be renewed.
    elif expires_at and time.time() > expires_at:
        err("Token expired. Run `eesel login` again.")
        sys.exit(1)

    _apply_effective_workspace(creds)
    return _use_creds(creds)


# ──────────────────────────────────────────────────────────────────────────
# Sessions
# ──────────────────────────────────────────────────────────────────────────


def _session_path(sid: str) -> Path:
    return SESSIONS_DIR / f"{sid}.json"


def list_sessions() -> list[dict]:
    if not SESSIONS_DIR.exists():
        return []
    out = []
    for p in SESSIONS_DIR.glob("*.json"):
        try:
            out.append(json.loads(p.read_text()))
        except Exception:
            continue
    out.sort(key=lambda s: s.get("updated_at", 0), reverse=True)
    return out


def load_session(sid: str) -> dict | None:
    p = _session_path(sid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def save_session(sess: dict) -> None:
    ensure_dirs()
    sess["updated_at"] = time.time()
    _atomic_write(_session_path(sess["id"]), json.dumps(sess, indent=2))


def delete_session(sid: str) -> bool:
    p = _session_path(sid)
    if p.exists():
        p.unlink()
        cur = load_current()
        if cur == sid:
            CURRENT_FILE.unlink(missing_ok=True)
        return True
    return False


def load_current() -> str | None:
    if not CURRENT_FILE.exists():
        return None
    try:
        return json.loads(CURRENT_FILE.read_text()).get("session_id")
    except Exception:
        return None


def set_current(sid: str | None) -> None:
    ensure_dirs()
    if sid is None:
        CURRENT_FILE.unlink(missing_ok=True)
        return
    _atomic_write(CURRENT_FILE, json.dumps({"session_id": sid}, indent=2))


def _pinned_session_id() -> str | None:
    """The session id pinned for this whole run via EESEL_SESSION, or None.

    Mirrors EESEL_BASE_URL: an agent driving several `eesel chat` runs in
    parallel sets a distinct EESEL_SESSION per run, so each run reads and writes
    only its own session file and never touches the shared current.json pointer —
    which removes the race where two unscoped runs fight over which session is
    active. The value is used directly as the session filename stem, so it is
    validated like any other id bound for the filesystem: `EESEL_SESSION=../creds`
    is rejected before it can escape the sessions directory."""
    raw = os.environ.get("EESEL_SESSION")
    if raw is None or not raw.strip():
        return None
    return validate_id(raw.strip(), "EESEL_SESSION")


def ensure_current_session(creds: dict, agent_id: str | None = None, *, agent_explicit: bool = False) -> dict:
    """Return the active session, creating one if needed.

    If a turn names an agent, only reuse an active session for that same agent;
    otherwise the message would go to the session's agent, not the named one.

    When EESEL_SESSION is set, that id *is* this run's session: it is reused if
    the file exists, else created with that id, and the shared current.json
    pointer is never read or written — so parallel runs with distinct
    EESEL_SESSION values can't interleave into one session.

    `agent_explicit` marks that `agent_id` came from an explicit `--agent` flag
    or the EESEL_AGENT env var (not an auto-picked sole agent). When an explicit
    agent conflicts with a pinned session's agent, the run is aborted rather than
    silently routed to the pinned session's agent — a non-interactive agent must
    not have its target swapped without notice.
    """
    pinned = _pinned_session_id()
    if pinned is not None:
        sess = load_session(pinned)
        if sess is None:
            return new_session(creds, agent_id=agent_id, name=None, switch_to=False, session_id=pinned)
        if agent_id is not None and sess.get("agent_id") != agent_id:
            if agent_explicit:
                # An explicit --agent/EESEL_AGENT disagrees with the pinned
                # session's agent. Routing the turn to the pinned session would
                # send it to the wrong agent with no signal — a silent target
                # swap that's unsafe for an unattended agent. Fail loud instead.
                err(f"session {sess['id']} (pinned via EESEL_SESSION) belongs to agent "
                    f"{str(sess.get('agent_id'))[:8]}, but --agent/EESEL_AGENT names agent "
                    f"{agent_id[:8]}. Refusing to route the turn to a different agent than "
                    "requested. Unset EESEL_SESSION, or drop the explicit agent to use the "
                    "pinned session's agent.")
                sys.exit(EXIT_VALIDATION)
            # The agent was auto-selected (sole agent), not explicitly requested.
            # The pin is an explicit per-run choice, so it wins; note the mismatch
            # rather than forking the pinned id.
            info(f"session {sess['id']} (pinned via EESEL_SESSION) belongs to agent "
                 f"{str(sess.get('agent_id'))[:8]}; the turn's agent is {agent_id[:8]} — "
                 "using the pinned session.")
        return sess
    sid = load_current()
    sess = load_session(sid) if sid else None
    if sess and (agent_id is None or sess.get("agent_id") == agent_id):
        return sess
    if sess and agent_id is not None:
        info(f"active session {sess['id']} belongs to agent "
             f"{str(sess.get('agent_id'))[:8]}; starting a new session for agent "
             f"{agent_id[:8]}.")
    return new_session(creds, agent_id=agent_id, name=None, switch_to=True)


def find_session_by_task(task_id: str) -> dict | None:
    """Find the local session bound to a backend task id, if any."""
    for sess in list_sessions():
        if sess.get("task_id") == task_id:
            return sess
    return None


def new_session(creds: dict, *, agent_id: str | None, name: str | None, switch_to: bool = True, trigger_id: str | None = None, trigger_title: str | None = None, task_id: str | None = None, session_id: str | None = None) -> dict:
    # `session_id` is set only by the EESEL_SESSION path, which pins a run to a
    # caller-chosen id (already validated) instead of the generated 12-hex one.
    sid = session_id or uuid.uuid4().hex[:12]
    sess = {
        "id": sid,
        "name": name or f"chat-{datetime.now().strftime('%Y%m%d-%H%M')}",
        "agent_id": agent_id or creds.get("agent_id"),
        "workspace_id": creds["workspace_id"],
        "task_id": task_id or str(uuid.uuid4()),
        "messages": [],
        "created_at": time.time(),
        "updated_at": time.time(),
    }
    if trigger_id:
        sess["trigger_id"] = trigger_id
        sess["trigger_title"] = trigger_title
    save_session(sess)
    if switch_to:
        set_current(sid)
    return sess


