def _is_tty() -> bool:
    return sys.stdout.isatty()


def _color(s: str, code: str) -> str:
    if not _is_tty():
        return s
    return f"\033[{code}m{s}\033[0m"


def info(msg: str) -> None:
    print(_color(msg, "2;37"), file=sys.stderr)  # dim


def warn(msg: str) -> None:
    print(_color(f"! {msg}", "33"), file=sys.stderr)


def err(msg: str) -> None:
    print(_color(f"✗ {msg}", "31"), file=sys.stderr)


def ok(msg: str) -> None:
    print(_color(f"✓ {msg}", "32"), file=sys.stderr)


def confirm(prompt: str) -> bool:
    """Ask a yes/no question on stderr and return True only on an explicit yes.

    The prompt is written to stderr (not stdout) so that piping a command's
    output to a file — e.g. `eesel ... > out.txt` — never captures the prompt
    text. Anything other than "y" or "yes" (case-insensitive), including an
    empty line or EOF on a non-interactive stdin, counts as "no", so
    destructive operations default to not happening.
    """
    print(_color(prompt, "33"), end="", file=sys.stderr, flush=True)
    try:
        answer = input().strip().lower()
    except EOFError:
        return False
    return answer in ("y", "yes")


# ──────────────────────────────────────────────────────────────────────────
# Interactive selection (arrow-key menu)
# ──────────────────────────────────────────────────────────────────────────


def _read_key(fd: int) -> str:
    """Read one keypress from the raw fd (already in cbreak mode) and normalize.

    Returns one of: 'up', 'down', 'left', 'right', 'enter', 'esc', 'ctrl-c',
    or the raw single character for anything else.

    Reads bytes straight off the fd with os.read (not sys.stdin.read): a
    TextIOWrapper would buffer ahead, and select() — which only sees the OS-level
    fd — would then disagree with what's actually been consumed.
    """
    import select

    ch = os.read(fd, 1)
    if ch == b"\x03":
        return "ctrl-c"
    if ch in (b"\r", b"\n"):
        return "enter"
    if ch == b"\x1b":
        # Distinguish a lone Esc from an arrow-key escape sequence. Arrow keys
        # arrive as a complete "\x1b[A" burst, so if nothing is queued right
        # after the Esc it was a bare Esc keypress.
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r or os.read(fd, 1) != b"[":
            return "esc"
        r, _, _ = select.select([fd], [], [], 0.05)
        if not r:
            return "esc"
        return {b"A": "up", b"B": "down", b"C": "right", b"D": "left"}.get(os.read(fd, 1), "other")
    try:
        return ch.decode()
    except UnicodeDecodeError:
        return "other"


def _numbered_select(options: list[str], *, title: str | None = None) -> int | None:
    """Fallback picker for non-interactive terminals: print a numbered list and
    read an index. Returns the chosen index, or None if cancelled/invalid."""
    if title:
        print(title, file=sys.stderr)
    for i, opt in enumerate(options):
        print(f"  [{i}] {opt}", file=sys.stderr)
    try:
        raw = input("> ").strip()
    except (EOFError, KeyboardInterrupt):
        return None
    try:
        idx = int(raw)
    except ValueError:
        return None
    return idx if 0 <= idx < len(options) else None


def interactive_select(options: list[str], *, title: str | None = None, initial: int = 0) -> int | None:
    """Show an arrow-key navigable menu and return the chosen index.

    ↑/↓ (or k/j) move, Enter confirms, q/Esc/Ctrl-C cancel (returns None). Falls
    back to a numbered text prompt when stdin/stderr isn't an interactive TTY or
    raw-mode control is unavailable (e.g. Windows). The menu renders to stderr
    so command stdout stays clean.
    """
    if not options:
        return None
    try:
        import termios
        import tty
    except ImportError:
        return _numbered_select(options, title=title)
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        return _numbered_select(options, title=title)

    out = sys.stderr
    idx = max(0, min(initial, len(options) - 1))

    def render(first: bool) -> None:
        if not first:
            out.write(f"\033[{len(options)}A")  # back to the top of the list
        for i, opt in enumerate(options):
            marker = "❯" if i == idx else " "
            line = f"{marker} {opt}"
            if i == idx:
                line = f"\033[36m{line}\033[0m"  # cyan highlight
            out.write(f"\r\033[K{line}\n")
        out.flush()

    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
    except termios.error:
        # isatty() lied (e.g. a pipe masquerading as a tty) — degrade gracefully.
        return _numbered_select(options, title=title)

    if title:
        out.write(title + "\n")
    out.write("\033[?25l")  # hide cursor
    out.flush()
    chosen: int | None = idx
    try:
        tty.setcbreak(fd)
        render(first=True)
        while True:
            key = _read_key(fd)
            if key in ("ctrl-c", "esc", "q"):
                chosen = None
                break
            if key in ("up", "k"):
                idx = (idx - 1) % len(options)
                render(first=False)
            elif key in ("down", "j"):
                idx = (idx + 1) % len(options)
                render(first=False)
            elif key == "enter":
                chosen = idx
                break
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write("\033[?25h")  # restore cursor
        out.flush()
    return chosen


# ──────────────────────────────────────────────────────────────────────────
# Config / credentials
# ──────────────────────────────────────────────────────────────────────────


def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)


def load_creds() -> dict | None:
    if not CREDS_FILE.exists():
        return None
    try:
        return json.loads(CREDS_FILE.read_text())
    except Exception:
        return None


def save_creds(creds: dict) -> None:
    ensure_dirs()
    CREDS_FILE.write_text(json.dumps(creds, indent=2))
    try:
        os.chmod(CREDS_FILE, 0o600)
    except OSError:
        pass


def require_creds() -> dict:
    creds = load_creds()
    if not creds:
        err("Not logged in. Run `eesel login` first.")
        sys.exit(1)
    if creds.get("expires_at") and time.time() > creds["expires_at"]:
        err("Token expired. Run `eesel login` again.")
        sys.exit(1)
    return creds


# ──────────────────────────────────────────────────────────────────────────
# Sessions
# ──────────────────────────────────────────────────────────────────────────


def _session_path(sid: str) -> Path:
    return SESSIONS_DIR / f"{sid}.json"


def list_sessions() -> list[dict]:
    if not SESSIONS_DIR.exists():
        return []
    out = []
    for p in SESSIONS_DIR.glob("*.json"):
        try:
            out.append(json.loads(p.read_text()))
        except Exception:
            continue
    out.sort(key=lambda s: s.get("updated_at", 0), reverse=True)
    return out


def load_session(sid: str) -> dict | None:
    p = _session_path(sid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def save_session(sess: dict) -> None:
    ensure_dirs()
    sess["updated_at"] = time.time()
    _session_path(sess["id"]).write_text(json.dumps(sess, indent=2))


def delete_session(sid: str) -> bool:
    p = _session_path(sid)
    if p.exists():
        p.unlink()
        cur = load_current()
        if cur == sid:
            CURRENT_FILE.unlink(missing_ok=True)
        return True
    return False


def load_current() -> str | None:
    if not CURRENT_FILE.exists():
        return None
    try:
        return json.loads(CURRENT_FILE.read_text()).get("session_id")
    except Exception:
        return None


def set_current(sid: str | None) -> None:
    ensure_dirs()
    if sid is None:
        CURRENT_FILE.unlink(missing_ok=True)
        return
    CURRENT_FILE.write_text(json.dumps({"session_id": sid}, indent=2))


def ensure_current_session(creds: dict, agent_id: str | None = None) -> dict:
    """Return the active session, creating one if needed."""
    sid = load_current()
    sess = load_session(sid) if sid else None
    if sess:
        return sess
    return new_session(creds, agent_id=agent_id, name=None, switch_to=True)


def find_session_by_task(task_id: str) -> dict | None:
    """Find the local session bound to a backend task id, if any."""
    for sess in list_sessions():
        if sess.get("task_id") == task_id:
            return sess
    return None


def new_session(creds: dict, *, agent_id: str | None, name: str | None, switch_to: bool = True, trigger_id: str | None = None, trigger_title: str | None = None, task_id: str | None = None) -> dict:
    sid = uuid.uuid4().hex[:12]
    sess = {
        "id": sid,
        "name": name or f"chat-{datetime.now().strftime('%Y%m%d-%H%M')}",
        "agent_id": agent_id or creds.get("agent_id"),
        "workspace_id": creds["workspace_id"],
        "task_id": task_id or str(uuid.uuid4()),
        "messages": [],
        "created_at": time.time(),
        "updated_at": time.time(),
    }
    if trigger_id:
        sess["trigger_id"] = trigger_id
        sess["trigger_title"] = trigger_title
    save_session(sess)
    if switch_to:
        set_current(sid)
    return sess


