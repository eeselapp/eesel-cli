def fetch_agents(creds: dict) -> list[dict]:
    """Return list of {agent_id, name, agent_type} for the workspace."""
    url = f"{creds['api_url']}/agents?{urllib.parse.urlencode({'workspace_id': creds['workspace_id']})}"
    data = http_request("GET", url, token=creds["token"])
    # Response shape varies; normalize.
    items = data if isinstance(data, list) else data.get("agents") or data.get("items") or []
    return items


# ── Legacy v2 namespaces (bots) ───────────────────────────────────────────
# The legacy platform's unit is a "namespace" (user-facing "bot"), addressed by
# `id`, with a display name in the `namespace` field. These mirror the agent
# resolvers so the same --agent/EESEL_AGENT scoping resolves a bot in legacy mode.


def fetch_namespaces(creds: dict) -> list[dict]:
    """Return the workspace's legacy v2 namespaces from GET /namespaces.

    The endpoint is user-scoped (resolved from the token), so no query param.
    Response is `{namespaces: [...]}`; a bare list is tolerated.
    """
    data = http_request("GET", f"{creds['api_url']}/namespaces", token=creds.get("token"))
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        return data.get("namespaces") or data.get("items") or []
    return []


def match_namespaces(namespaces: list[dict], target: str) -> list[dict]:
    """Namespaces matching `target`, in resolution-priority order: exact id,
    then id-prefix, then exact `namespace` (name). A blank target matches
    nothing (so it can't resolve as a lone match on a single-bot workspace).
    Mirrors `match_agents`."""
    if not (target or "").strip():
        return []
    exact_id = [n for n in namespaces if n.get("id") == target]
    if exact_id:
        return exact_id
    prefix = [n for n in namespaces if (n.get("id") or "").startswith(target)]
    name = [n for n in namespaces if n.get("namespace") == target and n not in prefix]
    return prefix + name


def resolve_namespace(namespaces: list[dict], target: str) -> dict | None:
    """First namespace matching `target`, or None (first-match; arbitrary
    tie-break). Use `resolve_namespace_strict` where ambiguity must be refused."""
    matches = match_namespaces(namespaces, target)
    return matches[0] if matches else None


def resolve_namespace_strict(namespaces: list[dict], target: str) -> tuple[dict | None, list[dict]]:
    """Resolve `target` to exactly one namespace. Returns (ns, []) on a unique
    match, (None, candidates) when more than one matches, (None, []) when none."""
    matches = match_namespaces(namespaces, target)
    if len(matches) == 1:
        return matches[0], []
    return None, matches


# ── Legacy v2 connections + configuration ─────────────────────────────────
# Legacy "connections" are the v2 equivalent of integrations. The system prompt
# is NOT a namespace field — it's a config entry named `customPrompt` on the
# connection whose type is `eesel`.
CONNECTION_TYPE_EESEL = "eesel"
CONNECTION_CONFIG_CUSTOM_PROMPT = "customPrompt"


def fetch_namespace_connections(creds: dict, namespace_id: str) -> list[dict]:
    """A namespace's connections from GET /namespaces/{id}/connections."""
    nid = validate_id(namespace_id, "namespace id")
    data = http_request("GET", f"{creds['api_url']}/namespaces/{nid}/connections", token=creds.get("token"))
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        return data.get("connections") or []
    return []


def fetch_connection(creds: dict, connection_id: str) -> dict:
    """One connection's detail from GET /connections/{id}."""
    cid = validate_id(connection_id, "connection id")
    data = http_request("GET", f"{creds['api_url']}/connections/{cid}", token=creds.get("token"))
    return data if isinstance(data, dict) else {"result": data}


def fetch_connection_config(creds: dict, connection_id: str, params: str | None = None) -> list[dict]:
    """A connection's configuration entries from GET
    /connections/{id}/configuration. `params` optionally filters to
    comma-separated entry names (e.g. "customPrompt"). Returns the
    `configurationEntries` list."""
    cid = validate_id(connection_id, "connection id")
    url = f"{creds['api_url']}/connections/{cid}/configuration"
    if params:
        url += "?" + urllib.parse.urlencode({"params": params})
    data = http_request("GET", url, token=creds.get("token"))
    if isinstance(data, dict):
        return data.get("configurationEntries") or []
    if isinstance(data, list):
        return data
    return []


def get_namespace_prompt(creds: dict, namespace_id: str) -> str:
    """The namespace's system prompt: the `customPrompt` config entry on its
    `eesel` connection. Empty string when there's no eesel connection or no
    customPrompt entry (a clean 'no prompt set')."""
    conns = fetch_namespace_connections(creds, namespace_id)
    eesel_conn = next((c for c in conns if c.get("connectionType") == CONNECTION_TYPE_EESEL), None)
    if not eesel_conn:
        return ""
    entries = fetch_connection_config(creds, eesel_conn.get("connectionId"), params=CONNECTION_CONFIG_CUSTOM_PROMPT)
    entry = next((e for e in entries if e.get("name") == CONNECTION_CONFIG_CUSTOM_PROMPT), None)
    return (entry.get("value") if entry else "") or ""


# ── Legacy v2 chat history (sessions) ─────────────────────────────────────


def fetch_session(creds: dict, namespace_id: str, session_id: str) -> dict:
    """One conversation's full transcript from
    GET /v2/namespaces/{id}/sessions/{sessionId}."""
    nid = validate_id(namespace_id, "namespace id")
    sid = validate_id(session_id, "session id")
    data = http_request("GET", f"{creds['api_url']}/v2/namespaces/{nid}/sessions/{sid}", token=creds.get("token"))
    return data if isinstance(data, dict) else {"result": data}


def fetch_sessions(creds: dict, namespace_id: str, *, limit: int = 50, search: str | None = None) -> list[dict]:
    """List chat sessions from GET /v2/namespaces/{id}/sessions, following the
    opaque `lastEvaluatedKey` cursor internally until `limit` rows are gathered
    (or the source is exhausted)."""
    nid = validate_id(namespace_id, "namespace id")
    base = f"{creds['api_url']}/v2/namespaces/{nid}/sessions"
    out: list[dict] = []
    cursor: str | None = None
    while len(out) < limit:
        params: dict = {"limit": limit}
        if search:
            params["search"] = search
        if cursor:
            params["lastEvaluatedKey"] = cursor
        data = http_request("GET", f"{base}?{urllib.parse.urlencode(params)}", token=creds.get("token"))
        page = data.get("sessions") if isinstance(data, dict) else (data if isinstance(data, list) else [])
        out.extend(page or [])
        cursor = data.get("lastEvaluatedKey") if isinstance(data, dict) else None
        if not cursor or not page:
            break
    return out[:limit]


def match_agents(agents: list[dict], target: str) -> list[dict]:
    """All agents matching `target`, in resolution-priority order: an exact id
    first, then id-prefix matches, then exact-name matches.

    An exact id is unique, so it short-circuits to a single result. The same
    agent never appears twice (a prefix match isn't re-listed as a name match),
    so callers can count the result to detect ambiguity.

    A blank/whitespace target matches nothing (returns `[]`). An empty string is
    a prefix of every id, so without this guard a blank target would match every
    agent — and on a single-agent workspace that lone match would resolve as
    "unique" and let a destructive command act on it with no real target given.
    """
    if not (target or "").strip():
        return []
    exact_id = [a for a in agents if a.get("agent_id") == target]
    if exact_id:
        return exact_id
    prefix = [a for a in agents if (a.get("agent_id") or "").startswith(target)]
    name = [a for a in agents if a.get("name") == target and a not in prefix]
    return prefix + name


def resolve_agent(agents: list[dict], target: str) -> dict | None:
    """First agent matching `target` by exact id, id-prefix, then exact name,
    or None. First-match, for lookups where an arbitrary tie-break is
    acceptable; agent-scoped commands use `resolve_agent_or_error`, which
    refuses ambiguity instead of acting on an arbitrary match."""
    matches = match_agents(agents, target)
    return matches[0] if matches else None


def resolve_agent_strict(agents: list[dict], target: str) -> tuple[dict | None, list[dict]]:
    """Resolve `target` to exactly one agent. Returns (agent, []) on a unique
    match, (None, candidates) when more than one matches, and (None, []) when
    none do. Used by write/destructive commands, which must not act on an
    arbitrary first match when a prefix or name is ambiguous."""
    matches = match_agents(agents, target)
    if len(matches) == 1:
        return matches[0], []
    return None, matches


def build_agent_create_body(workspace_id: str, name: str, instructions: str | None = None) -> dict:
    """Request body for `POST /agents`. `workspace_id` comes from stored creds,
    never a flag. New agents are created live (`is_active=true`). Instructions
    are optional and ride the `prompt` wire field (what `eesel instructions`
    reads back); an empty string is sent when none are given."""
    return {
        "workspace_id": workspace_id,
        "name": name,
        "prompt": instructions or "",
        "is_active": True,
    }


def build_agent_update_body(*, name: str | None = None, instructions: str | None = None) -> dict:
    """Request body for `PUT /agents/{id}`, containing only the fields the user
    actually passed. The server uses unset-exclusion, so a field left out is
    untouched. Instructions ride the `prompt` wire field."""
    body: dict = {}
    if name is not None:
        body["name"] = name
    if instructions is not None:
        body["prompt"] = instructions
    return body


def fetch_triggers(creds: dict, agent_id: str) -> list[dict]:
    """Return list of triggers for one agent."""
    url = f"{creds['api_url']}/agents/{agent_id}/triggers"
    data = http_request("GET", url, token=creds["token"])
    return data.get("triggers") or []


def fetch_all_triggers(creds: dict) -> list[dict]:
    """Return every trigger across all agents in the workspace.

    Each row is the raw trigger dict, augmented with `agent_id` and
    `agent_name` for display. One agent's failure is warned and skipped so a
    single broken agent can't blank the whole list.
    """
    out = []
    for a in fetch_agents(creds):
        agent_id = a.get("agent_id")
        if not agent_id:
            continue
        try:
            for t in fetch_triggers(creds, agent_id):
                t["agent_id"] = agent_id
                t["agent_name"] = a.get("name") or "?"
                out.append(t)
        except Exception as e:  # one agent's failure shouldn't kill the list
            warn(f"Couldn't list triggers for {a.get('name', agent_id)}: {e}")
    return out


# A scheduled job is stored on the backend as a trigger whose `trigger_key` is
# this sentinel. Everything else (`zendesk_ticket_created`, etc.) is an
# event/webhook trigger. The CLI surfaces the two as separate sub-namespaces
# (`eesel automations schedules` vs `eesel automations triggers`) even though
# they share one endpoint.
SCHEDULED_TRIGGER_KEY = "eesel_scheduled"


def fetch_all_scheduled_jobs(creds: dict) -> list[dict]:
    """Scheduled jobs across the workspace — the subset of `fetch_all_triggers`
    whose `trigger_key` is the scheduled-job sentinel."""
    return [t for t in fetch_all_triggers(creds) if t.get("trigger_key") == SCHEDULED_TRIGGER_KEY]


def fetch_all_event_triggers(creds: dict) -> list[dict]:
    """Event/webhook triggers across the workspace — every trigger that is not a
    scheduled job."""
    return [t for t in fetch_all_triggers(creds) if t.get("trigger_key") != SCHEDULED_TRIGGER_KEY]


def fetch_integrations(creds: dict, *, agent_id: str | None = None) -> list[dict]:
    """List the workspace's integrations.

    Passing ``agent_id`` makes the server compute connection status against
    that agent. The response is a flat list of serialized integration dicts:
    id, integrationType, connectionStatus, identifier (subdomain), properties.
    """
    params = {"agent_id": agent_id} if agent_id else {}
    qs = f"?{urllib.parse.urlencode(params)}" if params else ""
    data = http_request("GET", f"{creds['api_url']}/integrations{qs}", token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("integrations") or data.get("items") or []


def fetch_integration_definitions(creds: dict) -> list[dict]:
    """List the connectable integration types — the catalog of what *can* be
    connected, as opposed to what already is (`fetch_integrations`).

    GET /integration-definitions returns ``{categories, integrations}``; this
    returns the ``integrations`` list (tolerating a bare-list or ``items``
    shape too). Each definition carries a ``key`` (the connector identifier
    passed to ``eesel integrations connect <key>``), ``title``, ``category``,
    and ``connection_options`` — the list of ways to connect it, each with a
    ``type`` (the value for ``connect --option``), ``handler_type``
    (``submit`` = direct POST, ``redirect`` = browser OAuth), an ``endpoint``,
    and a field ``schema``.
    """
    data = http_request("GET", f"{creds['api_url']}/integration-definitions", token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("integrations") or data.get("items") or []


def fetch_integration_definition(creds: dict, key: str) -> dict | None:
    """One connectable type's definition from GET /integration-definitions/{key}
    (the response wraps it under ``integration``), or None if there's no such
    connector. `connect` uses this to read just the target's connection_options
    rather than transferring the whole catalog."""
    status, data = http_request_allow_error(
        "GET", f"{creds['api_url']}/integration-definitions/{urllib.parse.quote(key)}", token=creds["token"]
    )
    if status >= 400 or not isinstance(data, dict):
        return None
    return data.get("integration")


def _connection_options(definition: dict) -> list[dict]:
    """The connection options for one integration definition. The server has
    used both snake_case and camelCase for this field, so accept either."""
    return (definition or {}).get("connection_options") or (definition or {}).get("connectionOptions") or []


def match_integrations(integrations: list[dict], target: str) -> list[dict]:
    """All connected integrations matching `target`, in resolution-priority
    order: an exact id first, then id-prefix matches, then exact integration
    type (e.g. ``zendesk``). The same integration never appears twice, so
    callers can count the result to detect ambiguity. A blank/whitespace target
    matches nothing, so a destructive command can't act on the sole integration
    when no real target was given (an empty string prefixes every id)."""
    if not (target or "").strip():
        return []
    exact = [it for it in integrations if str(it.get("id")) == target]
    if exact:
        return exact
    prefix = [it for it in integrations if str(it.get("id") or "").startswith(target)]
    by_type = [it for it in integrations if it.get("integrationType") == target and it not in prefix]
    return prefix + by_type


def resolve_integration(integrations: list[dict], target: str) -> dict | None:
    """First integration matching `target` by exact id, id-prefix, then type, or
    None. First-match — used by the read view (`integrations show`). The
    destructive disconnect path uses `resolve_integration_strict`, which refuses
    an ambiguous value rather than acting on an arbitrary match."""
    matches = match_integrations(integrations, target)
    return matches[0] if matches else None


def resolve_integration_strict(integrations: list[dict], target: str) -> dict | None:
    """Resolve `target` to exactly one integration for a destructive command, or
    print why it could not (no match, or ambiguous with the candidates listed)
    and return None. Disconnecting removes the integration and its synced
    knowledge, so it must not act on an arbitrary first match."""
    matches = match_integrations(integrations, target)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        err(f"No connected integration matches '{target}'. Run `eesel integrations list`.")
        return None
    err(f"'{target}' is ambiguous — it matches {len(matches)} integrations:")
    for it in matches:
        line = f"  {it.get('id', '?')}  {it.get('integrationType', '?')}"
        if it.get("identifier"):
            line += f"  {it['identifier']}"
        err(line)
    err("Re-run with a full integration id to disambiguate.")
    return None


def fetch_tools(creds: dict, agent_id: str) -> list[dict]:
    """List the tools/actions configured for one agent.

    Each entry carries tool_key, name, tool_action (read/write), permission_mode,
    integration_id, is_connected, and a nested ``config.tool_data`` holding the
    integration_key. The endpoint returns a bare JSON array.
    """
    data = http_request("GET", f"{creds['api_url']}/agents/{agent_id}/tools", token=creds["token"])
    if isinstance(data, list):
        return data
    return data.get("tools") or []


def _is_sysadmin(creds: dict) -> bool:
    """True if the caller is on the impersonator/sysadmin allowlist.

    Reuses the same introspection `whoami` uses (`/sysadmin/impersonator-status`,
    normalized to ``{"allowed": bool}``). Fails closed: any error means "not a
    sysadmin".
    """
    status = _get_impersonate_status(creds)
    return bool(status and status.get("allowed"))


def _tool_row(t: dict) -> dict:
    """Flatten a /agents/{id}/tools entry into the columns the actions commands print."""
    cfg = t.get("config") if isinstance(t.get("config"), dict) else {}
    tool_data = (cfg or {}).get("tool_data") or {}
    return {
        "name": t.get("name") or t.get("tool_key") or "?",
        "tool_key": t.get("tool_key") or "?",
        "action": (t.get("tool_action") or "").upper() or "?",
        "permission": t.get("permission_mode") or "?",
        "integration_key": t.get("integration_key") or tool_data.get("integration_key") or "—",
        "integration_id": t.get("integration_id") or "—",
        "connected": bool(t.get("is_connected")),
    }


# Field names that mark a value as secret. Masking is a substring match against
# this fixed list (case-insensitive), so it is a best-effort guard, not an
# exhaustive classifier. Known gaps to be aware of before trusting it:
#   - Only these hint words match. A field named `bearer`, `pat`, `signature`,
#     or a bare `key` is NOT masked because none contain one of these substrings.
#   - Only non-empty *string* values are masked (see `_redact_secrets`). A secret
#     stored as a number or other non-string type is left in the clear.
# Adequate for eesel's real property names, which use these words; extend the
# list (and reconsider the string-only rule) if a new field carries a secret
# under a name or type not covered here.
_SECRET_KEY_HINTS = (
    "token", "secret", "password", "passwd", "credential",
    "api_key", "apikey", "private_key", "authorization", "access_key",
)


def _redact_secrets(obj):
    """Recursively copy obj, masking scalar values that look sensitive.

    Two shapes are masked, both used by the read-only views that print
    config/properties inline:

    - a dict value whose *key* looks sensitive, e.g. ``{"access_token": "..."}``
      (trigger/schedule config); and
    - an integration property entry ``{"key": "...access_token", "value": "..."}``,
      where the secret-looking name is the value of the ``key`` field rather than
      a dict key — so keying off dict keys alone would miss it.

    Anything secret-looking (`token`, `secret`, `password`, …) is replaced with
    ``"***"``. The raw values are reachable via the API, or via `--json` only with
    `--secrets` on a sysadmin/impersonator account.
    """
    if isinstance(obj, dict):
        # Property-entry shape: the secret name lives in the value of "key", so
        # the sibling "value" field is what must be masked.
        prop_key = obj.get("key")
        prop_is_secret = isinstance(prop_key, str) and any(h in prop_key.lower() for h in _SECRET_KEY_HINTS)
        out = {}
        for k, v in obj.items():
            key_is_secret = isinstance(k, str) and any(h in k.lower() for h in _SECRET_KEY_HINTS)
            mask = key_is_secret or (k == "value" and prop_is_secret)
            # Only a non-empty *string* is secret material. This deliberately
            # spares numbers and booleans, whose keys can collide with a hint
            # substring without being secrets — `has_auth_token: true` (a
            # presence flag) and `input_tokens: 1234` (a usage count) both match
            # "token" but carry no secret, and masking them would destroy real
            # information while protecting nothing.
            if mask and isinstance(v, str) and v:
                out[k] = "***"
            else:
                out[k] = _redact_secrets(v)
        return out
    if isinstance(obj, list):
        return [_redact_secrets(v) for v in obj]
    return obj


def _trigger_integration_label(t: dict, id_to_type: dict) -> str:
    """Group label for an event/webhook trigger: the resolved integration type
    when known, else the trigger_key's prefix (e.g. ``zendesk_ticket_created`` →
    ``zendesk``), else a catch-all."""
    iid = t.get("integration_id")
    if iid and id_to_type.get(iid):
        return id_to_type[iid]
    key = t.get("trigger_key") or ""
    if "_" in key:
        return key.split("_", 1)[0]
    return key or "other"


def match_scheduled_jobs(rows: list[dict], target: str) -> list[dict]:
    """All scheduled jobs matching `target`, in resolution-priority order: an
    exact id first, then id-prefix matches, then a case-insensitive substring of
    config.title. The same job never appears twice, so callers can count the
    result to detect ambiguity. A blank/whitespace target matches nothing, so a
    destructive command can't act on the sole job when no real target was given
    (an empty string both prefixes every id and is a substring of every title)."""
    if not (target or "").strip():
        return []
    exact = [t for t in rows if t.get("id") == target]
    if exact:
        return exact
    prefix = [t for t in rows if (t.get("id") or "").startswith(target)]
    needle = target.lower()
    by_title = [
        t for t in rows
        if needle in ((t.get("config") or {}).get("title") or "").lower() and t not in prefix
    ]
    return prefix + by_title


def resolve_scheduled_job(creds: dict, target: str) -> dict | None:
    """First scheduled job matching `target` by exact id, id-prefix, then title
    substring, or None. First-match — used by the preview binds (`chat
    --schedule`, `new --schedule`). The `fire`/`remove` paths use
    `resolve_scheduled_job_strict`, which refuses an ambiguous value rather than
    acting on an arbitrary match.

    `target` may be a job *title* substring containing `/`, `%`, etc., so it is
    resolved first; only the resolved job id — the value that becomes a URL path
    segment — is validated."""
    matches = match_scheduled_jobs(fetch_all_scheduled_jobs(creds), target)
    if not matches:
        return None
    validate_id(matches[0].get("id"), "scheduled job id")
    return matches[0]


def resolve_scheduled_job_strict(creds: dict, target: str) -> dict | None:
    """Resolve `target` to exactly one scheduled job for `fire`/`remove`, or
    print why it could not (no match, or ambiguous with the candidates listed)
    and return None. A title substring can match several jobs, so firing or
    deleting must not act on an arbitrary first match.

    A title substring can legitimately contain `/`, `%`, etc., so `target` is
    resolved first; only the resolved job id — the value that becomes a URL path
    segment — is validated."""
    matches = match_scheduled_jobs(fetch_all_scheduled_jobs(creds), target)
    if len(matches) == 1:
        validate_id(matches[0].get("id"), "scheduled job id")
        return matches[0]
    if not matches:
        err(f"No scheduled job matches '{target}'.")
        info("Run `eesel automations schedules list` to see available jobs.")
        return None
    err(f"'{target}' is ambiguous — it matches {len(matches)} scheduled jobs:")
    for t in matches:
        title = (t.get("config") or {}).get("title") or "(untitled)"
        err(f"  {t.get('id', '?')}  {title}")
    err("Re-run with a full job id to disambiguate.")
    return None


def resolve_session_agent(creds: dict) -> tuple[str | None, str | None]:
    """Resolve the agent a session runs against, without any interaction.

    Returns ``(agent_id, None)`` when the agent is unambiguous — an already
    applied `--agent`/`EESEL_AGENT` (`creds["agent_id"]`, set in memory for this
    invocation) wins, else a single-agent workspace is used automatically. When
    it can't decide (no agents, or several with no scope) returns
    ``(None, reason)`` with a human-readable reason, so the caller decides how to
    surface it (stderr + exit for a human, a JSON error envelope for `--json`).
    Never prompts, never writes to stdout, never exits.
    """
    if creds.get("agent_id"):
        return creds["agent_id"], None
    agents = fetch_agents(creds)
    if not agents:
        return None, "No agents in workspace. Create one with `eesel agents create` first."
    if len(agents) == 1:
        return agents[0]["agent_id"], None
    listing = "; ".join(f"{a.get('agent_id', '?')} {a.get('name', '?')}" for a in agents)
    return None, (
        f"This workspace has {len(agents)} agents — name the one to use with "
        f"`--agent <id|name>`, EESEL_AGENT=<id|name>, or `eesel agents <id> chat …`. "
        f"Agents: {listing}"
    )


def pick_agent(creds: dict, *, prompt: bool = True) -> str:
    """Resolve the agent a session (chat / new) runs against, for a human caller.

    Uses `resolve_session_agent` for the unambiguous cases. With several agents
    and no scope, an interactive terminal shows a picker (asking, not silently
    guessing); a non-interactive/scripted run errors, so a script never talks to
    an arbitrary agent. The choice is never persisted — the next command must
    scope itself again. `--json` must not use this (its picker/errors go to
    stdout/exit); it calls `resolve_session_agent` directly.
    """
    if creds.get("agent_id"):
        return creds["agent_id"]
    agents = fetch_agents(creds)
    if not agents:
        sys.exit("No agents in workspace. Create one with `eesel agents create` first.")
    if len(agents) == 1:
        return agents[0]["agent_id"]
    if not (prompt and sys.stdin.isatty()):
        err(f"This workspace has {len(agents)} agents — name the one to use:")
        for a in agents:
            err(f"  {a.get('agent_id', '?')}  {a.get('name', '?')}")
        err("Pass `--agent <id|name>`, set EESEL_AGENT=<id|name>, or use "
            "`eesel agents <id> chat …`.")
        sys.exit(1)
    print("Pick an agent:")
    for i, a in enumerate(agents):
        print(f"  [{i}] {a.get('name', '?')}  ({a.get('agent_id', '?')[:8]})")
    try:
        idx = int(input("> ").strip())
        chosen = agents[idx]
    except (ValueError, IndexError):
        sys.exit("Invalid choice.")
    return chosen["agent_id"]


