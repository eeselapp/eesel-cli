def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="eesel", description=__doc__.strip().split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("login", help="Authenticate (browser-based, or --dev for local)")
    sp.add_argument("--dev", action="store_true", help="Mint local dev JWT, no browser")
    sp.add_argument("--workspace-id", help="Dev login only: workspace id to mint credentials for")
    sp.set_defaults(func=cmd_login)

    sp = sub.add_parser("logout", help="Clear stored credentials")
    sp.set_defaults(func=cmd_logout)

    sp = sub.add_parser("whoami", help="Show the current login")
    sp.set_defaults(func=cmd_whoami)

    sp = sub.add_parser("agents", help="List or switch agents")
    a_sub = sp.add_subparsers(dest="agents_cmd")
    a_sub.add_parser("list", help="List agents in this workspace")
    use = a_sub.add_parser("use", help="Set the active agent")
    use.add_argument("agent_id", help="Full id, id prefix, or agent name")
    sp.set_defaults(func=cmd_agents)

    sp = sub.add_parser("new", help="Start a new chat session")
    sp.add_argument("--agent", help="Agent id to use (default: active agent)")
    sp.add_argument("--name", help="Session name (default: auto)")
    sp.add_argument("--trigger", help="Bind session to a scheduled trigger (id-prefix or title substring) so the agent runs under that trigger's context (preview mode)")
    sp.set_defaults(func=cmd_new)

    sp = sub.add_parser("sessions", help="Manage chat sessions")
    s_sub = sp.add_subparsers(dest="sessions_cmd")
    s_sub.add_parser("list", help="List sessions")
    use = s_sub.add_parser("use", help="Switch active session")
    use.add_argument("session_id")
    de = s_sub.add_parser("delete", help="Delete a session")
    de.add_argument("session_id")
    show = s_sub.add_parser("show", help="Print session history")
    show.add_argument("session_id", nargs="?", help="(default: active session)")
    sp.set_defaults(func=cmd_sessions)

    sp = sub.add_parser("chat", help="Send a message (no arg = interactive REPL)")
    sp.add_argument("message", nargs="?", help="Message to send (omit for REPL)")
    sp.add_argument("--cost", action="store_true", help="After each reply, print a one-line cost + token summary for the whole session (incl. sub-agents)")
    sp.add_argument(
        "--trigger",
        help="Open a preview session bound to a scheduled trigger "
        "(id-prefix or title substring like 'heartbeat'). "
        "The agent runs under that trigger's context — "
        "useful for iterating on what the trigger would output",
    )
    sp.add_argument(
        "--task",
        help="Continue an existing conversation by its backend task id "
        "(e.g. one an agent included in an outbound request so your "
        "service can post the result back into the same conversation). "
        "Uses the active agent for new sessions",
    )
    sp.set_defaults(func=cmd_chat)

    sp = sub.add_parser("cost", help="Print cost + token usage for a session (includes sub-agents). Dev mode only.")
    sp.add_argument("session_id", nargs="?", help="(default: active session, prefix-match ok)")
    sp.set_defaults(func=cmd_cost)

    sp = sub.add_parser("document", help="List or export documents")
    d_sub = sp.add_subparsers(dest="document_cmd")
    ls = d_sub.add_parser("list", help="List documents in this workspace")
    ls.add_argument("--prefix", help="Filter by document key prefix")
    ls.add_argument("--search", help="Search document names/keys")
    ls.add_argument("--limit", type=int, default=100, help="Maximum documents to return")
    ls.add_argument("--offset", type=int, default=0, help="Pagination offset")
    exp = d_sub.add_parser("export", help="Download a document as markdown or HTML")
    target = exp.add_mutually_exclusive_group(required=True)
    target.add_argument("--document-key", help="Document key to export")
    target.add_argument("--document-id", help="Document id to export")
    exp.add_argument("--format", default="md", choices=["md", "html"], help="Export format")
    exp.add_argument("-o", "--output", help="Output file path")
    sp.set_defaults(func=cmd_document, document_cmd="list", prefix=None, search=None, limit=100, offset=0)

    sp = sub.add_parser("triggers", help="List or fire scheduled triggers")
    t_sub = sp.add_subparsers(dest="triggers_cmd")
    t_sub.add_parser("list", help="List scheduled triggers in this workspace")
    fire = t_sub.add_parser("fire", help="Manually fire a scheduled trigger")
    fire.add_argument("trigger_id", help="Full id, id prefix, or substring of the trigger title (e.g. 'heartbeat')")
    sp.set_defaults(func=cmd_triggers)

    # Staff-only. Hidden from `eesel --help` (still runnable if you know the
    # subcommand). Server-side allowlist is the actual gate; this just keeps
    # the command off regular customers' radar so they're not asking what it
    # does.
    #
    # argparse's `help=SUPPRESS` only blanks the description; the subcommand
    # name still shows up in the choices list as `impersonate ==SUPPRESS==`.
    # To fully hide we also drop the action from the subparser's
    # `_choices_actions` list. Private attr but a known idiom — Python core
    # ships it as `argparse._SubParsersAction._ChoicesPseudoAction`.
    sp = sub.add_parser(
        "impersonate",
        help=argparse.SUPPRESS,
        description="Act as another user — every subsequent `eesel` command runs "
        "in their workspace. Combine with `eesel chat --trigger heartbeat` "
        "to preview their heartbeat, or just `eesel chat` for general "
        "chat. WRITE tools are stubbed server-side so no real emails/"
        "replies fire. Requires a sysadmin/impersonator account.",
    )
    sub._choices_actions = [a for a in sub._choices_actions if a.dest != "impersonate"]
    # Take a positional that's either a user_id or the literal "clear".
    sp.add_argument(
        "user_id",
        nargs="?",
        help="Auth0 user id of the target (e.g. 'auth0|abc…', 'google-oauth2|…'). Pass 'clear' to drop the impersonation.",
    )
    sp.set_defaults(func=cmd_impersonate)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
