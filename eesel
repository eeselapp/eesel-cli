def cmd_triggers(args) -> int:
    """`eesel automations triggers`: event/webhook triggers (the ones that fire
    themselves on an external event). Scheduled jobs live under
    `eesel automations schedules`."""
    creds = require_creds()
    sub = args.triggers_cmd or "list"

