        return 0
    print("  instructions:")
    print()
    print(p)
    return 0


def _agents_legacy(args, creds: dict) -> int:
    """Dispatch the `agents` verbs on a legacy workspace (read-only). Write
    verbs are refused; the pre-dispatch guard normally catches them first, but
    this fails closed if one reaches here."""
    sub = args.agents_cmd or "list"
    if sub == "list":
        return _namespaces_list(args, creds)
    if sub == "show":
        if getattr(args, "show_instructions", False):
            args.agent = args.agent_id
            return cmd_instructions(args)
        return _namespace_show(args, creds)
    return _legacy_unsupported(f"agents {sub}")


def cmd_agents(args) -> int:
    creds = require_creds()
    if resolve_platform(creds, args) == PLATFORM_LEGACY:
        return _agents_legacy(args, creds)
    sub = args.agents_cmd or "list"
    if sub == "list":
        agents = fetch_agents(creds)
        if _want_json(args):
            emit(agents)
            return 0
        if getattr(args, "plain", False):
            for a in agents:
                state = "on" if a.get("is_active") else "off"
                print(f"{str(a.get('agent_id') or '')}\t{state}\t{str(a.get('name') or '')}")
            return 0
        if not agents:
            info("(no agents)")
            return 0
        for a in agents:
            # Status is a column, not a filter: every agent is listed, each with
            # its live/off state shown inline.
            status = "[on] " if a.get("is_active") else "[off]"
            print(
                f" {a.get('agent_id', '?')[:12]}  {status}  {a.get('name', '?')}"
                + (f"  [{a.get('agent_type')}]" if a.get("agent_type") else "")
            )
        return 0
    if sub == "show":
        if getattr(args, "show_instructions", False):
            # `agents <id> show --instructions` is the canonical way to print
            # just the prompt; route it through the same printer the aliases use.
            args.agent = args.agent_id
            return cmd_instructions(args)
        return _agents_get(args, creds)
    if sub == "create":
        return _agents_create(args, creds)
    if sub == "set":
        return _agents_update(args, creds)
    if sub == "remove":
        return _agents_delete(args, creds)
    return 1


def _agents_create(args, creds: dict) -> int:
    if not args.name:
        err("--name is required.")
        return 1
    body = build_agent_create_body(creds["workspace_id"], args.name, args.instructions)
    data = write_request("POST", f"{creds['api_url']}/agents", token=creds["token"], body=body)
    agent_id = data.get("agent_id") or data.get("id") or (data.get("agent") or {}).get("agent_id")
    if agent_id:
        ok(f"Created agent '{args.name}' ({agent_id})")
    else:
        ok(f"Created agent '{args.name}'")
        info("(server returned no id; run `eesel agents list` to confirm)")
    return 0


def _agents_update(args, creds: dict) -> int:
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    body = build_agent_update_body(name=args.name, instructions=args.instructions)
    if not body:
        err("Nothing to change. Pass --name and/or --instructions.")
        return 1
    aid = agent["agent_id"]
    write_request("PUT", f"{creds['api_url']}/agents/{aid}", token=creds["token"], body=body)
    # Read the record back rather than trusting the 200: confirm every field the
    # user changed now holds the value we sent.
    updated = http_request("GET", f"{creds['api_url']}/agents/{aid}", token=creds["token"])
    mismatched = [k for k, v in body.items() if updated.get(k) != v]
    if mismatched:
        err(f"Server accepted the change but {', '.join(mismatched)} did not update as sent.")
        return 1
    ok(f"Edited {updated.get('name') or agent.get('name')} ({aid}): {', '.join(body.keys())}")
    return 0


def _agents_delete(args, creds: dict) -> int:
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    if not args.force and not confirm(f"Remove agent '{agent.get('name')}' ({agent['agent_id']})? [y/N] "):
        info("Aborted.")
        return 1
    write_request("DELETE", f"{creds['api_url']}/agents/{agent['agent_id']}", token=creds["token"])
    ok(f"Removed {agent.get('name')} ({agent['agent_id']}).")
    return 0


def _agents_get(args, creds: dict) -> int:
    """Print one agent's full record: id, type, live/off status, description, and
    instructions. The agent listing already carries every field, so this resolves
    the target from that list rather than making a second call."""
    agent = resolve_agent_or_error(creds, args.agent_id)
    if not agent:
        return 1
    if _want_json(args):
        emit(agent)
        return 0
    print(f"{agent.get('name', '?')}  ({agent.get('agent_id', '')})")
    if agent.get("agent_type"):
        print(f"  type:    {agent['agent_type']}")
    print(f"  status:  {'live' if agent.get('is_active') else 'off'}")
    if agent.get("description"):
        print(f"  summary: {agent['description']}")
    prompt = (agent.get("prompt") or "").strip()
    if not prompt:
        print("  instructions: (none)")
