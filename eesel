# Chat — POST /agents/sandbox/start + stream
# ──────────────────────────────────────────────────────────────────────────


def send_message(creds: dict, sess: dict, message: str, *, render: bool = True) -> dict:
    """Send one user turn and return the turn as one envelope dict:
    ``{"task_id", "status": "completed"|"error", "reply", "tool_calls"[, "error"]}``.

    ``render`` (True by default) streams the reply + tool activity live to stdout
    for a human behind an ``eesel →`` prefix; the human path ignores the return
    beyond ``status``. ``render=False`` (the ``--json`` path) leaves stdout
    untouched so the caller can emit the envelope as the sole JSON object. Every
    failure — server unreachable, rejected turn, mid-stream drop — returns an
    error envelope (``status`` "error", the reason in ``error``); it never raises
    or ``sys.exit``s, so ``--json`` always emits one parseable object.
    """
    # Empty user messages are how trigger-preview sessions auto-fire (kicked off
    # by `eesel new --trigger X` with no user typing yet). The backend filters
    # empty messages out of the persisted chat history, so the task's history
    # doesn't get polluted with "(blank user turn)" markers. Skip the local
    # session append for the same reason — keeps `eesel sessions show` clean
    # and subsequent turns don't keep resending the empty entry.
    if message:
        sess["messages"].append({"sender": "user", "message": message})

    # Build the outgoing messages array. For auto-fire we send a one-shot
    # `[{"sender":"user","message":""}]` so backend validation passes (it
    # requires a non-empty array), but the message itself drops out of the
    # persisted history.
    outgoing_messages = sess["messages"] if sess["messages"] else [{"sender": "user", "message": ""}]
    body = {
        "messages": outgoing_messages,
        "agentId": sess["agent_id"],
        "taskId": sess["task_id"],
    }
    if sess.get("trigger_id"):
        body["triggerId"] = sess["trigger_id"]
    url = f"{creds['api_url']}/agents/sandbox/start"
    # A chat turn is a billed side effect, so honour --dry-run here the same way
    # write_request does for config mutations: print the request that would be
    # sent and exit 0 without contacting the server. The reads above (agent
    # resolution) already ran so the preview shows the real resolved body.
    if _DRY_RUN:
        emit({"method": "POST", "url": url, "body": body})
        sys.exit(0)
    # sandbox/start decodes the bearer with HS256 only (it predates the Auth0
    # migration), so an Auth0 login must send a minted workspace token here.
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {workspace_token(creds)}",
        },
        method="POST",
    )

    def _fail(reason: str) -> dict:
        # A pre-stream failure (couldn't start the turn): roll back the just-
        # appended user message (it never reached the model), save, log to
        # stderr, and return an error envelope. Both paths fail honestly — the
        # human exits non-zero off `status`, the --json caller gets one parseable
        # object — instead of a traceback or a silent empty stdout.
        if message:
            sess["messages"].pop()
        save_session(sess)
        err(reason)
        return {"task_id": sess.get("task_id"), "status": "error", "reply": "", "tool_calls": [], "error": reason}

    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            raw = resp.read()
            try:
                start_resp = json.loads(raw)
            except json.JSONDecodeError:
                snippet = raw[:200].decode(errors="replace").strip()
                return _fail(
                    f"sandbox/start → {resp.status} but the response was not JSON "
                    f"({len(raw)} bytes; a proxy or login page?): {snippet}"
                )
    except urllib.error.HTTPError as e:
        return _fail(f"sandbox/start → {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        # Server unreachable (connection refused / DNS / timeout) — no HTTP
        # response to surface, but still a clean error envelope, not a traceback.
        return _fail(f"sandbox/start failed (server reachable?): {e}")

    task_id = start_resp.get("taskId", sess["task_id"])
    sess["task_id"] = task_id
    stream_url = start_resp.get("streamUrl")

    if render:
        print(_color("eesel ", "36") + "→ ", end="", flush=True)
    result = stream_reply(creds, task_id, stream_url, render=render)
    if render:
        print()  # newline after stream

    text = result["text"]
    # Don't persist a turn that failed mid-stream (a failed stream leaves no
    # assistant reply to append).
    if not result["error"] and text:
        sess["messages"].append({"sender": "assistant", "message": text})
    save_session(sess)

    envelope = {
        "task_id": task_id,
        "status": "error" if result["error"] else "completed",
        "reply": text,
        "tool_calls": result["tool_calls"],
    }
    if result["error"]:
        envelope["error"] = result.get("error_text") or "chat stream failed mid-reply"
    return envelope


def stream_reply(creds: dict, task_id: str, stream_url: str | None, *, render: bool = True) -> dict:
    """Consume the chat SSE stream into a structured result.

    Returns ``{"text": str, "tool_calls": [{"name","input","output"}], "error": bool}``.
    ``text`` is the concatenated assistant reply; ``tool_calls`` are ordered by
    when each tool's input first appeared, with outputs paired back to inputs by
    ``toolCallId`` (tools can run in parallel, so an output need not arrive right
    after its input). ``error`` is True if the stream signalled an error event or
    dropped mid-reply.

    When ``render`` is True the reply text and tool activity are also streamed to
    stdout live for a human; when False (the ``--json`` path) stdout is left
    untouched so the caller can emit exactly one JSON object.
    """
    if stream_url:
        url = stream_url
        headers = {}
    else:
        url = f"{creds['api_url']}/agents/chat/{task_id}/raw-stream"
        # Same HS256-only chat auth as sandbox/start — mint a workspace token
        # for Auth0 logins (the streamUrl path above is presigned, no header).
        headers = {"Authorization": f"Bearer {workspace_token(creds)}"}
    req = urllib.request.Request(url, headers=headers)

    text_buffers: dict[str, str] = {}
    text_order: list[str] = []
    # Tool calls keyed by toolCallId so a `tool-output-available` attaches to the
    # matching `tool-input-available`; `tool_order` preserves input arrival order.
    tool_calls: dict[str, dict] = {}
    tool_order: list[str] = []
    saw_error = False
    # The AI SDK stream ends with an authoritative terminal event — `finish` on a
    # normal turn, `abort` if it was cancelled. The server's raw-stream endpoint
    # consumes the transport's trailing `[DONE]` marker (it never reaches us), so
    # `finish`/`abort` is the only completion signal the client sees. Without one,
    # a clean EOF after partial text or an unfinished tool call is a truncated
    # turn, not a completed one — track it so we don't report success on truncation.
    saw_terminal = False
    # The failure reason, surfaced into the --json envelope's `error` field so an
    # agent parsing only stdout learns *why* a turn failed (not just that it did).
    error_text: str | None = None

    def _result() -> dict:
        return {
            "text": "".join(text_buffers[tid] for tid in text_order).strip(),
            "tool_calls": [tool_calls[cid] for cid in tool_order],
            "error": saw_error,
            "error_text": error_text,
        }

    try:
        with urllib.request.urlopen(req, timeout=900) as resp:
            for raw in resp:
                line = raw.decode(errors="replace").rstrip("\r\n")
                if not line.startswith("data:"):
                    continue
                data = line[5:].lstrip()
                if not data or data == "[DONE]":
                    continue
                try:
                    evt = json.loads(data)
                except json.JSONDecodeError:
                    continue
                etype = evt.get("type")
                if etype == "text-start":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                elif etype == "text-delta":
                    tid = evt.get("id", "_")
                    if tid not in text_buffers:
                        text_buffers[tid] = ""
                        text_order.append(tid)
                    delta = evt.get("delta", "")
                    text_buffers[tid] += delta
                    if render:
                        sys.stdout.write(delta)
                        sys.stdout.flush()
                elif etype == "tool-input-available":
                    cid = evt.get("toolCallId", "")
                    name = evt.get("toolName")
                    call = tool_calls.get(cid)
                    if call is None:
                        tool_calls[cid] = {"name": name, "input": evt.get("input"), "output": None}
                        tool_order.append(cid)
                    else:
                        call["name"] = name
                        call["input"] = evt.get("input")
                    if render:
                        inp = json.dumps(evt.get("input"))[:200]
                        print(_color(f"\n[tool] {name} {inp}", "2;37"), flush=True)
                elif etype == "tool-output-available":
                    cid = evt.get("toolCallId", "")
                    out = evt.get("output")
                    call = tool_calls.get(cid)
                    if call is None:
                        # An output with no preceding input event — record it
                        # rather than drop it, so the envelope still lists the call.
                        tool_calls[cid] = {"name": None, "input": None, "output": out}
                        tool_order.append(cid)
                    else:
                        call["output"] = out
                    if render:
                        preview = (json.dumps(out) if not isinstance(out, str) else out)[:200]
                        print(_color(f"[tool] → {preview}", "2;37"), flush=True)
                elif etype == "error":
                    saw_error = True
                    saw_terminal = True
                    error_text = evt.get("errorText") or "chat stream reported an error"
                    print(_color(f"\n[error] {evt.get('errorText') or evt}", "31"), file=sys.stderr, flush=True)
                elif etype == "finish":
                    # Normal end of turn — the reply and every tool call are complete.
                    saw_terminal = True
                elif etype == "abort":
                    # The turn was cancelled server-side; whatever we have is partial.
                    saw_terminal = True
                    saw_error = True
                    reason = evt.get("reason")
                    error_text = f"chat turn aborted{f': {reason}' if reason else ''}"
                    print(_color(f"\n[aborted] {reason or 'turn cancelled'}", "31"), file=sys.stderr, flush=True)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        err(f"raw-stream → {e.code}: {detail}")
        # error=True signals failure so the caller can exit non-zero (see send_message).
        saw_error = True
        error_text = f"raw-stream → {e.code}: {detail}"
        return _result()
    except (http.client.IncompleteRead, ConnectionError, TimeoutError, socket.timeout, ssl.SSLError) as e:
        # ssl.SSLError (incl. SSLEOFError) covers an encrypted connection torn
        # down mid-stream — the common abrupt drop on the HTTPS prod transport,
        # which is neither a ConnectionError nor a URLError.
        err(f"\nchat stream dropped mid-reply (server/connection?): {e}")
        saw_error = True
        error_text = f"chat stream dropped mid-reply: {e}"
        return _result()
    except urllib.error.URLError as e:
        # Server unreachable mid-stream — a failed turn like the branches above,
        # so the caller can exit non-zero and (in --json) emit an error envelope.
        err(f"\nchat stream dropped mid-reply (server reachable?): {e}")
        saw_error = True
        error_text = f"chat stream dropped mid-reply (server reachable?): {e}"
        return _result()

    # The stream closed without raising. A clean close is only a *completed* turn
    # if we saw the terminal event; otherwise the connection ended early (LB idle
    # close, graceful shutdown, empty stream) and the reply is truncated. Report
    # it as a failure so `--json` doesn't emit status "completed" on partial data.
    if not saw_terminal:
        err("\nchat stream ended without a completion signal (truncated reply?)")
        saw_error = True
        error_text = "chat stream ended without a completion signal (truncated reply)"

    return _result()


