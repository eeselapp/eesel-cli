def login_dev(workspace_id: str | None = None) -> dict:
    # discover_local_ids also returns an agent id, but login no longer stores a
    # default agent: every agent-scoped command names its own agent (or the sole
    # agent is used when there's only one), so there is no ambient "active agent"
    # to persist. The dev JWT authenticates on workspace + user, not agent.
    workspace_id, _agent_id, user_id = discover_local_ids(workspace_id)
    token = mint_dev_jwt(workspace_id, None, user_id)
    creds = {
        "env": "dev",
        "api_url": ENVS["dev"]["api"],
        "dashboard_url": ENVS["dev"]["dashboard"],
        "workspace_id": workspace_id,
        "agent_id": None,
        "user_id": user_id,
        "token": token,
        "expires_at": int(time.time()) + CLI_TOKEN_TTL_SECONDS,
    }
    save_creds(creds)
    ok(f"Logged in (dev) — workspace={workspace_id}" + (f" user={user_id}" if user_id else " (no owner user_id)"))
    return creds


def _find_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def _creds_from_login_payload(captured: dict, api_url: str, dashboard: str) -> dict:
    """Build stored credentials from the browser bridge's POST to /auth.

    Supports both handoff formats so a current CLI works against any dashboard:

    - **Auth0 (preferred, what new logins request via `token=auth0`):**
      `access_token` + `refresh_token`. The CLI acts as the real user, so every
      `@requires_auth` route (writes + billing) works in prod, and the token
      refreshes silently. TTL is short, so a missing `expires_in` falls back to
      a conservative window that the refresh path renews.

    - **Workspace token (back-compat):** a bare `token`, handed back by a
      dashboard that predates the Auth0 handoff — or after a rollback, since the
      dashboard keeps the workspace flow as its default. Reads work; writes and
      billing still 401 in prod (the original limitation this migration removes
      for Auth0 logins). TTL falls back to the 30-day workspace lifetime.
    """
    access_token = captured.get("access_token")
    refresh_token = captured.get("refresh_token")
    workspace_token = captured.get("token")
    workspace_id = captured.get("workspace_id") or captured.get("workspaceId")
    user_email = captured.get("user_email") or captured.get("email")

    creds = {
        "env": "prod",
        "api_url": api_url,
        "dashboard_url": dashboard,
        "workspace_id": workspace_id,
        "user_email": user_email,
        "agent_id": None,  # no stored default; every command names its own agent
    }

    if access_token and refresh_token:
        creds["token"] = access_token
        creds["refresh_token"] = refresh_token
        default_ttl = PROD_TOKEN_TTL_FALLBACK_SECONDS
    elif workspace_token:
        creds["token"] = workspace_token
        default_ttl = CLI_TOKEN_TTL_SECONDS
    else:
        sys.exit(f"Auth response missing a token: {captured}")

    if not workspace_id:
        sys.exit(f"Auth response missing workspace_id: {captured}")

    expires_in = captured.get("expires_in")
    if not isinstance(expires_in, int) or expires_in <= 0:
        expires_in = default_ttl
    creds["expires_at"] = int(time.time()) + expires_in
    return creds


def login_prod() -> dict:
    """Browser bridge: open dashboard.eesel.ai/cli, capture token via local HTTP server."""
    state = secrets_mod.token_urlsafe(24)
    port = _find_free_port()
    dashboard = ENVS["prod"]["dashboard"]
    api_url = ENVS["prod"]["api"]

    captured: dict = {}
    done = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a, **kw):
            pass

        def _cors(self):
            origin = self.headers.get("Origin", "")
            allow = origin if origin in (dashboard, "http://localhost:3000") else dashboard
            self.send_header("Access-Control-Allow-Origin", allow)
            self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type")

        def do_OPTIONS(self):
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_POST(self):
            if self.path != "/auth":
                self.send_response(404)
                self._cors()
                self.end_headers()
                return
            length = int(self.headers.get("Content-Length", 0))
            try:
                payload = json.loads(self.rfile.read(length))
            except Exception:
                self.send_response(400)
                self._cors()
                self.end_headers()
                return
            if payload.get("state") != state:
                self.send_response(400)
                self._cors()
                self.end_headers()
                self.wfile.write(b'{"error":"state mismatch"}')
                return
            captured.update(payload)
            self.send_response(200)
            self._cors()
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
            done.set()

        def do_GET(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"eesel-cli local auth listener\n")

    server = http.server.HTTPServer(("127.0.0.1", port), Handler)
    th = threading.Thread(target=server.serve_forever, daemon=True)
    th.start()

    # We open /api/cli/init rather than /cli directly. The init route is
    # Auth0-gated, validates state + port, then sets `cli_state` as an
    # HttpOnly SameSite=Strict cookie scoped to /cli before 302-redirecting.
    # /cli reads the cookie server-side — state never lives in the URL,
    # so it can't end up in browser history, referrer headers, or be
    # injected by a malicious deep-link.
    # `token=auth0` opts into the Auth0-token handoff (access + refresh token)
    # so writes and billing reads work in prod. The dashboard defaults to the
    # legacy workspace token when the param is absent, so older CLIs are
    # unaffected.
    url = f"{dashboard}/api/cli/init?{urllib.parse.urlencode({'port': port, 'state': state, 'token': 'auth0'})}"
    info(f"Opening {url}")
    info("If the browser didn't open, paste that URL manually.")
    try:
        webbrowser.open(url)
    except Exception:
        pass

    if not done.wait(timeout=300):
        server.shutdown()
        sys.exit("Timed out waiting for browser auth (5 min).")
    server.shutdown()

    # The CLI requests the Auth0 handoff (`token=auth0`), but accepts whichever
    # credential the dashboard returns — Auth0 tokens from a current dashboard,
    # or a workspace token from one that predates the handoff / after a rollback.
    creds = _creds_from_login_payload(captured, api_url, dashboard)
    save_creds(creds)
    ok(f"Logged in — workspace={creds['workspace_id']}"
       + (f" as {creds['user_email']}" if creds.get("user_email") else ""))
    return creds


