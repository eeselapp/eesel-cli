def hide_subcommands(sub_action, *names: str) -> None:
    """Hide already-registered subparsers (back-compat aliases) from a group's
    `--help`: drop them from the visible choice list AND rebuild the usage-line
    metavar so neither the listed subcommands nor the `{...}` usage shows them.

    argparse has no public API for a hidden alias: `help=argparse.SUPPRESS` only
    blanks the description, so the choice still leaks into the metavar unless the
    metavar is rebuilt from the trimmed list. Both steps live here so every group
    hides aliases identically — a per-group copy of this once forgot the metavar
    rebuild and leaked `delete`/`run` into `eesel automations schedules --help`.
    """
    hidden = set(names)
    sub_action._choices_actions = [a for a in sub_action._choices_actions if a.dest not in hidden]
    sub_action.metavar = "{" + ",".join(ca.dest for ca in sub_action._choices_actions) + "}"


def _hide_unsupported_legacy(top_sub) -> None:
    """Trim `--help` to the legacy v2 read commands: hide the nouns with no
    legacy meaning, and (under the partially-supported nouns) every subcommand
    that isn't in `_LEGACY_SUPPORTED_SUBS`. Everything stays PARSEABLE — hiding
    only drops it from help — so the pre-dispatch guard still answers with the
    friendly 'not available on the legacy (v2) platform' message. Reuses the
    same classification the guard and schema read, so the three can't drift."""
    hide_subcommands(top_sub, *[n for n in _LEGACY_HIDDEN_NOUNS if n in top_sub.choices])
    for noun, supported in _LEGACY_SUPPORTED_SUBS.items():
        if supported is None:
            continue  # whole noun supported (e.g. instructions) — nothing to trim
        parser = top_sub.choices.get(noun)
        if parser is None:
            continue
        child = next((a for a in parser._actions if isinstance(a, argparse._SubParsersAction)), None)
        if child is None:
            continue
        hide = [name for name in child.choices if name not in supported]
        if hide:
            hide_subcommands(child, *hide)


def _add_files_parser(sub, name: str, hidden: bool = False) -> None:
    """Register the files command tree under `name`.

    Called once for the canonical `files` and once for the legacy singular
    `document` (with `hidden=True`), so both share an identical subcommand
    surface. When hidden, the alias still parses and runs but is dropped from
    `--help` (the same technique used for the staff `impersonate` command).
    """
    sp = sub.add_parser(
        name,
        help=argparse.SUPPRESS if hidden else "List, show, add, remove files (and manage knowledge ACLs)",
    )
    d_sub = sp.add_subparsers(dest="file_cmd")

    ls = d_sub.add_parser("list", help="List files in this workspace")
    ls.add_argument("--prefix", help="Filter by file key prefix")
    ls.add_argument("--search", help="Free-text query over file names/keys")
    ls.add_argument("--limit", type=int, default=100, help="Maximum files to return")
    ls.add_argument("--offset", type=int, default=0, help="Pagination offset")
    ls.add_argument("--agent", help="Agent id, id-prefix, or name to scope to; a single-agent workspace is used automatically, otherwise name the agent (--agent, EESEL_AGENT, or the `agents <id> …` path)")
    ls.add_argument("--json", action="store_true", help="Emit the raw files payload")
    ls.add_argument("--plain", action="store_true", help="Emit one tab-separated `id<TAB>key<TAB>name` row per file")

    # `show` is the canonical verb for "see one file"; `read` is its hidden
    # alias, kept for existing scripts. Both print a file's contents.
    for verb, hide in (("show", False), ("read", True)):
        rd = d_sub.add_parser(
            verb,
            help=argparse.SUPPRESS if hide else "Print a file's contents (omit id for an interactive menu)",
        )
        rd.add_argument("target", nargs="?", help="File id, id-prefix, key, or filename (omit to pick from a menu)")
        rd.add_argument("--prefix", help="Filter the menu/list to keys under this prefix (e.g. files/, outputs/)")
        rd.add_argument("--agent", help="Agent id, id-prefix, or name to scope to; a single-agent workspace is used automatically, otherwise name the agent (--agent, EESEL_AGENT, or the `agents <id> …` path)")
        rd.add_argument("--format", default="md", choices=["md", "html"], help="Content format (default: md)")
        rd.add_argument("--json", action="store_true", help="Emit the file as a JSON object (id, key, content)")

    exp = d_sub.add_parser("export", help="Download a file as markdown or HTML")
    target = exp.add_mutually_exclusive_group(required=True)
    # `--document-key`/`--document-id` are kept as hidden aliases of the primary
    # `--file-*` flags for scripts that predate the rename.
    target.add_argument("--file-key", "--document-key", dest="document_key", help="File key to export")
    target.add_argument("--file-id", "--document-id", dest="document_id", help="File id to export")
    exp.add_argument("--format", default="md", choices=["md", "html"], help="Export format")
    exp.add_argument("-o", "--output", help="Output file path")
    exp.add_argument("--agent", help="Agent whose file to export (id / prefix / name); "
                                     "required unless the workspace has a single agent — or use "
                                     "the `agents <id> …` path or EESEL_AGENT")

    cr = d_sub.add_parser("add", help="Add a file to the workspace (prints its key)")
    cr.set_defaults(write=True)
    cr.add_argument("--title", required=True, help="File title")
    content = cr.add_mutually_exclusive_group(required=True)
    content.add_argument("--content", help="File content (inline)")
    content.add_argument("--content-file", help="Read file content from this file")
    cr.add_argument("--source-type", default="files", help="Source type the file is filed under (default: files)")
    cr.add_argument("--agent", help="Agent id, id-prefix, or name to grant knowledge access; a single-agent workspace is used automatically, otherwise name the agent (--agent, EESEL_AGENT, or the `agents <id> …` path)")

    de = d_sub.add_parser("remove", help="Remove files by key (asks for confirmation)")
    de.set_defaults(write=True)
    de.add_argument("keys", nargs="+", help="One or more file keys or ids to remove (each must match an existing file)")
    de.add_argument("-f", "--force", action="store_true", help="Skip the confirmation prompt (for non-interactive use)")
    de.add_argument("--agent", help="Agent whose files to remove; a single-agent workspace is used automatically, otherwise name the agent (--agent, EESEL_AGENT, or the `agents <id> …` path)")

    acl = d_sub.add_parser("acl", help="Show or set an agent's knowledge-ACL key prefixes")
    acl_sub = acl.add_subparsers(dest="acl_cmd")
    acl_get = acl_sub.add_parser("show", help="Print an agent's knowledge-ACL key prefixes")
    acl_get.add_argument("agent", help="Agent id, id-prefix, or name")
    acl_get.add_argument("--json", action="store_true", help="Emit the key prefixes as a JSON array")
    acl_set = acl_sub.add_parser(
        "set",
        help="Replace an agent's knowledge-ACL key prefixes (this REPLACES the existing prefixes, it does not append)",
    )
    acl_set.set_defaults(write=True)
    acl_set.add_argument("agent", help="Agent id, id-prefix, or name")
    acl_set.add_argument(
        "--prefix",
        action="append",
        required=True,
        dest="prefix",
        help="A key prefix to grant (repeatable). REPLACES the agent's current prefixes",
    )

    hide_subcommands(d_sub, "read")  # `read` is the hidden alias for `show`

    sp.set_defaults(func=cmd_files, file_cmd="list", prefix=None, search=None, limit=100, offset=0)
    if hidden:
        # Keep the alias parseable but off `--help`: drop it from the choices
        # list and the metavar is rebuilt from the survivors after all parsers
        # are registered.
        sub._choices_actions = [a for a in sub._choices_actions if a.dest != name]


def _install_suggestions(parser: argparse.ArgumentParser) -> None:
    """Make every subcommand level suggest the closest valid name on a typo.

    By default argparse fails an unknown subcommand with a bare "invalid
    choice", which dead-ends the user (or an agent). For each parser that has
    subcommands, this replaces the error handler so an unrecognized subcommand
    gets a "Did you mean X?" hint (nearest match by edit distance), then
    recurses into the child parsers so nested levels behave the same. Other
    parse errors fall through unchanged. Called once on the root after the whole
    tree is built, so it covers every noun automatically.
    """
    sub_action = next(
        (a for a in parser._actions if isinstance(a, argparse._SubParsersAction)), None
    )
    if sub_action is None:
        return
    # Suggest only visible subcommands (hidden back-compat aliases are dropped
    # from _choices_actions), falling back to all choices if none are visible.
    visible = [a.dest for a in sub_action._choices_actions]
    choices = visible or list(sub_action.choices)
    original_error = parser.error

    # A parser can carry a `_eesel_relocations` map of {old-subcommand: hint} for
    # subcommands that moved to a different command group: when the moved name is
    # given, point at the new home instead of a generic "did you mean". The root
    # parser sets this for `documents` (renamed to `files`) and `triggers` /
    # `schedules` (now under `automations`); other parsers carry none, so their
    # errors are unaffected.
    relocations = getattr(parser, "_eesel_relocations", None) or {}

    def error(message: str, _orig=original_error, _choices=choices, _reloc=relocations) -> None:
        if "invalid choice" in message:
            bad = message.split("invalid choice: ", 1)[1].split(" ", 1)[0].strip("'\"")
            if bad in _reloc:
                hint = f" {_reloc[bad]}"
            else:
                near = difflib.get_close_matches(bad, _choices, n=1)
                hint = f" Did you mean {near[0]!r}?" if near else f" Choose from: {', '.join(_choices)}."
            message = message + hint
        _orig(message)

    parser.error = error  # type: ignore[method-assign]
    for child in sub_action.choices.values():
        _install_suggestions(child)


