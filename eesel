def _session_path(sid: str) -> Path:
    return SESSIONS_DIR / f"{sid}.json"


def list_sessions() -> list[dict]:
    if not SESSIONS_DIR.exists():
        return []
    out = []
    for p in SESSIONS_DIR.glob("*.json"):
        try:
            out.append(json.loads(p.read_text()))
        except Exception:
            continue
    out.sort(key=lambda s: s.get("updated_at", 0), reverse=True)
    return out


def load_session(sid: str) -> dict | None:
    p = _session_path(sid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def save_session(sess: dict) -> None:
    ensure_dirs()
    sess["updated_at"] = time.time()
    _session_path(sess["id"]).write_text(json.dumps(sess, indent=2))


def delete_session(sid: str) -> bool:
    p = _session_path(sid)
    if p.exists():
        p.unlink()
        cur = load_current()
        if cur == sid:
            CURRENT_FILE.unlink(missing_ok=True)
        return True
    return False


def load_current() -> str | None:
    if not CURRENT_FILE.exists():
        return None
    try:
        return json.loads(CURRENT_FILE.read_text()).get("session_id")
    except Exception:
        return None


def set_current(sid: str | None) -> None:
    ensure_dirs()
    if sid is None:
        CURRENT_FILE.unlink(missing_ok=True)
        return
    CURRENT_FILE.write_text(json.dumps({"session_id": sid}, indent=2))


def ensure_current_session(creds: dict, agent_id: str | None = None) -> dict:
    """Return the active session, creating one if needed."""
    sid = load_current()
    sess = load_session(sid) if sid else None
    if sess:
        return sess
    return new_session(creds, agent_id=agent_id, name=None, switch_to=True)


def find_session_by_task(task_id: str) -> dict | None:
    """Find the local session bound to a backend task id, if any."""
    for sess in list_sessions():
        if sess.get("task_id") == task_id:
            return sess
    return None


def new_session(creds: dict, *, agent_id: str | None, name: str | None, switch_to: bool = True, trigger_id: str | None = None, trigger_title: str | None = None, task_id: str | None = None) -> dict:
    sid = uuid.uuid4().hex[:12]
    sess = {
        "id": sid,
        "name": name or f"chat-{datetime.now().strftime('%Y%m%d-%H%M')}",
        "agent_id": agent_id or creds.get("agent_id"),
        "workspace_id": creds["workspace_id"],
        "task_id": task_id or str(uuid.uuid4()),
        "messages": [],
        "created_at": time.time(),
        "updated_at": time.time(),
    }
    if trigger_id:
        sess["trigger_id"] = trigger_id
        sess["trigger_title"] = trigger_title
    save_session(sess)
    if switch_to:
        set_current(sid)
    return sess


