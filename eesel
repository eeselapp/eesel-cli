# Single-item detail views — one `/subscription/*` GET each, rendered as a
# key/value summary. These are `eesel billing show <topic>`.
_BILLING_SHOW = {
    "usage": ("/subscription/usage", _print_billing_usage, _print_billing_usage_plain),
    "license": ("/subscription/license", _print_billing_license, _print_billing_license_plain),
    "mode": ("/subscription/billing-mode", _print_billing_mode, _print_billing_mode_plain),
}

# Multi-row views with a column per field — these are `eesel billing list <kind>`.
_BILLING_LIST = {
    "invoices": ("/subscription/invoices", _print_billing_invoices, _print_billing_invoices_plain),
    "spend": ("/subscription/spend-history", _print_billing_spend, _print_billing_spend_plain),
}


def cmd_billing(args) -> int:
    """Read-only views over the workspace's subscription.

    `eesel billing show <usage|license|mode>` prints one summary;
    `eesel billing list <invoices|spend>` prints rows with a column per field.
    `eesel billing` with no subcommand shows usage. Pass `--json` for the raw
    server payload or `--plain` for tab-separated, decoration-free output.
    """
    creds = require_creds()
    verb = getattr(args, "billing_cmd", None) or "show"

    if verb == "show":
        topic = getattr(args, "topic", None) or "usage"
        if topic not in _BILLING_SHOW:
            err(f"Unknown billing topic: {topic}. Try: {', '.join(_BILLING_SHOW)}")
            return 1
        path, printer, plain_printer = _BILLING_SHOW[topic]
    elif verb == "list":
        kind = getattr(args, "kind", None)
        if kind not in _BILLING_LIST:
            err(f"Unknown billing list: {kind}. Try: {', '.join(_BILLING_LIST)}")
            return 1
        path, printer, plain_printer = _BILLING_LIST[kind]
    else:
        err(f"Unknown billing command: {verb}. Try 'show' or 'list'.")
        return 1

    data = http_request("GET", f"{creds['api_url']}{path}", token=creds["token"])
    if _want_json(args):
        emit(data)
        return 0
    if getattr(args, "plain", False):
        plain_printer(data)
        return 0
    printer(data)
    return 0


# ──────────────────────────────────────────────────────────────────────────
# Settings — per-agent notification configuration
#
# Notification settings are fields on one agent. The commands map onto the
# canonical verb set:
#   eesel settings notifications show <agent>            — read the fields
#   eesel settings notifications enable|disable <agent>  — flip the `enabled` field
#   eesel settings notifications set <agent> --channel … — set a value field
# All three sit on GET/PATCH /agents/{agent_id}/notification-settings. PATCH
# sends only the field being changed, so the server's unset-exclusion leaves the
# others untouched.
# ──────────────────────────────────────────────────────────────────────────


def _print_notification_settings(data: dict) -> None:
    print(f"enabled  : {data.get('enabled')}")
    print(f"channel  : {data.get('channel') or 'dashboard'}")
    member_ids = (data.get("email") or {}).get("member_ids") or []
    channel_ids = (data.get("slack") or {}).get("channel_ids") or []
    print(f"email    : {', '.join(member_ids) if member_ids else '(no recipients)'}")
    print(f"slack    : {', '.join(channel_ids) if channel_ids else '(no channels)'}")


def _print_notification_settings_plain(data: dict) -> None:
    """Tab-separated key/value lines for `--plain`."""
    member_ids = (data.get("email") or {}).get("member_ids") or []
    channel_ids = (data.get("slack") or {}).get("channel_ids") or []
    print(f"enabled\t{'' if data.get('enabled') is None else data.get('enabled')}")
    print(f"channel\t{data.get('channel') or ''}")
    print(f"email\t{','.join(member_ids)}")
    print(f"slack\t{','.join(channel_ids)}")


def cmd_settings(args) -> int:
    """`eesel settings notifications show|enable|disable|set <agent>` — read or
    change one agent's notification configuration."""
    creds = require_creds()
    if getattr(args, "settings_cmd", None) != "notifications":
        err("Usage: eesel settings notifications show|enable|disable|set <agent>")
        return 1

    action = getattr(args, "notifications_cmd", None)
    if action not in ("show", "enable", "disable", "set"):
        err("Usage: eesel settings notifications show|enable|disable|set <agent>")
        return 1

    # enable/disable/set write the agent's notification config, so refuse an
    # ambiguous name rather than configuring an arbitrary first match.
    agent = resolve_agent_or_error(creds, args.agent)
    if not agent:
        return 1
    agent_id = agent["agent_id"]
    url = f"{creds['api_url']}/agents/{agent_id}/notification-settings"

    if action == "show":
        data = http_request("GET", url, token=creds["token"])
        if _want_json(args):
            emit(data)
            return 0
        if getattr(args, "plain", False):
            _print_notification_settings_plain(data)
            return 0
        info(f"# {agent.get('name', '?')} ({agent_id[:12]}) — notification settings")
        _print_notification_settings(data)
        return 0

    # enable/disable/set all PATCH only the field they own, so the server's
    # unset-exclusion leaves everything else untouched.
    if action == "enable":
        body = {"enabled": True}
    elif action == "disable":
        body = {"enabled": False}
    else:  # action == "set"
        body = {}
        if args.channel is not None:
            body["channel"] = args.channel
        if not body:
            err("Nothing to set. Pass --channel dashboard|email|slack.")
            return 1

    data = write_request("PATCH", url, token=creds["token"], body=body)
    ok(f"Updated notification settings for {agent.get('name')} ({agent_id[:12]}): {', '.join(body.keys())}")
    if _want_json(args):
        emit(data)
        return 0
    _print_notification_settings(data)
    return 0


