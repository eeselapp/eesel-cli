# Per-token cache of the impersonator-status lookup, so repeated `_is_sysadmin`
# checks in one process (e.g. `_configure_output` + a handler under `--secrets`)
# make at most one network call.
_IMPERSONATE_STATUS_CACHE: dict = {}


def _get_impersonate_status(creds: dict) -> dict | None:
    """Best-effort impersonation status, normalized to ``{allowed, target_user_id}``.

    Reads `/sysadmin/impersonator-status` (the same endpoint the dashboard uses,
    now reachable with the CLI's Auth0 token). Never calls sys.exit — whoami
    display and the staff-command gate must not abort the CLI on a network
    hiccup.

    `allowed` is whether the caller may impersonate. `target_user_id` is the
    *active* target or None. When idle the endpoint echoes the caller's own uid
    as both `impersonator_uid` and `target_uid`, so a target counts as active
    only when the two differ — i.e. the caller is acting as a *different* user.
    Testing `target_uid` alone would report a phantom self-impersonation for
    every sysadmin, since the caller's own uid is always present there.

    Memoized per token for the life of the process: a single `--secrets`
    invocation resolves the sysadmin gate in both `_configure_output` and the
    integrations handler, and this endpoint is otherwise hit once per lookup.
    """
    token = creds.get("token") if creds else None
    if token is not None and token in _IMPERSONATE_STATUS_CACHE:
        return _IMPERSONATE_STATUS_CACHE[token]
    try:
        req = urllib.request.Request(
            f"{creds['api_url']}/sysadmin/impersonator-status",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {creds['token']}"},
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read() or b"{}")
    except Exception:
        result = None
    else:
        allowed = bool(data.get("is_impersonator") or data.get("is_sysadmin"))
        impersonator = data.get("impersonator_uid")
        target_uid = data.get("target_uid")
        target = target_uid if (impersonator and target_uid and target_uid != impersonator) else None
        result = {"allowed": allowed, "target_user_id": target}
    if token is not None:
        _IMPERSONATE_STATUS_CACHE[token] = result
    return result


def resolve_effective_workspace_id(creds: dict) -> str | None:
    """Return the workspace id the caller currently operates in.

    `POST /workspaces/token` derives the workspace from the *effective* identity
    — the impersonation target if one is active, otherwise the caller — so it is
    the authoritative answer to "which workspace am I acting in". Used to point
    the CLI at an impersonated user's workspace and back again on clear.

    Best-effort: returns None on any failure so callers can leave the stored
    workspace untouched rather than overwrite it with a wrong value.
    """
    try:
        req = urllib.request.Request(
            f"{creds['api_url']}/workspaces/token",
            data=json.dumps({"client": "cli"}).encode(),
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {creds['token']}"},
            method="POST",
        )
        # Short timeout: a slow endpoint must not stall the CLI for long. Called
        # once per invocation, only while impersonating (from the pre-dispatch
        # guard), never on a normal customer's commands.
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = json.loads(resp.read() or b"{}")
    except Exception:
        return None
    return data.get("workspaceId") or data.get("workspace_id")


def _apply_effective_workspace(creds: dict) -> None:
    """Point `workspace_id` at the impersonated target's workspace, if active.

    The stored `workspace_id` is the caller's own, fixed at login and never
    overwritten on disk — so outside impersonation it is already correct and
    there is nothing to do (a normal customer's commands make no extra call).
    While impersonating, requests run as the target, usually in a different
    workspace, so the stored value would 401. The pre-dispatch guard
    (`_guard_impersonated_command`) has already resolved the target's workspace
    and stashed it on `_impersonation_target`; reuse that rather than resolving
    again. Applied in memory only, so nothing is persisted.
    """
    if _impersonation_target:
        creds["workspace_id"] = _impersonation_target["workspace"]


def cache_impersonator_flag(creds: dict) -> bool:
    """Refresh and persist `is_impersonator` on the stored creds, returning
    whether this login is on the global impersonator allowlist.

    The cached flag is what gates the staff-only commands (`impersonate`, dev
    login) in `build_parser`, so the gate costs no per-command network call. On
    a network/endpoint error the cached value is left untouched, so a blip
    doesn't transiently hide a staff member's commands.
    """
    status = _get_impersonate_status(creds)
    if status is None:
        return bool(creds.get("is_impersonator"))
    allowed = bool(status.get("allowed"))
    if creds.get("is_impersonator") != allowed:
        creds["is_impersonator"] = allowed
        save_creds(creds)
    return allowed


def cmd_login(args) -> int:
    # Logging in is a side effect (dev mints a token from the branch env's
    # /dev/session; prod opens a browser OAuth bridge), so honour --dry-run:
    # print what the login would do and exit 0 without contacting anything or
    # writing credentials to disk.
    if _DRY_RUN:
        if args.dev:
            emit({
                "action": "login (dev)",
                "reads": "local Postgres for workspace/user ids, then mints a dev JWT",
                "api_url": ENVS["dev"]["api"],
                "writes": f"credentials to {CREDS_FILE}",
            })
        else:
            emit({
                "action": "login (prod)",
                "flow": f"opens {ENVS['prod']['dashboard']}/cli in a browser and captures the token via a local HTTP server",
                "api_url": ENVS["prod"]["api"],
                "writes": f"credentials to {CREDS_FILE}",
            })
        sys.exit(0)
    creds = login_dev(args.workspace_id) if args.dev else login_prod()
    # Cache whether this login is a global impersonator so the staff-only
    # commands can be surfaced/hidden without a network call on every run.
    cache_impersonator_flag(creds)
    return 0


def cmd_logout(args) -> int:
    if CREDS_FILE.exists():
        CREDS_FILE.unlink()
        ok("Logged out.")
    else:
        info("Not logged in.")
    return 0


def cmd_whoami(args) -> int:
    # A linked worktree overrides the stored login, so report what commands here
    # actually hit — not the stale global login. Minting also confirms the env is
    # reachable and surfaces its workspace id, the way to check a link worked.
    base_url = resolve_dev_base_url()
    if base_url:
        creds = dev_session_creds(base_url)
        src = "EESEL_BASE_URL" if os.environ.get("EESEL_BASE_URL") else WORKTREE_CONFIG_NAME
        print(f"env          : {creds['env']} (linked via {src})")
        print(f"api_url      : {creds['api_url']}")
        print(f"workspace_id : {creds['workspace_id']}")
        print("agent        : scoped per command (`agents <id> …`, --agent, or EESEL_AGENT)")
        print("token        : minted fresh per run from /dev/session (nothing stored)")
        return 0

    creds = load_creds()
    if not creds:
        info("Not logged in.")
        return 0
    # Resolve the workspace the CLI actually operates in — the impersonated
    # user's while a target is active — for display only. Done on a copy so the
    # is_impersonator save below can't persist it over the stored workspace.
    shown = dict(creds)
    _apply_effective_workspace(shown)
    expires_in = int((creds.get("expires_at") or 0) - time.time())
    print(f"env          : {creds.get('env')}")
    print(f"api_url      : {creds.get('api_url')}")
    print(f"workspace_id : {shown.get('workspace_id')}")
    # No stored "active agent": each agent-scoped command names its own agent
    # (path `agents <id> …`, `--agent`, or EESEL_AGENT), and a single-agent
    # workspace is used automatically.
    print("agent        : scoped per command (`agents <id> …`, --agent, or EESEL_AGENT)")
    if creds.get("user_email"):
        print(f"user_email   : {creds['user_email']}")
    print(f"token expires: {expires_in}s ({expires_in // 3600}h {(expires_in % 3600) // 60}m)")

    # Surface active impersonation so sticky state isn't invisible, and refresh
    # the cached `is_impersonator` gate while we're here (so an existing staff
    # login un-hides its commands without needing to re-login). Best-effort: a
    # network error or older server just leaves the cached value as-is.
    status = _get_impersonate_status(creds)
    if status is not None:
        allowed = bool(status.get("allowed"))
        if creds.get("is_impersonator") != allowed:
            creds["is_impersonator"] = allowed
            save_creds(creds)
        if allowed:
            tgt = status.get("target_user_id")
            if tgt:
                print(f"impersonating: {tgt}")
                print("               (every command runs as this user; clear with `eesel impersonate clear`)")
            else:
                print("impersonator : yes (no target set)")

    return 0


def cmd_link(args) -> int:
    url = args.url.rstrip("/")
    if not is_preprod_url(url):
        err(
            f"Refusing to link {url!r} — only https://<slug>{PREPROD_HOST_SUFFIX} "
            "branch envs can be linked."
        )
        return 1
    # Anchor the config at the worktree root (walk up to `.git`) so a subdirectory
    # command still finds it — falling back to cwd outside a git repo.
    root = walk_up_find(".git") or Path.cwd()
    path = root / WORKTREE_CONFIG_NAME
    path.write_text(json.dumps({"base_url": url}) + "\n")
    add_to_gitignore(root, WORKTREE_CONFIG_NAME)
    ok(f"Linked this worktree → {url}")
    info(f"  wrote {path} (gitignored)")
    info("  every eesel command here now targets that branch env; the token is minted")
    info("  fresh per run from /dev/session — nothing is stored. Unlink: delete that file.")
    return 0


def _legacy_unsupported(cmd_label: str) -> int:
    """Refuse a command that has no read-only meaning on the legacy v2 platform.
    Fails client-side (no network) with EXIT_VALIDATION."""
    fail(EXIT_VALIDATION, f"'{cmd_label}' is not available on the legacy (v2) platform (read-only).")


def resolve_namespace_or_error(creds: dict, target: str | None) -> dict | None:
    """Legacy counterpart of `resolve_agent_or_error`: resolve which bot
    (namespace) a command acts on, or print why it couldn't and return None.
    Scope comes from `--agent`/EESEL_AGENT (a single-bot workspace needs none);
    an ambiguous name is refused rather than resolved arbitrarily."""
    target = target or os.environ.get("EESEL_AGENT")
    namespaces = fetch_namespaces(creds)
    if not namespaces:
        err("No bots in this workspace.")
        return None
    if not target:
        if len(namespaces) == 1:
            validate_id(namespaces[0].get("id"), "namespace id")
            return namespaces[0]
        err(f"This workspace has {len(namespaces)} bots — name the one to act on:")
        for n in namespaces:
            err(f"  {n.get('id', '?')}  {n.get('namespace', '?')}")
        err("Scope it with `eesel agents <id> <command>`, a `--agent <id|name>` flag, "
            "or EESEL_AGENT=<id|name>.")
        return None
    ns, candidates = resolve_namespace_strict(namespaces, target)
    if ns:
        validate_id(ns.get("id"), "namespace id")
        return ns
    if candidates:
        err(f"'{target}' is ambiguous — it matches {len(candidates)} bots:")
        for n in candidates:
            err(f"  {n.get('id', '?')}  {n.get('namespace', '?')}")
        err("Re-run with a full bot id to disambiguate.")
    else:
        err(f"No bot matches '{target}'.")
    return None


def _namespaces_list(args, creds: dict) -> int:
    """`agents list` on legacy: the workspace's bots (namespaces)."""
    namespaces = fetch_namespaces(creds)
