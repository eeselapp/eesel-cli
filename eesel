# argparse action classes whose presence means the flag takes no value.
_STORE_CONST_ACTIONS = (
    argparse._StoreTrueAction,
    argparse._StoreFalseAction,
    argparse._StoreConstAction,
)


def _serialize_flag(action) -> dict:
    """One `--flag` as a schema entry: its names, whether it takes a value,
    whether it's required, its closed enum choices (if any), and help text.
    A suppressed help string (hidden staff flag) is reported as null."""
    return {
        "names": list(action.option_strings),
        "takes_value": not isinstance(action, _STORE_CONST_ACTIONS) and not isinstance(action, argparse._CountAction),
        "required": bool(action.required),
        "choices": [str(c) for c in action.choices] if action.choices else None,
        "help": None if action.help in (None, argparse.SUPPRESS) else action.help,
    }


def _serialize_parser(parser, path: tuple = (), inherited_handler=None) -> dict:
    """Recursively describe an argparse parser as a JSON-able dict: its flags,
    positionals, the handler it dispatches to, its API endpoint (from
    `_COMMAND_ENDPOINTS`), and its nested subcommands. Reads argparse's own
    parsed structure, so the schema can never drift from what the CLI accepts.

    A leaf command (`agents create`) has no `func` default of its own — the top
    command (`agents`) owns the handler and routes internally on the subcommand
    dest. So the effective handler is inherited from the nearest ancestor that
    sets one, and every command node reports the handler that ultimately runs.
    """
    handler = parser.get_default("func") or inherited_handler
    node: dict = {}
    flags = []
    positionals = []
    subcommands = {}
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, subparser in action.choices.items():
                subcommands[name] = _serialize_parser(subparser, path + (name,), handler)
        elif isinstance(action, argparse._HelpAction):
            continue
        elif action.option_strings:
            flags.append(_serialize_flag(action))
        else:
            positionals.append({
                "name": action.dest,
                "required": action.nargs not in ("?", "*", 0),
                "choices": [str(c) for c in action.choices] if action.choices else None,
                "help": None if action.help in (None, argparse.SUPPRESS) else action.help,
            })
    if handler is not None:
        node["handler"] = getattr(handler, "__name__", str(handler))
    key = ".".join(path)
    if key in _COMMAND_ENDPOINTS:
        node["endpoint"] = _COMMAND_ENDPOINTS[key]
    if flags:
        node["flags"] = flags
    if positionals:
        node["positionals"] = positionals
    if subcommands:
        node["subcommands"] = subcommands
    return node


def cmd_schema(args) -> int:
    """Emit the entire command surface as JSON — every command, flag, enum
    choice, positional, handler, and API endpoint — walked live from the parser
    so an agent can discover the CLI without reading `--help` or the source."""
    schema = _serialize_parser(build_parser(staff=True))
    schema["prog"] = "eesel"
    emit(schema)
    return 0


