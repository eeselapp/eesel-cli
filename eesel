def cmd_login(args) -> int:
    if args.dev:
        login_dev()
    else:
        login_prod()
    return 0


def cmd_logout(args) -> int:
    if CREDS_FILE.exists():
        CREDS_FILE.unlink()
        ok("Logged out.")
    else:
        info("Not logged in.")
    return 0


def cmd_whoami(args) -> int:
    creds = load_creds()
    if not creds:
        info("Not logged in.")
        return 0
    expires_in = int((creds.get("expires_at") or 0) - time.time())
    print(f"env          : {creds.get('env')}")
    print(f"api_url      : {creds.get('api_url')}")
    print(f"workspace_id : {creds.get('workspace_id')}")
    print(f"agent_id     : {creds.get('agent_id') or '(unset — pick one with `eesel agents use`)'}")
    if creds.get("user_email"):
        print(f"user_email   : {creds['user_email']}")
    print(f"token expires: {expires_in}s ({expires_in // 3600}h {(expires_in % 3600) // 60}m)")
    return 0


def cmd_agents(args) -> int:
    creds = require_creds()
    sub = args.agents_cmd or "list"
    if sub == "list":
        agents = fetch_agents(creds)
        if not agents:
            info("(no agents)")
            return 0
        active = creds.get("agent_id")
        for a in agents:
            mark = "*" if a.get("agent_id") == active else " "
            print(f" {mark} {a.get('agent_id', '?')[:12]}  {a.get('name', '?')}"
                  + (f"  [{a.get('agent_type')}]" if a.get('agent_type') else ""))
        return 0
    if sub == "use":
        target = args.agent_id
        agents = fetch_agents(creds)
        # Match by full id, prefix, or name.
        match = next((a for a in agents if a.get("agent_id") == target), None)
        if not match:
            match = next((a for a in agents if (a.get("agent_id") or "").startswith(target)), None)
        if not match:
            match = next((a for a in agents if a.get("name") == target), None)
        if not match:
            err(f"No agent matches '{target}'.")
            return 1
        creds["agent_id"] = match["agent_id"]
        save_creds(creds)
        ok(f"Active agent: {match.get('name')} ({match['agent_id']})")
        return 0
    return 1


def cmd_new(args) -> int:
    creds = require_creds()
    pick_agent(creds, prompt=not args.agent)
    if args.agent:
        creds["agent_id"] = args.agent
        save_creds(creds)
    sess = new_session(creds, agent_id=creds.get("agent_id"), name=args.name, switch_to=True)
    ok(f"New session: {sess['id']} ({sess['name']})")
    return 0


def cmd_sessions(args) -> int:
    sub = args.sessions_cmd or "list"
    if sub == "list":
        sessions = list_sessions()
        if not sessions:
            info("(no sessions)")
            return 0
        cur = load_current()
        for s in sessions:
            mark = "*" if s["id"] == cur else " "
            ts = datetime.fromtimestamp(s.get("updated_at", 0)).strftime("%Y-%m-%d %H:%M")
            n_msgs = len(s.get("messages", []))
            print(f" {mark} {s['id']}  {ts}  {n_msgs:>3}msg  {s.get('name', '')}")
        return 0
    if sub == "use":
        sess = load_session(args.session_id)
        if not sess:
            # try prefix match
            all_s = list_sessions()
            match = next((s for s in all_s if s["id"].startswith(args.session_id)), None)
            if not match:
                err(f"No session matches '{args.session_id}'.")
                return 1
            sess = match
        set_current(sess["id"])
        ok(f"Active session: {sess['id']} ({sess.get('name')})")
        return 0
    if sub == "delete":
        if delete_session(args.session_id):
            ok(f"Deleted {args.session_id}.")
        else:
            err(f"No session {args.session_id}.")
            return 1
        return 0
    if sub == "show":
        sess = load_session(args.session_id) if args.session_id else load_session(load_current() or "")
        if not sess:
            err("No such session.")
            return 1
        print(f"# {sess.get('name')} ({sess['id']})")
        print(f"# agent={sess.get('agent_id')} task={sess.get('task_id')}")
        for m in sess.get("messages", []):
            who = _color("you", "33") if m["sender"] == "user" else _color("eesel", "36")
            print(f"\n{who}:")
            print(m["message"])
        return 0
    return 1


def _print_cost_after_turn(creds: dict, sess: dict, prev_runs: int) -> None:
    """Poll briefly for fresh cost data, then print a one-line summary.

    The sandbox posts usage metrics back to the server *after* each LLM call
    finishes, so right when the SSE stream ends, the new metric rows haven't
    landed yet. We wait until either (a) the run count grew vs. before this
    turn, or (b) we hit the deadline.
    """
    deadline = time.time() + 4.0
    last = None
    while time.time() < deadline:
        d = fetch_session_cost(creds, sess)
        if d is None:
            print(_color("[cost: unavailable in prod — check /activity in dashboard]",
                         "2;37"), file=sys.stderr)
            return
        last = d
        if d["total_runs"] > prev_runs:
            break
        time.sleep(0.4)
    if last is None:
        return
    print(_color(format_cost_oneline(last), "2;37"), file=sys.stderr)


def _current_run_count(creds: dict, sess: dict) -> int:
    d = fetch_session_cost(creds, sess)
    return d["total_runs"] if d else 0


def cmd_chat(args) -> int:
    creds = require_creds()
    pick_agent(creds, prompt=False)  # only prompt in REPL if needed
    sess = ensure_current_session(creds, agent_id=creds.get("agent_id"))
    show_cost = bool(getattr(args, "cost", False))

    if args.message:
        prev_runs = _current_run_count(creds, sess) if show_cost else 0
        send_message(creds, sess, args.message)
        if show_cost:
            _print_cost_after_turn(creds, sess, prev_runs)
        return 0

    # REPL mode
    info(f"session {sess['id']} ({sess.get('name')}) — agent {sess.get('agent_id', '?')[:8]}")
    if show_cost:
        info("cost-on: a one-line cost summary will print after each reply.")
    info("Type your message. Empty line submits. Ctrl-C to quit. /help for commands.")
    try:
        import readline  # noqa: F401  — enables line editing
    except ImportError:
        pass

    while True:
        try:
            print(_color("\nyou ", "33") + "→ ", end="", flush=True)
            line = input()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        line = line.strip()
        if not line:
            continue
        if line.startswith("/"):
            if line in ("/quit", "/exit", "/q"):
                return 0
            if line == "/help":
                print("  /new        start a new session")
                print("  /sessions   list sessions")
                print("  /agents     list agents")
                print("  /show       print this session's history")
                print("  /cost       print cost summary for this session")
                print("  /cost-on    auto-print cost after each reply")
                print("  /cost-off   stop auto-printing cost")
                print("  /quit       exit")
                continue
            if line == "/new":
                sess = new_session(creds, agent_id=creds.get("agent_id"),
                                   name=None, switch_to=True)
                info(f"new session: {sess['id']}")
                continue
            if line == "/sessions":
                cmd_sessions(argparse.Namespace(sessions_cmd="list", session_id=None))
                continue
            if line == "/agents":
                cmd_agents(argparse.Namespace(agents_cmd="list", agent_id=None))
                continue
            if line == "/show":
                cmd_sessions(argparse.Namespace(sessions_cmd="show", session_id=sess["id"]))
                continue
            if line == "/cost":
                d = fetch_session_cost(creds, sess)
                if d is None:
                    info("cost data is dev-only right now — see /activity in the dashboard for prod")
                else:
                    print(format_cost_full(d, sess))
                continue
            if line == "/cost-on":
                show_cost = True
                info("cost-on")
                continue
            if line == "/cost-off":
                show_cost = False
                info("cost-off")
                continue
            warn(f"unknown command: {line}")
            continue
        prev_runs = _current_run_count(creds, sess) if show_cost else 0
        send_message(creds, sess, line)
        if show_cost:
            _print_cost_after_turn(creds, sess, prev_runs)


def cmd_cost(args) -> int:
    creds = require_creds()
    sid = args.session_id or load_current()
    if not sid:
        err("No active session. Run `eesel new` or `eesel sessions use <id>` first.")
        return 1
    sess = load_session(sid)
    if not sess:
        # try prefix match
        match = next((s for s in list_sessions() if s["id"].startswith(sid)), None)
        if not match:
            err(f"No session matches '{sid}'.")
            return 1
        sess = match
    d = fetch_session_cost(creds, sess)
    if d is None:
        info("cost data is dev-only right now — see /activity in the dashboard for prod")
        return 0
    print(format_cost_full(d, sess))
    return 0


# ──────────────────────────────────────────────────────────────────────────
# Argument parsing
# ──────────────────────────────────────────────────────────────────────────

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="eesel", description=__doc__.strip().split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("login", help="Authenticate (browser-based, or --dev for local)")
    sp.add_argument("--dev", action="store_true", help="Mint local dev JWT, no browser")
    sp.set_defaults(func=cmd_login)

    sp = sub.add_parser("logout", help="Clear stored credentials")
    sp.set_defaults(func=cmd_logout)

    sp = sub.add_parser("whoami", help="Show the current login")
    sp.set_defaults(func=cmd_whoami)

    sp = sub.add_parser("agents", help="List or switch agents")
    a_sub = sp.add_subparsers(dest="agents_cmd")
    a_sub.add_parser("list", help="List agents in this workspace")
    use = a_sub.add_parser("use", help="Set the active agent")
    use.add_argument("agent_id", help="Full id, id prefix, or agent name")
    sp.set_defaults(func=cmd_agents)

    sp = sub.add_parser("new", help="Start a new chat session")
    sp.add_argument("--agent", help="Agent id to use (default: active agent)")
    sp.add_argument("--name", help="Session name (default: auto)")
    sp.set_defaults(func=cmd_new)

    sp = sub.add_parser("sessions", help="Manage chat sessions")
    s_sub = sp.add_subparsers(dest="sessions_cmd")
    s_sub.add_parser("list", help="List sessions")
    use = s_sub.add_parser("use", help="Switch active session")
    use.add_argument("session_id")
    de = s_sub.add_parser("delete", help="Delete a session")
    de.add_argument("session_id")
    show = s_sub.add_parser("show", help="Print session history")
    show.add_argument("session_id", nargs="?", help="(default: active session)")
    sp.set_defaults(func=cmd_sessions)

    sp = sub.add_parser("chat", help="Send a message (no arg = interactive REPL)")
    sp.add_argument("message", nargs="?", help="Message to send (omit for REPL)")
    sp.add_argument("--cost", action="store_true",
                    help="After each reply, print a one-line cost + token "
                         "summary for the whole session (incl. sub-agents)")
    sp.set_defaults(func=cmd_chat)

    sp = sub.add_parser("cost",
                        help="Print cost + token usage for a session "
                             "(includes sub-agents). Dev mode only.")
    sp.add_argument("session_id", nargs="?",
                    help="(default: active session, prefix-match ok)")
    sp.set_defaults(func=cmd_cost)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
