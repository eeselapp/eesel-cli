def http_request(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60, headers: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json", **(headers or {})}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            if not raw:
                return {}
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                # A 2xx with a non-JSON body usually means a proxy/gateway or
                # login page answered instead of the API (e.g. an HTML error
                # page served with status 200). Surface a clean message rather
                # than letting the JSONDecodeError traceback escape.
                snippet = raw[:200].decode(errors="replace").strip()
                sys.exit(
                    f"{method} {url} → {resp.status} but the response was not JSON "
                    f"({len(raw)} bytes; a proxy or login page?): {snippet}"
                )
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        sys.exit(f"{method} {url} → {e.code}: {body_text}")
    except urllib.error.URLError as e:
        sys.exit(f"{method} {url} failed (server reachable?): {e}")


def http_request_allow_error(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60) -> tuple[int, dict]:
    """Like ``http_request`` but returns ``(status_code, parsed_json)`` instead
    of exiting on an HTTP error response.

    Used by flows that need to react to the server's error body rather than
    just abort — e.g. connecting an integration, where a 400 carries setup
    guidance (missing ``subdomain``, OAuth required) that the user must see.
    On a non-HTTP failure (server unreachable) it still exits, since there's no
    structured body to surface.
    """
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            parsed = json.loads(raw) if raw else {}
            return resp.status, (parsed if isinstance(parsed, dict) else {"result": parsed})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            parsed = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            parsed = {"error": raw.decode(errors="replace")}
        if not isinstance(parsed, dict):
            parsed = {"error": parsed}
        return e.code, parsed
    except urllib.error.URLError as e:
        sys.exit(f"{method} {url} failed (server reachable?): {e}")


def http_fetch(url: str, *, token: str, timeout: int = 120) -> bytes:
    """GET a URL with the workspace Bearer token and return the raw bytes.

    Shared by the document download (write to file) and read (print to stdout)
    paths. Mirrors http_request's error handling — sys.exit with the server's
    body on failure.
    """
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        sys.exit(f"GET {url} → {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"GET {url} failed (server reachable?): {e}")


def http_download(url: str, *, token: str, output_path: Path) -> None:
    output_path.write_bytes(http_fetch(url, token=token))


def parse_config_object(raw: str, *, example: str = '{"key": "value"}') -> dict:
    """Parse a ``--config`` JSON string into a dict, or exit with code 2 and a
    uniform error message.

    The shared parser for plain ``--config`` JSON-object arguments (triggers
    add, schedules add, skills edit, mcp add): malformed input gives the same
    message and the same exit code, rather than each command inventing its own
    error contract. ``example`` tailors the "must be a JSON object" hint to the
    calling command. (Two commands keep bespoke parsers because their config
    carries extra handling: ``integrations add`` and ``integrations actions
    edit``.)
    """
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError as e:
        err(f"--config is not valid JSON: {e}")
        sys.exit(2)
    if not isinstance(obj, dict):
        err(f"--config must be a JSON object (e.g. '{example}').")
        sys.exit(2)
    return obj


