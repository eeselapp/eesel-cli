def _fmt_money(amount) -> str:
    """Format a dollar amount, or '—' when it's missing/non-numeric."""
    if not isinstance(amount, (int, float)):
        return "—"
    return f"${amount:,.2f}"


def _fmt_iso_date(value) -> str:
    """Render an ISO-8601 timestamp as 'YYYY-MM-DD HH:MM', or pass it through
    unchanged when it isn't a parseable timestamp."""
    if not value:
        return "—"
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).strftime("%Y-%m-%d %H:%M")
    except (ValueError, AttributeError):
        return str(value)


def _print_billing_license(data: dict) -> None:
    print(f"active           : {data.get('isActive')}")
    print(f"plan             : {data.get('planName') or '—'}")
    print(f"status           : {data.get('subscriptionStatus') or '—'}")
    print(f"source           : {data.get('subscriptionSource') or '—'}")
    amount = data.get("paymentAmount")
    if amount is not None:
        interval = data.get("paymentInterval") or "—"
        print(f"payment          : {_fmt_money(amount)} / {interval}")
    else:
        print("payment          : —")
    print(f"billing email    : {data.get('billingEmail') or '—'}")
    print(f"billing limit    : {_fmt_money(data.get('billingLimit'))}")
    print(f"billing period   : {_fmt_iso_date(data.get('billingPeriodStart'))} → {_fmt_iso_date(data.get('billingPeriodEnd'))}")
    if data.get("trialEnd"):
        print(f"trial ends       : {_fmt_iso_date(data.get('trialEnd'))}")
    features = data.get("features") or []
    if features:
        print(f"features         : {', '.join(str(f) for f in features)}")
    pricing = data.get("pricing") or {}
    if pricing:
        print(
            "task pricing     : "
            f"light {_fmt_money(pricing.get('lightTaskDollars'))}, "
            f"regular {_fmt_money(pricing.get('regularTaskDollars'))}, "
            f"heavy {_fmt_money(pricing.get('heavyTaskDollars'))}"
        )


def _print_billing_usage(data: dict) -> None:
    def line(label: str, used, limit) -> None:
        cap = "∞" if limit in (None, "") else str(limit)
        print(f"{label:<16} : {used} / {cap}")

    line("interactions", data.get("numMessages"), data.get("maxMessages"))
    line("namespaces", data.get("numNamespaces"), data.get("maxNamespaces"))
    line("learning jobs", data.get("numLearningJobs"), data.get("maxLearningJobs"))
    print(f"{'cost consumed':<16} : {_fmt_money(data.get('costConsumed'))}")
    print(
        f"{'tasks':<16} : "
        f"light {data.get('numLightTasks', 0)}, "
        f"regular {data.get('numRegularTasks', 0)}, "
        f"heavy {data.get('numHeavyTasks', 0)}"
    )
    if data.get("limitReached"):
        reason = data.get("limitReachedReason") or "limit reached"
        warn(f"usage limit reached ({reason})")


def _print_billing_invoices(invoices: list) -> None:
    if not invoices:
        info("(no invoices)")
        return
    fmt = " {:<14}  {:<12}  {:<10}  {:<8}  {}"
    info(fmt.format("number", "created", "amount", "status", "pdf"))
    for inv in invoices:
        number = inv.get("number") or inv.get("id") or "—"
        created = _fmt_iso_date(inv.get("created"))
        amount = _fmt_money(inv.get("amountPaid"))
        status = inv.get("status") or "—"
        pdf = inv.get("invoicePdf") or inv.get("hostedInvoiceUrl") or "—"
        print(fmt.format(str(number)[:14], created[:12], amount, str(status)[:8], pdf))


def _print_billing_spend(series: list) -> None:
    if not series:
        info("(no spend recorded this period)")
        return
    total = 0.0
    for day in series:
        amount = day.get("amount")
        if isinstance(amount, (int, float)):
            total += amount
        print(f" {day.get('date') or '—':<12}  {_fmt_money(amount)}")
    print(f" {'total':<12}  {_fmt_money(total)}")


def _print_billing_mode(data: dict) -> None:
