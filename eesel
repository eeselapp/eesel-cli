def cmd_schedules(args) -> int:
    """`eesel schedules`: scheduled jobs — cron-driven agent runs. These are
    triggers whose key is the scheduled-job sentinel; the CLI gives them their
    own command group because they behave differently from event triggers
    (they have a cron, and they can be fired manually)."""
    creds = require_creds()
    sub = args.schedules_cmd or "list"

    if sub == "list":
        return _schedules_list(creds, as_json=getattr(args, "json", False))

    if sub == "add":
        return _schedules_add(creds, args)

    if sub in ("remove", "delete"):
        return _schedules_remove(creds, args)

