CREDS_FILE = CONFIG_DIR / "credentials.json"
SESSIONS_DIR = CONFIG_DIR / "sessions"
CURRENT_FILE = CONFIG_DIR / "current.json"

# Mirrors server/app/auth/dev_secrets.py — only used in --dev mode.
DEV_JWT_SECRET = "dev-fallback-secret-key-not-for-production"
POSTGRES_CONTAINER = "slack-postgres_db_dev-1"
POSTGRES_DB = "eesel_dev"


# ──────────────────────────────────────────────────────────────────────────
# Output helpers
# ──────────────────────────────────────────────────────────────────────────

def _is_tty() -> bool:
    return sys.stdout.isatty()


def _color(s: str, code: str) -> str:
    if not _is_tty():
        return s
    return f"\033[{code}m{s}\033[0m"


def info(msg: str) -> None:
    print(_color(msg, "2;37"), file=sys.stderr)  # dim


def warn(msg: str) -> None:
    print(_color(f"! {msg}", "33"), file=sys.stderr)


def err(msg: str) -> None:
    print(_color(f"✗ {msg}", "31"), file=sys.stderr)


def ok(msg: str) -> None:
    print(_color(f"✓ {msg}", "32"), file=sys.stderr)


# ──────────────────────────────────────────────────────────────────────────
# Config / credentials
# ──────────────────────────────────────────────────────────────────────────

def ensure_dirs() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)


def load_creds() -> dict | None:
    if not CREDS_FILE.exists():
        return None
    try:
        return json.loads(CREDS_FILE.read_text())
    except Exception:
        return None


def save_creds(creds: dict) -> None:
    ensure_dirs()
    CREDS_FILE.write_text(json.dumps(creds, indent=2))
    try:
        os.chmod(CREDS_FILE, 0o600)
    except OSError:
        pass


def require_creds() -> dict:
    creds = load_creds()
    if not creds:
        err("Not logged in. Run `eesel login` first.")
        sys.exit(1)
    if creds.get("expires_at") and time.time() > creds["expires_at"]:
        err("Token expired. Run `eesel login` again.")
        sys.exit(1)
    return creds


# ──────────────────────────────────────────────────────────────────────────
# Sessions
# ──────────────────────────────────────────────────────────────────────────

def _session_path(sid: str) -> Path:
    return SESSIONS_DIR / f"{sid}.json"


def list_sessions() -> list[dict]:
    if not SESSIONS_DIR.exists():
        return []
    out = []
    for p in SESSIONS_DIR.glob("*.json"):
        try:
            out.append(json.loads(p.read_text()))
        except Exception:
            continue
    out.sort(key=lambda s: s.get("updated_at", 0), reverse=True)
    return out


def load_session(sid: str) -> dict | None:
    p = _session_path(sid)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def save_session(sess: dict) -> None:
    ensure_dirs()
    sess["updated_at"] = time.time()
    _session_path(sess["id"]).write_text(json.dumps(sess, indent=2))


def delete_session(sid: str) -> bool:
    p = _session_path(sid)
    if p.exists():
        p.unlink()
        cur = load_current()
        if cur == sid:
            CURRENT_FILE.unlink(missing_ok=True)
        return True
    return False


def load_current() -> str | None:
    if not CURRENT_FILE.exists():
        return None
    try:
        return json.loads(CURRENT_FILE.read_text()).get("session_id")
    except Exception:
        return None


def set_current(sid: str | None) -> None:
    ensure_dirs()
    if sid is None:
        CURRENT_FILE.unlink(missing_ok=True)
        return
    CURRENT_FILE.write_text(json.dumps({"session_id": sid}, indent=2))


def ensure_current_session(creds: dict, agent_id: str | None = None) -> dict:
    """Return the active session, creating one if needed."""
    sid = load_current()
    sess = load_session(sid) if sid else None
    if sess:
        return sess
    return new_session(creds, agent_id=agent_id, name=None, switch_to=True)


def new_session(creds: dict, *, agent_id: str | None, name: str | None,
                switch_to: bool = True) -> dict:
    sid = uuid.uuid4().hex[:12]
    sess = {
        "id": sid,
        "name": name or f"chat-{datetime.now().strftime('%Y%m%d-%H%M')}",
        "agent_id": agent_id or creds.get("agent_id"),
        "workspace_id": creds["workspace_id"],
        "task_id": str(uuid.uuid4()),
        "messages": [],
        "created_at": time.time(),
        "updated_at": time.time(),
    }
    save_session(sess)
    if switch_to:
        set_current(sid)
    return sess


# ──────────────────────────────────────────────────────────────────────────
# JWT helpers (dev mode only)
# ──────────────────────────────────────────────────────────────────────────

def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def mint_dev_jwt(workspace_id: str, agent_id: str | None) -> str:
    header = _b64url(json.dumps({"alg": "HS256", "typ": "JWT"},
                                separators=(",", ":")).encode())
    now = int(time.time())
    payload_d = {"workspace_id": workspace_id, "iat": now, "exp": now + 86400}
    if agent_id:
        payload_d["agent_id"] = agent_id
    payload = _b64url(json.dumps(payload_d, separators=(",", ":")).encode())
    sig = _b64url(hmac.new(DEV_JWT_SECRET.encode(),
                           f"{header}.{payload}".encode(),
                           hashlib.sha256).digest())
    return f"{header}.{payload}.{sig}"


def _run_psql(sql: str) -> str:
    """Run a query via `docker exec psql` against the dev container.

    Raises RuntimeError on failure rather than sys.exit so callers can
    decide whether the failure is fatal (e.g. login) or just a soft miss
    (e.g. cost lookup before metrics have landed).
    """
    try:
        return subprocess.check_output(
            ["docker", "exec", POSTGRES_CONTAINER, "psql", "-U", "postgres",
             "-d", POSTGRES_DB, "-Atc", sql],
            stderr=subprocess.PIPE,
        ).decode().strip()
    except FileNotFoundError:
        raise RuntimeError("docker not on PATH. Is Docker running?")
    except subprocess.CalledProcessError as e:
        raise RuntimeError(
            f"psql failed against {POSTGRES_CONTAINER}: "
            f"{e.stderr.decode().strip()}"
        )


def discover_local_ids() -> tuple[str, str]:
    """Read workspace_id + agent_id from the local Postgres container."""
    sql = (
        'SELECT w."workspaceId", a.agent_id '
        "FROM eesel_ai_workspaces w "
        'LEFT JOIN eesel_ai_agents a ON a.workspace_id = w."workspaceId" '
        'ORDER BY w."createdAt" ASC LIMIT 1;'
    )
    try:
        out = _run_psql(sql)
    except RuntimeError as e:
        sys.exit(
            f"Could not read workspace from local db. "
            f"Is `docker compose up` running in ~/src/slack?\n{e}"
        )
    if not out or "|" not in out:
        sys.exit("No workspace in local db. Sign up via the local dashboard first.")
    ws, ag = out.split("|", 1)
    if not ag:
        sys.exit(f"Workspace {ws} has no agent. Create one in the dashboard first.")
    return ws, ag


# ──────────────────────────────────────────────────────────────────────────
# Cost tracking (dev-only for now)
# ──────────────────────────────────────────────────────────────────────────

# Recursively walks task → child tasks via parent_task_id, joins eesel_ai_task_metrics.
# One row per task in the tree; the root row has parent_task_id NULL.
_COST_SQL_TEMPLATE = """
WITH RECURSIVE task_tree AS (
    SELECT task_id, parent_task_id, name FROM eesel_ai_tasks WHERE task_id = '{root}'
    UNION ALL
    SELECT t.task_id, t.parent_task_id, t.name
    FROM eesel_ai_tasks t
    INNER JOIN task_tree tt ON t.parent_task_id = tt.task_id
)
SELECT
    tt.task_id,
    COALESCE(tt.parent_task_id::text, ''),
    COALESCE(tt.name, ''),
    COALESCE(SUM(tm.cost), 0),
    COALESCE(SUM(tm.input_tokens), 0),
    COALESCE(SUM(tm.output_tokens), 0),
    COALESCE(SUM(tm.cache_read_tokens), 0),
    COALESCE(SUM(tm.cache_write_tokens), 0),
    COUNT(tm.id)
FROM task_tree tt
LEFT JOIN eesel_ai_task_metrics tm ON tm.task_id = tt.task_id
GROUP BY tt.task_id, tt.parent_task_id, tt.name
ORDER BY tt.parent_task_id NULLS FIRST, tt.task_id;
""".strip()


def parse_cost_rows(raw: str) -> dict:
    """Parse the |-delimited psql output into a structured cost dict.

    Returns:
        {
            "total_cost": float,
            "total_runs": int,
            "totals": {input_tokens, output_tokens, cache_read_tokens, cache_write_tokens},
            "by_task": [{task_id, parent_task_id, name, cost, runs, ...}, ...],
        }
    """
    by_task: list[dict] = []
    total_cost = 0.0
    total_runs = 0
    totals = {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
    }
    for line in raw.splitlines():
        if not line.strip():
            continue
        parts = line.split("|")
        if len(parts) != 9:
            continue
        task_id, parent_id, name, cost, in_t, out_t, cr, cw, runs = parts
        row = {
            "task_id": task_id,
            "parent_task_id": parent_id or None,
            "name": name,
            "cost": float(cost or 0),
            "input_tokens": int(in_t or 0),
            "output_tokens": int(out_t or 0),
            "cache_read_tokens": int(cr or 0),
            "cache_write_tokens": int(cw or 0),
            "runs": int(runs or 0),
        }
        by_task.append(row)
        total_cost += row["cost"]
        total_runs += row["runs"]
        totals["input_tokens"] += row["input_tokens"]
        totals["output_tokens"] += row["output_tokens"]
        totals["cache_read_tokens"] += row["cache_read_tokens"]
        totals["cache_write_tokens"] += row["cache_write_tokens"]
    return {
        "total_cost": total_cost,
        "total_runs": total_runs,
        "totals": totals,
        "by_task": by_task,
    }


def fetch_session_cost(creds: dict, sess: dict) -> dict | None:
    """Pull cost + token usage for a session's whole task tree.

    Currently dev-only — reads directly from local Postgres. In prod the
    workspace JWT can't reach the metrics endpoint (it's Auth0-gated), so
    we return None and the caller prints a hint.
    """
    if creds.get("env") != "dev":
        return None
    root = sess.get("task_id")
    if not root:
        return None
    # Root must look UUID-ish — defends against any oddly stored task_ids
    # ending up interpolated into the SQL string.
    if not all(c in "0123456789abcdef-" for c in root.lower()):
        return None
    sql = _COST_SQL_TEMPLATE.format(root=root)
    try:
        raw = _run_psql(sql)
    except RuntimeError:
        return None
    return parse_cost_rows(raw)


def _fmt_tokens(n: int) -> str:
    """1234 → '1,234'; 1234567 → '1.23M'."""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _fmt_cost(c: float) -> str:
    if c < 0.01:
        return f"${c:.4f}"
    return f"${c:.4f}"


def format_cost_oneline(d: dict) -> str:
    if d["total_runs"] == 0:
        return "[no cost data yet — metrics arrive async]"
    return (
        f"[{_fmt_cost(d['total_cost'])} · "
        f"{_fmt_tokens(d['totals']['input_tokens'])} in / "
        f"{_fmt_tokens(d['totals']['output_tokens'])} out · "
        f"{d['total_runs']} call{'s' if d['total_runs'] != 1 else ''}"
        + (f" · {len(d['by_task'])} tasks" if len(d["by_task"]) > 1 else "")
        + "]"
    )


def format_cost_full(d: dict, sess: dict) -> str:
    lines = []
    lines.append(f"session {sess['id']} ({sess.get('name', '?')})")
    lines.append(f"  task_id: {sess.get('task_id', '?')}")
    if d["total_runs"] == 0:
        lines.append("  no cost data — either nothing has run yet, or metrics")
        lines.append("  haven't been flushed (sandbox posts them async after")
        lines.append("  each LLM call finishes).")
        return "\n".join(lines)
    t = d["totals"]
    lines.append("")
    lines.append(f"  total: {_fmt_cost(d['total_cost'])}  ({d['total_runs']} LLM calls)")
    lines.append(f"    input          {_fmt_tokens(t['input_tokens']):>10}  tokens")
    lines.append(f"    output         {_fmt_tokens(t['output_tokens']):>10}  tokens")
    lines.append(f"    cache read     {_fmt_tokens(t['cache_read_tokens']):>10}  tokens")
    lines.append(f"    cache write    {_fmt_tokens(t['cache_write_tokens']):>10}  tokens")
    if len(d["by_task"]) > 1:
        lines.append("")
        lines.append(f"  by task ({len(d['by_task'])}):")
        for row in d["by_task"]:
            label = "root" if not row["parent_task_id"] else "sub"
            short = row["task_id"][:8]
            name = row["name"][:40] if row["name"] else "(unnamed)"
            lines.append(
                f"    [{label}] {short}  {_fmt_cost(row['cost'])}  "
                f"{row['runs']} call{'s' if row['runs'] != 1 else ''}  {name}"
            )
    return "\n".join(lines)


