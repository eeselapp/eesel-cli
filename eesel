def login_dev() -> dict:
    workspace_id, agent_id = discover_local_ids()
    token = mint_dev_jwt(workspace_id, agent_id)
    creds = {
        "env": "dev",
        "api_url": ENVS["dev"]["api"],
        "dashboard_url": ENVS["dev"]["dashboard"],
        "workspace_id": workspace_id,
        "agent_id": agent_id,
        "token": token,
        "expires_at": int(time.time()) + 86400,
    }
    save_creds(creds)
    ok(f"Logged in (dev) — workspace={workspace_id} agent={agent_id}")
    return creds


def _find_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def login_prod() -> dict:
    """Browser bridge: open dashboard.eesel.ai/cli, capture token via local HTTP server."""
    state = secrets_mod.token_urlsafe(24)
    port = _find_free_port()
    dashboard = ENVS["prod"]["dashboard"]
    api_url = ENVS["prod"]["api"]

    captured: dict = {}
    done = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a, **kw):
            pass

        def _cors(self):
            origin = self.headers.get("Origin", "")
            allow = origin if origin in (dashboard, "http://localhost:3000") else dashboard
            self.send_header("Access-Control-Allow-Origin", allow)
            self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type")

        def do_OPTIONS(self):
            self.send_response(204)
            self._cors()
            self.end_headers()

        def do_POST(self):
            if self.path != "/auth":
                self.send_response(404)
                self._cors()
                self.end_headers()
                return
            length = int(self.headers.get("Content-Length", 0))
            try:
                payload = json.loads(self.rfile.read(length))
            except Exception:
                self.send_response(400)
                self._cors()
                self.end_headers()
                return
            if payload.get("state") != state:
                self.send_response(400)
                self._cors()
                self.end_headers()
                self.wfile.write(b'{"error":"state mismatch"}')
                return
            captured.update(payload)
            self.send_response(200)
            self._cors()
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ok":true}')
            done.set()

        def do_GET(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"eesel-cli local auth listener\n")

    server = http.server.HTTPServer(("127.0.0.1", port), Handler)
    th = threading.Thread(target=server.serve_forever, daemon=True)
    th.start()

    # We open /api/cli/init rather than /cli directly. The init route is
    # Auth0-gated, validates state + port, then sets `cli_state` as an
    # HttpOnly SameSite=Strict cookie scoped to /cli before 302-redirecting.
    # /cli reads the cookie server-side — state never lives in the URL,
    # so it can't end up in browser history, referrer headers, or be
    # injected by a malicious deep-link.
    url = f"{dashboard}/api/cli/init?{urllib.parse.urlencode({'port': port, 'state': state})}"
    info(f"Opening {url}")
    info("If the browser didn't open, paste that URL manually.")
    try:
        webbrowser.open(url)
    except Exception:
        pass

    if not done.wait(timeout=300):
        server.shutdown()
        sys.exit("Timed out waiting for browser auth (5 min).")
    server.shutdown()

    token = captured.get("token")
    workspace_id = captured.get("workspace_id") or captured.get("workspaceId")
    user_email = captured.get("user_email") or captured.get("email")
    if not token or not workspace_id:
        sys.exit(f"Auth response missing fields: {captured}")

    creds = {
        "env": "prod",
        "api_url": api_url,
        "dashboard_url": dashboard,
        "workspace_id": workspace_id,
        "user_email": user_email,
        "agent_id": None,  # picked on first chat / via `eesel agents use`
        "token": token,
        "expires_at": int(time.time()) + 86400,
    }
    save_creds(creds)
    ok(f"Logged in — workspace={workspace_id}{f' as {user_email}' if user_email else ''}")
    return creds


