    ns = resolve_namespace_or_error(creds, getattr(args, "agent_id", None))
    if not ns:
        return 1
    prompt = get_namespace_prompt(creds, ns["id"])
    if _want_json(args):
        emit({**ns, "prompt": prompt})
        return 0
    print(f"{ns.get('namespace', '?')}  ({ns.get('id', '')})")
    print(f"  owner:       {'yes' if ns.get('isOwner') else 'no'}")
    print(f"  connections: {len(ns.get('connections') or [])}")
    p = (prompt or "").strip()
    if not p:
