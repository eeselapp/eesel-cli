        print(f"user_email   : {creds['user_email']}")
    print(f"token expires: {expires_in}s ({expires_in // 3600}h {(expires_in % 3600) // 60}m)")

    # Surface active impersonation so sticky state isn't invisible. Failures
    # here (network, allowlist gate, missing endpoint on older servers) are
    # intentionally silent — whoami shouldn't error just because we can't
    # reach the endpoint.
    try:
        url = f"{creds['api_url']}/cli/impersonate"
