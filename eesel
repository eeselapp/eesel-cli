# JWT helpers (dev mode only)
# ──────────────────────────────────────────────────────────────────────────


def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def mint_dev_jwt(workspace_id: str, agent_id: str | None, user_id: str | None = None) -> str:
    header = _b64url(json.dumps({"alg": "HS256", "typ": "JWT"}, separators=(",", ":")).encode())
    now = int(time.time())
    payload_d = {"workspace_id": workspace_id, "iat": now, "exp": now + CLI_TOKEN_TTL_SECONDS}
    if agent_id:
        payload_d["agent_id"] = agent_id
    if user_id:
        # Required by chat RBAC (kira/rbac-core) — POST /agents/sandbox/start
        # rejects tokens without user_id since 2026-04-30.
        payload_d["user_id"] = user_id
        payload_d["sub"] = user_id
    payload = _b64url(json.dumps(payload_d, separators=(",", ":")).encode())
    sig = _b64url(hmac.new(DEV_JWT_SECRET.encode(), f"{header}.{payload}".encode(), hashlib.sha256).digest())
    return f"{header}.{payload}.{sig}"


def _run_psql(sql: str) -> str:
    """Run a query via `docker exec psql` against the dev container.

    Raises RuntimeError on failure rather than sys.exit so callers can
    decide whether the failure is fatal (e.g. login) or just a soft miss
    (e.g. cost lookup before metrics have landed).
    """
    try:
        return (
            subprocess.check_output(
                ["docker", "exec", POSTGRES_CONTAINER, "psql", "-U", "postgres", "-d", POSTGRES_DB, "-Atc", sql],
                stderr=subprocess.PIPE,
            )
            .decode()
            .strip()
        )
    except FileNotFoundError:
        raise RuntimeError("docker not on PATH. Is Docker running?")
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"psql failed against {POSTGRES_CONTAINER}: {e.stderr.decode().strip()}")


def discover_local_ids(workspace_id: str | None = None) -> tuple[str, str, str | None]:
    """Read workspace_id, agent_id, and workspace owner user_id from local Postgres."""
    # Tab separator avoids collision with `|` characters that appear inside
    # user_ids like "google-oauth2|104939625588671259012".
    workspace_filter = ""
    if workspace_id:
        workspace_filter = f"""WHERE w."workspaceId" = '{workspace_id.replace("'", "''")}'"""
    sql = f"""SELECT w."workspaceId", a.agent_id, w."workspaceOwnerUserId" FROM eesel_ai_workspaces w LEFT JOIN eesel_ai_agents a ON a.workspace_id = w."workspaceId" {workspace_filter} ORDER BY w."createdAt" ASC LIMIT 1;"""
    try:
        out = (
            subprocess.check_output(
                ["docker", "exec", POSTGRES_CONTAINER, "psql", "-U", "postgres", "-d", POSTGRES_DB, "-AtF", "\t", "-c", sql],
                stderr=subprocess.PIPE,
            )
            .decode()
            .strip()
        )
    except FileNotFoundError:
        sys.exit("docker not on PATH. Is Docker running?")
    except subprocess.CalledProcessError as e:
        sys.exit(f"Could not read workspace from local db. Is `docker compose up` running in ~/src/slack?\n{e.stderr.decode().strip()}")
    parts = out.split("\t") if out else []
    if len(parts) < 2:
        if workspace_id:
            sys.exit(f"No workspace {workspace_id} in local db.")
        sys.exit("No workspace in local db. Sign up via the local dashboard first.")
    ws, ag = parts[0], parts[1]
    user_id = parts[2] if len(parts) >= 3 and parts[2] else None
    if not ag:
        sys.exit(f"Workspace {ws} has no agent. Create one in the dashboard first.")
    return ws, ag, user_id


# ──────────────────────────────────────────────────────────────────────────
# Cost tracking (dev-only for now)
# ──────────────────────────────────────────────────────────────────────────

# Recursively walks task → child tasks via parent_task_id, joins eesel_ai_task_metrics.
# One row per task in the tree; the root row has parent_task_id NULL.
_COST_SQL_TEMPLATE = """
WITH RECURSIVE task_tree AS (
    SELECT task_id, parent_task_id, name FROM eesel_ai_tasks WHERE task_id = '{root}'
    UNION ALL
    SELECT t.task_id, t.parent_task_id, t.name
    FROM eesel_ai_tasks t
    INNER JOIN task_tree tt ON t.parent_task_id = tt.task_id
)
SELECT
    tt.task_id,
    COALESCE(tt.parent_task_id::text, ''),
    COALESCE(tt.name, ''),
    COALESCE(SUM(tm.cost), 0),
    COALESCE(SUM(tm.input_tokens), 0),
    COALESCE(SUM(tm.output_tokens), 0),
    COALESCE(SUM(tm.cache_read_tokens), 0),
    COALESCE(SUM(tm.cache_write_tokens), 0),
    COUNT(tm.id)
FROM task_tree tt
LEFT JOIN eesel_ai_task_metrics tm ON tm.task_id = tt.task_id
GROUP BY tt.task_id, tt.parent_task_id, tt.name
ORDER BY tt.parent_task_id NULLS FIRST, tt.task_id;
""".strip()


def parse_cost_rows(raw: str) -> dict:
    """Parse the |-delimited psql output into a structured cost dict.

    Returns:
        {
            "total_cost": float,
            "total_runs": int,
            "totals": {input_tokens, output_tokens, cache_read_tokens, cache_write_tokens},
            "by_task": [{task_id, parent_task_id, name, cost, runs, ...}, ...],
        }
    """
    by_task: list[dict] = []
    total_cost = 0.0
    total_runs = 0
    totals = {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
    }
    for line in raw.splitlines():
        if not line.strip():
            continue
        parts = line.split("|")
        if len(parts) != 9:
            continue
        task_id, parent_id, name, cost, in_t, out_t, cr, cw, runs = parts
        row = {
            "task_id": task_id,
            "parent_task_id": parent_id or None,
            "name": name,
            "cost": float(cost or 0),
            "input_tokens": int(in_t or 0),
            "output_tokens": int(out_t or 0),
            "cache_read_tokens": int(cr or 0),
            "cache_write_tokens": int(cw or 0),
            "runs": int(runs or 0),
        }
        by_task.append(row)
        total_cost += row["cost"]
        total_runs += row["runs"]
        totals["input_tokens"] += row["input_tokens"]
        totals["output_tokens"] += row["output_tokens"]
        totals["cache_read_tokens"] += row["cache_read_tokens"]
        totals["cache_write_tokens"] += row["cache_write_tokens"]
    return {
        "total_cost": total_cost,
        "total_runs": total_runs,
        "totals": totals,
        "by_task": by_task,
    }


def fetch_session_cost(creds: dict, sess: dict) -> dict | None:
    """Pull cost + token usage for a session's whole task tree.

    Currently dev-only — reads directly from local Postgres. In prod the
    workspace JWT can't reach the metrics endpoint (it's Auth0-gated), so
    we return None and the caller prints a hint.
    """
    if creds.get("env") != "dev":
        return None
    root = sess.get("task_id")
    if not root:
        return None
    # Root must look UUID-ish — defends against any oddly stored task_ids
    # ending up interpolated into the SQL string.
    if not all(c in "0123456789abcdef-" for c in root.lower()):
        return None
    sql = _COST_SQL_TEMPLATE.format(root=root)
    try:
        raw = _run_psql(sql)
    except RuntimeError:
        return None
    return parse_cost_rows(raw)


def _fmt_tokens(n: int) -> str:
    """1234 → '1,234'; 1234567 → '1.23M'."""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _fmt_cost(c: float) -> str:
    if c < 0.01:
        return f"${c:.4f}"
    return f"${c:.4f}"


def format_cost_oneline(d: dict) -> str:
    if d["total_runs"] == 0:
        return "[no cost data yet — metrics arrive async]"
    return (
        f"[{_fmt_cost(d['total_cost'])} · "
        f"{_fmt_tokens(d['totals']['input_tokens'])} in / "
        f"{_fmt_tokens(d['totals']['output_tokens'])} out · "
        f"{d['total_runs']} call{'s' if d['total_runs'] != 1 else ''}" + (f" · {len(d['by_task'])} tasks" if len(d["by_task"]) > 1 else "") + "]"
    )


def format_cost_full(d: dict, sess: dict, label: str = "session") -> str:
    lines = []
    lines.append(f"{label} {sess['id']} ({sess.get('name', '?')})")
    lines.append(f"  task_id: {sess.get('task_id', '?')}")
    if d["total_runs"] == 0:
        lines.append("  no cost data — either nothing has run yet, or metrics")
        lines.append("  haven't been flushed (sandbox posts them async after")
        lines.append("  each LLM call finishes).")
        return "\n".join(lines)
    t = d["totals"]
    lines.append("")
    lines.append(f"  total: {_fmt_cost(d['total_cost'])}  ({d['total_runs']} LLM calls)")
    lines.append(f"    input          {_fmt_tokens(t['input_tokens']):>10}  tokens")
    lines.append(f"    output         {_fmt_tokens(t['output_tokens']):>10}  tokens")
    lines.append(f"    cache read     {_fmt_tokens(t['cache_read_tokens']):>10}  tokens")
    lines.append(f"    cache write    {_fmt_tokens(t['cache_write_tokens']):>10}  tokens")
    if len(d["by_task"]) > 1:
        lines.append("")
        lines.append(f"  by task ({len(d['by_task'])}):")
        for row in d["by_task"]:
            label = "root" if not row["parent_task_id"] else "sub"
            short = row["task_id"][:8]
            name = row["name"][:40] if row["name"] else "(unnamed)"
            lines.append(f"    [{label}] {short}  {_fmt_cost(row['cost'])}  {row['runs']} call{'s' if row['runs'] != 1 else ''}  {name}")
    return "\n".join(lines)


# ──────────────────────────────────────────────────────────────────────────
# HTTP helpers
# ──────────────────────────────────────────────────────────────────────────


def http_request(method: str, url: str, *, token: str | None = None, body: dict | None = None, timeout: int = 60, headers: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json", **(headers or {})}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
            if not raw:
                return {}
            try:
                return json.loads(raw)
            except json.JSONDecodeError:
                # A 2xx with a non-JSON body usually means a proxy/gateway or
                # login page answered instead of the API (e.g. an HTML error
                # page served with status 200). Surface a clean message rather
                # than letting the JSONDecodeError traceback escape.
                snippet = raw[:200].decode(errors="replace").strip()
                sys.exit(
                    f"{method} {url} → {resp.status} but the response was not JSON "
                    f"({len(raw)} bytes; a proxy or login page?): {snippet}"
                )
    except urllib.error.HTTPError as e:
        body_text = e.read().decode(errors="replace")
        sys.exit(f"{method} {url} → {e.code}: {body_text}")
    except urllib.error.URLError as e:
        sys.exit(f"{method} {url} failed (server reachable?): {e}")


def http_fetch(url: str, *, token: str, timeout: int = 120) -> bytes:
    """GET a URL with the workspace Bearer token and return the raw bytes.

    Shared by the document download (write to file) and read (print to stdout)
    paths. Mirrors http_request's error handling — sys.exit with the server's
    body on failure.
    """
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as e:
        sys.exit(f"GET {url} → {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"GET {url} failed (server reachable?): {e}")


def http_download(url: str, *, token: str, output_path: Path) -> None:
    output_path.write_bytes(http_fetch(url, token=token))


def parse_config_object(raw: str, *, example: str = '{"key": "value"}') -> dict:
    """Parse a ``--config`` JSON string into a dict, or exit with code 2 and a
    uniform error message.

    Every command that takes a ``--config`` JSON argument routes through this
    so malformed input behaves identically across the whole surface (the same
    message and the same exit code), rather than each command inventing its own
    error contract. ``example`` tailors the "must be a JSON object" hint to the
    calling command.
    """
    try:
        obj = json.loads(raw)
    except json.JSONDecodeError as e:
        err(f"--config is not valid JSON: {e}")
        sys.exit(2)
    if not isinstance(obj, dict):
        err(f"--config must be a JSON object (e.g. '{example}').")
        sys.exit(2)
    return obj


