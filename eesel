# Recursively walks task → child tasks via parent_task_id, joins eesel_ai_task_metrics.
# One row per task in the tree; the root row has parent_task_id NULL.
_COST_SQL_TEMPLATE = """
WITH RECURSIVE task_tree AS (
    SELECT task_id, parent_task_id, name FROM eesel_ai_tasks WHERE task_id = '{root}'
    UNION ALL
    SELECT t.task_id, t.parent_task_id, t.name
    FROM eesel_ai_tasks t
    INNER JOIN task_tree tt ON t.parent_task_id = tt.task_id
)
SELECT
    tt.task_id,
    COALESCE(tt.parent_task_id::text, ''),
    COALESCE(tt.name, ''),
    COALESCE(SUM(tm.cost), 0),
    COALESCE(SUM(tm.input_tokens), 0),
    COALESCE(SUM(tm.output_tokens), 0),
    COALESCE(SUM(tm.cache_read_tokens), 0),
    COALESCE(SUM(tm.cache_write_tokens), 0),
    COUNT(tm.id)
FROM task_tree tt
LEFT JOIN eesel_ai_task_metrics tm ON tm.task_id = tt.task_id
GROUP BY tt.task_id, tt.parent_task_id, tt.name
ORDER BY tt.parent_task_id NULLS FIRST, tt.task_id;
""".strip()


def parse_cost_rows(raw: str) -> dict:
    """Parse the |-delimited psql output into a structured cost dict.

    Returns:
        {
            "total_cost": float,
            "total_runs": int,
            "totals": {input_tokens, output_tokens, cache_read_tokens, cache_write_tokens},
            "by_task": [{task_id, parent_task_id, name, cost, runs, ...}, ...],
        }
    """
    by_task: list[dict] = []
    total_cost = 0.0
    total_runs = 0
    totals = {
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
    }
    for line in raw.splitlines():
        if not line.strip():
            continue
        parts = line.split("|")
        if len(parts) != 9:
            continue
        task_id, parent_id, name, cost, in_t, out_t, cr, cw, runs = parts
        row = {
            "task_id": task_id,
            "parent_task_id": parent_id or None,
            "name": name,
            "cost": float(cost or 0),
            "input_tokens": int(in_t or 0),
            "output_tokens": int(out_t or 0),
            "cache_read_tokens": int(cr or 0),
            "cache_write_tokens": int(cw or 0),
            "runs": int(runs or 0),
        }
        by_task.append(row)
        total_cost += row["cost"]
        total_runs += row["runs"]
        totals["input_tokens"] += row["input_tokens"]
        totals["output_tokens"] += row["output_tokens"]
        totals["cache_read_tokens"] += row["cache_read_tokens"]
        totals["cache_write_tokens"] += row["cache_write_tokens"]
    return {
        "total_cost": total_cost,
        "total_runs": total_runs,
        "totals": totals,
        "by_task": by_task,
    }


def fetch_session_cost(creds: dict, sess: dict) -> dict | None:
    """Pull cost + token usage for a session's whole task tree.

    Currently dev-only — reads directly from local Postgres. In prod the
    workspace JWT can't reach the metrics endpoint (it's Auth0-gated), so
    we return None and the caller prints a hint.
    """
    if creds.get("env") != "dev":
        return None
    root = sess.get("task_id")
    if not root:
        return None
    # Root must look UUID-ish — defends against any oddly stored task_ids
    # ending up interpolated into the SQL string.
    if not all(c in "0123456789abcdef-" for c in root.lower()):
        return None
    sql = _COST_SQL_TEMPLATE.format(root=root)
    try:
        raw = _run_psql(sql)
    except RuntimeError:
        return None
    return parse_cost_rows(raw)


def _fmt_tokens(n: int) -> str:
    """1234 → '1,234'; 1234567 → '1.23M'."""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.2f}M"
    if n >= 10_000:
        return f"{n / 1_000:.1f}k"
    return f"{n:,}"


def _fmt_cost(c: float) -> str:
    if c < 0.01:
        return f"${c:.4f}"
    return f"${c:.4f}"


def format_cost_oneline(d: dict) -> str:
    if d["total_runs"] == 0:
        return "[no cost data yet — metrics arrive async]"
    return (
        f"[{_fmt_cost(d['total_cost'])} · "
        f"{_fmt_tokens(d['totals']['input_tokens'])} in / "
        f"{_fmt_tokens(d['totals']['output_tokens'])} out · "
        f"{d['total_runs']} call{'s' if d['total_runs'] != 1 else ''}" + (f" · {len(d['by_task'])} tasks" if len(d["by_task"]) > 1 else "") + "]"
    )


def format_cost_full(d: dict, sess: dict, label: str = "session") -> str:
    lines = []
    lines.append(f"{label} {sess['id']} ({sess.get('name', '?')})")
    lines.append(f"  task_id: {sess.get('task_id', '?')}")
    if d["total_runs"] == 0:
        lines.append("  no cost data — either nothing has run yet, or metrics")
        lines.append("  haven't been flushed (sandbox posts them async after")
        lines.append("  each LLM call finishes).")
        return "\n".join(lines)
    t = d["totals"]
    lines.append("")
    lines.append(f"  total: {_fmt_cost(d['total_cost'])}  ({d['total_runs']} LLM calls)")
    lines.append(f"    input          {_fmt_tokens(t['input_tokens']):>10}  tokens")
    lines.append(f"    output         {_fmt_tokens(t['output_tokens']):>10}  tokens")
    lines.append(f"    cache read     {_fmt_tokens(t['cache_read_tokens']):>10}  tokens")
    lines.append(f"    cache write    {_fmt_tokens(t['cache_write_tokens']):>10}  tokens")
    if len(d["by_task"]) > 1:
        lines.append("")
        lines.append(f"  by task ({len(d['by_task'])}):")
        for row in d["by_task"]:
            label = "root" if not row["parent_task_id"] else "sub"
            short = row["task_id"][:8]
            name = row["name"][:40] if row["name"] else "(unnamed)"
            lines.append(f"    [{label}] {short}  {_fmt_cost(row['cost'])}  {row['runs']} call{'s' if row['runs'] != 1 else ''}  {name}")
    return "\n".join(lines)


