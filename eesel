def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def mint_dev_jwt(workspace_id: str, agent_id: str | None, user_id: str | None = None) -> str:
    header = _b64url(json.dumps({"alg": "HS256", "typ": "JWT"}, separators=(",", ":")).encode())
    now = int(time.time())
    payload_d = {"workspace_id": workspace_id, "iat": now, "exp": now + CLI_TOKEN_TTL_SECONDS}
    if agent_id:
        payload_d["agent_id"] = agent_id
    if user_id:
        # Required by chat RBAC (kira/rbac-core) — POST /agents/sandbox/start
        # rejects tokens without user_id since 2026-04-30.
        payload_d["user_id"] = user_id
        payload_d["sub"] = user_id
    payload = _b64url(json.dumps(payload_d, separators=(",", ":")).encode())
    sig = _b64url(hmac.new(DEV_JWT_SECRET.encode(), f"{header}.{payload}".encode(), hashlib.sha256).digest())
    return f"{header}.{payload}.{sig}"


def _run_psql(sql: str) -> str:
    """Run a query via `docker exec psql` against the dev container.

    Raises RuntimeError on failure rather than sys.exit so callers can
    decide whether the failure is fatal (e.g. login) or just a soft miss
    (e.g. cost lookup before metrics have landed).
    """
    try:
        return (
            subprocess.check_output(
                ["docker", "exec", POSTGRES_CONTAINER, "psql", "-U", "postgres", "-d", POSTGRES_DB, "-Atc", sql],
                stderr=subprocess.PIPE,
            )
            .decode()
            .strip()
        )
    except FileNotFoundError:
        raise RuntimeError("docker not on PATH. Is Docker running?")
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"psql failed against {POSTGRES_CONTAINER}: {e.stderr.decode().strip()}")


def discover_local_ids(workspace_id: str | None = None) -> tuple[str, str, str | None]:
    """Read workspace_id, agent_id, and workspace owner user_id from local Postgres."""
    # Tab separator avoids collision with `|` characters that appear inside
    # user_ids like "google-oauth2|104939625588671259012".
    workspace_filter = ""
    if workspace_id:
        workspace_filter = f"""WHERE w."workspaceId" = '{workspace_id.replace("'", "''")}'"""
    sql = f"""SELECT w."workspaceId", a.agent_id, w."workspaceOwnerUserId" FROM eesel_ai_workspaces w LEFT JOIN eesel_ai_agents a ON a.workspace_id = w."workspaceId" {workspace_filter} ORDER BY w."createdAt" ASC LIMIT 1;"""
    try:
        out = (
            subprocess.check_output(
                ["docker", "exec", POSTGRES_CONTAINER, "psql", "-U", "postgres", "-d", POSTGRES_DB, "-AtF", "\t", "-c", sql],
                stderr=subprocess.PIPE,
            )
            .decode()
            .strip()
        )
    except FileNotFoundError:
        sys.exit("docker not on PATH. Is Docker running?")
    except subprocess.CalledProcessError as e:
        sys.exit(f"Could not read workspace from local db. Is `docker compose up` running in ~/src/slack?\n{e.stderr.decode().strip()}")
    parts = out.split("\t") if out else []
    if len(parts) < 2:
        if workspace_id:
            sys.exit(f"No workspace {workspace_id} in local db.")
        sys.exit("No workspace in local db. Sign up via the local dashboard first.")
    ws, ag = parts[0], parts[1]
    user_id = parts[2] if len(parts) >= 3 and parts[2] else None
    if not ag:
        sys.exit(f"Workspace {ws} has no agent. Create one in the dashboard first.")
    return ws, ag, user_id


