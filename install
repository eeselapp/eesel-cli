#!/bin/sh
# eesel-cli installer.
#
# Usage:
#   curl -fsSL https://dashboard.eesel.ai/eesel-cli/install | sh
#   curl -fsSL https://dashboard.eesel.ai/eesel-cli/install | sh -s -- --version v0.1.0
#
# Downloads the eesel CLI from:
#   https://github.com/eeselapp/eesel-cli/releases/latest/download/eesel
#
# Env:
#   EESEL_INSTALL_DIR   override install dir (default: $HOME/.local/bin)
#   EESEL_REPO          override repo (default: eeselapp/eesel-cli)
#   EESEL_VERSION       pin a specific release tag (default: latest)

set -eu

REPO="${EESEL_REPO:-eeselapp/eesel-cli}"
BIN_NAME="eesel"
INSTALL_DIR="${EESEL_INSTALL_DIR:-$HOME/.local/bin}"
REQUESTED_VERSION="${EESEL_VERSION:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --version) REQUESTED_VERSION="$2"; shift 2 ;;
    --version=*) REQUESTED_VERSION="${1#*=}"; shift ;;
    -h|--help)
      cat <<EOF
eesel-cli installer

Options:
  --version <tag>   install a specific release (default: latest)
  -h, --help        show this help

Env:
  EESEL_INSTALL_DIR  install dir (default: \$HOME/.local/bin)
  EESEL_REPO         repo (default: eeselapp/eesel-cli)
  EESEL_VERSION      pin a specific release tag (default: latest)
EOF
      exit 0 ;;
    *) printf "error: unknown arg: %s\n" "$1" >&2; exit 2 ;;
  esac
done

err()  { printf "error: %s\n" "$*" >&2; exit 1; }
info() { printf "%s\n" "$*"; }

command -v python3 >/dev/null 2>&1 || err "python3 is required (>= 3.8)"
command -v curl    >/dev/null 2>&1 || err "curl is required"

PY_OK=$(python3 -c 'import sys; print("ok" if sys.version_info >= (3, 8) else "")')
[ "$PY_OK" = "ok" ] || err "python 3.8+ is required (found $(python3 --version))"

mkdir -p "$INSTALL_DIR"

if [ -n "$REQUESTED_VERSION" ]; then
  URL="https://github.com/$REPO/releases/download/$REQUESTED_VERSION/eesel"
  LABEL="$REQUESTED_VERSION"
else
  URL="https://github.com/$REPO/releases/latest/download/eesel"
  LABEL="latest"
fi

TMP="$INSTALL_DIR/$BIN_NAME.download.$$"
trap 'rm -f "$TMP"' EXIT

info "installing eesel ($LABEL) → $INSTALL_DIR/$BIN_NAME"
curl -fsSL "$URL" -o "$TMP" || err "download failed: $URL"

# Sanity check: must be a python script.
head -1 "$TMP" | grep -q '^#!.*python' || err "downloaded file is not a python script (corrupt download?)"

chmod +x "$TMP"
mv "$TMP" "$INSTALL_DIR/$BIN_NAME"
trap - EXIT

case ":$PATH:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    info ""
    info "note: $INSTALL_DIR is not on your PATH."
    info "add this to your shell rc (.bashrc / .zshrc):"
    info "  export PATH=\"$INSTALL_DIR:\$PATH\""
    ;;
esac

info ""
info "done. try:"
info "  eesel login"